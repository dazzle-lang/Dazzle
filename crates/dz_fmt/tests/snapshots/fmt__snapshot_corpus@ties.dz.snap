// Ties and `kills` clauses keep their meaning through formatting (spec §6.7): only the
// layout around them changes. A function type's single path loses its parentheses; a list
// keeps them, and a declaration's list never needs them.
struct Grid<T> {
    m_cells:   own ^mut T = null
    pub width: i32 = 0
    tie @cells = m_cells
    tie [*] = m_cells[*]

    pub fn push(&mut self, v: T) kills self@cells {}

    pub fn clear(&mut self) kills self@cells, self[*] {}

    pub fn first(&self) -> ^T in self@cells {
        return null
    }
}

fn think(e: &mut Enemy in world, world: &mut World) kills world.enemies@items {}

fn longer(a: str, b: str) -> str in (a, b) {
    return a
}

fn only(a: str) -> str in a {
    return a
}

struct Hooks {
    pub on_spawn: fn(world: &mut World) kills world.spawned@items
    pub on_reset: fn(world: &mut World) kills (world.enemies@items, world.spawned@items)
    pub pick:     fn(a: &Enemy, b: &Enemy) -> &Enemy in (a, b)
    pub first:    fn(xs: &List<i32>) -> ^i32 in xs@items
}

pub view struct Cursor<view I: Iterate> {
    pub inner: I
}

trait Walk {
    view type Steps: Iterate
}

fn count<view T: Iterate>(it: T, view: i32) -> i32 {
    return view
}
