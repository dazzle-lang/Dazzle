// The prelude: in scope in every file with no `import` (spec §3.2, §18.23).
//
// This is ordinary Dazzle source, carried by the compiler rather than read from disk. It is
// not a fixture to be thrown away — it is the seed of the stdlib (§19 M12), and keeping it
// in the language means the trait machinery is exercised by real Dazzle code from the day it
// exists rather than by compiler-invented symbols.
//
// What may go in here is limited by what the compiler can do with it. The language's traits
// come first; then the standard allocators (§14), the first stdlib code with bodies of its
// own. `String`, `List` and `HashMap` are below.

// --- ownership (spec §6.3, §8.2) --------------------------------------------

/// What runs when a value dies (§6.5). Implementing it makes the type move-only, and it
/// becomes the type's C++ destructor — which is why it may only be implemented for a
/// struct, in the struct's own module, for every instance at once (§6.1).
pub trait Drop {
    fn drop(&mut self)
}

/// A type that can be copied. Every copyable type satisfies it (§6.3): one with no `drop`
/// and no `own` field is copyable by default and needs no implementation. Implementing it
/// is how a type that owns something becomes copyable anyway — `copy` runs on a value at
/// its defaults, and fills it in from `other` (§6.6). `impl<T: Copy> Copy for List<T>`
/// makes `List<f32>` copyable and leaves `List<File>` move-only (§8.2, §18.26).
pub trait Copy {
    fn copy(&mut self, other: &Self)
}

// --- comparison (spec §11.2) ------------------------------------------------

/// The result of `cmp`. Ordinary enum, so `switch` on it is exhaustive.
pub enum Ordering : i8 {
    Less    = -1
    Equal   = 0
    Greater = 1
}

/// `==` and `!=`.
///
/// `rhs` is a reference because comparing must not consume: a move-only type (§6.3) taken
/// by value would be moved, and `a == b` has no business destroying `b`.
pub trait Eq {
    fn eq(&self, rhs: &Self) -> bool
}

/// `<`, `>`, `<=`, `>=`. Every `Ord` is an `Eq`, so a type implementing `Ord` must
/// implement both.
pub trait Ord : Eq {
    fn cmp(&self, rhs: &Self) -> Ordering
}

/// A value's hash, which is what lets it be a `HashMap` key (§14.2).
///
/// Values that are equal must hash equally; values that differ should hash differently in
/// as many bits as possible, since a table keeps only a few of them. Integers, `bool`,
/// `char` and `str` implement it already — floats do not, because `NaN != NaN` and
/// `0.0 == -0.0` break that first promise. For a struct, combine its fields':
/// `hash_combine(x.hash(), y.hash())`.
pub trait Hash {
    fn hash(&self) -> u64
}

/// Two hashes as one, where the order matters: `(a, b)` and `(b, a)` hash apart.
pub fn hash_combine(seed: u64, h: u64) -> u64 {
    return seed ^^ (h + 0x9E3779B97F4A7C15 + (seed << 6) + (seed >> 2))
}

// --- assertions (spec §9.8, §12.7) ------------------------------------------

/// Panic when `cond` is false. The panic names the line that called `assert`, not this one:
/// `loc` is filled in where the call is written, and handed on to `panic`.
pub fn assert(cond: bool, msg: str = "", loc: SourceLocation = #location) {
    if cond {
        return
    }
    if msg.len == 0 {
        panic("assertion failed", loc)
    }
    panic("assertion failed: {}", msg, loc)
}

// --- arithmetic (spec §11.2) ------------------------------------------------
//
// `Rhs` defaults to `Self`, so `struct Vec3 : Add` means `Vec3 + Vec3`, while
// `struct Vec3 : Mul<f32>` means `Vec3 * f32` — which is what makes `v * scalar` work.
//
// `rhs` is by value, unlike `Eq`'s and `Ord`'s: `Rhs` may be a scalar, and when this was
// decided a `&f32` could not be read as an `f32` (§18.25; it can now, §18.35). By value is
// still the right signature for the copyable math types these traits exist for — a 4-byte
// copy beats an indirection.

pub trait Add<Rhs = Self> {
    type Output
    fn add(&self, rhs: Rhs) -> Output
}

pub trait Sub<Rhs = Self> {
    type Output
    fn sub(&self, rhs: Rhs) -> Output
}

pub trait Mul<Rhs = Self> {
    type Output
    fn mul(&self, rhs: Rhs) -> Output
}

pub trait Div<Rhs = Self> {
    type Output
    fn div(&self, rhs: Rhs) -> Output
}

pub trait Rem<Rhs = Self> {
    type Output
    fn rem(&self, rhs: Rhs) -> Output
}

/// Unary `-`.
pub trait Neg {
    type Output
    fn neg(&self) -> Output
}

/// `container[i]`, read. Returns a reference, so the element is not copied to be looked at.
pub trait Index<I> {
    type Output
    fn index(&self, i: I) -> &Output
}

/// `container[i]` where the container may be written: `a[i] = v` and `a[i] += 1` write
/// through the reference this returns. Chosen over `Index` whenever the container is a
/// writable place.
pub trait IndexMut<I> {
    type Output
    fn index_mut(&mut self, i: I) -> &mut Output
}

// --- iteration (spec §8.5, §10.4) -------------------------------------------

/// Something you can step through, and what `for` desugars to.
///
/// Three methods rather than one `next() -> Item?`: an optional return would put the
/// end-of-iteration signal inside the item's own value domain, so an iterator over
/// `[]^Entity` would stop at its first null element and one over `[]T?` at its first
/// `none`. Keeping "is there one" apart from "what is it" lets `Item` be any type at all —
/// `&T`, `&mut T`, `^T`, `T?`, a tuple. See §8.5 for the full argument.
pub trait Iterate {
    type Item

    fn valid(&self) -> bool
    fn get(&self) -> Item
    fn advance(&mut self)
}

/// A container `for` can loop over: it hands out a fresh iterator, since an iterator keeps
/// its position in itself and the container must not (§10.4, 18.51). `for &e in xs` calls
/// `iter()`.
pub trait Iterable {
    type Iter : Iterate
    fn iter(&self) -> Iter
}

/// A container whose elements a loop may change: `for &mut e in xs` calls `iter_mut()`.
pub trait IterableMut {
    type IterMut : Iterate
    fn iter_mut(&mut self) -> IterMut
}

/// Steps through a slice, handing out a reference to each element.
pub struct SliceIter<T> {
    m_slice: []T
    m_index: usize = 0

    SliceIter(slice: []T) {
        m_slice = slice
    }
}

impl<T> Iterate for SliceIter<T> {
    type Item = &T

    fn valid(&self) -> bool {
        return m_index < m_slice.len
    }

    fn get(&self) -> &T {
        return &m_slice[m_index]
    }

    fn advance(&mut self) {
        m_index += 1
    }
}

/// Steps through a writable slice, handing out a writable reference to each element.
pub struct SliceIterMut<T> {
    m_slice: []mut T
    m_index: usize = 0

    SliceIterMut(slice: []mut T) {
        m_slice = slice
    }
}

impl<T> Iterate for SliceIterMut<T> {
    type Item = &mut T

    fn valid(&self) -> bool {
        return m_index < m_slice.len
    }

    fn get(&self) -> &mut T {
        return &mut m_slice[m_index]
    }

    fn advance(&mut self) {
        m_index += 1
    }
}

// --- formatting (spec §12.9) ------------------------------------------------

/// Where a `Format` implementation writes.
///
/// Empty for now, and deliberately so: what it needs is a growable buffer, which is
/// `String` and arrives with M12. Declaring it here means `Format` can be written and
/// implemented today, and filling it in later adds fields rather than changing anything's
/// shape.
pub struct Formatter {
}

/// What `println("{}", x)` needs of `x`. The format string is parsed at compile time and
/// lowers to a direct sequence of these calls, with no allocation and no intermediate
/// string.
pub trait Format {
    fn format(&self, f: &mut Formatter)
}

// --- allocation (spec §7.6, §14) --------------------------------------------

/// Allocation is a library concern expressed through a trait, and the allocator is an
/// explicit parameter (§14, §18.10). `&mut self`, because an arena changes on every
/// allocation (§18.47). `loc` is the caller's line, so memory tracking names the code
/// that allocated rather than the allocator (§12.7).
pub trait Allocator {
    fn alloc(&mut self, size: usize, align: usize, loc: SourceLocation = #location) -> ^mut u8
    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation = #location,
    ) -> ^mut u8
    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation = #location)
}

/// The standard allocators (§14.2). Each is a reference to a static, evaluated where it is
/// named — so `Temp` is the arena of the thread that names it — and a reference, so
/// `Allocators::Temp.reset()` needs no `unsafe`. Either converts to the `^mut Allocator` a
/// container stores.
pub struct Allocators {
    /// The C heap: `malloc` and `free`.
    pub const Global: &mut Allocator = unsafe { &mut HEAP }
    /// This thread's scratch arena. Freeing into it does nothing; `reset()` releases
    /// everything at once, at a point the program chooses.
    pub const Temp: &mut TempArena = unsafe { &mut TEMP }
}

static HEAP: Heap = Heap{}

#[thread_local]
static TEMP: TempArena = TempArena{}

/// `Allocators::Global`. Nothing of its own: the C heap is already a good general-purpose
/// allocator, and the platform's tools understand it (§18.46).
pub struct Heap {
}

/// The strictest alignment the C heap guarantees on every platform Dazzle builds for.
/// Anything stricter is over-allocated, with the heap's own pointer kept just before the
/// one handed out — which `free` can find because it is told the alignment (§14).
const HEAP_ALIGN: usize = 8

impl Allocator for Heap {
    fn alloc(&mut self, size: usize, align: usize, loc: SourceLocation) -> ^mut u8 {
        let p: ^mut u8 = if align <= HEAP_ALIGN {
            unsafe { alloc(size, align) }
        } else {
            unsafe {
                let raw = alloc(size + align + HEAP_ALIGN, HEAP_ALIGN)
                let first = (raw as usize) + HEAP_ALIGN
                let at = (first + align - 1) / align * align
                ((at - HEAP_ALIGN) as ^mut ^mut u8)[0] = raw
                at as ^mut u8
            }
        }
        #if TRACK_MEMORY {
            unsafe { TRACKER.record(p, size, align, loc) }
        }
        return p
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 {
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
            self.free(p, old_size, align, loc)
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        if p == null {
            return
        }
        #if TRACK_MEMORY {
            unsafe { TRACKER.release(p, size, align, loc) }
        } #else {
            let _ = size + loc.line as usize
        }
        if align <= HEAP_ALIGN {
            unsafe { free(p) }
        } else {
            unsafe { free(((p as usize - HEAP_ALIGN) as ^mut ^mut u8)[0]) }
        }
    }
}

/// Bytes at the start of every arena chunk: the previous chunk, and this one's capacity.
const TEMP_HEADER: usize = 16

/// The smallest chunk an arena asks the heap for.
const TEMP_CHUNK: usize = 65536

/// `Allocators::Temp`: allocation is a pointer bump inside the current chunk, freeing is
/// nothing, and `reset()` keeps the first chunk and returns the rest (§14.2).
pub struct TempArena {
    m_chunk: ^mut u8 = null
    m_used: usize = 0
    m_cap: usize = 0

    /// Release everything allocated since the last reset. Every pointer the arena handed
    /// out is dangling afterwards; with `TRACK_MEMORY` the memory is overwritten, so a
    /// stale read shows as `0xDD` bytes rather than as plausible old data.
    pub fn reset(&mut self) {
        if m_chunk == null {
            return
        }
        unsafe {
            let mut chunk = m_chunk
            let mut prev = (chunk as ^mut ^mut u8)[0]
            while prev != null {
                #if TRACK_MEMORY {
                    poison(chunk, TEMP_HEADER, (chunk as ^mut usize)[1])
                }
                free(chunk)
                chunk = prev
                prev = (chunk as ^mut ^mut u8)[0]
            }
            #if TRACK_MEMORY {
                poison(chunk, TEMP_HEADER, if chunk == m_chunk { m_used } else { (chunk as ^mut usize)[1] })
            }
            m_chunk = chunk
            m_cap = (chunk as ^mut usize)[1]
            m_used = TEMP_HEADER
        }
    }

    /// Bytes handed out from the current chunk, for measuring a frame's scratch use.
    pub fn used(&self) -> usize {
        if m_used < TEMP_HEADER {
            return 0
        }
        return m_used - TEMP_HEADER
    }

    /// A new chunk big enough for `size` bytes at `align`, in front of the current one.
    fn grow(&mut self, size: usize, align: usize) {
        let wanted = TEMP_HEADER + align + size
        let cap = if wanted > TEMP_CHUNK { wanted } else { TEMP_CHUNK }
        unsafe {
            let chunk = alloc(cap, alignof(usize))
            (chunk as ^mut ^mut u8)[0] = m_chunk
            (chunk as ^mut usize)[1] = cap
            m_chunk = chunk
        }
        m_cap = cap
        m_used = TEMP_HEADER
    }

    /// The first offset at or past `m_used` whose address is a multiple of `align`.
    fn aligned(&self, align: usize) -> usize {
        let base = m_chunk as usize
        let at = base + m_used
        return (at + align - 1) / align * align - base
    }

    /// Does `p` point into one of this arena's chunks?
    fn owns(&self, p: ^mut u8) -> bool {
        let at = p as usize
        let mut chunk = m_chunk
        while chunk != null {
            let start = chunk as usize
            let cap = unsafe { (chunk as ^mut usize)[1] }
            if at >= start + TEMP_HEADER && at < start + cap {
                return true
            }
            chunk = unsafe { (chunk as ^mut ^mut u8)[0] }
        }
        return false
    }
}

impl Allocator for TempArena {
    fn alloc(&mut self, size: usize, align: usize, _loc: SourceLocation) -> ^mut u8 {
        let mut start = self.aligned(align)
        if m_chunk == null || start + size > m_cap {
            self.grow(size, align)
            start = self.aligned(align)
        }
        m_used = start + size
        let p: ^mut u8 = unsafe { &mut m_chunk[start] }
        return p
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 {
        // The last allocation grows in place when the chunk has room.
        if p != null && m_chunk != null {
            let offset = (p as usize) - (m_chunk as usize)
            if offset + old_size == m_used && offset + new_size <= m_cap {
                m_used = offset + new_size
                return p
            }
        }
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        #if TRACK_MEMORY {
            if p != null && !self.owns(p) {
                panic(
                    "free of {} bytes (align {}) through Allocators::Temp, which did not allocate it, at {}:{}",
                    size,
                    align,
                    loc.file,
                    loc.line,
                )
            }
        } #else {
            let _ = p != null && size + align > 0 && loc.line > 0
        }
    }
}

impl Drop for TempArena {
    fn drop(&mut self) {
        let mut chunk = m_chunk
        while chunk != null {
            unsafe {
                let prev = (chunk as ^mut ^mut u8)[0]
                free(chunk)
                chunk = prev
            }
        }
    }
}

// --- containers (spec §14) --------------------------------------------------------

/// A growable array of `T`, in memory from the allocator it was built with.
///
/// Move-only unless `T` is copyable, in which case copying it copies every element into a
/// new allocation from the same allocator. `b[i]` reads and writes an element, checked
/// against the length; `as_slice()` views them all.
pub struct List<T> {
    m_data: own ^mut T = null
    m_len: usize = 0
    m_cap: usize = 0
    m_allocator: ^mut Allocator = Allocators::Global

    /// An empty list, with room for `capacity` elements already allocated when it is
    /// given.
    List(
        capacity: usize = 0,
        allocator: ^mut Allocator = Allocators::Global,
        loc: SourceLocation = #location,
    ) {
        m_allocator = allocator
        if capacity > 0 {
            self.grow_to(capacity, loc)
        }
    }

    pub fn len(&self) -> usize {
        return m_len
    }

    pub fn capacity(&self) -> usize {
        return m_cap
    }

    pub fn is_empty(&self) -> bool {
        return m_len == 0
    }

    /// Every element, in order. Valid until the list next grows or is dropped.
    pub fn as_slice(&self) -> []T {
        return unsafe { m_data[0..m_len] }
    }

    pub fn as_mut_slice(&mut self) -> []mut T {
        return unsafe { m_data[0..m_len] }
    }

    /// Add `v` at the end, growing when there is no room.
    pub fn push(&mut self, v: T, loc: SourceLocation = #location) {
        if m_len == m_cap {
            self.grow_to(m_len + 1, loc)
        }
        unsafe { construct(m_data[m_len], move(v)) }
        m_len += 1
    }

    /// Take the last element out, or `none` when there is none.
    pub fn pop(&mut self) -> T? {
        if m_len == 0 {
            return none
        }
        m_len -= 1
        return unsafe { move_out(m_data[m_len]) }
    }

    /// Put `v` at index `i`, moving the elements from `i` on up by one. `i` may be `len()`.
    pub fn insert(&mut self, i: usize, v: T, loc: SourceLocation = #location) {
        if i > m_len {
            panic("List::insert at {} past the length {}", i, m_len)
        }
        if m_len == m_cap {
            self.grow_to(m_len + 1, loc)
        }
        let mut j = m_len
        while j > i {
            unsafe { construct(m_data[j], move_out(m_data[j - 1])) }
            j -= 1
        }
        unsafe { construct(m_data[i], move(v)) }
        m_len += 1
    }

    /// Take the element at `i` out, moving the ones after it down by one.
    pub fn remove(&mut self, i: usize) -> T {
        if i >= m_len {
            panic("List::remove at {} for a length of {}", i, m_len)
        }
        let v = unsafe { move_out(m_data[i]) }
        let mut j = i
        while j + 1 < m_len {
            unsafe { construct(m_data[j], move_out(m_data[j + 1])) }
            j += 1
        }
        m_len -= 1
        return move(v)
    }

    /// Take the element at `i` out and put the last one in its place: no shifting, and the
    /// order is not kept.
    pub fn swap_remove(&mut self, i: usize) -> T {
        if i >= m_len {
            panic("List::swap_remove at {} for a length of {}", i, m_len)
        }
        let v = unsafe { move_out(m_data[i]) }
        m_len -= 1
        if i != m_len {
            unsafe { construct(m_data[i], move_out(m_data[m_len])) }
        }
        return move(v)
    }

    /// Drop every element and keep the allocation.
    pub fn clear(&mut self) {
        self.truncate(0)
    }

    /// Drop the elements from `n` on; nothing happens when there are fewer.
    pub fn truncate(&mut self, n: usize) {
        while m_len > n {
            m_len -= 1
            unsafe { destroy(m_data[m_len]) }
        }
    }

    /// Make the length `n`: new elements start at their defaults, extra ones are dropped.
    pub fn resize(&mut self, n: usize, loc: SourceLocation = #location) {
        if n > m_cap {
            self.grow_to(n, loc)
        }
        while m_len < n {
            unsafe { construct(m_data[m_len]) }
            m_len += 1
        }
        self.truncate(n)
    }

    /// Room for at least `additional` more elements without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) {
        if m_len + additional > m_cap {
            self.grow_to(m_len + additional, loc)
        }
    }

    /// A new allocation of at least `wanted` elements — doubling, so pushing one at a time
    /// costs amortised constant time — with the elements moved into it.
    fn grow_to(&mut self, wanted: usize, loc: SourceLocation) {
        let doubled = if m_cap == 0 { 8 } else { m_cap * 2 }
        let cap = if wanted > doubled { wanted } else { doubled }
        let a = m_allocator or panic("a List with no allocator cannot grow")
        if T::is_trivially_copyable {
            // Bytes can move anywhere, so the allocator may grow the memory in place.
            let old = unsafe { m_data as ^mut u8 }
            m_data = unsafe { a.realloc(old, m_cap * sizeof(T), cap * sizeof(T), alignof(T), loc) as ^mut T }
        } else {
            let fresh = unsafe { a.alloc(cap * sizeof(T), alignof(T), loc) as ^mut T }
            for i in 0..m_len {
                unsafe { construct(fresh[i], move_out(m_data[i])) }
            }
            if m_data != null {
                a.free(unsafe { m_data as ^mut u8 }, m_cap * sizeof(T), alignof(T), loc)
            }
            m_data = fresh
        }
        m_cap = cap
    }
}

impl<T> Drop for List<T> {
    fn drop(&mut self) {
        if m_data == null {
            return
        }
        if !T::is_trivially_copyable {
            for i in 0..m_len {
                unsafe { destroy(m_data[i]) }
            }
        }
        let a = m_allocator or return
        a.free(unsafe { m_data as ^mut u8 }, m_cap * sizeof(T), alignof(T))
    }
}

impl<T: Copy> Copy for List<T> {
    fn copy(&mut self, other: &Self) {
        m_allocator = other.m_allocator
        if other.m_len == 0 {
            return
        }
        let a = m_allocator or panic("a List with no allocator cannot be copied")
        m_data = unsafe { a.alloc(other.m_len * sizeof(T), alignof(T)) as ^mut T }
        m_cap = other.m_len
        for i in 0..other.m_len {
            unsafe { construct(m_data[i], other.m_data[i]) }
        }
        m_len = other.m_len
    }
}

impl<T> Index<usize> for List<T> {
    type Output = T

    fn index(&self, i: usize) -> &T {
        if i >= m_len {
            panic("index {} is out of bounds for a List of length {}", i, m_len)
        }
        return unsafe { &m_data[i] }
    }
}

/// `for &e in list`, in order.
impl<T> Iterable for List<T> {
    type Iter = SliceIter<T>

    fn iter(&self) -> SliceIter<T> {
        return SliceIter<T>(self.as_slice())
    }
}

/// `for &mut e in list`, in order.
impl<T> IterableMut for List<T> {
    type IterMut = SliceIterMut<T>

    fn iter_mut(&mut self) -> SliceIterMut<T> {
        return SliceIterMut<T>(self.as_mut_slice())
    }
}

impl<T> IndexMut<usize> for List<T> {
    type Output = T

    fn index_mut(&mut self, i: usize) -> &mut T {
        if i >= m_len {
            panic("index {} is out of bounds for a List of length {}", i, m_len)
        }
        return unsafe { &mut m_data[i] }
    }
}

/// Owned, growable UTF-8 text, in memory from the allocator it was built with.
///
/// Its bytes are always followed by a zero, so `as_cstr()` hands a C function the text
/// without a copy. Copying a `String` copies the text.
pub struct String {
    m_bytes: List<u8>

    /// A copy of `s`.
    String(s: str = "", allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) {
        m_bytes = List<u8>(0, allocator, loc)
        self.push_str(s, loc)
    }

    /// A copy of `s`: `String::from("name")`.
    pub fn from(s: str, allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) -> String {
        return String(s, allocator, loc)
    }

    /// The length in bytes, not counting the zero after them.
    pub fn len(&self) -> usize {
        if m_bytes.len() == 0 {
            return 0
        }
        return m_bytes.len() - 1
    }

    pub fn is_empty(&self) -> bool {
        return self.len() == 0
    }

    pub fn capacity(&self) -> usize {
        return m_bytes.capacity()
    }

    /// The text, borrowed. Valid until the `String` next changes or is dropped.
    pub fn as_str(&self) -> str {
        let bytes = m_bytes.as_slice()
        return unsafe { bytes[0..self.len()] as str }
    }

    /// The text as a C string, borrowed, for C and C++ functions that want one.
    pub fn as_cstr(&self) -> cstr {
        if m_bytes.len() == 0 {
            return ""
        }
        return unsafe { m_bytes.as_slice().ptr as cstr }
    }

    /// Append `s`.
    pub fn push_str(&mut self, s: str, loc: SourceLocation = #location) {
        if s.len == 0 {
            return
        }
        let _ = m_bytes.pop()
        m_bytes.reserve(s.len + 1, loc)
        let bytes = s as []u8
        for b in bytes {
            m_bytes.push(b, loc)
        }
        m_bytes.push(0, loc)
    }

    /// Append one character, encoded as UTF-8.
    pub fn push(&mut self, c: char, loc: SourceLocation = #location) {
        let mut encoded: [4]u8 = [0, 0, 0, 0]
        let n = encode_utf8(c, &mut encoded)
        let text = unsafe { encoded[0..n] as str }
        self.push_str(text, loc)
    }

    /// Empty the text and keep the allocation.
    pub fn clear(&mut self) {
        m_bytes.clear()
    }

    /// Room for at least `additional` more bytes without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) {
        m_bytes.reserve(additional + 1, loc)
    }
}

impl Eq for String {
    fn eq(&self, rhs: &String) -> bool {
        return self.as_str() == rhs.as_str()
    }
}

/// The same hash as the text as a `str`.
impl Hash for String {
    fn hash(&self) -> u64 {
        return self.as_str().hash()
    }
}

/// A map from keys to values, in memory from the allocator it was built with.
///
/// Open addressing with linear probing: one array each of hashes, keys and values, a slot
/// empty when its hash is zero. It grows to twice the slots when three quarters are full,
/// and `remove` shifts the entries after a removed one back rather than leaving a marker,
/// so lookups never slow down with use. Move-only unless both `K` and `V` are copyable.
///
/// A lookup returns a pointer, `null` when the key is absent (§9.1), so it is handled with
/// `or`: `let hp = health.get(&id) or return`.
pub struct HashMap<K: Hash + Eq, V> {
    m_hashes: own ^mut u64 = null
    m_keys: own ^mut K = null
    m_values: own ^mut V = null
    m_len: usize = 0
    m_slots: usize = 0
    m_allocator: ^mut Allocator = Allocators::Global

    /// An empty map, with room for `capacity` entries already allocated when it is given.
    HashMap(
        capacity: usize = 0,
        allocator: ^mut Allocator = Allocators::Global,
        loc: SourceLocation = #location,
    ) {
        m_allocator = allocator
        if capacity > 0 {
            self.grow_to(capacity, loc)
        }
    }

    pub fn len(&self) -> usize {
        return m_len
    }

    pub fn is_empty(&self) -> bool {
        return m_len == 0
    }

    /// How many entries fit before the map grows again.
    pub fn capacity(&self) -> usize {
        return m_slots / 4 * 3
    }

    /// Add `key` with `value`. When the key was already there its value is replaced, and
    /// the old one dropped; `replace` hands it back instead.
    pub fn insert(&mut self, key: K, value: V, loc: SourceLocation = #location) {
        let _ = self.replace(move(key), move(value), loc)
    }

    /// Add `key` with `value`, returning the value it replaces, or `none` when the key is
    /// new.
    pub fn replace(&mut self, key: K, value: V, loc: SourceLocation = #location) -> V? {
        let h = key_hash(&key)
        if let slot = self.find(&key, h) {
            let old = unsafe { move_out(m_values[slot]) }
            unsafe { construct(m_values[slot], move(value)) }
            return move(old)
        }
        if (m_len + 1) * 4 > m_slots * 3 {
            self.grow_to(m_len + 1, loc)
        }
        self.place(move(key), move(value), h)
        m_len += 1
        return none
    }

    /// The value for `key`, or `null` when there is none.
    pub fn get(&self, key: &K) -> ^V {
        let slot = self.find(key, key_hash(key)) or return null
        return unsafe { &m_values[slot] }
    }

    /// The value for `key`, to change in place, or `null` when there is none.
    pub fn get_mut(&mut self, key: &K) -> ^mut V {
        let slot = self.find(key, key_hash(key)) or return null
        return unsafe { &mut m_values[slot] }
    }

    pub fn contains(&self, key: &K) -> bool {
        return self.find(key, key_hash(key)) != none
    }

    /// Take the entry for `key` out, returning its value, or `none` when there is none.
    pub fn remove(&mut self, key: &K) -> V? {
        let found = self.find(key, key_hash(key)) or return none
        let value = unsafe { move_out(m_values[found]) }
        unsafe {
            destroy(m_keys[found])
            m_hashes[found] = 0
        }
        // Backward shift: an entry further along the run moves into the hole when the hole
        // lies between the slot it hashes to and where it sits, so no probe that passed the
        // removed entry can stop short at the gap.
        let mask = m_slots - 1
        let mut hole = found
        let mut i = (found + 1) & mask
        while unsafe { m_hashes[i] } != 0 {
            let home = (unsafe { m_hashes[i] } & (mask as u64)) as usize
            if ((i + m_slots - home) & mask) >= ((i + m_slots - hole) & mask) {
                unsafe {
                    m_hashes[hole] = m_hashes[i]
                    m_hashes[i] = 0
                    construct(m_keys[hole], move_out(m_keys[i]))
                    construct(m_values[hole], move_out(m_values[i]))
                }
                hole = i
            }
            i = (i + 1) & mask
        }
        m_len -= 1
        return move(value)
    }

    /// Drop every entry and keep the allocation.
    pub fn clear(&mut self) {
        for i in 0..m_slots {
            if unsafe { m_hashes[i] } != 0 {
                unsafe {
                    destroy(m_keys[i])
                    destroy(m_values[i])
                    m_hashes[i] = 0
                }
            }
        }
        m_len = 0
    }

    /// Room for at least `additional` more entries without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) {
        if (m_len + additional) * 4 > m_slots * 3 {
            self.grow_to(m_len + additional, loc)
        }
    }

    /// How many slots there are, for visiting every entry: slots `0..slot_count()`, each
    /// holding an entry or not. `for` over a map itself is owed by M12, with the iterator
    /// a `List` needs too.
    pub fn slot_count(&self) -> usize {
        return m_slots
    }

    /// The key in `slot`, or `null` when the slot is empty.
    pub fn key_at(&self, slot: usize) -> ^K {
        if self.checked_slot(slot) == 0 {
            return null
        }
        return unsafe { &m_keys[slot] }
    }

    /// The value in `slot`, or `null` when the slot is empty.
    pub fn value_at(&self, slot: usize) -> ^V {
        if self.checked_slot(slot) == 0 {
            return null
        }
        return unsafe { &m_values[slot] }
    }

    /// The value in `slot`, to change in place, or `null` when the slot is empty.
    pub fn value_at_mut(&mut self, slot: usize) -> ^mut V {
        if self.checked_slot(slot) == 0 {
            return null
        }
        return unsafe { &mut m_values[slot] }
    }

    /// The hash stored in `slot`, after checking the slot exists.
    fn checked_slot(&self, slot: usize) -> u64 {
        if slot >= m_slots {
            panic("slot {} is out of bounds for a HashMap of {} slots", slot, m_slots)
        }
        return unsafe { m_hashes[slot] }
    }

    /// The slot holding `key`, whose hash is `h`.
    fn find(&self, key: &K, h: u64) -> usize? {
        if m_len == 0 {
            return none
        }
        let mask = m_slots - 1
        let mut i = (h & (mask as u64)) as usize
        // A quarter of the slots are always empty, so the run ends.
        while true {
            let stored = unsafe { m_hashes[i] }
            if stored == 0 {
                return none
            }
            if stored == h && unsafe { m_keys[i].eq(key) } {
                return i
            }
            i = (i + 1) & mask
        }
        return none
    }

    /// Put an entry known not to be present into the first free slot of its run.
    fn place(&mut self, key: K, value: V, h: u64) {
        let mask = m_slots - 1
        let mut i = (h & (mask as u64)) as usize
        while unsafe { m_hashes[i] } != 0 {
            i = (i + 1) & mask
        }
        unsafe {
            m_hashes[i] = h
            construct(m_keys[i], move(key))
            construct(m_values[i], move(value))
        }
    }

    /// Enough slots for `wanted` entries at three quarters full — a power of two, so a hash
    /// picks its slot with a mask — with every entry moved over.
    fn grow_to(&mut self, wanted: usize, loc: SourceLocation) {
        let mut slots: usize = if m_slots == 0 { 8 } else { m_slots * 2 }
        while wanted * 4 > slots * 3 {
            slots *= 2
        }
        let a = m_allocator or panic("a HashMap with no allocator cannot grow")
        let old_hashes = unsafe { m_hashes as ^mut u64 }
        let old_keys = unsafe { m_keys as ^mut K }
        let old_values = unsafe { m_values as ^mut V }
        let old_slots = m_slots
        m_hashes = unsafe { a.alloc(slots * sizeof(u64), alignof(u64), loc) as ^mut u64 }
        m_keys = unsafe { a.alloc(slots * sizeof(K), alignof(K), loc) as ^mut K }
        m_values = unsafe { a.alloc(slots * sizeof(V), alignof(V), loc) as ^mut V }
        m_slots = slots
        for i in 0..slots {
            unsafe { m_hashes[i] = 0 }
        }
        if old_hashes == null {
            return
        }
        for i in 0..old_slots {
            let h = unsafe { old_hashes[i] }
            if h != 0 {
                unsafe { self.place(move_out(old_keys[i]), move_out(old_values[i]), h) }
            }
        }
        a.free(unsafe { old_hashes as ^mut u8 }, old_slots * sizeof(u64), alignof(u64), loc)
        a.free(unsafe { old_keys as ^mut u8 }, old_slots * sizeof(K), alignof(K), loc)
        a.free(unsafe { old_values as ^mut u8 }, old_slots * sizeof(V), alignof(V), loc)
    }
}

/// Steps through a map's entries in slot order, handing out `(&K, &V)`: `for k, &v in map`.
pub struct HashMapIter<K: Hash + Eq, V> {
    m_map: ^HashMap<K, V> = null
    m_slot: usize = 0

    HashMapIter(map: &HashMap<K, V>) {
        m_map = map
        m_slot = first_entry_from(map, 0)
    }
}

impl<K: Hash + Eq, V> Iterate for HashMapIter<K, V> {
    type Item = (&K, &V)

    fn valid(&self) -> bool {
        let map = m_map or return false
        return m_slot < map.slot_count()
    }

    fn get(&self) -> (&K, &V) {
        let map = m_map or unreachable
        return (map.key_at(m_slot) or unreachable, map.value_at(m_slot) or unreachable)
    }

    fn advance(&mut self) {
        let map = m_map or return
        m_slot = first_entry_from(map, m_slot + 1)
    }
}

/// Steps through a map's entries in slot order, handing out `(&K, &mut V)`: `for k, &mut v
/// in map` changes the values in place. Keys stay read-only, since changing one would put
/// it in the wrong slot.
pub struct HashMapIterMut<K: Hash + Eq, V> {
    m_map: ^mut HashMap<K, V> = null
    m_slot: usize = 0

    HashMapIterMut(map: &mut HashMap<K, V>) {
        m_slot = first_entry_from(map, 0)
        m_map = map
    }
}

impl<K: Hash + Eq, V> Iterate for HashMapIterMut<K, V> {
    type Item = (&K, &mut V)

    fn valid(&self) -> bool {
        let map = m_map or return false
        return m_slot < map.slot_count()
    }

    fn get(&self) -> (&K, &mut V) {
        let map = m_map or unreachable
        return (map.key_at(m_slot) or unreachable, map.value_at_mut(m_slot) or unreachable)
    }

    fn advance(&mut self) {
        let map = m_map or return
        m_slot = first_entry_from(map, m_slot + 1)
    }
}

/// The first slot from `slot` on that holds an entry, or the slot count when none does.
fn first_entry_from<K: Hash + Eq, V>(map: &HashMap<K, V>, slot: usize) -> usize {
    let mut i = slot
    while i < map.slot_count() && map.key_at(i) == null {
        i += 1
    }
    return i
}

impl<K: Hash + Eq, V> Iterable for HashMap<K, V> {
    type Iter = HashMapIter<K, V>

    fn iter(&self) -> HashMapIter<K, V> {
        return HashMapIter<K, V>(&self)
    }
}

impl<K: Hash + Eq, V> IterableMut for HashMap<K, V> {
    type IterMut = HashMapIterMut<K, V>

    fn iter_mut(&mut self) -> HashMapIterMut<K, V> {
        return HashMapIterMut<K, V>(&mut self)
    }
}

/// A key's hash, never zero: zero marks an empty slot.
fn key_hash<K: Hash>(key: &K) -> u64 {
    let h = key.hash()
    if h == 0 {
        return 1
    }
    return h
}

impl<K, V> Drop for HashMap<K, V> {
    fn drop(&mut self) {
        if m_hashes == null {
            return
        }
        self.clear()
        let a = m_allocator or return
        a.free(unsafe { m_hashes as ^mut u8 }, m_slots * sizeof(u64), alignof(u64))
        a.free(unsafe { m_keys as ^mut u8 }, m_slots * sizeof(K), alignof(K))
        a.free(unsafe { m_values as ^mut u8 }, m_slots * sizeof(V), alignof(V))
    }
}

impl<K: Hash + Eq + Copy, V: Copy> Copy for HashMap<K, V> {
    fn copy(&mut self, other: &Self) {
        m_allocator = other.m_allocator
        if other.m_len == 0 {
            return
        }
        let a = m_allocator or panic("a HashMap with no allocator cannot be copied")
        m_slots = other.m_slots
        m_hashes = unsafe { a.alloc(m_slots * sizeof(u64), alignof(u64)) as ^mut u64 }
        m_keys = unsafe { a.alloc(m_slots * sizeof(K), alignof(K)) as ^mut K }
        m_values = unsafe { a.alloc(m_slots * sizeof(V), alignof(V)) as ^mut V }
        for i in 0..m_slots {
            let h = unsafe { other.m_hashes[i] }
            unsafe { m_hashes[i] = h }
            if h != 0 {
                unsafe {
                    construct(m_keys[i], other.m_keys[i])
                    construct(m_values[i], other.m_values[i])
                }
            }
        }
        m_len = other.m_len
    }
}

/// `c` as UTF-8 into `out`, returning how many bytes it took.
fn encode_utf8(c: char, out: &mut [4]u8) -> usize {
    let cp = c as u32
    if cp < 0x80 {
        out[0] = cp as u8
        return 1
    }
    if cp < 0x800 {
        out[0] = (0xC0 | (cp >> 6)) as u8
        out[1] = (0x80 | (cp & 0x3F)) as u8
        return 2
    }
    if cp < 0x10000 {
        out[0] = (0xE0 | (cp >> 12)) as u8
        out[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8
        out[2] = (0x80 | (cp & 0x3F)) as u8
        return 3
    }
    out[0] = (0xF0 | (cp >> 18)) as u8
    out[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8
    out[2] = (0x80 | ((cp >> 6) & 0x3F)) as u8
    out[3] = (0x80 | (cp & 0x3F)) as u8
    return 4
}

// --- memory tracking (spec §14.2), only with `TRACK_MEMORY` -----------------------

#if TRACK_MEMORY {
    /// Fill `p[from..to]` with `0xDD`, so memory read after it was released is recognisable.
    fn poison(p: ^mut u8, from: usize, to: usize) {
        let mut i = from
        while i < to {
            unsafe { p[i] = 0xDD }
            i += 1
        }
    }

    /// One allocation the heap handed out, and — once freed — where it was freed, so a
    /// second free can say where the first one was.
    struct Allocation {
        pub addr: usize = 0
        pub size: usize = 0
        pub align: usize = 0
        pub live: bool = false
        pub file: cstr = ""
        pub line: u32 = 0
        pub freed_file: cstr = ""
        pub freed_line: u32 = 0
    }

    /// Every allocation `Allocators::Global` has made, by address: open addressing with
    /// linear probing, in memory of its own from the C heap so tracking never tracks itself.
    /// It reports leaks when the program ends, which is when this static is dropped.
    struct Tracker {
        m_slots: ^mut Allocation = null
        m_cap: usize = 0
        m_used: usize = 0

        pub fn record(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
            if (m_used + 1) * 2 > m_cap {
                self.rehash()
            }
            let i = self.slot(p as usize)
            unsafe {
                if m_slots[i].addr == 0 {
                    m_used += 1
                }
                m_slots[i].addr = p as usize
                m_slots[i].size = size
                m_slots[i].align = align
                m_slots[i].live = true
                m_slots[i].file = loc.file
                m_slots[i].line = loc.line
            }
        }

        pub fn release(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
            if m_cap == 0 {
                panic("free of a pointer Allocators::Global never allocated, at {}:{}", loc.file, loc.line)
            }
            let i = self.slot(p as usize)
            unsafe {
                if m_slots[i].addr == 0 {
                    panic(
                        "free of a pointer Allocators::Global never allocated, at {}:{}",
                        loc.file,
                        loc.line,
                    )
                }
                if !m_slots[i].live {
                    panic(
                        "double free at {}:{}; allocated at {}:{} and already freed at {}:{}",
                        loc.file,
                        loc.line,
                        m_slots[i].file,
                        m_slots[i].line,
                        m_slots[i].freed_file,
                        m_slots[i].freed_line,
                    )
                }
                if m_slots[i].size != size || m_slots[i].align != align {
                    panic(
                        "free of {} bytes (align {}) at {}:{}, but {}:{} allocated {} bytes (align {})",
                        size,
                        align,
                        loc.file,
                        loc.line,
                        m_slots[i].file,
                        m_slots[i].line,
                        m_slots[i].size,
                        m_slots[i].align,
                    )
                }
                m_slots[i].live = false
                m_slots[i].freed_file = loc.file
                m_slots[i].freed_line = loc.line
            }
        }

        /// The slot holding `addr`, or the empty one where it would go.
        fn slot(&self, addr: usize) -> usize {
            let mut i = (addr / 16) % m_cap
            unsafe {
                while m_slots[i].addr != 0 && m_slots[i].addr != addr {
                    i = (i + 1) % m_cap
                }
            }
            return i
        }

        /// Double the table. Live allocations move; freed ones are forgotten, which only
        /// costs a double free of something freed long ago being reported as foreign.
        fn rehash(&mut self) {
            let old = m_slots
            let old_cap = m_cap
            m_cap = if old_cap == 0 { 1024 } else { old_cap * 2 }
            m_used = 0
            unsafe {
                m_slots = alloc(m_cap * sizeof(Allocation), alignof(Allocation)) as ^mut Allocation
                let mut i: usize = 0
                while i < m_cap {
                    construct(m_slots[i], Allocation{})
                    i += 1
                }
                let mut j: usize = 0
                while j < old_cap {
                    if old[j].live {
                        let k = self.slot(old[j].addr)
                        m_slots[k] = old[j]
                        m_used += 1
                    }
                    j += 1
                }
                if old != null {
                    free(old)
                }
            }
        }
    }

    impl Drop for Tracker {
        fn drop(&mut self) {
            let mut leaks: usize = 0
            let mut bytes: usize = 0
            let mut i: usize = 0
            while i < m_cap {
                unsafe {
                    if m_slots[i].live {
                        leaks += 1
                        bytes += m_slots[i].size
                        println(
                            "leak: {} bytes allocated at {}:{}",
                            m_slots[i].size,
                            m_slots[i].file,
                            m_slots[i].line,
                        )
                    }
                }
                i += 1
            }
            if leaks > 0 {
                println("{} allocations leaked, {} bytes", leaks, bytes)
            }
            if m_slots != null {
                unsafe { free(m_slots) }
            }
        }
    }

    static TRACKER: Tracker = Tracker{}
}
