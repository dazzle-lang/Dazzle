// The prelude: in scope in every file with no `import` (spec §3.2, §18.23).
//
// This is ordinary Dazzle source, carried by the compiler rather than read from disk. It is
// not a fixture to be thrown away — it is the seed of the stdlib (§19 M12), and keeping it
// in the language means the trait machinery is exercised by real Dazzle code from the day it
// exists rather than by compiler-invented symbols.
//
// What may go in here is limited by what the compiler can do with it. The language's traits
// come first; then the standard allocators (§14), the first stdlib code with bodies of its
// own. `String`, `Buffer` and `HashMap` follow in M12.

// --- ownership (spec §6.3, §8.2) --------------------------------------------

/// What runs when a value dies (§6.5). Implementing it makes the type move-only, and it
/// becomes the type's C++ destructor — which is why it may only be implemented for a
/// struct, in the struct's own module, for every instance at once (§6.1).
pub trait Drop {
    fn drop(&mut self)
}

/// A type that can be copied. Every copyable type satisfies it (§6.3): one with no `drop`
/// and no `own` field is copyable by default and needs no implementation. Implementing it
/// is how a type that owns something becomes copyable anyway — `copy` runs on a value at
/// its defaults, and fills it in from `other` (§6.6). `impl<T: Copy> Copy for Buffer<T>`
/// makes `Buffer<f32>` copyable and leaves `Buffer<File>` move-only (§8.2, §18.26).
pub trait Copy {
    fn copy(&mut self, other: &Self)
}

// --- comparison (spec §11.2) ------------------------------------------------

/// The result of `cmp`. Ordinary enum, so `switch` on it is exhaustive.
pub enum Ordering : i8 {
    Less    = -1
    Equal   = 0
    Greater = 1
}

/// `==` and `!=`.
///
/// `rhs` is a reference because comparing must not consume: a move-only type (§6.3) taken
/// by value would be moved, and `a == b` has no business destroying `b`.
pub trait Eq {
    fn eq(&self, rhs: &Self) -> bool
}

/// `<`, `>`, `<=`, `>=`. Every `Ord` is an `Eq`, so a type implementing `Ord` must
/// implement both.
pub trait Ord : Eq {
    fn cmp(&self, rhs: &Self) -> Ordering
}

// --- arithmetic (spec §11.2) ------------------------------------------------
//
// `Rhs` defaults to `Self`, so `struct Vec3 : Add` means `Vec3 + Vec3`, while
// `struct Vec3 : Mul<f32>` means `Vec3 * f32` — which is what makes `v * scalar` work.
//
// `rhs` is by value, unlike `Eq`'s and `Ord`'s: `Rhs` may be a scalar, and when this was
// decided a `&f32` could not be read as an `f32` (§18.25; it can now, §18.35). By value is
// still the right signature for the copyable math types these traits exist for — a 4-byte
// copy beats an indirection.

pub trait Add<Rhs = Self> {
    type Output
    fn add(&self, rhs: Rhs) -> Output
}

pub trait Sub<Rhs = Self> {
    type Output
    fn sub(&self, rhs: Rhs) -> Output
}

pub trait Mul<Rhs = Self> {
    type Output
    fn mul(&self, rhs: Rhs) -> Output
}

pub trait Div<Rhs = Self> {
    type Output
    fn div(&self, rhs: Rhs) -> Output
}

pub trait Rem<Rhs = Self> {
    type Output
    fn rem(&self, rhs: Rhs) -> Output
}

/// Unary `-`.
pub trait Neg {
    type Output
    fn neg(&self) -> Output
}

/// `container[i]`. Returns a reference, so `a[i] = v` writes through it.
pub trait Index<I> {
    type Output
    fn index(&self, i: I) -> &Output
}

// --- iteration (spec §8.5, §10.4) -------------------------------------------

/// Something you can step through, and what `for` desugars to.
///
/// Three methods rather than one `next() -> Item?`: an optional return would put the
/// end-of-iteration signal inside the item's own value domain, so an iterator over
/// `[]^Entity` would stop at its first null element and one over `[]T?` at its first
/// `none`. Keeping "is there one" apart from "what is it" lets `Item` be any type at all —
/// `&T`, `&mut T`, `^T`, `T?`, a tuple. See §8.5 for the full argument.
pub trait Iterate {
    type Item

    fn valid(&self) -> bool
    fn get(&self) -> Item
    fn advance(&mut self)
}

// --- formatting (spec §12.9) ------------------------------------------------

/// Where a `Format` implementation writes.
///
/// Empty for now, and deliberately so: what it needs is a growable buffer, which is
/// `String` and arrives with M12. Declaring it here means `Format` can be written and
/// implemented today, and filling it in later adds fields rather than changing anything's
/// shape.
pub struct Formatter {
}

/// What `println("{}", x)` needs of `x`. The format string is parsed at compile time and
/// lowers to a direct sequence of these calls, with no allocation and no intermediate
/// string.
pub trait Format {
    fn format(&self, f: &mut Formatter)
}

// --- allocation (spec §7.6, §14) --------------------------------------------

/// Allocation is a library concern expressed through a trait, and the allocator is an
/// explicit parameter (§14, §18.10). `&mut self`, because an arena changes on every
/// allocation (§18.47). `loc` is the caller's line, so memory tracking names the code
/// that allocated rather than the allocator (§12.7).
pub trait Allocator {
    fn alloc(&mut self, size: usize, align: usize, loc: SourceLocation = #location) -> ^mut u8
    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation = #location,
    ) -> ^mut u8
    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation = #location)
}

/// The standard allocators (§14.2). Each is a reference to a static, evaluated where it is
/// named — so `Temp` is the arena of the thread that names it — and a reference, so
/// `Allocators::Temp.reset()` needs no `unsafe`. Either converts to the `^mut Allocator` a
/// container stores.
pub struct Allocators {
    /// The C heap: `malloc` and `free`.
    pub const Global: &mut Allocator = unsafe { &mut HEAP }
    /// This thread's scratch arena. Freeing into it does nothing; `reset()` releases
    /// everything at once, at a point the program chooses.
    pub const Temp: &mut TempArena = unsafe { &mut TEMP }
}

static HEAP: Heap = Heap{}

#[thread_local]
static TEMP: TempArena = TempArena{}

/// `Allocators::Global`. Nothing of its own: the C heap is already a good general-purpose
/// allocator, and the platform's tools understand it (§18.46).
pub struct Heap {
}

/// The strictest alignment the C heap guarantees on every platform Dazzle builds for.
/// Anything stricter is over-allocated, with the heap's own pointer kept just before the
/// one handed out — which `free` can find because it is told the alignment (§14).
const HEAP_ALIGN: usize = 8

impl Allocator for Heap {
    fn alloc(&mut self, size: usize, align: usize, loc: SourceLocation) -> ^mut u8 {
        let p: ^mut u8 = if align <= HEAP_ALIGN {
            unsafe { alloc(size, align) }
        } else {
            unsafe {
                let raw = alloc(size + align + HEAP_ALIGN, HEAP_ALIGN)
                let first = (raw as usize) + HEAP_ALIGN
                let at = (first + align - 1) / align * align
                ((at - HEAP_ALIGN) as ^mut ^mut u8)[0] = raw
                at as ^mut u8
            }
        }
        #if TRACK_MEMORY {
            unsafe { TRACKER.record(p, size, align, loc) }
        }
        return p
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 {
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
            self.free(p, old_size, align, loc)
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        if p == null {
            return
        }
        #if TRACK_MEMORY {
            unsafe { TRACKER.release(p, size, align, loc) }
        } #else {
            let _ = size + loc.line as usize
        }
        if align <= HEAP_ALIGN {
            unsafe { free(p) }
        } else {
            unsafe { free(((p as usize - HEAP_ALIGN) as ^mut ^mut u8)[0]) }
        }
    }
}

/// Bytes at the start of every arena chunk: the previous chunk, and this one's capacity.
const TEMP_HEADER: usize = 16

/// The smallest chunk an arena asks the heap for.
const TEMP_CHUNK: usize = 65536

/// `Allocators::Temp`: allocation is a pointer bump inside the current chunk, freeing is
/// nothing, and `reset()` keeps the first chunk and returns the rest (§14.2).
pub struct TempArena {
    m_chunk: ^mut u8 = null
    m_used: usize = 0
    m_cap: usize = 0

    /// Release everything allocated since the last reset. Every pointer the arena handed
    /// out is dangling afterwards; with `TRACK_MEMORY` the memory is overwritten, so a
    /// stale read shows as `0xDD` bytes rather than as plausible old data.
    pub fn reset(&mut self) {
        if m_chunk == null {
            return
        }
        unsafe {
            let mut chunk = m_chunk
            let mut prev = (chunk as ^mut ^mut u8)[0]
            while prev != null {
                #if TRACK_MEMORY {
                    poison(chunk, TEMP_HEADER, (chunk as ^mut usize)[1])
                }
                free(chunk)
                chunk = prev
                prev = (chunk as ^mut ^mut u8)[0]
            }
            #if TRACK_MEMORY {
                poison(chunk, TEMP_HEADER, if chunk == m_chunk { m_used } else { (chunk as ^mut usize)[1] })
            }
            m_chunk = chunk
            m_cap = (chunk as ^mut usize)[1]
            m_used = TEMP_HEADER
        }
    }

    /// Bytes handed out from the current chunk, for measuring a frame's scratch use.
    pub fn used(&self) -> usize {
        if m_used < TEMP_HEADER {
            return 0
        }
        return m_used - TEMP_HEADER
    }

    /// A new chunk big enough for `size` bytes at `align`, in front of the current one.
    fn grow(&mut self, size: usize, align: usize) {
        let wanted = TEMP_HEADER + align + size
        let cap = if wanted > TEMP_CHUNK { wanted } else { TEMP_CHUNK }
        unsafe {
            let chunk = alloc(cap, alignof(usize))
            (chunk as ^mut ^mut u8)[0] = m_chunk
            (chunk as ^mut usize)[1] = cap
            m_chunk = chunk
        }
        m_cap = cap
        m_used = TEMP_HEADER
    }

    /// The first offset at or past `m_used` whose address is a multiple of `align`.
    fn aligned(&self, align: usize) -> usize {
        let base = m_chunk as usize
        let at = base + m_used
        return (at + align - 1) / align * align - base
    }

    /// Does `p` point into one of this arena's chunks?
    fn owns(&self, p: ^mut u8) -> bool {
        let at = p as usize
        let mut chunk = m_chunk
        while chunk != null {
            let start = chunk as usize
            let cap = unsafe { (chunk as ^mut usize)[1] }
            if at >= start + TEMP_HEADER && at < start + cap {
                return true
            }
            chunk = unsafe { (chunk as ^mut ^mut u8)[0] }
        }
        return false
    }
}

impl Allocator for TempArena {
    fn alloc(&mut self, size: usize, align: usize, _loc: SourceLocation) -> ^mut u8 {
        let mut start = self.aligned(align)
        if m_chunk == null || start + size > m_cap {
            self.grow(size, align)
            start = self.aligned(align)
        }
        m_used = start + size
        let p: ^mut u8 = unsafe { &mut m_chunk[start] }
        return p
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 {
        // The last allocation grows in place when the chunk has room.
        if p != null && m_chunk != null {
            let offset = (p as usize) - (m_chunk as usize)
            if offset + old_size == m_used && offset + new_size <= m_cap {
                m_used = offset + new_size
                return p
            }
        }
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        #if TRACK_MEMORY {
            if p != null && !self.owns(p) {
                panic(
                    "free of {} bytes (align {}) through Allocators::Temp, which did not allocate it, at {}:{}",
                    size,
                    align,
                    loc.file,
                    loc.line,
                )
            }
        } #else {
            let _ = p != null && size + align > 0 && loc.line > 0
        }
    }
}

impl Drop for TempArena {
    fn drop(&mut self) {
        let mut chunk = m_chunk
        while chunk != null {
            unsafe {
                let prev = (chunk as ^mut ^mut u8)[0]
                free(chunk)
                chunk = prev
            }
        }
    }
}

// --- memory tracking (spec §14.2), only with `TRACK_MEMORY` -----------------------

#if TRACK_MEMORY {
    /// Fill `p[from..to]` with `0xDD`, so memory read after it was released is recognisable.
    fn poison(p: ^mut u8, from: usize, to: usize) {
        let mut i = from
        while i < to {
            unsafe { p[i] = 0xDD }
            i += 1
        }
    }

    /// One allocation the heap handed out, and — once freed — where it was freed, so a
    /// second free can say where the first one was.
    struct Allocation {
        pub addr: usize = 0
        pub size: usize = 0
        pub align: usize = 0
        pub live: bool = false
        pub file: cstr = ""
        pub line: u32 = 0
        pub freed_file: cstr = ""
        pub freed_line: u32 = 0
    }

    /// Every allocation `Allocators::Global` has made, by address: open addressing with
    /// linear probing, in memory of its own from the C heap so tracking never tracks itself.
    /// It reports leaks when the program ends, which is when this static is dropped.
    struct Tracker {
        m_slots: ^mut Allocation = null
        m_cap: usize = 0
        m_used: usize = 0

        pub fn record(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
            if (m_used + 1) * 2 > m_cap {
                self.rehash()
            }
            let i = self.slot(p as usize)
            unsafe {
                if m_slots[i].addr == 0 {
                    m_used += 1
                }
                m_slots[i].addr = p as usize
                m_slots[i].size = size
                m_slots[i].align = align
                m_slots[i].live = true
                m_slots[i].file = loc.file
                m_slots[i].line = loc.line
            }
        }

        pub fn release(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
            if m_cap == 0 {
                panic("free of a pointer Allocators::Global never allocated, at {}:{}", loc.file, loc.line)
            }
            let i = self.slot(p as usize)
            unsafe {
                if m_slots[i].addr == 0 {
                    panic(
                        "free of a pointer Allocators::Global never allocated, at {}:{}",
                        loc.file,
                        loc.line,
                    )
                }
                if !m_slots[i].live {
                    panic(
                        "double free at {}:{}; allocated at {}:{} and already freed at {}:{}",
                        loc.file,
                        loc.line,
                        m_slots[i].file,
                        m_slots[i].line,
                        m_slots[i].freed_file,
                        m_slots[i].freed_line,
                    )
                }
                if m_slots[i].size != size || m_slots[i].align != align {
                    panic(
                        "free of {} bytes (align {}) at {}:{}, but {}:{} allocated {} bytes (align {})",
                        size,
                        align,
                        loc.file,
                        loc.line,
                        m_slots[i].file,
                        m_slots[i].line,
                        m_slots[i].size,
                        m_slots[i].align,
                    )
                }
                m_slots[i].live = false
                m_slots[i].freed_file = loc.file
                m_slots[i].freed_line = loc.line
            }
        }

        /// The slot holding `addr`, or the empty one where it would go.
        fn slot(&self, addr: usize) -> usize {
            let mut i = (addr / 16) % m_cap
            unsafe {
                while m_slots[i].addr != 0 && m_slots[i].addr != addr {
                    i = (i + 1) % m_cap
                }
            }
            return i
        }

        /// Double the table. Live allocations move; freed ones are forgotten, which only
        /// costs a double free of something freed long ago being reported as foreign.
        fn rehash(&mut self) {
            let old = m_slots
            let old_cap = m_cap
            m_cap = if old_cap == 0 { 1024 } else { old_cap * 2 }
            m_used = 0
            unsafe {
                m_slots = alloc(m_cap * sizeof(Allocation), alignof(Allocation)) as ^mut Allocation
                let mut i: usize = 0
                while i < m_cap {
                    construct(m_slots[i], Allocation{})
                    i += 1
                }
                let mut j: usize = 0
                while j < old_cap {
                    if old[j].live {
                        let k = self.slot(old[j].addr)
                        m_slots[k] = old[j]
                        m_used += 1
                    }
                    j += 1
                }
                if old != null {
                    free(old)
                }
            }
        }
    }

    impl Drop for Tracker {
        fn drop(&mut self) {
            let mut leaks: usize = 0
            let mut bytes: usize = 0
            let mut i: usize = 0
            while i < m_cap {
                unsafe {
                    if m_slots[i].live {
                        leaks += 1
                        bytes += m_slots[i].size
                        println(
                            "leak: {} bytes allocated at {}:{}",
                            m_slots[i].size,
                            m_slots[i].file,
                            m_slots[i].line,
                        )
                    }
                }
                i += 1
            }
            if leaks > 0 {
                println("{} allocations leaked, {} bytes", leaks, bytes)
            }
            if m_slots != null {
                unsafe { free(m_slots) }
            }
        }
    }

    static TRACKER: Tracker = Tracker{}
}
