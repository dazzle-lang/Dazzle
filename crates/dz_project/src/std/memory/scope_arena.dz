/// Bytes at the start of every region chunk: the previous chunk, and this one's capacity.
const SCOPE_HEADER: usize = 16

/// Bytes at the start of a large block: the blocks before and after it, and its size class.
/// A multiple of 16, so the memory after it is aligned to 16.
const SCOPE_LARGE_HEADER: usize = 32

/// The smallest chunk a region asks the pool for.
const SCOPE_CHUNK: usize = 65536

/// Allocations at least this big get a block of their own, given back to the pool as soon
/// as they are freed. A growing container's outgrown arrays then go back at once, as on the
/// heap, instead of staying in the region until it ends, which cost up to twice the memory;
/// and the next region that grows through the same sizes takes them from the pool rather
/// than from `malloc`.
const SCOPE_LARGE: usize = 16384

/// The largest size class the pool keeps, 4 MiB. A bigger block is exactly its size from
/// the heap and goes straight back to it: filling it costs far more than the `malloc`, and
/// keeping every class a huge buffer grew through held as much memory again as the buffer.
const SCOPE_POOLED: usize = 22

/// A region: the memory of the values one scope builds and never lets out (T-0104
/// prototype). The compiler declares one at the top of the scope and hands it to those
/// values' constructors, so it is released after every one of them is dropped.
///
/// A small allocation is a pointer bump and freeing it is nothing; the chunks go back to this
/// thread's pool when the region ends, so a region opened on every call or every pass of a
/// loop costs no `malloc` once the pool holds enough. A large one is a heap block of its own.
pub struct ScopeArena {
    m_chunk: ^mut u8 = null
    m_used: usize = 0
    m_cap: usize = 0
    /// The large blocks still held, each linked to the one before and after it.
    m_large: ^mut u8 = null

    /// A new chunk big enough for `size` bytes at `align`, in front of the current one. Each
    /// is at least twice the last, so the region settles in a few chunks.
    fn grow(&mut self, size: usize, align: usize) {
        let wanted = SCOPE_HEADER + align + size
        let mut cap = if m_cap * 2 > SCOPE_CHUNK { m_cap * 2 } else { SCOPE_CHUNK }
        if wanted > cap {
            cap = wanted
        }
        let chunk = unsafe { SCOPE_POOL.take(cap) }
        unsafe {
            (chunk as ^mut ^mut u8)[0] = m_chunk
        }
        m_chunk = chunk
        m_cap = unsafe { (chunk as ^mut usize)[1] }
        m_used = SCOPE_HEADER
    }

    /// The first offset at or past `m_used` whose address is a multiple of `align`.
    fn aligned(&self, align: usize) -> usize {
        let base = m_chunk as usize
        let at = base + m_used
        return (at + align - 1) / align * align - base
    }

    /// Whether an allocation of `size` at `align` is a large block of its own. The header
    /// keeps a block's memory aligned to 16, so anything stricter stays in a chunk.
    fn is_large(size: usize, align: usize) -> bool {
        return size >= SCOPE_LARGE && align <= SCOPE_HEADER
    }

    fn alloc_large(&mut self, size: usize) -> ^mut u8 {
        // A class past `SCOPE_POOLED` is recorded as `SCOPE_CLASSES`: not the pool's.
        let mut k = ScopePool::class(size)
        let mut block: ^mut u8 = null
        if k > SCOPE_POOLED {
            k = SCOPE_CLASSES
            block = c_malloc(SCOPE_LARGE_HEADER + size)
        } else {
            block = unsafe { SCOPE_POOL.take_large(k) }
        }
        unsafe {
            let links = block as ^mut ^mut u8
            links[0] = null
            links[1] = m_large
            (block as ^mut usize)[2] = k
            if m_large != null {
                (m_large as ^mut ^mut u8)[0] = block
            }
            m_large = block
            return &mut block[SCOPE_LARGE_HEADER]
        }
    }

    /// Give a large block back: to the pool, or to the heap when its class is too big to
    /// keep.
    fn release(block: ^mut u8) {
        unsafe {
            let k = (block as ^mut usize)[2]
            if k == SCOPE_CLASSES {
                c_free(block)
            } else {
                SCOPE_POOL.give_large(block, k)
            }
        }
    }

    fn free_large(&mut self, p: ^mut u8) {
        unsafe {
            let block = (p as usize - SCOPE_LARGE_HEADER) as ^mut u8
            let links = block as ^mut ^mut u8
            let prev = links[0]
            let next = links[1]
            if prev == null {
                m_large = next
            } else {
                (prev as ^mut ^mut u8)[1] = next
            }
            if next != null {
                (next as ^mut ^mut u8)[0] = prev
            }
            ScopeArena::release(block)
        }
    }
}

impl Allocator for ScopeArena {
    fn alloc(&mut self, size: usize, align: usize, _loc: SourceLocation) -> ^mut u8 {
        if ScopeArena::is_large(size, align) {
            return self.alloc_large(size)
        }
        let mut start = self.aligned(align)
        if m_chunk == null || start + size > m_cap {
            self.grow(size, align)
            start = self.aligned(align)
        }
        m_used = start + size
        let p: ^mut u8 = unsafe { &mut m_chunk[start] }
        return p
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 {
        // The last small allocation grows in place when the chunk has room and it stays
        // small: freeing it later by its size must not take it for a large block.
        if p != null && m_chunk != null && !ScopeArena::is_large(new_size, align) {
            let offset = (p as usize) - (m_chunk as usize)
            if offset + old_size == m_used && offset + new_size <= m_cap {
                m_used = offset + new_size
                return p
            }
        }
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
            self.free(p, old_size, align, loc)
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        if p == null {
            return
        }
        if ScopeArena::is_large(size, align) {
            self.free_large(p)
        } else if m_chunk != null && (p as usize) >= (m_chunk as usize) {
            // The last small allocation goes back: a value built and dropped at once — the
            // key `HashMap::insert` already had — costs the region nothing.
            let offset = (p as usize) - (m_chunk as usize)
            if offset + size == m_used {
                m_used = offset
            }
        }
        let _ = loc.line
    }

    fn scoped(&self) -> bool {
        return true
    }
}

impl Drop for ScopeArena {
    fn drop(&mut self) {
        let mut chunk = m_chunk
        while chunk != null {
            unsafe {
                let prev = (chunk as ^mut ^mut u8)[0]
                SCOPE_POOL.give(chunk)
                chunk = prev
            }
        }
        let mut block = m_large
        while block != null {
            unsafe {
                let next = (block as ^mut ^mut u8)[1]
                ScopeArena::release(block)
                block = next
            }
        }
    }
}
