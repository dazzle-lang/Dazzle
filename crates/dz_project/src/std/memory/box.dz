/// Sole ownership of one value, in an allocation of its own (spec §14.5). Move-only;
/// dropping it drops the value and frees it. May be `null`, which is its default and what a moved-from one is left
/// as. Reach the value with `or` or `if let`:
///
/// ```dz
/// let node = Box<Node>(Node{ value: 1 })
/// if let &n = node { println!("{}", n.value) }
/// ```
///
/// Nothing else owns the value, so there is no second owner to keep it alive while it is
/// used. Instead the value is in the box, `@value`: setting the box to `null` inside
/// `if let &n = self.node` ends `n`, and using `n` after is a compile-time error (§14.5).
///
/// A `Box<Button>` is accepted where a `Box<UiElement>` is wanted, moved into it; the box
/// remembers what it was made as, so dropping it drops the whole `Button` (18.64).
pub struct Box<T> {
    pub(module) m_ptr: own ^mut T = null
    pub(module) m_allocator: ^mut Allocator = null
    /// Drops the value and frees it, as the type the box was made as: its size and
    /// alignment are that type's, so the box need not keep them (T-0097).
    pub(module) m_drop: fn(^mut u8, ^mut Allocator)

    /// The value: emptying, replacing or moving the box ends a reference to it, and a
    /// clause names what is inside it as `h.node@value.name@text` (D-0094 point 3).
    tie @value = m_ptr[*]

    /// `value`, moved into an allocation from wherever the compiler places the box: its
    /// contents live where it lives (spec §14.6).
    Box(value: T, loc: SourceLocation = #location) {
        m_allocator = unsafe { #placement }
        let a = unsafe { m_allocator or panic!("a Box needs an allocator") }
        m_drop = drop_boxed_as<T>
        m_ptr = unsafe { a.alloc(sizeof(T), alignof(T), loc) as ^mut T }
        unsafe { construct(m_ptr[0], move(value)) }
    }
}

impl<T> Drop for Box<T> {
    fn drop(&mut self) {
        if m_ptr == null {
            return
        }
        let drop_value = m_drop
        drop_value(unsafe { m_ptr as ^mut u8 }, m_allocator)
    }
}

/// Drop the value at `p` as a `T` and give its memory back to `allocator`: what a
/// `Box` holds, made for the type its value was created as, so a `Box<UiElement>` holding
/// a `Button` drops and frees a whole `Button` (18.64).
fn drop_boxed_as<T>(p: ^mut u8, allocator: ^mut Allocator) {
    unsafe { destroy((p as ^mut T)[0]) }
    let a = unsafe { allocator or return }
    a.free(p, sizeof(T), alignof(T))
}

impl<T> Nullable for Box<T> {
    type Target = T
    type Guard = Unguarded<T>

    fn is_null(&self) -> bool {
        return m_ptr == null
    }

    fn guard(&self) -> Unguarded<T> {
        return Unguarded<T>{ m_ptr: m_ptr }
    }

    fn ptr(&self) -> ^mut T {
        return unsafe { m_ptr }
    }
}
