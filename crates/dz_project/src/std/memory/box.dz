/// Sole ownership of one value on the heap (spec §14.5). Move-only; dropping it drops the
/// value and frees it. May be `null`, which is its default and what a moved-from one is left
/// as. Reach the value with `or` or `if let`:
///
/// ```dz
/// let node = Box<Node>(Node{ value: 1 })
/// if let &n = node { println("{}", n.value) }
/// ```
///
/// Nothing else owns the value, so there is no second owner to keep it alive while it is
/// used: setting the box to `null` inside `if let &n = self.node` frees what `n` refers to,
/// as it would through a `^T` (§1.1).
///
/// A `Box<Button>` is accepted where a `Box<UiElement>` is wanted, moved into it; the box
/// remembers what it was made as, so dropping it drops the whole `Button` (18.64).
pub struct Box<T> {
    pub(module) m_ptr: own ^mut T = null
    pub(module) m_allocator: ^mut Allocator = null
    pub(module) m_size: usize = 0
    pub(module) m_align: usize = 0
    pub(module) m_drop: fn(^mut u8)

    /// `value`, moved into an allocation from `allocator`.
    Box(value: T, allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) {
        let a = allocator or panic("a Box needs an allocator")
        m_allocator = allocator
        m_size = sizeof(T)
        m_align = alignof(T)
        m_drop = drop_value_as<T>
        m_ptr = unsafe { a.alloc(m_size, m_align, loc) as ^mut T }
        unsafe { construct(m_ptr[0], move(value)) }
    }
}

impl<T> Drop for Box<T> {
    fn drop(&mut self) {
        if m_ptr == null {
            return
        }
        let drop_value = m_drop
        drop_value(unsafe { m_ptr as ^mut u8 })
        let a = m_allocator or return
        a.free(unsafe { m_ptr as ^mut u8 }, m_size, m_align)
    }
}

impl<T> Nullable for Box<T> {
    type Target = T
    type Guard = Unguarded<T>

    fn is_null(&self) -> bool {
        return m_ptr == null
    }

    fn guard(&self) -> Unguarded<T> {
        return Unguarded<T>{ m_ptr: m_ptr }
    }

    fn ptr(&self) -> ^mut T {
        return m_ptr
    }
}
