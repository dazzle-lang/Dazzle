/// Sole ownership of one value, in an allocation of its own (spec §14.5). Move-only;
/// dropping it drops the value and frees it. May be `null`, which is its default and what a moved-from one is left
/// as. Reach the value with `or` or `if let`:
///
/// ```dz
/// let node = Box<Node>(Node{ value: 1 })
/// if let &n = node { println!("{}", n.value) }
/// ```
///
/// Nothing else owns the value, so there is no second owner to keep it alive while it is
/// used. Instead the value is in the box, `@value`: setting the box to `null` inside
/// `if let &n = self.node` ends `n`, and using `n` after is a compile-time error (§14.5).
///
/// One word, as C++'s `unique_ptr` is: the allocator the value came from is in its
/// allocation, just before it, and the type it was made as is the one the box holds, or one
/// the vtable names. So a `Box<Button>` is accepted where a `Box<UiElement>` is wanted when
/// `UiElement` has a `virtual` method, and dropping it drops and frees the whole `Button`
/// (D-0064, D-0104).
pub struct Box<T> {
    pub(module) m_ptr: own ^mut T = null

    /// The value: emptying, replacing or moving the box ends a reference to it, and a
    /// clause names what is inside it as `h.node@value.name@text` (D-0094 point 3).
    tie @value = m_ptr[*]

    /// `value`, moved into an allocation from wherever the compiler places the box: its
    /// contents live where it lives (spec §14.6). The allocation is a `BoxHeader` and then
    /// the value, at the value's alignment.
    pub Box(value: T, loc: SourceLocation = #location) {
        let allocator: ^mut Allocator = unsafe { #placement }
        let a = unsafe { allocator or panic!("a Box needs an allocator") }
        let align = if alignof(T) > alignof(BoxHeader) {
            alignof(T)
        } else {
            alignof(BoxHeader)
        }
        // The header ends where the value starts, so it is found from the value alone.
        let header = if sizeof(BoxHeader) > align {
            sizeof(BoxHeader)
        } else {
            align
        }
        let start = unsafe { a.alloc(header + sizeof(T), align, loc) as usize }
        unsafe {
            construct(((start + header - sizeof(BoxHeader)) as ^mut BoxHeader)[0], BoxHeader{ allocator: allocator })
            m_ptr = (start + header) as ^mut T
            construct(m_ptr[0], value)
        }
    }
}

/// What a `Box`'s allocation keeps before its value: the allocator to give it back to.
struct BoxHeader {
    pub(module) allocator: ^mut Allocator = null
}

impl<T> Drop for Box<T> {
    fn drop(&mut self) {
        if m_ptr == null {
            return
        }
        // The size and alignment of what the box was made as: `T`'s, or a derived type's,
        // read through the vtable before the value is gone (spec §14.5).
        let size = unsafe { dyn_sizeof(m_ptr) }
        let value_align = unsafe { dyn_alignof(m_ptr) }
        let align = if value_align > alignof(BoxHeader) {
            value_align
        } else {
            alignof(BoxHeader)
        }
        let header = if sizeof(BoxHeader) > align {
            sizeof(BoxHeader)
        } else {
            align
        }
        let at = unsafe { m_ptr as usize }
        let allocator = unsafe { ((at - sizeof(BoxHeader)) as ^mut BoxHeader)[0].allocator }
        unsafe { destroy(m_ptr[0]) }
        let a = unsafe { allocator or return }
        a.free(unsafe { (at - header) as ^mut u8 }, header + size, align)
    }
}

impl<T> Nullable for Box<T> {
    type Target = T
    type Guard = Unguarded<T>

    fn is_null(&self) -> bool {
        return m_ptr == null
    }

    fn guard(&self) -> Unguarded<T> {
        return Unguarded<T>{ m_ptr: m_ptr }
    }

    fn ptr(&self) -> ^mut T {
        return unsafe { m_ptr }
    }
}
