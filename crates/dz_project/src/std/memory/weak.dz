/// A reference to a value an `Rc` owns, which does not keep it alive (spec §14.5).
///
/// When the last `Rc` is dropped the value goes, and every `Weak` to it reads as `null` from
/// then on. Reach the value with `or` or `if let`, which hold a strong `Rc` for as long as
/// it is used, so it cannot be freed mid-use:
///
/// ```dz
/// if let &mut e = self.target { e.health -= 10 } else { self.retarget() }
/// ```
///
/// Made from an `Rc` with `Weak(&rc)`. For a parent link or a cache, where an `Rc` would
/// keep the value alive for ever — or, with two of them, leak both. A `Weak<Button>` is
/// accepted where a `Weak<UiElement>` is wanted, as an `Rc` is (18.64).
pub struct Weak<T> {
    pub(module) m_header: ^mut RcHeader = null
    pub(module) m_value: ^mut T = null

    /// A weak reference to what `rc` owns; null when `rc` is.
    Weak(rc: &Rc<T>) {
        m_header = rc.m_header
        m_value = rc.m_value
        let h = m_header or return
        h.weak += 1
    }
}

impl<T> Drop for Weak<T> {
    fn drop(&mut self) {
        let h = m_header or return
        h.weak -= 1
        if h.weak == 0 && h.strong == 0 {
            let a = h.allocator or return
            a.free(unsafe { m_header as ^mut u8 }, h.size, h.align)
        }
    }
}

impl<T> Copy for Weak<T> {
    fn copy(&mut self, other: &Self) {
        m_header = other.m_header
        m_value = other.m_value
        let h = m_header or return
        h.weak += 1
    }
}

impl<T> Nullable for Weak<T> {
    type Target = T
    type Guard = Rc<T>

    fn is_null(&self) -> bool {
        let h = m_header or return true
        return h.strong == 0
    }

    /// A strong `Rc` to the value, or a null one when it is gone.
    fn guard(&self) -> Rc<T> {
        let mut r: Rc<T> = null
        let h = m_header or return r
        if h.strong == 0 {
            return r
        }
        h.strong += 1
        r.m_header = m_header
        r.m_value = m_value
        return r
    }

    fn ptr(&self) -> ^mut T {
        let h = m_header or return null
        if h.strong == 0 {
            return null
        }
        return m_value
    }
}
