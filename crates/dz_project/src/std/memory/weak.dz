/// A reference to a value an `Rc` owns, which does not keep it alive (spec §14.5).
///
/// When the last `Rc` is dropped the value goes, and every `Weak` to it reads as `null` from
/// then on. Reach the value with `or` or `if let`, which hold a strong `Rc` for as long as
/// it is used, so it cannot be freed mid-use:
///
/// ```dz
/// if let &mut e = self.target { e.health -= 10 } else { self.retarget() }
/// ```
///
/// Made from an `Rc` with `Weak(&rc)`. For a parent link or a cache, where an `Rc` would
/// keep the value alive for ever — or, with two of them, leak both. A `Weak<Button>` is
/// accepted where a `Weak<UiElement>` is wanted, as an `Rc` is (18.64).
pub struct Weak<T> {
    pub(module) m_header: ^mut RcHeader = null
    pub(module) m_value: ^mut T = null

    /// A weak reference to what `rc` owns; null when `rc` is.
    pub Weak(rc: &Rc<T>) {
        m_header = rc.m_header
        m_value = rc.m_value
        let h = unsafe { m_header or return }
        unsafe {
            rc_count_add(&mut h.weak)
        }
    }
}

impl<T> Drop for Weak<T> {
    fn drop(&mut self) {
        let h = unsafe { m_header or return }
        // The last `Weak` after the last `Rc`, which gave back its share once the value was
        // dropped (see `RcHeader`).
        if unsafe { rc_count_release(&mut h.weak) } {
            let a = unsafe { h.allocator or return }
            a.free(unsafe { m_header as ^mut u8 }, h.size, h.align)
        }
    }
}

impl<T> Clone for Weak<T> {
    fn clone(&mut self, other: &Self) {
        m_header = other.m_header
        m_value = other.m_value
        let h = unsafe { m_header or return }
        unsafe {
            rc_count_add(&mut h.weak)
        }
    }
}

impl<T> Nullable for Weak<T> {
    type Target = T
    type Guard = Rc<T>

    fn is_null(&self) -> bool {
        let h = unsafe { m_header or return true }
        return unsafe { rc_count_load(&h.strong) } == 0
    }

    /// A strong `Rc` to the value, or a null one when it is gone. On another thread the last
    /// `Rc` may be going at the same moment, so the count goes up only if it is not zero.
    fn guard(&self) -> Rc<T> {
        let mut r: Rc<T> = null
        let h = unsafe { m_header or return r }
        if !unsafe { rc_count_add_unless_zero(&mut h.strong) } {
            return r
        }
        r.m_header = m_header
        r.m_value = m_value
        return r
    }

    fn ptr(&self) -> ^mut T {
        let h = unsafe { m_header or return null }
        if unsafe { rc_count_load(&h.strong) } == 0 {
            return null
        }
        return unsafe { m_value }
    }
}
