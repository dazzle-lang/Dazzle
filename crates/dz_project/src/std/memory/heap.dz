/// `Allocators::Global`. Nothing of its own: the C heap is already a good general-purpose
/// allocator, and the platform's tools understand it (§18.46).
pub struct Heap {
}

/// The strictest alignment the C heap guarantees on every platform Dazzle builds for.
/// Anything stricter is over-allocated, with the heap's own pointer kept just before the
/// one handed out — which `free` can find because it is told the alignment (§14).
const HEAP_ALIGN: usize = 8

impl Allocator for Heap {
    fn alloc(&mut self, size: usize, align: usize, loc: SourceLocation) -> ^mut u8 {
        let p: ^mut u8 = if align <= HEAP_ALIGN {
            c_malloc(size, loc)
        } else {
            unsafe {
                let raw = c_malloc(size + align + HEAP_ALIGN, loc)
                let first = (raw as usize) + HEAP_ALIGN
                let at = (first + align - 1) / align * align
                ((at - HEAP_ALIGN) as ^mut ^mut u8)[0] = raw
                at as ^mut u8
            }
        }
        #if TRACK_MEMORY {
            unsafe { TRACKER.record(p, size, align, loc) }
        }
        return p
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 in self {
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
            self.free(p, old_size, align, loc)
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        if p == null {
            return
        }
        #if TRACK_MEMORY {
            unsafe { TRACKER.release(p, size, align, loc) }
        } #else {
            let _ = size + loc.line as usize
        }
        if align <= HEAP_ALIGN {
            c_free(p)
        } else {
            c_free(unsafe { ((p as usize - HEAP_ALIGN) as ^mut ^mut u8)[0] })
        }
    }
}
