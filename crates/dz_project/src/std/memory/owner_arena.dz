/// Bytes at the start of every chunk an owner arena takes: the next chunk, and this one's
/// capacity.
const OWNER_HEADER: usize = 16

/// The first chunk an owner arena takes. Each one after is at least twice the last, so an
/// arena grows as its container does: a few hundred bytes for a list of three labels, a
/// few hundred KiB for a frame's draw list.
const OWNER_CHUNK: usize = 4096

/// Allocations at least this big get a block of their own from the C heap, at their exact
/// size, given back as soon as they are freed, as in a region (`SCOPE_LARGE`). The arena
/// keeps its chunks from one fill to the next, and a chunk the size of one large block
/// would be kept too.
const OWNER_LARGE: usize = 16384

/// An owner arena: the memory the compiler places the contents of a container in when
/// that container is emptied only all at once (spec §14.6, T-0120). It belongs to the
/// container's owner, out of sight, and is reset each time the container is cleared, so a
/// frame's draw list refilled every frame takes no memory once its arena has grown to a
/// frame's worth.
///
/// It lives in memory taken from its owner's allocator, which its chunks come from too:
/// where the owner lives. It never moves, so the values in it may keep its address while
/// their owner is moved. A reset keeps every chunk for the next fill: the owner's allocator
/// may be a region, which takes nothing back until it ends.
///
/// Not for ordinary code: a value built in it by hand must be dead before the next reset,
/// and nothing checks that it is.
pub struct OwnerArena {
    /// Where this arena and its chunks come from.
    m_parent: ^mut Allocator = null
    /// The first chunk, where a reset starts again; each links to the next.
    m_first: ^mut u8 = null
    m_chunk: ^mut u8 = null
    m_used: usize = 0
    m_cap: usize = 0

    /// A new arena, in memory from `parent` (the heap when it is `null`): where the owner
    /// of the container it is for lives.
    pub fn make(parent: ^mut Allocator) -> ^mut OwnerArena {
        let mut from: ^mut Allocator = parent
        if from == null {
            from = Allocators::Global
        }
        let a = unsafe { from or panic!("an owner arena needs an allocator") }
        let p = unsafe { a.alloc(sizeof(OwnerArena), alignof(OwnerArena)) as ^mut OwnerArena }
        unsafe { construct(p[0], OwnerArena{ m_parent: from }) }
        return unsafe { p }
    }

    /// Give back the arena `make` gave: its chunks, then its own memory. It owns nothing
    /// else, so nothing is left to drop.
    pub fn unmake(p: ^mut OwnerArena) {
        let from = unsafe { p[0].m_parent }
        unsafe { p[0].release() }
        let a = unsafe { from or return }
        a.free(unsafe { p as ^mut u8 }, sizeof(OwnerArena), alignof(OwnerArena))
    }

    /// Give every chunk back to the owner's allocator.
    fn release(&mut self) {
        let a = unsafe { m_parent or return }
        let mut chunk = m_first
        while chunk != null {
            unsafe {
                let next = (chunk as ^mut ^mut u8)[0]
                let cap = (chunk as ^mut usize)[1]
                #if TRACK_MEMORY {
                    let used = if chunk == m_chunk { m_used } else { cap }
                    poison(chunk, OWNER_HEADER, used)
                }
                a.free(chunk, cap, 16)
                chunk = next
            }
        }
        m_first = null
        m_chunk = null
    }

    /// Empty the arena for its container's next fill. Everything in it is dead: the
    /// container was just cleared, and nothing it held could be taken out. Every chunk is
    /// kept, so the next fill allocates nothing until it outgrows the last.
    pub fn reset(&mut self) {
        #if TRACK_MEMORY {
            // What the arena held is dead: a value that outlived the reset reads `0xDD`.
            let mut chunk = m_first
            while chunk != null {
                unsafe {
                    let used = if chunk == m_chunk { m_used } else { (chunk as ^mut usize)[1] }
                    poison(chunk, OWNER_HEADER, used)
                    chunk = (chunk as ^mut ^mut u8)[0]
                }
            }
        }
        if m_first != null {
            self.enter(m_first)
        }
    }

    /// Start filling `chunk`.
    fn enter(&mut self, chunk: ^mut u8) {
        m_chunk = chunk
        m_cap = unsafe { (chunk as ^mut usize)[1] }
        m_used = OWNER_HEADER
    }

    /// Move to a chunk with room for `size` bytes at `align`: the next one kept from an
    /// earlier fill when it is big enough, or a new one from the owner's allocator, linked
    /// in after this one.
    fn next_chunk(&mut self, size: usize, align: usize) {
        let wanted = OWNER_HEADER + align + size
        if m_chunk != null {
            let next = unsafe { (m_chunk as ^mut ^mut u8)[0] }
            if next != null && unsafe { (next as ^mut usize)[1] } >= wanted {
                self.enter(next)
                return
            }
        }
        let mut cap = if m_cap * 2 > OWNER_CHUNK { m_cap * 2 } else { OWNER_CHUNK }
        if wanted > cap {
            cap = wanted
        }
        let a = unsafe { m_parent or panic!("an owner arena with no allocator") }
        let chunk = a.alloc(cap, 16)
        unsafe {
            (chunk as ^mut usize)[1] = cap
            if m_chunk == null {
                (chunk as ^mut ^mut u8)[0] = null
                m_first = chunk
            } else {
                (chunk as ^mut ^mut u8)[0] = (m_chunk as ^mut ^mut u8)[0]
                (m_chunk as ^mut ^mut u8)[0] = chunk
            }
        }
        self.enter(chunk)
    }

    /// The first offset at or past `m_used` whose address is a multiple of `align`.
    fn aligned(&self, align: usize) -> usize {
        let base = m_chunk as usize
        let at = base + m_used
        return (at + align - 1) / align * align - base
    }

    /// Whether an allocation of `size` at `align` is a block of its own. `malloc` aligns to
    /// 16, so anything stricter stays in a chunk.
    fn is_large(size: usize, align: usize) -> bool {
        return size >= OWNER_LARGE && align <= OWNER_HEADER
    }

    fn alloc_slow(&mut self, size: usize, align: usize) -> ^mut u8 {
        if OwnerArena::is_large(size, align) {
            // A block of its own, which the caller frees by its size.
            return unsafe { c_malloc(size) }
        }
        let mut start = if m_chunk == null { m_cap } else { self.aligned(align) }
        if m_chunk == null || start + size > m_cap {
            self.next_chunk(size, align)
            start = self.aligned(align)
        }
        m_used = start + size
        let p: ^mut u8 = unsafe { &mut m_chunk[start] }
        return unsafe { p }
    }
}

impl Allocator for OwnerArena {
    /// A small block that fits in the current chunk is a pointer bump, as in a region, and
    /// only that is here so the C++ compiler can inline it; everything else is `alloc_slow`.
    fn alloc(&mut self, size: usize, align: usize, _loc: SourceLocation) -> ^mut u8 {
        if size < OWNER_LARGE && m_chunk != null {
            let start = self.aligned(align)
            if start + size <= m_cap {
                m_used = start + size
                let p: ^mut u8 = unsafe { &mut m_chunk[start] }
                return unsafe { p }
            }
        }
        return self.alloc_slow(size, align)
    }

    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation,
    ) -> ^mut u8 in (self, p) {
        if self.resize_in_place(p, old_size, new_size, align) {
            return p
        }
        let q = self.alloc(new_size, align, loc)
        if p != null {
            let kept = if old_size < new_size { old_size } else { new_size }
            unsafe { memcpy(q, p, kept) }
            self.free(p, old_size, align, loc)
        }
        return q
    }

    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
        if p == null {
            return
        }
        if OwnerArena::is_large(size, align) {
            #if TRACK_MEMORY {
                poison(p, 0, size)
            }
            c_free(p)
            return
        }
        #if TRACK_MEMORY {
            // A small block stays in its chunk until the next reset, holding its old
            // contents; a wrong placement reads it (T-0131).
            poison(p, 0, size)
        }
        if m_chunk != null && (p as usize) >= (m_chunk as usize) {
            // The last small allocation goes back: a label built and then not kept costs
            // the arena nothing.
            let offset = (p as usize) - (m_chunk as usize)
            if offset < m_cap && offset + size == m_used {
                m_used = offset
            }
        }
        let _ = loc.line
    }

    /// The last small allocation grows or shrinks where it is when the chunk has room, as
    /// in a region (`ScopeArena::resize_in_place`).
    fn resize_in_place(&mut self, p: ^mut u8, old_size: usize, new_size: usize, align: usize) -> bool {
        if p == null || m_chunk == null || (p as usize) < (m_chunk as usize) {
            return false
        }
        if OwnerArena::is_large(old_size, align) || OwnerArena::is_large(new_size, align) {
            return false
        }
        let offset = (p as usize) - (m_chunk as usize)
        if offset + old_size != m_used || offset + new_size > m_cap {
            return false
        }
        #if TRACK_MEMORY {
            if new_size < old_size {
                poison(p, new_size, old_size)
            }
        }
        m_used = offset + new_size
        return true
    }

    /// A copy of a container in an owner arena is made on the heap: nothing says the copy
    /// dies at the next reset.
    fn scoped(&self) -> bool {
        return true
    }
}
