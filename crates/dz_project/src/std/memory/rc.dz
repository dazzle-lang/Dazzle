/// Shared ownership of one value, counted (spec §14.5).
///
/// Copying an `Rc` shares the value and counts one more owner; dropping one counts one
/// fewer, and the last drops the value. An `Rc` may be `null`, referring to nothing — its
/// default, and what a moved-from one is left as. Reach the value with `or` or `if let`,
/// which keep it alive while it is used:
///
/// ```dz
/// if let &mut t = sprite.texture { t.width = 64 }
/// let t = sprite.texture or return
/// ```
///
/// An `Rc<Button>` is accepted where an `Rc<UiElement>` is wanted, when `Button` inherits
/// `UiElement`: both share one count, and the last drops the whole `Button` (18.64).
///
/// Single-threaded: the counts are plain integers.
pub struct Rc<T> {
    pub(module) m_header: ^mut RcHeader = null
    pub(module) m_value: ^mut T = null

    /// A new value, in one allocation with its counts, from `allocator`.
    Rc(value: T, allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) {
        let a = allocator or panic!("an Rc needs an allocator")
        let size = RcBlock<T>::size
        let align = RcBlock<T>::align
        let block = unsafe { a.alloc(size, align, loc) as ^mut RcBlock<T> }
        let header = RcHeader{
            strong: 1,
            weak: 0,
            allocator: allocator,
            size: size,
            align: align,
            drop_value: drop_value_as<T>,
        }
        unsafe {
            construct(block[0], RcBlock<T>{ header: header, value: move(value) })
            m_header = &mut block[0].header
            m_value = &mut block[0].value
        }
    }

    /// How many `Rc`s share the value; 0 for a null one.
    pub fn count(&self) -> usize {
        let h = m_header or return 0
        return h.strong
    }

    /// How many `Weak`s refer to the value; 0 for a null `Rc`.
    pub fn weak_count(&self) -> usize {
        let h = m_header or return 0
        return h.weak
    }
}

impl<T> Drop for Rc<T> {
    fn drop(&mut self) {
        let h = m_header or return
        h.strong -= 1
        if h.strong > 0 {
            return
        }
        // The value goes with its last owner, as the type it was made as. A `Weak` may still
        // hold the allocation to read `strong`, so that is freed only when no `Weak` does.
        let drop_value = h.drop_value
        drop_value(unsafe { m_value as ^mut u8 })
        if h.weak == 0 {
            let a = h.allocator or return
            a.free(unsafe { m_header as ^mut u8 }, h.size, h.align)
        }
    }
}

impl<T> Copy for Rc<T> {
    fn copy(&mut self, other: &Self) {
        m_header = other.m_header
        m_value = other.m_value
        let h = m_header or return
        h.strong += 1
    }
}

impl<T> Nullable for Rc<T> {
    type Target = T
    type Guard = Rc<T>

    fn is_null(&self) -> bool {
        return m_header == null
    }

    /// Another owner, so the value outlives whatever happens to this one.
    fn guard(&self) -> Rc<T> {
        return self
    }

    fn ptr(&self) -> ^mut T {
        return m_value
    }
}
