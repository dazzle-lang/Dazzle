/// Shared ownership of one value, counted (spec §14.5).
///
/// Copying an `Rc` shares the value and counts one more owner; dropping one counts one
/// fewer, and the last drops the value. An `Rc` may be `null`, referring to nothing — its
/// default, and what a moved-from one is left as. Reach the value with `or` or `if let`,
/// which keep it alive while it is used:
///
/// ```dz
/// if let &mut t = sprite.texture { t.width = 64 }
/// let t = sprite.texture or return
/// ```
///
/// An `Rc<Button>` is accepted where an `Rc<UiElement>` is wanted, when `Button` inherits
/// `UiElement`: both share one count, and the last drops the whole `Button` (18.64).
///
/// The counts are atomic in a program that runs anything at the same time, and plain
/// integers in one that does not (spec §22.4).
pub struct Rc<T> {
    pub(module) m_header: ^mut RcHeader = null
    pub(module) m_value: ^mut T = null

    /// A new value, in one allocation with its counts, on the heap: a `Weak` can outlive
    /// any scope the `Rc` is made in (spec §14.6).
    pub Rc(value: T, loc: SourceLocation = #location) {
        let size = RcBlock<T>::size
        let align = RcBlock<T>::align
        let block = unsafe { Allocators::Global.alloc(size, align, loc) as ^mut RcBlock<T> }
        // A debug build names a leaked `Rc` on a cycle as one (spec §14.5, D-0122).
        #if TRACK_MEMORY {
            unsafe {
                track_rc_block(block as ^mut u8)
            }
        }
        let header = RcHeader{
            strong: 1,
            weak: 1,
            allocator: Allocators::Global,
            size: size,
            align: align,
            drop_value: drop_value_as<T>,
        }
        unsafe {
            construct(block[0], RcBlock<T>{ header: header, value: value })
            m_header = &mut block[0].header
            m_value = &mut block[0].value
        }
    }

    /// How many `Rc`s share the value; 0 for a null one.
    pub fn count(&self) -> usize {
        let h = unsafe { m_header or return 0 }
        return unsafe { rc_count_load(&h.strong) }
    }

    /// How many `Weak`s refer to the value; 0 for a null `Rc`.
    pub fn weak_count(&self) -> usize {
        let h = unsafe { m_header or return 0 }
        // Less the share every `Rc` holds together, which this one keeps.
        return unsafe { rc_count_load(&h.weak) } - 1
    }
}

impl<T> Drop for Rc<T> {
    fn drop(&mut self) {
        let h = unsafe { m_header or return }
        if !unsafe { rc_count_release(&mut h.strong) } {
            return
        }
        // The value goes with its last owner, as the type it was made as. Given the block,
        // not `m_value`: an `Rc<Plain>` of a `Fancy` that adds the first `virtual` points 8
        // bytes into the `Fancy`, past its vtable (D-0104).
        let drop_value = h.drop_value
        drop_value(unsafe { m_header as ^mut u8 })
        // Then the `Rc`s' share of `weak`: a `Weak` may still hold the allocation to read
        // `strong`, so it is freed by whichever of this and the last `Weak` goes second.
        if unsafe { rc_count_release(&mut h.weak) } {
            let a = unsafe { h.allocator or return }
            a.free(unsafe { m_header as ^mut u8 }, h.size, h.align)
        }
    }
}

impl<T> Clone for Rc<T> {
    fn clone(&mut self, other: &Self) {
        m_header = other.m_header
        m_value = other.m_value
        let h = unsafe { m_header or return }
        unsafe {
            rc_count_add(&mut h.strong)
        }
    }
}

impl<T> Nullable for Rc<T> {
    type Target = T
    type Guard = Rc<T>

    fn is_null(&self) -> bool {
        return m_header == null
    }

    /// Another owner, so the value outlives whatever happens to this one.
    fn guard(&self) -> Rc<T> {
        return self.clone()
    }

    fn ptr(&self) -> ^mut T {
        return unsafe { m_value }
    }
}
