/// The chunks regions have finished with, kept for the next region on this thread (spec
/// §14.6, T-0117), each linked to the next through its first word with its capacity in the
/// second, the same header a `ScopeArena` gives it. Its memory is the C heap's, untracked
/// like `TempArena`'s.
///
/// Large blocks are not kept: a region's large block is the heap's, at its exact size, and
/// goes back to the heap the moment it is freed. Keeping them by power-of-two size class
/// (T-0104) made `astar` a few percent faster, but only by holding about as much again as a
/// growing container's final array — every class it grew through — and by rounding each
/// block up to its class: a third more peak memory than the heap, which T-0117's gate
/// refuses. A pool held to a byte budget kept the memory and lost the speed.
struct ScopePool {
    m_free: ^mut u8 = null

    /// A chunk of at least `cap` bytes: the first free one big enough, or a new one.
    pub(module) fn take(&mut self, cap: usize) -> ^mut u8 {
        let mut prev: ^mut u8 = null
        let mut chunk = m_free
        while chunk != null {
            unsafe {
                let next = (chunk as ^mut ^mut u8)[0]
                if (chunk as ^mut usize)[1] >= cap {
                    if prev == null {
                        m_free = next
                    } else {
                        (prev as ^mut ^mut u8)[0] = next
                    }
                    return chunk
                }
                prev = chunk
                chunk = next
            }
        }
        let fresh = c_malloc(cap)
        unsafe {
            (fresh as ^mut usize)[1] = cap
        }
        return unsafe { fresh }
    }

    /// Keep `chunk` for a later region.
    pub(module) fn give(&mut self, chunk: ^mut u8) {
        unsafe {
            (chunk as ^mut ^mut u8)[0] = m_free
        }
        m_free = chunk
    }
}

impl Drop for ScopePool {
    fn drop(&mut self) {
        let mut chunk = m_free
        while chunk != null {
            unsafe {
                let next = (chunk as ^mut ^mut u8)[0]
                c_free(chunk)
                chunk = next
            }
        }
    }
}

#[thread_local]
static SCOPE_POOL: ScopePool = ScopePool{}
