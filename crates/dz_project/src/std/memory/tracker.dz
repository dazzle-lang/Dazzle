// Memory tracking (spec §14.2): compiled only with `TRACK_MEMORY`.

#if TRACK_MEMORY {
    /// Every allocation `Allocators::Global` has made, by address: open addressing with
    /// linear probing, in memory of its own from the C heap so tracking never tracks itself.
    /// It reports leaks when the program ends, which is when this static is dropped.
    struct Tracker {
        m_slots: ^mut Allocation = null
        m_cap: usize = 0
        m_used: usize = 0
        m_seq: u64 = 0

        pub fn record(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
            if (m_used + 1) * 2 > m_cap {
                self.rehash()
            }
            let i = self.slot(p as usize)
            unsafe {
                if m_slots[i].addr == 0 {
                    m_used += 1
                }
                m_slots[i].addr = p as usize
                m_slots[i].size = size
                m_slots[i].align = align
                m_slots[i].live = true
                m_slots[i].file = loc.file
                m_slots[i].line = loc.line
                m_seq += 1
                m_slots[i].seq = m_seq
            }
        }

        pub fn release(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation) {
            if m_cap == 0 {
                panic!("free of a pointer Allocators::Global never allocated, at {}:{}", loc.file, loc.line)
            }
            let i = self.slot(p as usize)
            unsafe {
                if m_slots[i].addr == 0 {
                    panic!(
                        "free of a pointer Allocators::Global never allocated, at {}:{}",
                        loc.file,
                        loc.line,
                    )
                }
                if !m_slots[i].live {
                    panic!(
                        "double free at {}:{}; allocated at {}:{} and already freed at {}:{}",
                        loc.file,
                        loc.line,
                        m_slots[i].file,
                        m_slots[i].line,
                        m_slots[i].freed_file,
                        m_slots[i].freed_line,
                    )
                }
                if m_slots[i].size != size || m_slots[i].align != align {
                    panic!(
                        "free of {} bytes (align {}) at {}:{}, but {}:{} allocated {} bytes (align {})",
                        size,
                        align,
                        loc.file,
                        loc.line,
                        m_slots[i].file,
                        m_slots[i].line,
                        m_slots[i].size,
                        m_slots[i].align,
                    )
                }
                m_slots[i].live = false
                m_slots[i].freed_file = loc.file
                m_slots[i].freed_line = loc.line
            }
        }

        /// The live block starting at `addr`, by its slot.
        pub(module) fn live_at(&self, addr: usize) -> usize? {
            if m_cap == 0 || addr == 0 {
                return none
            }
            let i = self.slot(addr)
            unsafe {
                if m_slots[i].addr == addr && m_slots[i].live {
                    return i
                }
            }
            return none
        }

        /// Every live block reachable from the `size` bytes at `root`, read as words that may
        /// be pointers to a block's start, and from each block found, in `out`.
        pub(module) fn reach(&self, root: usize, size: usize, out: &mut HeldList) {
            self.scan(root, size, out)
            let mut k: usize = 0
            while k < out.len {
                let at = unsafe { out.items[k].addr }
                let i = self.live_at(at) or unreachable
                let n = unsafe { m_slots[i].size }
                self.scan(at, n, out)
                k += 1
            }
        }

        fn scan(&self, start: usize, size: usize, out: &mut HeldList) {
            let word = sizeof(usize)
            let mut off: usize = 0
            while off + word <= size {
                let w = unsafe { ((start + off) as ^usize)^ }
                if let i = self.live_at(w) {
                    if !out.has(w) {
                        out.push(Held{ addr: w, seq: unsafe { m_slots[i].seq } })
                    }
                }
                off += word
            }
        }

        /// Which allocation the live block at `addr` is, if one starts there.
        pub(module) fn seq_at(&self, addr: usize) -> u64? {
            let i = self.live_at(addr) or return none
            return unsafe { m_slots[i].seq }
        }

        /// The slot holding `addr`, or the empty one where it would go.
        fn slot(&self, addr: usize) -> usize {
            let mut i = (addr / 16) % m_cap
            unsafe {
                while m_slots[i].addr != 0 && m_slots[i].addr != addr {
                    i = (i + 1) % m_cap
                }
            }
            return i
        }

        /// Double the table. Live allocations move; freed ones are forgotten, which only
        /// costs a double free of something freed long ago being reported as foreign.
        fn rehash(&mut self) {
            let old = m_slots
            let old_cap = m_cap
            m_cap = if old_cap == 0 { 1024 } else { old_cap * 2 }
            m_used = 0
            unsafe {
                m_slots = c_malloc(m_cap * sizeof(Allocation)) as ^mut Allocation
                let mut i: usize = 0
                while i < m_cap {
                    construct(m_slots[i], Allocation{})
                    i += 1
                }
                let mut j: usize = 0
                while j < old_cap {
                    if old[j].live {
                        let k = self.slot(old[j].addr)
                        m_slots[k] = old[j]
                        m_used += 1
                    }
                    j += 1
                }
                if old != null {
                    c_free(old as ^mut u8)
                }
            }
        }
    }

    impl Drop for Tracker {
        fn drop(&mut self) {
            let mut leaks: usize = 0
            let mut bytes: usize = 0
            let mut i: usize = 0
            while i < m_cap {
                unsafe {
                    if m_slots[i].live {
                        leaks += 1
                        bytes += m_slots[i].size
                        eprintln!(
                            "leak: {} bytes allocated at {}:{}",
                            m_slots[i].size,
                            m_slots[i].file,
                            m_slots[i].line,
                        )
                    }
                }
                i += 1
            }
            if leaks > 0 {
                eprintln!("{} allocations leaked, {} bytes", leaks, bytes)
            }
            if m_slots != null {
                unsafe { c_free(m_slots as ^mut u8) }
            }
        }
    }

    static TRACKER: Tracker = Tracker{}

    /// One block a debug build's element check remembers: where it starts, and which
    /// allocation it is, so one freed and handed out again at the same address is not the
    /// same block (spec §6.7, T-0116).
    struct Held {
        pub addr: usize = 0
        pub seq: u64 = 0
    }

    /// A growing array of `Held`, in C heap memory so the check never tracks itself.
    struct HeldList {
        pub items: ^mut Held = null
        pub len: usize = 0
        pub cap: usize = 0

        pub fn push(&mut self, h: Held) {
            unsafe {
                if len == cap {
                    let grown = if cap == 0 { 64 } else { cap * 2 }
                    let fresh = c_malloc(grown * sizeof(Held)) as ^mut Held
                    let mut i: usize = 0
                    while i < len {
                        fresh[i] = items[i]
                        i += 1
                    }
                    if items != null {
                        c_free(items as ^mut u8)
                    }
                    items = fresh
                    cap = grown
                }
                items[len] = h
            }
            len += 1
        }

        pub fn has(&self, addr: usize) -> bool {
            let mut i: usize = 0
            while i < len {
                if unsafe { items[i].addr } == addr {
                    return true
                }
                i += 1
            }
            return false
        }
    }

    impl Drop for HeldList {
        fn drop(&mut self) {
            if items != null {
                unsafe { c_free(items as ^mut u8) }
            }
        }
    }

    /// The blocks a container's elements own when a function begins, for
    /// `trusted_elements_kept` to check when it ends: every tracked block reachable from the
    /// `size` bytes at `root`, other than the `skip` ones, the container's own arrays, which
    /// its pointer ties stand for. Made by a debug build with `check_trusted` (spec §6.7,
    /// T-0116). The handle is the list, in C heap memory.
    pub fn trusted_elements(root: usize, size: usize, skip: ^usize, nskip: usize) -> usize {
        let mut all = HeldList{}
        unsafe { TRACKER.reach(root, size, &mut all) }
        let kept = unsafe { c_malloc(sizeof(HeldList)) as ^mut HeldList }
        unsafe {
            construct(kept^, HeldList{})
            let mut i: usize = 0
            while i < all.len {
                let h = all.items[i]
                let mut skipped = false
                let mut j: usize = 0
                while j < nskip {
                    if skip[j] == h.addr {
                        skipped = true
                    }
                    j += 1
                }
                if !skipped {
                    kept.push(h)
                }
                i += 1
            }
        }
        return kept as usize
    }

    /// Whether every block `trusted_elements` remembered is still the live allocation it was:
    /// none freed, none freed and handed out again. Frees the handle.
    pub fn trusted_elements_kept(handle: usize) -> bool {
        let held = unsafe { handle as ^mut HeldList }
        let mut ok = true
        unsafe {
            let mut i: usize = 0
            while i < held.len {
                let h = held.items[i]
                let same = if let s = TRACKER.seq_at(h.addr) {
                    s == h.seq
                } else {
                    false
                }
                ok = ok && same
                i += 1
            }
            destroy(held^)
            c_free(held as ^mut u8)
        }
        return ok
    }
}
