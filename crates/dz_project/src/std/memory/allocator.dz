/// Allocation is a library concern expressed through a trait, and which allocator a value's
/// memory comes from is the compiler's choice: a container reads it as `#placement` (§14,
/// §14.6). `&mut self`, because an arena changes on every allocation (§18.47). `loc` is the
/// caller's line, so memory tracking names the code that allocated rather than the
/// allocator (§12.7).
pub trait Allocator {
    fn alloc(&mut self, size: usize, align: usize, loc: SourceLocation = #location) -> ^mut u8
    fn realloc(
        &mut self,
        p: ^mut u8,
        old_size: usize,
        new_size: usize,
        align: usize,
        loc: SourceLocation = #location,
    ) -> ^mut u8 in (self, p)
    fn free(&mut self, p: ^mut u8, size: usize, align: usize, loc: SourceLocation = #location)

    /// Whether what this allocator hands out is released when a scope ends, rather than
    /// when it is freed: a region (spec §14.6). A copy of a container in such memory is made
    /// on the heap, since nothing says the copy dies with the scope.
    fn scoped(&self) -> bool {
        return false
    }

    /// Resize the allocation at `p` from `old_size` to `new_size` bytes without moving it,
    /// when this allocator can: an arena's last allocation can, by moving its bump. On
    /// `false` nothing has changed. Unlike `realloc`, it never copies, so it is how a
    /// container grows when its elements cannot be moved as bytes.
    fn resize_in_place(&mut self, p: ^mut u8, old_size: usize, new_size: usize, align: usize) -> bool {
        return false
    }
}
