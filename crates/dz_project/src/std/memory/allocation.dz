// Memory tracking (spec §14.2): compiled only with `TRACK_MEMORY`.

#if TRACK_MEMORY {
    /// One allocation the heap handed out, and — once freed — where it was freed, so a
    /// second free can say where the first one was.
    struct Allocation {
        pub addr: usize = 0
        pub size: usize = 0
        pub align: usize = 0
        pub live: bool = false
        pub file: const &cstr = ""
        pub line: u32 = 0
        pub freed_file: const &cstr = ""
        pub freed_line: u32 = 0
        /// Which allocation this is, counting from one: a block freed and handed out again
        /// at the same address is a different one (spec §6.7, T-0116).
        pub seq: u64 = 0
    }
}
