/// Steps through a map's values in slot order, handing out `&V`: `for v in map.values()`.
pub view struct HashMapValues<K: Hash + Eq, V> {
    m_map:  &HashMap<K, V>
    m_slot: usize = 0

    /// What the map holds, so a value outlives the iterator it came from (spec 6.7).
    tie @items = m_map

    HashMapValues(map: &HashMap<K, V>) {
        m_map = map
        m_slot = first_entry_from(map, 0)
    }
}

impl<K: Hash + Eq, V> Iterate for HashMapValues<K, V> {
    type Item = &V

    fn valid(&self) -> bool {
        return m_slot < m_map.slot_count()
    }

    fn get(&self) -> &V in self@items {
        return m_map.value_at(m_slot) or unreachable
    }

    fn advance(&mut self) {
        m_slot = first_entry_from(m_map, m_slot + 1)
    }
}
