/// Steps through a slot map's values, handing out `(Key<T>, &mut T)`: `for k, &mut v in
/// map` changes them in place.
pub view struct SlotMapIterMut<T> {
    m_map:   &mut SlotMap<T>
    m_index: usize = 0

    /// What the map holds, so a value outlives the iterator it came from (spec 6.7).
    tie @items = m_map

    SlotMapIterMut(map: &mut SlotMap<T>) {
        m_map = map
    }
}

impl<T> Iterate for SlotMapIterMut<T> {
    type Item = (Key<T>, &mut T)

    fn valid(&self) -> bool {
        return m_index < m_map.len()
    }

    fn get(&self) -> (Key<T>, &mut T) in self@items {
        return (m_map.key_at(m_index), &mut m_map.values_mut()[m_index])
    }

    fn advance(&mut self) {
        m_index += 1
    }
}
