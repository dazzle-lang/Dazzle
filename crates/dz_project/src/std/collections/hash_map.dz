/// A map from keys to values, in memory from the allocator it was built with.
///
/// Open addressing with linear probing: one array each of hashes, keys and values, a slot
/// empty when its hash is zero. It grows to twice the slots when three quarters are full,
/// and `remove` shifts the entries after a removed one back rather than leaving a marker,
/// so lookups never slow down with use. Move-only unless both `K` and `V` are copyable.
///
/// A lookup returns a pointer, `null` when the key is absent (§9.1), so it is handled with
/// `or`: `let hp = health.get(&id) or return`.
pub struct HashMap<K: Hash + Eq, V> {
    m_hashes: own ^mut u64 = null
    m_keys: own ^mut K = null
    m_values: own ^mut V = null
    m_len: usize = 0
    m_slots: usize = 0
    m_allocator: ^mut Allocator = Allocators::Global

    /// An empty map, with room for `capacity` entries already allocated when it is given.
    HashMap(
        capacity: usize = 0,
        allocator: ^mut Allocator = Allocators::Global,
        loc: SourceLocation = #location,
    ) {
        m_allocator = allocator
        if capacity > 0 {
            self.grow_to(capacity, loc)
        }
    }

    pub fn len(&self) -> usize {
        return m_len
    }

    pub fn is_empty(&self) -> bool {
        return m_len == 0
    }

    /// How many entries fit before the map grows again.
    pub fn capacity(&self) -> usize {
        return m_slots / 4 * 3
    }

    /// Add `key` with `value`. When the key was already there its value is replaced, and
    /// the old one dropped; `replace` hands it back instead.
    pub fn insert(&mut self, key: K, value: V, loc: SourceLocation = #location) {
        let _ = self.replace(move(key), move(value), loc)
    }

    /// Add `key` with `value`, returning the value it replaces, or `none` when the key is
    /// new.
    pub fn replace(&mut self, key: K, value: V, loc: SourceLocation = #location) -> V? {
        let h = key_hash(&key)
        if let slot = self.find(&key, h) {
            let old = unsafe { move_out(m_values[slot]) }
            unsafe { construct(m_values[slot], move(value)) }
            return move(old)
        }
        if (m_len + 1) * 4 > m_slots * 3 {
            self.grow_to(m_len + 1, loc)
        }
        self.place(move(key), move(value), h)
        m_len += 1
        return none
    }

    /// The value for `key`, or `null` when there is none.
    pub fn get(&self, key: &K) -> ^V {
        let slot = self.find(key, key_hash(key)) or return null
        return unsafe { &m_values[slot] }
    }

    /// The value for `key`, to change in place, or `null` when there is none.
    pub fn get_mut(&mut self, key: &K) -> ^mut V {
        let slot = self.find(key, key_hash(key)) or return null
        return unsafe { &mut m_values[slot] }
    }

    pub fn contains(&self, key: &K) -> bool {
        return self.find(key, key_hash(key)) != none
    }

    /// Take the entry for `key` out, returning its value, or `none` when there is none.
    pub fn remove(&mut self, key: &K) -> V? {
        let found = self.find(key, key_hash(key)) or return none
        let value = unsafe { move_out(m_values[found]) }
        unsafe {
            destroy(m_keys[found])
            m_hashes[found] = 0
        }
        // Backward shift: an entry further along the run moves into the hole when the hole
        // lies between the slot it hashes to and where it sits, so no probe that passed the
        // removed entry can stop short at the gap.
        let mask = m_slots - 1
        let mut hole = found
        let mut i = (found + 1) & mask
        while unsafe { m_hashes[i] } != 0 {
            let home = (unsafe { m_hashes[i] } & (mask as u64)) as usize
            if ((i + m_slots - home) & mask) >= ((i + m_slots - hole) & mask) {
                unsafe {
                    m_hashes[hole] = m_hashes[i]
                    m_hashes[i] = 0
                    construct(m_keys[hole], move_out(m_keys[i]))
                    construct(m_values[hole], move_out(m_values[i]))
                }
                hole = i
            }
            i = (i + 1) & mask
        }
        m_len -= 1
        return move(value)
    }

    /// Drop every entry and keep the allocation.
    pub fn clear(&mut self) {
        for i in 0..m_slots {
            if unsafe { m_hashes[i] } != 0 {
                unsafe {
                    destroy(m_keys[i])
                    destroy(m_values[i])
                    m_hashes[i] = 0
                }
            }
        }
        m_len = 0
    }

    /// Room for at least `additional` more entries without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) {
        if (m_len + additional) * 4 > m_slots * 3 {
            self.grow_to(m_len + additional, loc)
        }
    }

    /// How many slots there are, for visiting every entry: slots `0..slot_count()`, each
    /// holding an entry or not. `for` over a map itself is owed by M12, with the iterator
    /// a `List` needs too.
    pub fn slot_count(&self) -> usize {
        return m_slots
    }

    /// The key in `slot`, or `null` when the slot is empty.
    pub fn key_at(&self, slot: usize) -> ^K {
        if self.checked_slot(slot) == 0 {
            return null
        }
        return unsafe { &m_keys[slot] }
    }

    /// The value in `slot`, or `null` when the slot is empty.
    pub fn value_at(&self, slot: usize) -> ^V {
        if self.checked_slot(slot) == 0 {
            return null
        }
        return unsafe { &m_values[slot] }
    }

    /// The value in `slot`, to change in place, or `null` when the slot is empty.
    pub fn value_at_mut(&mut self, slot: usize) -> ^mut V {
        if self.checked_slot(slot) == 0 {
            return null
        }
        return unsafe { &mut m_values[slot] }
    }

    /// The hash stored in `slot`, after checking the slot exists.
    fn checked_slot(&self, slot: usize) -> u64 {
        if slot >= m_slots {
            #panic("slot {} is out of bounds for a HashMap of {} slots", slot, m_slots)
        }
        return unsafe { m_hashes[slot] }
    }

    /// The slot holding `key`, whose hash is `h`.
    fn find(&self, key: &K, h: u64) -> usize? {
        if m_len == 0 {
            return none
        }
        let mask = m_slots - 1
        let mut i = (h & (mask as u64)) as usize
        // A quarter of the slots are always empty, so the run ends.
        while true {
            let stored = unsafe { m_hashes[i] }
            if stored == 0 {
                return none
            }
            if stored == h && unsafe { m_keys[i].eq(key) } {
                return i
            }
            i = (i + 1) & mask
        }
        return none
    }

    /// Put an entry known not to be present into the first free slot of its run.
    fn place(&mut self, key: K, value: V, h: u64) {
        let mask = m_slots - 1
        let mut i = (h & (mask as u64)) as usize
        while unsafe { m_hashes[i] } != 0 {
            i = (i + 1) & mask
        }
        unsafe {
            m_hashes[i] = h
            construct(m_keys[i], move(key))
            construct(m_values[i], move(value))
        }
    }

    /// Enough slots for `wanted` entries at three quarters full — a power of two, so a hash
    /// picks its slot with a mask — with every entry moved over.
    fn grow_to(&mut self, wanted: usize, loc: SourceLocation) {
        let mut slots: usize = if m_slots == 0 { 8 } else { m_slots * 2 }
        while wanted * 4 > slots * 3 {
            slots *= 2
        }
        let a = m_allocator or #panic("a HashMap with no allocator cannot grow")
        let old_hashes = unsafe { m_hashes as ^mut u64 }
        let old_keys = unsafe { m_keys as ^mut K }
        let old_values = unsafe { m_values as ^mut V }
        let old_slots = m_slots
        m_hashes = unsafe { a.alloc(slots * sizeof(u64), alignof(u64), loc) as ^mut u64 }
        m_keys = unsafe { a.alloc(slots * sizeof(K), alignof(K), loc) as ^mut K }
        m_values = unsafe { a.alloc(slots * sizeof(V), alignof(V), loc) as ^mut V }
        m_slots = slots
        for i in 0..slots {
            unsafe { m_hashes[i] = 0 }
        }
        if old_hashes == null {
            return
        }
        for i in 0..old_slots {
            let h = unsafe { old_hashes[i] }
            if h != 0 {
                unsafe { self.place(move_out(old_keys[i]), move_out(old_values[i]), h) }
            }
        }
        a.free(unsafe { old_hashes as ^mut u8 }, old_slots * sizeof(u64), alignof(u64), loc)
        a.free(unsafe { old_keys as ^mut u8 }, old_slots * sizeof(K), alignof(K), loc)
        a.free(unsafe { old_values as ^mut u8 }, old_slots * sizeof(V), alignof(V), loc)
    }
}

/// The first slot from `slot` on that holds an entry, or the slot count when none does.
fn first_entry_from<K: Hash + Eq, V>(map: &HashMap<K, V>, slot: usize) -> usize {
    let mut i = slot
    while i < map.slot_count() && map.key_at(i) == null {
        i += 1
    }
    return i
}

impl<K: Hash + Eq, V> Iterable for HashMap<K, V> {
    type Iter = HashMapIter<K, V>

    fn iter(&self) -> HashMapIter<K, V> {
        return HashMapIter<K, V>(&self)
    }
}

impl<K: Hash + Eq, V> IterableMut for HashMap<K, V> {
    type IterMut = HashMapIterMut<K, V>

    fn iter_mut(&mut self) -> HashMapIterMut<K, V> {
        return HashMapIterMut<K, V>(&mut self)
    }
}

/// A key's hash, never zero: zero marks an empty slot.
fn key_hash<K: Hash>(key: &K) -> u64 {
    let h = key.hash()
    if h == 0 {
        return 1
    }
    return h
}

impl<K, V> Drop for HashMap<K, V> {
    fn drop(&mut self) {
        if m_hashes == null {
            return
        }
        self.clear()
        let a = m_allocator or return
        a.free(unsafe { m_hashes as ^mut u8 }, m_slots * sizeof(u64), alignof(u64))
        a.free(unsafe { m_keys as ^mut u8 }, m_slots * sizeof(K), alignof(K))
        a.free(unsafe { m_values as ^mut u8 }, m_slots * sizeof(V), alignof(V))
    }
}

impl<K: Hash + Eq + Copy, V: Copy> Copy for HashMap<K, V> {
    fn copy(&mut self, other: &Self) {
        m_allocator = other.m_allocator
        if other.m_len == 0 {
            return
        }
        let a = m_allocator or #panic("a HashMap with no allocator cannot be copied")
        m_slots = other.m_slots
        m_hashes = unsafe { a.alloc(m_slots * sizeof(u64), alignof(u64)) as ^mut u64 }
        m_keys = unsafe { a.alloc(m_slots * sizeof(K), alignof(K)) as ^mut K }
        m_values = unsafe { a.alloc(m_slots * sizeof(V), alignof(V)) as ^mut V }
        for i in 0..m_slots {
            let h = unsafe { other.m_hashes[i] }
            unsafe { m_hashes[i] = h }
            if h != 0 {
                unsafe {
                    construct(m_keys[i], other.m_keys[i])
                    construct(m_values[i], other.m_values[i])
                }
            }
        }
        m_len = other.m_len
    }
}
