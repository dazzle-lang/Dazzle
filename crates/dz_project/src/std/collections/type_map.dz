#if TYPE_INFO {
    /// Owns at most one value of each type, found again by that type (spec §22.8).
    /// Available when the build has a type table (§13), since a type's key is its `TypeId`.
    pub struct TypeMap {
        m_entries: List<Box<TypeMapEntry>> = List<Box<TypeMapEntry>>()
        m_slots:   HashMap<TypeId, usize> = HashMap<TypeId, usize>()

        tie @items = m_entries@items, m_slots@items, m_slots[*]
        tie @values = m_entries[*]@value

        pub TypeMap() {}

        /// How many types have a value.
        pub fn len(&self) -> usize {
            return m_entries.len()
        }

        /// The value of type `T`, or `null` when it has none.
        #[inline]
        pub fn get<T>(&self) -> ^T in self@values {
            let id = typeid_of<T>()
            let slot: usize = m_slots.get(&id) or return null
            let entry = m_entries[slot] or unreachable
            // Every entry is a `TypeMapValue` boxed by `insert`, under its own type's id, and
            // the private base cannot be derived from outside this module. The check costs
            // one virtual call and keeps a corrupted slot from becoming a bad cast.
            if entry.type_id() != id {
                return null
            }
            let p: ^TypeMapEntry = entry
            return unsafe {
                &(p as ^TypeMapValue<T>)[0].value
            }
        }

        /// The value of type `T`, to change in place, or `null` when it has none.
        #[inline]
        pub fn get_mut<T>(&mut self) -> ^mut T in self@values {
            let id = typeid_of<T>()
            let slot: usize = m_slots.get(&id) or return null
            let entry = m_entries[slot] or unreachable
            if entry.type_id() != id {
                return null
            }
            let p: ^mut TypeMapEntry = entry
            return unsafe {
                &mut (p as ^mut TypeMapValue<T>)[0].value
            }
        }

        /// Store `value` as the map's `T`, dropping the one it had. A value stays where it is
        /// when others are added, but any reference into the map ends here.
        pub fn insert<T>(
            &mut self,
            value: T,
            loc: SourceLocation = #location
        ) kills self@items, self@values sends value to self {
            if let &mut existing = self.get_mut<T>() {
                existing = value
                return
            }
            m_slots.insert(typeid_of<T>(), m_entries.len(), loc)
            m_entries.push(Box<TypeMapValue<T>>(TypeMapValue<T>{ value: value }, loc), loc)
        }
    }

    /// What every entry is boxed as, so the map can hold values of different types in one
    /// list and check which one an entry holds before casting to it.
    struct TypeMapEntry {
        pub virtual fn type_id(&self) -> TypeId
    }

    struct TypeMapValue<T> : TypeMapEntry {
        pub(module) value: T

        pub override fn type_id(&self) -> TypeId {
            return typeid_of<T>()
        }
    }
}
