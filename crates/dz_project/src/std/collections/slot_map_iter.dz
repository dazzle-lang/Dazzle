/// Steps through a slot map's values, handing out `(Key<T>, &T)`: `for k, &v in map`.
pub view struct SlotMapIter<T> {
    m_map:   &SlotMap<T>
    m_index: usize = 0

    /// What the map holds, so a value outlives the iterator it came from (spec 6.7).
    tie @items = m_map

    SlotMapIter(map: &SlotMap<T>) {
        m_map = map
    }
}

impl<T> Iterate for SlotMapIter<T> {
    type Item = (Key<T>, &T)

    fn valid(&self) -> bool {
        return m_index < m_map.len()
    }

    fn get(&self) -> (Key<T>, &T) in self@items {
        return (m_map.key_at(m_index), &m_map.values()[m_index])
    }

    fn advance(&mut self) {
        m_index += 1
    }
}
