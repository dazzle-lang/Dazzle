/// Steps through a slice, handing out a reference to each element.
pub view struct SliceIter<T> {
    m_slice: &[]T
    m_index: usize = 0

    /// What the slice views, so an element outlives the iterator it came from (spec §6.7).
    tie @items = m_slice

    pub SliceIter(slice: &[]T) {
        m_slice = slice
    }
}

impl<T> Iterate for SliceIter<T> {
    type Item = &T

    #[inline]
    fn valid(&self) -> bool {
        return m_index < m_slice.len
    }

    #[inline]
    fn get(&mut self) -> &T in self@items {
        return &m_slice[m_index]
    }

    #[inline]
    fn advance(&mut self) {
        m_index += 1
    }
}

/// `parallel for &e in list`: each part reads a range of the slice (spec §22.3).
impl<T> ParallelIterate for SliceIter<T> {
    fn passes(&self) -> usize {
        return m_slice.len - m_index
    }

    fn part(&self, start: usize, end: usize) -> SliceIter<T> {
        return SliceIter<T>(m_slice[m_index + start..m_index + end])
    }
}
