/// Steps through a slice, handing out a reference to each element.
pub view struct SliceIter<T> {
    m_slice: []T
    m_index: usize = 0

    /// What the slice views, so an element outlives the iterator it came from (spec §6.7).
    tie @items = m_slice

    SliceIter(slice: []T) {
        m_slice = slice
    }
}

impl<T> Iterate for SliceIter<T> {
    type Item = &T

    fn valid(&self) -> bool {
        return m_index < m_slice.len
    }

    fn get(&self) -> &T in self@items {
        return &m_slice[m_index]
    }

    fn advance(&mut self) {
        m_index += 1
    }
}
