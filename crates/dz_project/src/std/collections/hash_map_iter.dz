/// Steps through a map's entries in slot order, handing out `(&K, &V)`: `for k, &v in map`.
pub view struct HashMapIter<K: Hash + Eq, V> {
    m_map: ^HashMap<K, V> = null
    m_slot: usize = 0

    HashMapIter(map: &HashMap<K, V>) {
        m_map = map
        m_slot = first_entry_from(map, 0)
    }
}

impl<K: Hash + Eq, V> Iterate for HashMapIter<K, V> {
    type Item = (&K, &V)

    fn valid(&self) -> bool {
        let map = m_map or return false
        return m_slot < map.slot_count()
    }

    fn get(&self) -> (&K, &V) {
        let map = m_map or unreachable
        return (map.key_at(m_slot) or unreachable, map.value_at(m_slot) or unreachable)
    }

    fn advance(&mut self) {
        let map = m_map or return
        m_slot = first_entry_from(map, m_slot + 1)
    }
}
