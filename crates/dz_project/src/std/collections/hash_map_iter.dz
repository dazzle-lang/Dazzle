/// Steps through a map's entries in slot order, handing out `(&K, &V)`: `for k, &v in map`.
pub view struct HashMapIter<K: Hash + Eq, V> {
    m_map:  &HashMap<K, V>
    m_slot: usize = 0

    /// What the map holds, so an entry outlives the iterator it came from (spec 6.7).
    tie @items = m_map

    HashMapIter(map: &HashMap<K, V>) {
        m_map = map
        m_slot = first_entry_from(map, 0)
    }
}

impl<K: Hash + Eq, V> Iterate for HashMapIter<K, V> {
    type Item = (&K, &V)

    fn valid(&self) -> bool {
        return m_slot < m_map.slot_count()
    }

    fn get(&self) -> (&K, &V) in self@items {
        return (m_map.key_at(m_slot) or unreachable, m_map.value_at(m_slot) or unreachable)
    }

    fn advance(&mut self) {
        m_slot = first_entry_from(m_map, m_slot + 1)
    }
}
