/// A growable array of `T`, in memory from the allocator it was built with.
///
/// Move-only unless `T` is copyable, in which case copying it copies every element into a
/// new allocation from the same allocator. `b[i]` reads and writes an element, checked
/// against the length; `as_slice()` views them all.
pub struct List<T> {
    m_data: own ^mut T = null
    m_len: usize = 0
    m_cap: usize = 0
    m_allocator: ^mut Allocator = Allocators::Global

    /// The array of elements: it moves when the list grows.
    tie @items = m_data
    tie [*] = m_data[*]

    /// An empty list, with room for `capacity` elements already allocated when it is
    /// given.
    List(
        capacity: usize = 0,
        allocator: ^mut Allocator = #allocator,
        loc: SourceLocation = #location,
    ) {
        m_allocator = allocator
        if capacity > 0 {
            self.grow_to(capacity, loc)
        }
    }

    pub fn len(&self) -> usize {
        return m_len
    }

    /// Where a value stored in this list may get its memory: the list's own region when
    /// the compiler built it as one that never gives an element back, `fallback` otherwise
    /// (T-0105 prototype).
    pub fn contents_allocator(&self, fallback: ^mut Allocator) -> ^mut Allocator {
        let a = m_allocator or return fallback
        let c = a.contents() or return fallback
        return c
    }

    pub fn capacity(&self) -> usize {
        return m_cap
    }

    pub fn is_empty(&self) -> bool {
        return m_len == 0
    }

    /// Every element, in order. Valid until the list next grows or is dropped.
    pub fn as_slice(&self) -> []T in self@items {
        return unsafe { m_data[0..m_len] }
    }

    pub fn as_mut_slice(&mut self) -> []mut T in self@items {
        return unsafe { m_data[0..m_len] }
    }

    /// The first element, or `null` when the list is empty: `let top = stack.first() or
    /// return`.
    pub fn first(&self) -> ^T in self@items {
        if m_len == 0 {
            return null
        }
        return unsafe { &m_data[0] }
    }

    pub fn first_mut(&mut self) -> ^mut T in self@items {
        if m_len == 0 {
            return null
        }
        return unsafe { &mut m_data[0] }
    }

    /// The last element, or `null` when the list is empty.
    pub fn last(&self) -> ^T in self@items {
        if m_len == 0 {
            return null
        }
        return unsafe { &m_data[m_len - 1] }
    }

    pub fn last_mut(&mut self) -> ^mut T in self@items {
        if m_len == 0 {
            return null
        }
        return unsafe { &mut m_data[m_len - 1] }
    }

    /// Add `v` at the end, growing when there is no room.
    pub fn push(&mut self, v: T, loc: SourceLocation = #location) kills self@items {
        if m_len == m_cap {
            self.grow_to(m_len + 1, loc)
        }
        unsafe { construct(m_data[m_len], move(v)) }
        m_len += 1
    }

    /// Take the last element out, or `none` when there is none.
    pub fn pop(&mut self) -> T? kills self@items, self[*] {
        if m_len == 0 {
            return none
        }
        m_len -= 1
        return unsafe { move_out(m_data[m_len]) }
    }

    /// Put `v` at index `i`, moving the elements from `i` on up by one. `i` may be `len()`.
    pub fn insert(&mut self, i: usize, v: T, loc: SourceLocation = #location) kills self@items {
        if i > m_len {
            panic!("List::insert at {} past the length {}", i, m_len)
        }
        if m_len == m_cap {
            self.grow_to(m_len + 1, loc)
        }
        self.shift_up(i, 1)
        unsafe { construct(m_data[i], move(v)) }
        m_len += 1
    }

    /// Take the element at `i` out, moving the ones after it down by one.
    pub fn remove(&mut self, i: usize) -> T kills self@items, self[*] {
        if i >= m_len {
            panic!("List::remove at {} for a length of {}", i, m_len)
        }
        let v = unsafe { move_out(m_data[i]) }
        self.shift_down(i + 1, 1)
        m_len -= 1
        return move(v)
    }

    /// Drop the elements `from..to`, moving the ones after them down. Panics when the range
    /// is backwards or runs past the length.
    pub fn remove_range(&mut self, from: usize, to: usize) kills self@items, self[*] {
        if from > to || to > m_len {
            panic!("List::remove_range of {}..{} for a length of {}", from, to, m_len)
        }
        if from == to {
            return
        }
        for i in from..to {
            unsafe { destroy(m_data[i]) }
        }
        self.shift_down(to, to - from)
        m_len -= to - from
    }

    /// Keep only the elements `keep` says yes to, in their order, and drop the rest:
    /// `particles.retain(is_alive)`. Each element is asked once.
    pub fn retain(&mut self, keep: fn(&T) -> bool) kills self@items, self[*] {
        let mut kept: usize = 0
        for i in 0..m_len {
            if keep(unsafe { &m_data[i] }) {
                if kept != i {
                    unsafe { construct(m_data[kept], move_out(m_data[i])) }
                }
                kept += 1
            } else {
                unsafe { destroy(m_data[i]) }
            }
        }
        m_len = kept
    }

    /// Move every element of `other` onto the end, in order, leaving `other` empty with its
    /// allocation kept.
    pub fn append(&mut self, other: &mut List<T>, loc: SourceLocation = #location) kills self@items, other@items {
        let n = other.m_len
        if n == 0 {
            return
        }
        self.reserve(n, loc)
        if T::is_trivially_copyable {
            unsafe { memcpy(&mut m_data[m_len], &other.m_data[0], n * sizeof(T)) }
        } else {
            for i in 0..n {
                unsafe { construct(m_data[m_len + i], move_out(other.m_data[i])) }
            }
        }
        m_len += n
        other.m_len = 0
    }

    /// Put the elements in the opposite order.
    pub fn reverse(&mut self) kills self@items {
        if m_len < 2 {
            return
        }
        let mut i: usize = 0
        let mut j = m_len - 1
        while i < j {
            self.swap(i, j)
            i += 1
            j -= 1
        }
    }

    /// Give the room past the last element back to the allocator; an empty list holds no
    /// memory afterwards.
    pub fn shrink_to_fit(&mut self, loc: SourceLocation = #location) kills self@items {
        if m_cap == m_len {
            return
        }
        self.move_to(m_len, loc)
    }

    /// Open a gap of `n` slots at `at` by moving the elements from `at` on up; the gap is
    /// left raw. There must be room.
    fn shift_up(&mut self, at: usize, n: usize) kills self@items {
        if at >= m_len {
            return
        }
        if T::is_trivially_copyable {
            // Bytes can move anywhere, so the whole tail goes in one overlapping copy.
            unsafe { memmove(&mut m_data[at + n], &m_data[at], (m_len - at) * sizeof(T)) }
            return
        }
        let mut j = m_len
        while j > at {
            j -= 1
            unsafe { construct(m_data[j + n], move_out(m_data[j])) }
        }
    }

    /// Close the `n` raw slots just before `from` by moving the elements from `from` on
    /// down. The length is the caller's to change.
    fn shift_down(&mut self, from: usize, n: usize) kills self@items {
        if from >= m_len {
            return
        }
        if T::is_trivially_copyable {
            unsafe { memmove(&mut m_data[from - n], &m_data[from], (m_len - from) * sizeof(T)) }
            return
        }
        for j in from..m_len {
            unsafe { construct(m_data[j - n], move_out(m_data[j])) }
        }
    }

    /// Take the element at `i` out and put the last one in its place: no shifting, and the
    /// order is not kept.
    pub fn swap_remove(&mut self, i: usize) -> T kills self@items, self[*] {
        if i >= m_len {
            panic!("List::swap_remove at {} for a length of {}", i, m_len)
        }
        let v = unsafe { move_out(m_data[i]) }
        m_len -= 1
        if i != m_len {
            unsafe { construct(m_data[i], move_out(m_data[m_len])) }
        }
        return move(v)
    }

    /// Exchange the elements at `i` and `j`.
    pub fn swap(&mut self, i: usize, j: usize) kills self@items {
        if i >= m_len || j >= m_len {
            panic!("List::swap of {} and {} for a length of {}", i, j, m_len)
        }
        if i == j {
            return
        }
        unsafe {
            let held = move_out(m_data[i])
            construct(m_data[i], move_out(m_data[j]))
            construct(m_data[j], move(held))
        }
    }

    /// Put the elements in order: afterwards no element is `before` one ahead of it.
    /// `before` must be a strict order — `a < b`, not `a <= b`. A heapsort, so no memory is
    /// allocated and no input takes more than `n log n` steps; equal elements may change
    /// places. `xs.sort()` does the same by `<` for elements that are `Ord`.
    pub fn sort_by(&mut self, before: fn(&T, &T) -> bool) kills self@items {
        if m_len < 2 {
            return
        }
        // Build a heap with the greatest element first, then move the greatest to the end
        // one at a time.
        let mut start = m_len / 2
        while start > 0 {
            start -= 1
            self.sift_down(start, m_len, before)
        }
        let mut end = m_len - 1
        while end > 0 {
            self.swap(0, end)
            self.sift_down(0, end, before)
            end -= 1
        }
    }

    /// Restore the heap below `root`, among the first `len` elements.
    fn sift_down(&mut self, root: usize, len: usize, before: fn(&T, &T) -> bool) kills self@items {
        let mut at = root
        while true {
            let left = at * 2 + 1
            if left >= len {
                return
            }
            let mut larger = left
            let right = left + 1
            unsafe {
                if right < len && before(&m_data[left], &m_data[right]) {
                    larger = right
                }
                if !before(&m_data[at], &m_data[larger]) {
                    return
                }
            }
            self.swap(at, larger)
            at = larger
        }
    }

    /// Drop every element and keep the allocation.
    pub fn clear(&mut self) kills self@items, self[*] {
        self.truncate(0)
    }

    /// Drop the elements from `n` on; nothing happens when there are fewer.
    pub fn truncate(&mut self, n: usize) kills self@items, self[*] {
        while m_len > n {
            m_len -= 1
            unsafe { destroy(m_data[m_len]) }
        }
    }

    /// Make the length `n`: new elements start at their defaults, extra ones are dropped.
    pub fn resize(&mut self, n: usize, loc: SourceLocation = #location) kills self@items, self[*] {
        if n > m_cap {
            self.grow_to(n, loc)
        }
        while m_len < n {
            unsafe { construct(m_data[m_len]) }
            m_len += 1
        }
        self.truncate(n)
    }

    /// Room for at least `additional` more elements without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) kills self@items {
        if m_len + additional > m_cap {
            self.grow_to(m_len + additional, loc)
        }
    }

    /// A new allocation of at least `wanted` elements — doubling, so pushing one at a time
    /// costs amortised constant time — with the elements moved into it.
    fn grow_to(&mut self, wanted: usize, loc: SourceLocation) kills self@items {
        let doubled = if m_cap == 0 { 8 } else { m_cap * 2 }
        self.move_to(if wanted > doubled { wanted } else { doubled }, loc)
    }

    /// A new allocation of exactly `cap` elements, at least the length, with the elements
    /// moved into it; none at all when `cap` is zero.
    fn move_to(&mut self, cap: usize, loc: SourceLocation) kills self@items {
        let a = m_allocator or panic!("a List with no allocator cannot grow")
        if cap == 0 {
            if m_data != null {
                a.free(unsafe { m_data as ^mut u8 }, m_cap * sizeof(T), alignof(T), loc)
            }
            m_data = null
        } else if T::is_trivially_copyable {
            // Bytes can move anywhere, so the allocator may resize the memory in place.
            let old = unsafe { m_data as ^mut u8 }
            m_data = unsafe { a.realloc(old, m_cap * sizeof(T), cap * sizeof(T), alignof(T), loc) as ^mut T }
        } else {
            let fresh = unsafe { a.alloc(cap * sizeof(T), alignof(T), loc) as ^mut T }
            for i in 0..m_len {
                unsafe { construct(fresh[i], move_out(m_data[i])) }
            }
            if m_data != null {
                a.free(unsafe { m_data as ^mut u8 }, m_cap * sizeof(T), alignof(T), loc)
            }
            m_data = fresh
        }
        m_cap = cap
    }
}

impl<T> Drop for List<T> {
    fn drop(&mut self) {
        if m_data == null {
            return
        }
        if !T::is_trivially_copyable {
            for i in 0..m_len {
                unsafe { destroy(m_data[i]) }
            }
        }
        let a = m_allocator or return
        a.free(unsafe { m_data as ^mut u8 }, m_cap * sizeof(T), alignof(T))
    }
}

impl<T: Copy> Copy for List<T> {
    fn copy(&mut self, other: &Self) {
        m_allocator = other.m_allocator
        // The copy may outlive the scope a region belongs to, so it goes to the heap.
        if let &from = other.m_allocator {
            if from.scoped() {
                m_allocator = Allocators::Global
            }
        }
        if other.m_len == 0 {
            return
        }
        let a = m_allocator or panic!("a List with no allocator cannot be copied")
        m_data = unsafe { a.alloc(other.m_len * sizeof(T), alignof(T)) as ^mut T }
        m_cap = other.m_len
        for i in 0..other.m_len {
            unsafe { construct(m_data[i], other.m_data[i]) }
        }
        m_len = other.m_len
    }
}

/// The same length and equal elements in the same order.
impl<T: Eq> Eq for List<T> {
    fn eq(&self, rhs: &List<T>) -> bool {
        if m_len != rhs.m_len {
            return false
        }
        for i in 0..m_len {
            if unsafe { m_data[i] != rhs.m_data[i] } {
                return false
            }
        }
        return true
    }
}

/// The elements' hashes combined in order, so a list of grid cells can key a `HashMap`.
impl<T: Hash> Hash for List<T> {
    fn hash(&self) -> u64 {
        let mut h = m_len.hash()
        for i in 0..m_len {
            h = hash_combine(h, unsafe { m_data[i].hash() })
        }
        return h
    }
}

impl<T> Index<usize> for List<T> {
    type Output = T

    fn index(&self, i: usize) -> &T in self@items {
        if i >= m_len {
            panic!("index {} is out of bounds for a List of length {}", i, m_len)
        }
        return unsafe { &m_data[i] }
    }
}

/// `for &e in list`, in order.
impl<T> Iterable for List<T> {
    type Iter = SliceIter<T>

    fn iter(&self) -> SliceIter<T> {
        return SliceIter<T>(self.as_slice())
    }
}

/// `for &mut e in list`, in order.
impl<T> IterableMut for List<T> {
    type IterMut = SliceIterMut<T>

    fn iter_mut(&mut self) -> SliceIterMut<T> {
        return SliceIterMut<T>(self.as_mut_slice())
    }
}

impl<T> IndexMut<usize> for List<T> {
    type Output = T

    fn index_mut(&mut self, i: usize) -> &mut T in self@items {
        if i >= m_len {
            panic!("index {} is out of bounds for a List of length {}", i, m_len)
        }
        return unsafe { &mut m_data[i] }
    }
}
