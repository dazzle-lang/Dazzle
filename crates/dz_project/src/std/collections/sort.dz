/// Putting a container's elements in order by `<`: `scores.sort()` on a `List` of anything
/// `Ord` (spec §14.4). For another order, `List::sort_by` takes the comparison.
pub trait Sort {
    fn sort(&mut self)
}

impl<T: Ord> Sort for List<T> {
    fn sort(&mut self) {
        self.sort_by(ord_before<T>)
    }
}

/// `a < b`, as a function a sort can take.
fn ord_before<T: Ord>(a: &T, b: &T) -> bool {
    return a.cmp(b) == Ordering::Less
}

/// Byte by byte, then the shorter first: the order of `String` and `Path`, which for UTF-8
/// is also the order of the characters' code points.
fn compare_bytes(a: []u8, b: []u8) -> Ordering {
    let n = if a.len < b.len { a.len } else { b.len }
    let mut i: usize = 0
    while i < n {
        if a[i] != b[i] {
            return if a[i] < b[i] { Ordering::Less } else { Ordering::Greater }
        }
        i += 1
    }
    if a.len == b.len {
        return Ordering::Equal
    }
    return if a.len < b.len { Ordering::Less } else { Ordering::Greater }
}
