/// Steps through a writable slice, handing out a writable reference to each element.
pub view struct SliceIterMut<T> {
    m_slice: &mut []T
    m_index: usize = 0

    /// What the slice views, so an element outlives the iterator it came from (spec §6.7).
    tie @items = m_slice

    pub SliceIterMut(slice: &mut []T) {
        m_slice = slice
    }
}

impl<T> Iterate for SliceIterMut<T> {
    type Item = &mut T

    #[inline]
    fn valid(&self) -> bool {
        return m_index < m_slice.len
    }

    #[inline]
    fn get(&mut self) -> &mut T in self@items {
        return &mut m_slice[m_index]
    }

    #[inline]
    fn advance(&mut self) {
        m_index += 1
    }
}

/// `parallel for &mut e in list`: each part writes a range of the slice no other part has
/// (spec §22.3). Built from `&self`, since the parts are made at once, one per thread; two
/// ranges that do not overlap are two places, which is why this is `unsafe`.
impl<T> ParallelIterate for SliceIterMut<T> {
    fn passes(&self) -> usize {
        return m_slice.len - m_index
    }

    fn part(&self, start: usize, end: usize) -> SliceIterMut<T> {
        let p = unsafe { m_slice.ptr as ^mut T }
        return SliceIterMut<T>(unsafe { p[m_index + start..m_index + end] })
    }
}
