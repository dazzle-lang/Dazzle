/// Steps through a map's keys in slot order, handing out `&K`: `for k in map.keys()`. A
/// `HashSet` is looped over with one.
pub view struct HashMapKeys<K: Hash + Eq, V> {
    m_map:  &HashMap<K, V>
    m_slot: usize = 0

    /// What the map holds, so a key outlives the iterator it came from (spec 6.7).
    tie @items = m_map

    HashMapKeys(map: &HashMap<K, V>) {
        m_map = map
        m_slot = first_entry_from(map, 0)
    }
}

impl<K: Hash + Eq, V> Iterate for HashMapKeys<K, V> {
    type Item = &K

    fn valid(&self) -> bool {
        return m_slot < m_map.slot_count()
    }

    fn get(&self) -> &K in self@items {
        return m_map.key_at(m_slot) or unreachable
    }

    fn advance(&mut self) {
        m_slot = first_entry_from(m_map, m_slot + 1)
    }
}
