/// Owned, growable UTF-8 text (spec §14.6). Text of up to 15 bytes is kept inside the
/// `String` itself, as `std::string` keeps it; longer text is in memory from wherever the
/// compiler places the string.
///
/// Its bytes are always followed by a zero, so `as_cstr()` hands a C function the text
/// without a copy. Copying a `String` copies the text.
pub struct String {
    /// Short text and its zero, in place; or, for longer text, where it is (`[0]`) and how
    /// many bytes there are room for there, the zero's included (`[1]`).
    m_store: [2]usize = [0, 0]
    /// The length in bytes, with its top bit set when the text is on the heap.
    m_len: usize = 0
    m_allocator: ^mut Allocator = Allocators::Global

    /// The text. A short one is inside the string, so moving the string ends a view of it,
    /// as growing it does, and so does moving the list it is in (spec §6.7, T-0156).
    tie @text = m_store

    /// A copy of `s`.
    String(s: &str = "", loc: SourceLocation = #location) {
        m_allocator = unsafe { #placement }
        self.push_str(s, loc)
    }

    /// A copy of `s`: `String::from("name")`.
    pub fn from(s: &str, loc: SourceLocation = #location) -> String {
        return String(s, loc)
    }

    /// A copy of `bytes` when they are valid UTF-8, and `none` when they are not.
    pub fn from_utf8(bytes: &[]u8, loc: SourceLocation = #location) -> String? {
        let text = str::from_utf8(bytes) or return none
        return String(text, loc)
    }

    /// The length in bytes, not counting the zero after them. A character outside ASCII
    /// takes two to four; `len()` counts characters (spec §5.3).
    #[inline]
    pub fn byte_len(&self) -> usize {
        return m_len & (STRING_ON_HEAP - 1)
    }

    #[inline]
    pub fn is_empty(&self) -> bool {
        return self.byte_len() == 0
    }

    /// How many bytes it can hold before it next grows, not counting the zero.
    #[inline]
    pub fn capacity(&self) -> usize {
        if m_len >= STRING_ON_HEAP {
            return m_store[1] - 1
        }
        return STRING_INLINE
    }

    /// The text, borrowed. Valid until the `String` next changes, moves or is dropped.
    #[inline]
    pub fn as_str(&self) -> &str in self@text {
        let p = self.start()
        return unsafe { p[0..self.byte_len()] as &str }
    }

    /// The text as a C string, borrowed, for C and C++ functions that want one. Valid until
    /// the `String` next changes, moves or is dropped, which nothing checks: pass a `String`
    /// straight to a `cstr` parameter instead, and it converts for that call alone.
    pub fn as_cstr(&self) -> &cstr in self@text {
        return unsafe { self.start() as &cstr }
    }

    /// Append `s`.
    #[inline]
    pub fn push_str(&mut self, s: &str, loc: SourceLocation = #location) kills self@text {
        if s.byte_len == 0 {
            return
        }
        let len = self.byte_len()
        if len + s.byte_len > self.capacity() {
            self.make_room(len + s.byte_len, loc)
        }
        let p = self.start()
        unsafe { memcpy(&mut p[len], (s as &[]u8).ptr, s.byte_len) }
        self.set_len(len + s.byte_len)
    }

    /// Append one character, encoded as UTF-8.
    #[inline]
    pub fn push(&mut self, c: char, loc: SourceLocation = #location) kills self@text {
        let cp = c as u32
        if cp < 0x80 {
            // ASCII, the common case: one byte where the zero was, and a new zero after it.
            let len = self.byte_len()
            if len == self.capacity() {
                self.make_room(len + 1, loc)
            }
            let p = self.start()
            unsafe { p[len] = cp as u8 }
            self.set_len(len + 1)
            return
        }
        self.push_encoded(c, loc)
    }

    /// `push` of a character past ASCII. Out of line, so `push` stays small enough for the
    /// C++ compiler to inline into a loop that builds text a byte at a time (T-0096).
    fn push_encoded(&mut self, c: char, loc: SourceLocation) kills self@text {
        let mut encoded: [4]u8 = [0, 0, 0, 0]
        let n = encode_utf8(c, &mut encoded)
        let text = unsafe { encoded[0..n] as &str }
        self.push_str(text, loc)
    }

    /// Put `s` in at byte `at`, which must be where a character starts or the end.
    pub fn insert_str(&mut self, at: usize, s: &str, loc: SourceLocation = #location) kills self@text {
        if !self.is_char_boundary(at) {
            panic!("insert at byte {}, inside a character or past the end", at, loc)
        }
        if s.byte_len == 0 {
            return
        }
        let len = self.byte_len()
        if len + s.byte_len > self.capacity() {
            self.make_room(len + s.byte_len, loc)
        }
        let p = self.start()
        unsafe { memmove(&mut p[at + s.byte_len], &p[at], len - at) }
        unsafe { memcpy(&mut p[at], (s as &[]u8).ptr, s.byte_len) }
        self.set_len(len + s.byte_len)
    }

    /// Put one character in at byte `at`, encoded as UTF-8.
    pub fn insert(&mut self, at: usize, c: char, loc: SourceLocation = #location) kills self@text {
        let mut encoded: [4]u8 = [0, 0, 0, 0]
        let n = encode_utf8(c, &mut encoded)
        self.insert_str(at, unsafe { encoded[0..n] as &str }, loc)
    }

    /// Take out the character starting at byte `at` and hand it back. Panics when `at` is
    /// not where a character starts.
    pub fn remove(&mut self, at: usize, loc: SourceLocation = #location) -> char kills self@text {
        let len = self.byte_len()
        if at >= len || !self.is_char_boundary(at) {
            panic!("remove at byte {}, not the start of a character", at, loc)
        }
        let (c, width) = decode_utf8(self.as_str() as &[]u8, at)
        let p = self.start()
        unsafe { memmove(&mut p[at], &p[at + width], len - at - width) }
        self.set_len(len - width)
        return c
    }

    /// Empty the text and keep the allocation.
    #[inline]
    pub fn clear(&mut self) kills self@text {
        self.set_len(0)
    }

    /// The characters, decoded from UTF-8: `for c in name.chars()`, or `for c in name`.
    pub fn chars(&self) -> Chars {
        return Chars(self.as_str())
    }

    /// Remove the last character and hand it back, or `none` when the text is empty.
    pub fn pop(&mut self) -> char? kills self@text {
        let len = self.byte_len()
        if len == 0 {
            return none
        }
        let bytes = self.as_str() as &[]u8
        let mut start = len - 1
        while start > 0 && !is_utf8_boundary(bytes, start) {
            start -= 1
        }
        let (c, _) = decode_utf8(bytes, start)
        self.truncate(start)
        return c
    }

    /// Whether byte `index` is where a character starts, or the end of the text: the only
    /// places text may be cut.
    pub fn is_char_boundary(&self, index: usize) -> bool {
        return is_utf8_boundary(self.as_str() as &[]u8, index)
    }

    /// Keep the first `len` bytes. Panics when `len` falls inside a character, which would
    /// leave the text invalid; a `len` past the end changes nothing.
    pub fn truncate(&mut self, len: usize, loc: SourceLocation = #location) kills self@text {
        if len >= self.byte_len() {
            return
        }
        if !self.is_char_boundary(len) {
            panic!("truncate at byte {}, inside a character", len, loc)
        }
        self.set_len(len)
    }

    /// Room for at least `additional` more bytes without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) kills self@text {
        let wanted = self.byte_len() + additional
        if wanted > self.capacity() {
            self.make_room(wanted, loc)
        }
    }

    /// Where the text starts: inside the string when it is short, else on the heap.
    #[inline]
    fn start(&self) -> ^mut u8 in self@text {
        if m_len >= STRING_ON_HEAP {
            return unsafe { m_store[0] as ^mut u8 }
        }
        let inside: ^usize = &m_store[0]
        return unsafe { inside as ^mut u8 }
    }

    /// The text is `n` bytes long, with the zero after them, where it already is. Every
    /// edit ends here, having changed the bytes under a view through `start()`, which the
    /// ties check cannot see; `destroy` of a word, which does nothing, tells it (§6.7).
    #[inline]
    fn set_len(&mut self, n: usize) kills self@text {
        unsafe { destroy(m_store[1]) }
        let p = self.start()
        unsafe { p[n] = 0 }
        m_len = if m_len >= STRING_ON_HEAP {
            n | STRING_ON_HEAP
        } else {
            n
        }
    }

    /// Room for `n` bytes of text and the zero after them, on the heap, with the text moved
    /// there: at least twice what there was, so a string built a byte at a time grows a
    /// logarithmic number of times.
    fn make_room(&mut self, n: usize, loc: SourceLocation) kills self@text {
        // The text moves, and on the heap its old memory is freed: see `set_len`.
        unsafe { destroy(m_store[1]) }
        let a = unsafe { m_allocator or panic!("a String with no allocator cannot grow") }
        let len = self.byte_len()
        let doubled = if m_len >= STRING_ON_HEAP {
            m_store[1] * 2
        } else {
            (STRING_INLINE + 1) * 2
        }
        let room = if n + 1 > doubled {
            n + 1
        } else {
            doubled
        }
        if m_len >= STRING_ON_HEAP {
            // Bytes can move anywhere, so the allocator may resize the memory in place.
            let old = unsafe { m_store[0] as ^mut u8 }
            let moved = unsafe { a.realloc(old, m_store[1], room, 1, loc) }
            m_store[0] = unsafe { moved as usize }
        } else {
            let fresh = unsafe { a.alloc(room, 1, loc) }
            unsafe { memcpy(fresh, self.start(), len + 1) }
            m_store[0] = unsafe { fresh as usize }
        }
        m_store[1] = room
        m_len = len | STRING_ON_HEAP
    }
}

/// Text this long or shorter is kept inside the `String`, before its zero: two machine words
/// on a 64-bit target, so a short string allocates nothing (T-0156).
const STRING_INLINE: usize = sizeof(usize) * 2 - 1

/// The top bit of a `String`'s length, set when its text is on the heap. No text is that
/// long.
const STRING_ON_HEAP: usize = (1 as usize) << (sizeof(usize) * 8 - 1)

/// Gives a long text's memory back; a short one is in the string.
impl Drop for String {
    fn drop(&mut self) {
        if m_len < STRING_ON_HEAP {
            return
        }
        let a = unsafe { m_allocator or return }
        a.free(unsafe { m_store[0] as ^mut u8 }, m_store[1], 1)
    }
}

/// A copy of the text, built wherever the compiler places the copy, never where the original
/// is: the copy may outlive the original's region (§14.6).
impl Copy for String {
    fn copy(&mut self, other: &Self) {
        m_allocator = unsafe { #placement }
        self.push_str(other.as_str())
    }
}

impl Eq for String {
    fn eq(&self, rhs: &String) -> bool {
        return self.as_str() == rhs.as_str()
    }
}

/// By bytes, which for UTF-8 is by code point: not a language's alphabetical order.
impl Ord for String {
    fn cmp(&self, rhs: &String) -> Ordering {
        return compare_bytes(self.as_str() as &[]u8, rhs.as_str() as &[]u8)
    }
}

/// `for c in name` steps through the characters (spec §10.4, §14.4).
impl Iterable for String {
    type Iter = Chars
    fn iter(&self) -> Chars {
        return self.chars()
    }
}

/// A `String` passed where a `cstr` is wanted is its text, borrowed for the call:
/// `rl::DrawText(format!("score {}", n), …)` (spec §7.2).
impl ImplicitAs<&cstr> for String {
    fn convert(&self) -> &cstr in self@text {
        return self.as_cstr()
    }
}

/// A `String` passed where a `&str` is wanted is its text, borrowed for the call:
/// `greet(name)` for a `name: String` (spec §7.2, D-0093).
impl ImplicitAs<&str> for String {
    fn convert(&self) -> &str in self@text {
        return self.as_str()
    }
}

/// The same hash as the text as a `&str`.
impl Hash for String {
    fn hash(&self) -> u64 {
        return self.as_str().hash()
    }
}

/// `{}` writes the text.
impl Format for String {
    fn format(&self, f: &mut Formatter) {
        f.write_str(self.as_str())
    }
}

/// `c` as UTF-8 into `out`, returning how many bytes it took.
fn encode_utf8(c: char, out: &mut [4]u8) -> usize {
    let cp = c as u32
    if cp < 0x80 {
        out[0] = cp as u8
        return 1
    }
    if cp < 0x800 {
        out[0] = (0xC0 | (cp >> 6)) as u8
        out[1] = (0x80 | (cp & 0x3F)) as u8
        return 2
    }
    if cp < 0x10000 {
        out[0] = (0xE0 | (cp >> 12)) as u8
        out[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8
        out[2] = (0x80 | (cp & 0x3F)) as u8
        return 3
    }
    out[0] = (0xF0 | (cp >> 18)) as u8
    out[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8
    out[2] = (0x80 | ((cp >> 6) & 0x3F)) as u8
    out[3] = (0x80 | (cp & 0x3F)) as u8
    return 4
}
