/// Owned, growable UTF-8 text, in memory from the allocator it was built with.
///
/// Its bytes are always followed by a zero, so `as_cstr()` hands a C function the text
/// without a copy. Copying a `String` copies the text.
pub struct String {
    m_bytes: List<u8>

    /// A copy of `s`.
    String(s: str = "", allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) {
        m_bytes = List<u8>(0, allocator, loc)
        self.push_str(s, loc)
    }

    /// A copy of `s`: `String::from("name")`.
    pub fn from(s: str, allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) -> String {
        return String(s, allocator, loc)
    }

    /// `fmt` with each `{}` replaced by the next argument, as a new `String` (spec §12.9):
    /// `String::format("Score {}", score)`, or in memory from another allocator,
    /// `String::format("{} hp", hp, allocator = Allocators::Temp)`. The format string is
    /// checked against the arguments when the call is compiled, and anything that
    /// implements `Format` can be an argument.
    pub fn format(fmt: str, args: ..&Format, allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) -> String {
        let mut out = String("", allocator, loc)
        out.reserve(fmt.len, loc)
        let mut f = Formatter(&mut out, loc)
        f.write_format(fmt, args)
        return out
    }

    /// A copy of `bytes` when they are valid UTF-8, and `none` when they are not.
    pub fn from_utf8(bytes: []u8, allocator: ^mut Allocator = Allocators::Global, loc: SourceLocation = #location) -> String? {
        let text = str::from_utf8(bytes) or return none
        return String(text, allocator, loc)
    }

    /// The length in bytes, not counting the zero after them. A character outside ASCII
    /// takes two to four; `char_count` counts characters.
    pub fn len(&self) -> usize {
        if m_bytes.len() == 0 {
            return 0
        }
        return m_bytes.len() - 1
    }

    pub fn is_empty(&self) -> bool {
        return self.len() == 0
    }

    pub fn capacity(&self) -> usize {
        return m_bytes.capacity()
    }

    /// The text, borrowed. Valid until the `String` next changes or is dropped.
    pub fn as_str(&self) -> str {
        let bytes = m_bytes.as_slice()
        return unsafe { bytes[0..self.len()] as str }
    }

    /// The text as a C string, borrowed, for C and C++ functions that want one.
    pub fn as_cstr(&self) -> cstr {
        if m_bytes.len() == 0 {
            return ""
        }
        return unsafe { m_bytes.as_slice().ptr as cstr }
    }

    /// Append `s`.
    pub fn push_str(&mut self, s: str, loc: SourceLocation = #location) {
        if s.len == 0 {
            return
        }
        let _ = m_bytes.pop()
        m_bytes.reserve(s.len + 1, loc)
        let bytes = s as []u8
        for b in bytes {
            m_bytes.push(b, loc)
        }
        m_bytes.push(0, loc)
    }

    /// Append one character, encoded as UTF-8.
    pub fn push(&mut self, c: char, loc: SourceLocation = #location) {
        let mut encoded: [4]u8 = [0, 0, 0, 0]
        let n = encode_utf8(c, &mut encoded)
        let text = unsafe { encoded[0..n] as str }
        self.push_str(text, loc)
    }

    /// Empty the text and keep the allocation.
    pub fn clear(&mut self) {
        m_bytes.clear()
    }

    /// The characters, decoded from UTF-8: `for c in name.chars()`, or `for c in name`.
    pub fn chars(&self) -> Chars {
        return Chars(self.as_str())
    }

    /// How many characters the text holds. It walks the text, so it takes time in
    /// proportion to its length.
    pub fn char_count(&self) -> usize {
        let bytes = self.as_str() as []u8
        let mut n: usize = 0
        for b in bytes {
            if ((b as u32) & 0xC0) != 0x80 {
                n += 1
            }
        }
        return n
    }

    /// Remove the last character and hand it back, or `none` when the text is empty.
    pub fn pop(&mut self) -> char? {
        let len = self.len()
        if len == 0 {
            return none
        }
        let bytes = self.as_str() as []u8
        let mut start = len - 1
        while start > 0 && !is_utf8_boundary(bytes, start) {
            start -= 1
        }
        let (c, _) = decode_utf8(bytes, start)
        self.truncate(start)
        return c
    }

    /// Whether byte `index` is where a character starts, or the end of the text: the only
    /// places text may be cut.
    pub fn is_char_boundary(&self, index: usize) -> bool {
        return is_utf8_boundary(self.as_str() as []u8, index)
    }

    /// Bytes `from..to` of the text, borrowed, or `none` when either end falls inside a
    /// character or past the end — so the piece is always text.
    pub fn slice(&self, from: usize, to: usize) -> str? {
        let bytes = self.as_str() as []u8
        if from > to || to > bytes.len || !is_utf8_boundary(bytes, from) || !is_utf8_boundary(bytes, to) {
            return none
        }
        return unsafe { bytes[from..to] as str }
    }

    /// Keep the first `len` bytes. Panics when `len` falls inside a character, which would
    /// leave the text invalid; a `len` past the end changes nothing.
    pub fn truncate(&mut self, len: usize, loc: SourceLocation = #location) {
        if len >= self.len() {
            return
        }
        if !self.is_char_boundary(len) {
            panic("truncate at byte {}, inside a character", len, loc)
        }
        m_bytes.truncate(len)
        m_bytes.push(0, loc)
    }

    /// Room for at least `additional` more bytes without growing again.
    pub fn reserve(&mut self, additional: usize, loc: SourceLocation = #location) {
        m_bytes.reserve(additional + 1, loc)
    }
}

impl Eq for String {
    fn eq(&self, rhs: &String) -> bool {
        return self.as_str() == rhs.as_str()
    }
}

/// By bytes, which for UTF-8 is by code point: not a language's alphabetical order.
impl Ord for String {
    fn cmp(&self, rhs: &String) -> Ordering {
        return compare_bytes(self.as_str() as []u8, rhs.as_str() as []u8)
    }
}

/// `for c in name` steps through the characters (spec §10.4, §14.4).
impl Iterable for String {
    type Iter = Chars
    fn iter(&self) -> Chars {
        return self.chars()
    }
}

/// The same hash as the text as a `str`.
impl Hash for String {
    fn hash(&self) -> u64 {
        return self.as_str().hash()
    }
}

/// `{}` writes the text.
impl Format for String {
    fn format(&self, f: &mut Formatter) {
        f.write_str(self.as_str())
    }
}

/// `c` as UTF-8 into `out`, returning how many bytes it took.
fn encode_utf8(c: char, out: &mut [4]u8) -> usize {
    let cp = c as u32
    if cp < 0x80 {
        out[0] = cp as u8
        return 1
    }
    if cp < 0x800 {
        out[0] = (0xC0 | (cp >> 6)) as u8
        out[1] = (0x80 | (cp & 0x3F)) as u8
        return 2
    }
    if cp < 0x10000 {
        out[0] = (0xE0 | (cp >> 12)) as u8
        out[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8
        out[2] = (0x80 | (cp & 0x3F)) as u8
        return 3
    }
    out[0] = (0xF0 | (cp >> 18)) as u8
    out[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8
    out[2] = (0x80 | ((cp >> 6) & 0x3F)) as u8
    out[3] = (0x80 | (cp & 0x3F)) as u8
    return 4
}
