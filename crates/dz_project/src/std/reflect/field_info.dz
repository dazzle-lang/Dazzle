/// A field of a struct, a tuple, a union variant's payload, or the parts of a `str`, slice
/// or optional (spec §13.1).
pub struct FieldInfo {
    pub name: str
    pub type_id: TypeId
    /// Bytes from the start of the value holding it.
    pub offset: usize
    pub vis: Visibility
    pub owning: bool
    /// The field's tag, without its backticks: `json:"hp" save:"-"`. Empty when it has none.
    pub tag: str

    /// The value `key` has in the tag, when the tag holds `key:"value"` — the convention
    /// Odin and Go use, pairs separated by spaces. `f.tag_value("json")` is `"hp"` above, and
    /// `none` for a key the tag does not mention.
    pub fn tag_value(&self, key: str) -> str? {
        let bytes = tag as []u8
        let want = key as []u8
        let mut i: usize = 0
        while i < bytes.len {
            // A key starts the tag or follows a space.
            let at_start = i == 0 || bytes[i - 1] == 32
            let fits = i + want.len + 1 < bytes.len
            if at_start && fits && bytes[i + want.len] == 58 && bytes[i + want.len + 1] == 34 {
                let mut same = true
                let mut k: usize = 0
                while k < want.len {
                    if bytes[i + k] != want[k] {
                        same = false
                        break
                    }
                    k += 1
                }
                if same {
                    let start = i + want.len + 2
                    let mut end = start
                    while end < bytes.len && bytes[end] != 34 {
                        end += 1
                    }
                    return str::from_utf8(bytes[start..end])
                }
            }
            i += 1
        }
        return none
    }
}
