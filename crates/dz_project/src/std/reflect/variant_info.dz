/// An enum's or a union's variant (spec §13.1).
pub struct VariantInfo {
    pub name: str
    /// An enum variant's value, or the tag a union holds while this variant is active.
    pub value: i64
    /// A union variant's payload, with offsets from the start of the union. A variant that
    /// carries an existing struct has one field, named after that struct.
    pub fields: []FieldInfo
}
