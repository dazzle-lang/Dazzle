modules: 1, files: 0

error[DZ0004]: `not a valid name` is not a valid module name
  ┌─ badmanifest/dazzle.toml:2:11
  │
2 │ name    = "not a valid name"
  │           ^^^^^^^^^^^^^^^^^^ invalid module name
  │
  = help: a name is an identifier, or several joined by `::` — for example "engine" or "engine::render" (spec §3.2)

error[DZ0004]: `module.version` must be a string
  ┌─ badmanifest/dazzle.toml:3:11
  │
3 │ version = 3
  │           ^ this is an integer

error[DZ0004]: `module.sources` must be an array of strings
  ┌─ badmanifest/dazzle.toml:4:11
  │
4 │ sources = "src/**/*.dz"
  │           ^^^^^^^^^^^^^ this is a string

error[DZ0004]: invalid value for `build.output`
  ┌─ badmanifest/dazzle.toml:7:13
  │
7 │ output    = "library"
  │             ^^^^^^^^^ not one of the allowed values
  │
  = help: valid values are "executable", "static-lib", "shared-lib"

error[DZ0004]: invalid value for `build.optimize`
  ┌─ badmanifest/dazzle.toml:8:13
  │
8 │ optimize  = "fastest"
  │             ^^^^^^^^^ not one of the allowed values
  │
  = help: valid values are "debug", "release", "shipping"

