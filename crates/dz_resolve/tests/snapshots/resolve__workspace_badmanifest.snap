error[DZ0004]: `dazzle.toml` is not a C or C++ source
   ┌─ badmanifest/dazzle.toml:24:25
   │
24 │ sources = ["missing.c", "dazzle.toml"]
   │                         ^^^^^^^^^^^^^ not compilable
