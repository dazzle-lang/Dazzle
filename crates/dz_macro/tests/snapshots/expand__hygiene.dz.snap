source: crates/dz_macro/tests/expand.rs
expression: out
---
// Hygiene (spec §12.4): `swap`'s `tmp` is its own and is renamed `tmp·N`; the caller's
// `tmp` and `other` are captured and keep their names. A struct literal's shorthand field
// keeps its field name when the local behind it is renamed.

struct Pair {
    pub left:  i32
    pub right: i32
}

macro swap -> stmt {
    pattern { $a: ident , $b: ident }
    expand {
        let tmp = $a
        $a = $b
        $b = tmp
    }
}

macro pair -> expr {
    pattern { ( $a: expr , $b: expr ) }
    expand {
        {
            let left = $a
            let right = $b
            Pair{ left, right }
        }
    }
}

fn main() {
    let mut tmp = 1
    let mut other = 2
    let tmp·1 = tmp
    tmp = other
    other = tmp·1
    let p = {
        let left·2 = tmp
        let right·2 = other
        Pair{ left: left·2, right: right·2 }
    }
    #println("{} {}", p.left, p.right)
}
