// A lit 3D scene on SDL3 and OpenGL 3.3: a window and a GL context from SDL, compiled from
// its own source by `dz` (see dazzle.toml); OpenGL's functions from glad; and per-pixel
// lighting, soft shadows, fog and a field of grass computed on the GPU by shaders written
// inline in `shaders.dz`.
//
// Drag with the mouse to turn the camera, scroll to move it nearer, Space to pause, Escape
// to quit.

const WIDTH: i32 = 1280

const HEIGHT: i32 = 720

fn gl_attribute(attr: sdl::SDL_GLAttr, value: i32) {
    if !sdl::SDL_GL_SetAttribute(attr, value) {
        eprintln!("SDL_GL_SetAttribute: {}", sdl::SDL_GetError() as str)
    }
}

fn main() {
    if !sdl::SDL_Init(sdl::SDL_INIT_VIDEO) {
        eprintln!("SDL_Init: {}", sdl::SDL_GetError() as str)
        return
    }
    defer sdl::SDL_Quit()

    // A core 3.3 context, as macOS insists, with a depth buffer and 4x multisampling.
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_CONTEXT_MAJOR_VERSION, 3)
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_CONTEXT_MINOR_VERSION, 3)
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_CONTEXT_PROFILE_MASK, sdl::SDL_GL_CONTEXT_PROFILE_CORE)
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_CONTEXT_FLAGS, sdl::SDL_GL_CONTEXT_FORWARD_COMPATIBLE_FLAG)
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_DEPTH_SIZE, 24)
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_MULTISAMPLEBUFFERS, 1)
    gl_attribute(sdl::SDL_GLAttr::SDL_GL_MULTISAMPLESAMPLES, 4)

    let flags: u64 = sdl::SDL_WINDOW_OPENGL | sdl::SDL_WINDOW_RESIZABLE | sdl::SDL_WINDOW_HIGH_PIXEL_DENSITY
    let window = sdl::SDL_CreateWindow("Dazzle + SDL3", WIDTH, HEIGHT, flags)
    if window == null {
        eprintln!("SDL_CreateWindow: {}", sdl::SDL_GetError() as str)
        return
    }
    defer sdl::SDL_DestroyWindow(window)
    let context = sdl::SDL_GL_CreateContext(window)
    if context == null {
        eprintln!("SDL_GL_CreateContext: {}", sdl::SDL_GetError() as str)
        return
    }
    defer sdl::SDL_GL_DestroyContext(context)
    sdl::SDL_GL_SetSwapInterval(1)

    // OpenGL's functions, asked of the driver now that there is a context to ask.
    if gl::gladLoadGL(sdl::SDL_GL_GetProcAddress) == 0 {
        eprintln!("no OpenGL 3.3 driver")
        return
    }
    let mut renderer = Renderer()
    let mut camera: Camera
    let mut t: f32 = 0
    let mut paused = false
    let mut last = Instant::now()

    let mut running = true
    while running {
        let mut ev: sdl::SDL_Event
        while sdl::SDL_PollEvent(&mut ev) {
            if ev.type == sdl::SDL_EVENT_QUIT {
                running = false
            } else if ev.type == sdl::SDL_EVENT_KEY_DOWN {
                if ev.key.key == sdl::SDLK_ESCAPE {
                    running = false
                } else if ev.key.key == sdl::SDLK_SPACE {
                    paused = !paused
                }
            } else if ev.type == sdl::SDL_EVENT_MOUSE_MOTION {
                if ev.motion.state & sdl::SDL_BUTTON_LMASK != 0 {
                    camera.yaw -= ev.motion.xrel * 0.006
                    camera.pitch = (camera.pitch + ev.motion.yrel * 0.006).clamp(0.05, 1.4)
                }
            } else if ev.type == sdl::SDL_EVENT_MOUSE_WHEEL {
                camera.distance = (camera.distance - ev.wheel.y).clamp(6, 40)
            }
        }

        let now = Instant::now()
        let dt = now.since(last).as_secs_f32().min(0.1)
        last = now
        if !paused {
            t += dt
            camera.yaw += dt * 0.12
        }

        let mut width: i32 = 0
        let mut height: i32 = 0
        sdl::SDL_GetWindowSizeInPixels(window, &mut width, &mut height)
        renderer.draw(&build(t, &camera), width, height)
        sdl::SDL_GL_SwapWindow(window)
    }
}
