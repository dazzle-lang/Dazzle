struct Buffer<T> {
    m_data: own ^mut T
    m_len:  usize
    m_cap:  usize

    Buffer(cap: usize) {
        unsafe {
            m_data = alloc(cap * sizeof(T), alignof(T)) as ^mut T
        }
        m_cap = cap
    }

    pub fn push(&mut self, v: T) {
        if m_len == m_cap {
            panic("buffer full")
        }
        unsafe {
            construct(m_data[m_len], move(v))
        }
        m_len += 1
    }

    pub fn len(&self) -> usize {
        return m_len
    }

    pub fn at(&self, i: usize) -> ^T {
        unsafe {
            return &mut m_data[i]
        }
    }
}

impl<T> Drop for Buffer<T> {
    fn drop(&mut self) {
        unsafe {
            if !T::is_trivially_copyable {
                for i in 0..m_len {
                    destroy(m_data[i])
                }
            }
            free(m_data)
        }
    }
}

struct Movie {
    pub id:     u32
    pub rating: f32
    pub name:   str
}

struct List<T> {
    m_buffer: Buffer<T> = Buffer<T>(10)

    pub fn push(&mut self, value: T) {
        m_buffer.push(move(value))
    }

    pub fn len(&self) -> usize {
        return m_buffer.len()
    }

    pub fn at(&self, i: usize) -> ^T {
        return m_buffer.at(i)
    }

    pub fn iter(&mut self) -> ListIterator<T> {
        let l: ^List<T> = &mut self
        return ListIterator<T> { 0, l }
    }
}

struct ListIterator<T> {
    m_at:   usize
    m_list: ^List<T>
}

impl<T> Iterate for ListIterator<T> {
    type Item = &T

    fn valid(&self) -> bool {
        unsafe {
            return m_at < m_list.len()
        }
    }

    fn get(&self) -> &T {
        unsafe {
            return m_list.at(m_at) or unreachable
        }
    }

    fn advance(&mut self) {
        m_at += 1
    }
}

fn find_movie(list: &mut List<Movie>, name: str) -> Movie? {
    for m in list.iter() {

        if m.name == name {
            return m
        }
    }

    return none
}

enum Test {
    a, b, c
}

fn main() {
    let mut list: List<Movie>

    list.push(Movie{ 1, 6.8, "Fast and Furious" })
    list.push(Movie{ 2, 7.0, "Madagascar" })

    let m = find_movie(&mut list, "Nemo")

    if let m2 = m  {
        println("Movie found with id: {}", m2.id)
    } else {
        println("Movie not found")
    }

    for m in list.iter() {
        println("{}", m.name)
    }
}
