// `for` and `case` bindings (spec §10.3, §10.4): copies, references and writable
// references; tuple elements taken apart; `indexed()`; consuming loops; and each of them
// mixed with `switch`, `or`, generics and ownership.

struct P {
    pub n: i32
}

struct Res {
    pub n: i32
}

impl Drop for Res {
    fn drop(&mut self) {
        println("drop {}", n)
    }
}

enum Step {
    Go
    Stop
}

union Shape {
    Circle { radius: f32 }
    Point {}
}

union Choice<T> {
    One { value: T }
    Neither {}
}

// A countdown hands out values: only `for n in` fits it.
struct Countdown {
    left: i32
    Countdown(n: i32) {
        left = n
    }
}

impl Iterate for Countdown {
    type Item = i32
    fn valid(&self) -> bool {
        return left > 0
    }
    fn get(&self) -> i32 {
        return left
    }
    fn advance(&mut self) {
        left -= 1
    }
}

// The shape of an ECS query: each pass is an id and two components, one of them writable.
struct Query {
    pub names: ^[3]P
    pub scores: ^mut [3]i32
    pub at: usize
}

impl Iterate for Query {
    type Item = (usize, &P, &mut i32)
    fn valid(&self) -> bool {
        return at < 3
    }
    fn get(&self) -> (usize, &P, &mut i32) {
        // Block-valued references: these did not compile until the value of a block that
        // yields a `&T` was held as a pointer.
        let name: &P = unsafe { &names^[at] }
        let score: &mut i32 = unsafe { &mut scores^[at] }
        return (at, name, score)
    }
    fn advance(&mut self) {
        at += 1
    }
}

fn clear(xs: &mut [2]i32) {
    for &mut x in xs {
        x = 0
    }
}

fn set(x: &mut i32) {
    x = 40
    x += 2
}

fn grow(s: &mut Shape) {
    switch s {
        case Circle(&mut c) { c.radius += 1 }
        case Point {}
    }
}

fn maybe(n: i32) -> i32? {
    if n > 2 {
        return none
    }
    return n
}

fn count<T: Copy>(xs: []T, stop: Step) -> i32 {
    let mut n = 0
    for i, &_x in xs.indexed() {
        switch stop {
            case Go { continue }
            case Stop {
                let v = maybe(i as i32) or break
                n += v
            }
        }
    }
    return n
}

fn wrap<T>(x: T) -> Choice<T> {
    return Choice::One{ value: move(x) }
}

fn main() {
    // Copies cannot change the array; `&mut` does.
    let mut xs = [1, 2, 3]
    for &mut x in xs {
        x *= 10
    }
    let mut seen = 0
    for x in xs {
        seen += x
    }
    println("{} {}", xs[2], seen)

    let mut pair = [5, 6]
    clear(&mut pair)
    let mut n = 0
    set(&mut n)
    println("{} {} {}", pair[0], pair[1], n)

    // Fields through `&mut`, and a struct read through `&`.
    let mut ps = [P{ n: 1 }, P{ n: 2 }]
    for &mut p in ps {
        p.n += 100
    }
    for &p in ps {
        println("p {}", p.n)
    }

    // Tuple elements: each part copied, referred to, or written.
    let mut pairs = [(1, 2.5), (3, 4.5)]
    for a, &mut b in pairs {
        b += a as f64
    }
    for &a, b in pairs {
        println("pair {} {}", a, b)
    }

    // `indexed()` over an array, an iterator and a range, with `continue` in the middle.
    for i, x in xs.indexed() {
        println("{}: {}", i, x)
    }
    for i, left in Countdown(3).indexed() {
        if left == 2 {
            continue
        }
        println("countdown {} {}", i, left)
    }
    for i, v in (7..9).indexed() {
        println("range {} {}", i, v)
    }

    // An iterator of references, taken apart: the score is written through the query.
    let names = [P{ n: 10 }, P{ n: 20 }, P{ n: 30 }]
    let mut scores = [0, 0, 0]
    let query = Query{ names: &names, scores: &mut scores, at: 0 }
    for id, &name, &mut score in query {
        score = name.n + id as i32
    }
    println("scores {} {} {}", scores[0], scores[1], scores[2])

    // A switch in a loop, writing into each element's payload.
    let mut shapes = [Shape::Circle{ radius: 1 }, Shape::Point, Shape::Circle{ radius: 5 }]
    for &mut s in shapes {
        switch s {
            case Circle(&mut c) { c.radius *= 2 }
            case Point {}
        }
    }
    grow(&mut shapes[0])
    for &s in shapes {
        switch s {
            case Circle(&c) { println("circle {}", c.radius) }
            case Point { println("point") }
        }
    }

    // `break`, `continue` and `or break` inside arms, inside a generic loop.
    let ns = [1, 2, 3, 4]
    println("count {} {}", count(ns, Step::Stop), count(ns, Step::Go))

    // A generic union inferred from its payload, and matched over copies.
    let cs = [wrap(1), wrap(2), Choice<i32>::Neither]
    let mut total = 0
    for c in cs {
        switch c {
            case One(o) { total += o.value }
            case Neither {}
        }
    }
    println("choices {}", total)

    // Move-only elements: referred to, then consumed. Each is dropped once where it is
    // taken; what the loop leaves behind is dropped at the end, at its defaults.
    let rs = [Res{ n: 1 }, Res{ n: 2 }]
    for i, &r in rs.indexed() {
        println("see {} {}", i, r.n)
    }
    for r in move(rs) {
        println("took {}", r.n)
    }
    println("end")
}
