// A method named as a value is a function whose first parameter is the receiver (spec §8.1,
// T-0261): `Counter::add` is a `fn(&mut Counter, i32)`. Here a plain method, one given to a
// function, one with no receiver, both methods of a generic struct's instance, and a generic
// method with its type argument written and inferred. Each keeps its own `kills` and `sends`,
// which the function type it is stored in states.

struct Counter {
    pub n: i32 = 0

    pub fn add(&mut self, by: i32) {
        n += by
    }

    pub fn get(&self) -> i32 {
        return n
    }

    pub fn zero() -> Counter {
        return Counter{}
    }
}

struct Pair<T> {
    pub a: T
    pub b: T

    pub fn set_a(&mut self, v: T) kills self.a sends v to self {
        a = v
    }

    pub fn first(&self) -> &T {
        return &a
    }
}

struct Shelf {
    pub names: List<String> = List<String>()

    pub fn count_of<T>(&self, x: T) -> usize {
        let _ = x
        return names.len()
    }

    pub fn add(&mut self, s: String) kills self.names@items sends s to self {
        names.push(s)
    }
}

fn apply(f: fn(c: &mut Counter, by: i32), c: &mut Counter) {
    f(c, 5)
}

fn main() {
    let mut c = Counter{}
    let f: fn(c: &mut Counter, by: i32) = Counter::add
    f(&mut c, 2)
    apply(Counter::add, &mut c)
    let g: fn(c: &Counter) -> i32 = Counter::get
    println!("counter {}", g(&c))
    let z: fn() -> Counter = Counter::zero
    println!("zero {}", z().n)

    let mut p = Pair<i32>{ a: 1, b: 2 }
    let s: fn(p: &mut Pair<i32>, v: i32) kills p.a sends v to p = Pair<i32>::set_a
    s(&mut p, 7)
    let first: fn(p: &Pair<i32>) -> &i32 = Pair<i32>::first
    println!("pair {} {}", first(&p), p.b)

    let mut shelf = Shelf{}
    let add: fn(s: &mut Shelf, x: String) kills s.names@items sends x to s = Shelf::add
    add(&mut shelf, String::from("a"))
    let count: fn(s: &Shelf, x: bool) -> usize = Shelf::count_of<bool>
    let inferred: fn(s: &Shelf, x: i32) -> usize = Shelf::count_of
    println!("shelf {} {}", count(&shelf, true), inferred(&shelf, 3))
}

