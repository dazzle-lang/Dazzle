// Placement by the compiler (spec §14.6, T-0117): a value a block builds and never lets out
// gets its memory from a region released when the block ends, and a value a function
// returns is built wherever its caller keeps it. The output must be the same with regions
// on (`DZ_REGIONS=1`, `regions_change_nothing` in crates/dz/tests/run.rs) and off. The
// cases are the prototype's (T-0104), less its `#allocator`.

struct Store {
    pub saved: List<i32>
    pub names: List<String>
}

// Placed: only borrowed, by its own methods and a `for`.
fn sum_squares(n: i32) -> i32 {
    let mut xs = List<i32>()
    for i in 0..n {
        xs.push(i * i)
    }
    let mut total = 0
    for &x in xs {
        total += x
    }
    return total
}

// Returned: built where the caller keeps it, `main`'s region below.
fn evens(n: i32) -> List<i32> {
    let mut xs = List<i32>()
    for i in 0..n {
        if i % 2 == 0 {
            xs.push(i)
        }
    }
    return move(xs)
}

// Copies what it is lent into a store that outlives the lender's region.
fn keep(store: &mut Store, xs: &List<i32>) kills store.saved {
    store.saved = xs
}

// Fills a region of its own, reusing the chunks the last region gave back, so anything
// still pointing into them reads these values instead of its own.
fn churn() -> i32 {
    let mut junk = List<i32>()
    for _ in 0..20000 {
        junk.push(-1)
    }
    return junk.len() as i32
}

// Grows a list it is lent while its own region is open: the list's memory must come from
// wherever the lender built it, not this region, which is gone when it returns.
fn fill(xs: &mut List<i32>, n: i32) kills xs@items {
    let mut scratch = List<i32>()
    for i in 0..n {
        scratch.push(i)
        xs.push(i)
    }
    xs.push(scratch.len() as i32)
}

// Returned: built where the caller keeps it. `main` keeps one in its region and stores
// one in `store`, which gets the heap.
fn squares(n: i32) -> List<i32> {
    let mut xs = List<i32>()
    for i in 0..n {
        xs.push(i * i)
    }
    return move(xs)
}

// Passes its own caller's placement on to `squares`.
fn more_squares(n: i32) -> List<i32> {
    return squares(n)
}

// Placed: the scratch `String` dies here; the name kept is a copy, on the heap.
fn label(store: &mut Store, prefix: &str, n: i32) kills store.names@items {
    let mut text = String::from(prefix)
    text.push_str("-")
    text.push_str(format!("{}", n).as_str())
    store.names.push(String::from(text.as_str()))
}

// The scratch string dies here, so it is this block's region's; the pushed one is a new
// string, on the heap.
fn tag(names: &mut List<String>, prefix: &str, n: i32) kills names@items {
    let mut scratch = String::from(prefix)
    scratch.push_str("-")
    scratch.push_str(format!("{}", n).as_str())
    names.push(String::from(scratch.as_str()))
}

fn tag_twice(names: &mut List<String>, prefix: &str) kills names@items {
    tag(names, prefix, 1)
    tag(names, prefix, 2)
}

// Gives an element back, so a list lent here does not keep what it stores.
fn take_last(
    names: &mut List<String>,
    into: &mut Store
) kills names@items, names[*], into.names@items sends names[*] to into {
    let last = names.pop() or return
    into.names.push(move(last))
}

// Counts words into a map whose keys are copies of one reused buffer, as the `words`
// benchmark does: the buffer is placed, and each copy goes to the heap.
fn distinct(text: &str) -> i32 {
    let mut counts = HashMap<String, i32>()
    let mut word = String::from("")
    for piece in text.split_whitespace() {
        word.clear()
        word.push_str(piece)
        if let &mut n = counts.get_mut_str(word.as_str()) {
            n += 1
        } else {
            counts.insert(word, 1)
        }
    }
    let mut most = 0
    for _, &c in counts {
        if c > most {
            most = c
        }
    }
    return counts.len() as i32 * 100 + most
}

// A trait method returning a list: every implementation, the trait object's vtable slot and
// a call through a bound take where the result goes alike.
trait Counter {
    fn upto(&self, n: i32) -> List<i32>

    // A default method, copied into each implementation.
    fn twice(&self, n: i32) -> List<i32> {
        let mut xs = self.upto(n)
        for i in 0..n {
            xs.push(i)
        }
        return move(xs)
    }
}

struct Steps {
    pub by: i32 = 1
}

impl Counter for Steps {
    fn upto(&self, n: i32) -> List<i32> {
        let mut xs = List<i32>()
        for i in 0..n {
            xs.push(i * by)
        }
        return move(xs)
    }
}

fn sum_of(xs: &List<i32>) -> i32 {
    let mut t = 0
    for &x in xs {
        t += x
    }
    return t
}

fn through_object(c: &Counter, n: i32) -> List<i32> {
    return c.upto(n)
}

fn through_bound<C: Counter>(c: &C, n: i32) -> List<i32> {
    return c.twice(n)
}

// A function value: it passes where its result goes like a call by name.
fn apply(make: fn(i32) -> List<i32>, n: i32) -> List<i32> {
    return make(n)
}

// A generic function takes no placement, so as a `fn(String) -> String` it is adapted.
fn same<T>(x: T) -> T in x@home {
    return move(x)
}

// A constructor builds its fields where the value it makes is placed, and a value's
// fields and a box's contents live where the value lives.
struct Bag {
    pub items: List<i32>
    pub label: String

    Bag() {
        items = List<i32>()
        label = String::from("empty")
    }

    Bag(n: i32) {
        items = List<i32>()
        for i in 0..n {
            items.push(i)
        }
        label = String::from("bag")
    }

    // A parameter taken by reference: the heap overload passes it on as it is, where a
    // value is moved (`static_cast<T&&>` of a reference was `T&&&`).
    Bag(from: &List<i32>, extra: i32) {
        items = List<i32>()
        for &x in from {
            items.push(x)
        }
        items.push(extra)
        label = String::from("lent")
    }
}

// Kept and only lent: the bag and its fields in this block's region.
fn bag_total(n: i32) -> i32 {
    let b = Bag(n)
    return sum_of(&b.items)
}

// Returned: built where the caller keeps it.
fn make_bag(n: i32) -> Bag {
    return Bag(n)
}

// A literal's fields, and a box's contents, where the literal and the box are.
fn pair_total() -> i32 {
    let s = Store{ saved: squares(4), names: List<String>() }
    let boxed = Box(squares(3))
    let held = &boxed
    return sum_of(&s.saved) + if held.is_null() {
        0
    } else {
        1
    }
}

// `format!`'s text goes where the macro's value goes: kept and lent, in a region (here one
// per pass of the loop); returned, where the caller keeps it; stored, on the heap.
fn heading(n: i32) -> i32 {
    let mut total = 0
    for i in 0..n {
        let line = format!("== {} ==", i)
        total += line.len() as i32
    }
    return total
}

fn caption(n: i32) -> String {
    return format!("caption {}", n)
}

fn captions(names: &mut List<String>, n: i32) kills names@items {
    for i in 0..n {
        let s = format!("c{}", i)
        names.push(move(s))
    }
}

// Passed by value to a parameter that stays in the call: built in the caller's region, and
// dropped by the callee, into it.
fn weigh(xs: List<i32>) -> i32 {
    let mut total = 0
    for &x in xs {
        total += x
    }
    return total
}

fn weighed() -> i32 {
    let mut xs = List<i32>()
    for i in 0..100 {
        xs.push(i)
    }
    return weigh(move(xs))
}

fn main() {
    let mut kept = List<String>()
    tag_twice(&mut kept, "kept")
    for i in 0..3 {
        tag(&mut kept, "loop", i)
    }
    println!("kept {} {} {}", kept.len(), kept[0], kept[4])

    // `take_last` moves an element out into the store, which outlives this block's region,
    // so what `tag` pushes here must not be in it.
    let mut given = Store{ saved: List<i32>(), names: List<String>() }
    {
        let mut lent = List<String>()
        tag(&mut lent, "lent", 7)
        tag(&mut lent, "lent", 8)
        take_last(&mut lent, &mut given)
    }
    println!("churned {}", churn())
    println!("given {}", given.names[0])

    println!("distinct {}", distinct("a b a c b a d"))

    println!("{}", sum_squares(10))

    let e = evens(10)
    println!("{} evens, last {}", e.len(), e.last() or return)

    let mut store = Store{ saved: List<i32>(), names: List<String>() }
    {
        let mut lent = List<i32>()
        lent.push(7)
        lent.push(8)
        keep(&mut store, &lent)
    }
    // The block's region is released and its chunk reused; the copy must not have been in it.
    println!("churned {}", churn())
    store.saved.push(9)
    println!("saved {} {} {}", store.saved[0], store.saved[1], store.saved[2])

    let mut grown = List<i32>()
    fill(&mut grown, 1000)
    let mut check = 0
    for &g in grown {
        check += g
    }
    println!("grown {} sum {}", grown.len(), check)

    // A region per pass of the loop: each pass's list is gone by the next.
    let mut longest = 0
    for round in 0..50 {
        let mut words = List<String>()
        for i in 0..round {
            words.push(String::from("w"))
            if i > longest {
                longest = i
            }
        }
        if words.len() as i32 != round {
            println!("round {} lost words", round)
        }
    }
    println!("longest {}", longest)

    let mut counts = HashMap<i32, i32>()
    for i in 0..100 {
        let n = counts.get_or_insert(i % 7, 0)
        n += 1
    }
    let mut total = 0
    for _, &c in counts {
        total += c
    }
    println!("counts {} total {}", counts.len(), total)

    let local = squares(20)
    println!("squares {} last {}", local.len(), local.last() or return)

    store.saved = squares(5)
    println!("stored {}", store.saved[4])

    let deep = more_squares(30)
    println!("deep {} last {}", deep.len(), deep.last() or return)

    label(&mut store, "item", 1)
    label(&mut store, "item", 2)
    for &name in store.names {
        println!("{}", name)
    }

    let steps = Steps{ by: 2 }
    let direct = steps.upto(4)
    let by_object = through_object(&steps, 5)
    let by_bound = through_bound(&steps, 3)
    println!("traits {} {} {}", sum_of(&direct), sum_of(&by_object), sum_of(&by_bound))

    let made = apply(squares, 6)
    let f = evens
    let called = f(8)
    let g = same<String>
    let text = g(String::from("adapted"))
    println!("values {} {} {}", sum_of(&made), called.len(), text)

    let kept_bag = make_bag(4)
    let empty: Bag
    let mut bags = List<Bag>()
    bags.push(Bag(2))
    println!("bags {} {} {} {} {} {}", bag_total(5), sum_of(&kept_bag.items), kept_bag.label, empty.label, bags[0].items.len(), pair_total())
    let copied = Bag(&kept_bag.items, 10)
    println!("lent bag {} {}", sum_of(&copied.items), copied.label)

    let mut caps = List<String>()
    captions(&mut caps, 3)
    let kept_caption = caption(7)
    println!("formatted {} {} {} {}", heading(12), kept_caption, caps.len(), caps[2])
    println!("weighed {}", weighed())
    println!("stored {} {} {} {}", filled(4), popped(&mut store), drained(3), counted(5))
    println!("kept {}", store.names[store.names.len() - 1])
    let word = String::from("lent")
    lend_copy(&mut store, &word)
    let holder = Holder{ named: Named{ name: String::from("held"), tags: List<String>() } }
    let got = named_of(&holder)
    println!("copied {} {} {} {}", tallied("b a c a b a"), labelled(3), named_copy(), got.name)
    println!("kept {} {}", store.names[store.names.len() - 1], churn())
    println!("paths {}", paths(8))
    println!("appended {} indexed {}", appended(), indexed())
    println!("returned {}", create_strings())
}

// The user's example in T-0147: a list filled with `format!`'s text, indexed, grown through
// an element and through a `&mut` held in a `let`, all in the region, so it skips its drop;
// what it returns is a copy, on the heap.
fn create_strings() -> String {
    let mut strings: List<String> = List<String>()
    for i in 0..1000 {
        strings.push(format!("String number {}", i))
    }
    let selected: &mut String = &mut strings[500]
    selected.push_str(" - modified!")
    strings[100].push_str(" - changed too")
    println!("{}", selected)
    strings.push(String("One more string"))
    churn()
    return strings[500]
}

// `append` moves in the elements of a list that was lent, so they are on the heap: the
// list that takes them keeps its drop, or they would leak (T-0208).
fn appended() -> usize {
    let mut other = List<String>()
    other.push(String::from("appended from a list that was lent, long enough for the heap"))
    let mut names = List<String>()
    names.push(String::from("built here"))
    names.append(&mut other)
    churn()
    let last = names.last() or return 0
    return last.len()
}

// Read, grown and sorted through its elements, everything still in the region: it skips its
// drop, and `churn` must leave every element intact (T-0208).
fn indexed() -> usize {
    let mut names = List<String>()
    names.push(String::from("b, long enough to need memory of its own"))
    names.push(String::from("a"))
    names[1].push_str(", grown in place until it too needs memory of its own")
    names.sort()
    // Through a local, and through a loop's bindings (T-0209).
    let first = names[0]
    first.push_str("!")
    for &mut s in names {
        s.push_str("?")
    }
    churn()
    return names[0].len() + names[1].len() + names.len()
}

// Each pass builds a list over several statements and then pushes it: it goes into the
// region with `all`, as `all.push(List())` would, and the outer list's growth and `churn`
// must leave every path intact.
fn paths(n: i32) -> i32 {
    let mut all = List<List<i32>>()
    for i in 0..n {
        let mut path = List<i32>()
        for step in 0..20 {
            path.push(i * 100 + step)
        }
        all.push(move(path))
    }
    churn()
    let mut sum = 0
    for &p in all {
        sum += p[0] + p[19]
    }
    return sum
}

// A map filled under a lookup that found nothing keeps every key it is given, so each copy
// of `word` goes into the region with the map, on every pass (T-0140, T-0149).
fn tallied(text: &str) -> usize {
    let mut counts = HashMap<String, i32>()
    let mut word = String()
    for piece in text.split_whitespace() {
        word.clear()
        word.push_str(piece)
        if let &mut n = counts.get_mut_str(word.as_str()) {
            n += 1
        } else {
            counts.insert(word, 1)
        }
    }
    let mut total: usize = 0
    for k, &n in counts {
        total += k.len() * 10 + n as usize
    }
    return total + churn() as usize
}

// `format!`'s text pushed on every pass, into a list that keeps it (T-0149).
fn labelled(n: i32) -> usize {
    let mut names = List<String>()
    for i in 0..n {
        names.push(format!("label {}", i))
    }
    return names[names.len() - 1].len() + names.len()
}

// A copy into a list the caller lent keeps the heap: the list outlives this region.
fn lend_copy(store: &mut Store, word: &String) kills store.names@items {
    store.names.push(word)
    churn()
}

struct Named {
    pub name: String
    pub tags: List<String>
}

// A `copy` of its own builds both fields where the copy is placed (T-0140).
impl Copy for Named {
    fn copy(&mut self, other: &Self) {
        name = other.name
        tags = other.tags
    }
}

struct Holder {
    pub named: Named
}

// A copy returned: built where the caller keeps it.
fn named_of(h: &Holder) -> Named {
    return h.named
}

// A copy bound by `let`, in this region, which outlives nothing it copied.
fn named_copy() -> usize {
    let mut a = Named{ name: String::from("a"), tags: List<String>() }
    a.tags.push(String::from("tag"))
    let b = a
    a.tags.push(String::from("more"))
    return b.name.len() + b.tags.len() * 10 + a.tags.len() * 100
}

// Stored into a container: built where the container lives (T-0145). The pushed strings
// are in this function's region with the list, so the list's drop is skipped, and then
// the region is released and its chunk reused by `churn`.
fn filled(n: i32) -> usize {
    let mut names = List<String>()
    for i in 0..n {
        names.push(String::from("filled"))
        if i % 2 == 0 {
            names.push(String::from("even"))
        }
    }
    let mut total: usize = 0
    for &s in names {
        total += s.len()
    }
    return total + churn() as usize
}

// Taken back out and kept in a store that outlives the list: the string keeps the heap, so
// what `churn` writes over the region does not reach it.
fn popped(store: &mut Store) -> usize kills store.names@items {
    let mut names = List<String>()
    names.push(String::from("popped"))
    let last = names.pop() or return 0
    store.names.push(move(last))
    return names.len() + churn() as usize
}

// Popped on the same pass: the list does not keep what it is given, so each pass's string
// keeps the heap rather than grow the region.
fn drained(n: i32) -> usize {
    let mut names = List<String>()
    let mut count: usize = 0
    for _ in 0..n {
        names.push(String::from("pass"))
        let s = names.pop() or return 0
        count += s.len()
    }
    return count
}

// A map filled outside a loop takes its values into its region, though `insert` may drop
// the one it replaces.
fn counted(n: i32) -> usize {
    let mut m = HashMap<i32, String>()
    m.insert(n, String::from("five"))
    let mut total: usize = 0
    if let &v = m.get(&n) {
        total += v.len()
    }
    return total
}
