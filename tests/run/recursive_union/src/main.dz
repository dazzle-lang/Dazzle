// A union that holds a `List` of itself, directly and through a struct, as a JSON tree does.
// Whether it copies asks whether `List<Tree>` does, and `List`'s `impl<T: Clone> Copy` asks
// back about `Tree`: until T-0173 that question started over from nothing each time, and the
// compiler overflowed its own stack checking this program.

union Tree {
    Leaf { value: i32 }
    Node { kids: List<Tree> }
    Named { entries: List<Entry> }
}

struct Entry {
    pub name: String
    pub tree: Tree
}

fn sum(t: &Tree) -> i32 {
    switch t {
        case Leaf(&l) {
            return l.value
        }
        case Node(&n) {
            let mut total = 0
            for &k in n.kids {
                total += sum(&k)
            }
            return total
        }
        case Named(&n) {
            let mut total = 0
            for &e in n.entries {
                total += sum(&e.tree)
            }
            return total
        }
    }
}

fn main() {
    let mut kids = List<Tree>()
    kids.push(Tree::Leaf{ value: 1 })
    kids.push(Tree::Leaf{ value: 2 })
    let mut entries = List<Entry>()
    entries.push(Entry{ name: String("three"), tree: Tree::Leaf{ value: 3 } })
    entries.push(Entry{ name: String("pair"), tree: Tree::Node{ kids: kids } })
    let root = Tree::Named{ entries: entries }
    println!("sum {}", sum(&root))
}
