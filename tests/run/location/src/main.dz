// An intrinsic as a default argument is evaluated where the function is *called* (spec
// §12.7): `loc: SourceLocation = #location` records the caller, which is what lets an
// allocator's tracking name the line that allocated rather than its own.

fn where_from(tag: str, align: i32 = 8, loc: SourceLocation = #location, line: u32 = #line) -> u32 {
    println!("{} {} {} {} {}", tag, align, loc.line, line, loc.function)
    return loc.line
}

struct Heap {
    pub fn alloc(&mut self, _size: usize, loc: SourceLocation = #location) -> u32 {
        return loc.line
    }
}

fn helper() -> u32 {
    return where_from("from helper")
}

fn main() {
    where_from("a")
    where_from("b", 4)
    helper()

    let mut h = Heap{}
    let allocated_at = h.alloc(4)
    // Written directly, it is where it is written.
    let here = #location
    println!("{} {} {}", allocated_at, here.line, here.column)
}
