// A handle to a derived struct used as a handle to its base (spec §14.5, 18.64): `Rc`, `Weak`
// and `Box`. The derived type adds fields and a field with a `drop`, so dropping through the
// base must still drop all of it and free the right size — `--track-memory` would report a
// wrong-size free, and `a_tracked_build_reports_leaks_and_bad_frees` runs this fixture.

struct Label {
    pub text: const &str = ""
}

impl Drop for Label {
    fn drop(&mut self) {
        if text.byte_len > 0 {
            println!("drop label {}", text)
        }
    }
}

struct UiElement {
    pub x: i32 = 0

    pub virtual fn draw(&self) {
        println!("element at {}", x)
    }
}

struct Button : UiElement {
    pub label: Label = Label{}
    pub extra: u64 = 7
    pub more: u64 = 9

    override fn draw(&self) {
        println!("button '{}' at {} ({})", label.text, x, extra + more)
    }
}

// A struct that adds the first `virtual` below a base with none: in C++ the base is a word
// into it, after its vtable, so an `Rc<Plain>` points past the start of what it holds and
// must still drop and free all of it (D-0104). A `Box<Plain>` of one is refused (DZ0588);
// a `Box<Fancy>` of a `Fancier` is fine.
struct Plain {
    pub x: i32 = 0
}

struct Fancy : Plain {
    pub y: u64 = 3

    pub virtual fn show(&self) {
        println!("fancy {} {}", x, y)
    }
}

struct Fancier : Fancy {
    pub label: Label = Label{}
    pub z: u64 = 5

    override fn show(&self) {
        println!("fancier {} {} {}", x, y, z)
    }
}

fn draw_all(items: &List<Rc<UiElement>>) {
    for &item in items {
        if let &e = item {
            e.draw()
        }
    }
}

fn keep(e: Rc<UiElement>) -> usize {
    return e.count()
}

fn main() {
    let b = Rc<Button>(Button{ x: 1, label: Label{ text: "ok" } })
    let mut items = List<Rc<UiElement>>()
    items.push(b.clone())
    items.push(Rc<UiElement>(UiElement{ x: 5 }))
    println!("count {} passed {}", b.count(), keep(b.clone()))
    let weak: Weak<UiElement> = Weak<Button>(&b)
    draw_all(&items)

    let boxed: Box<UiElement> = Box<Button>(Button{ x: 2, label: Label{ text: "boxed" } })
    if let &e = boxed {
        e.draw()
    }

    items.clear()
    println!("weak alive {}", weak != null)
    let _ = b
    println!("weak after {}", weak != null)

    let plain: Rc<Plain> = Rc<Fancier>(Fancier{ x: 3, label: Label{ text: "rc fancier" } })
    if let &p = plain {
        println!("plain {}", p.x)
    }
    let _ = plain
    let fancy: Box<Fancy> = Box<Fancier>(Fancier{ x: 4, label: Label{ text: "box fancier" } })
    if let &f = fancy {
        f.show()
    }
}
