// Exercises everything M4 codegen supports, and prints a line per feature so the
// end-to-end test can compare stdout exactly.

pub enum Layer : u16 {
    Background = 0
    World
    Ui = 300
}

pub struct Vec3 {
    pub x: f32
    pub y: f32
    pub z: f32 = 0

    pub fn length_squared(&self) -> f32 {
        return x * x + y * y + z * z
    }
}

pub struct Counter {
    m_count:   u32
    pub label: str

    Counter(start: u32, label: str = "counter") {
        m_count = start
        self.label = label
    }

    pub fn get(&self) -> u32 {
        return m_count
    }

    pub fn bump(&mut self) {
        m_count += 1
    }
}

// A struct held by value inside another must be emitted first, whatever the source order.
pub struct Outer {
    pub inner: Inner
    pub tag:   Layer
}

pub struct Inner {
    pub value: i32
}

fn arithmetic(a: i32, b: i32) -> i32 {
    return (a + b) * 2 - a / b % 3
}

fn conditionals(n: i32) -> str {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    }
    return "positive"
}

fn loops(n: i32) -> i32 {
    let mut total = 0
    for i in 0..n {
        total += i
    }
    for i in 1..=3 {
        total += i
    }
    let mut k = 0
    while k < 3 {
        total += 1
        k += 1
    }
    return total
}

fn arrays() -> i32 {
    let mut fixed: [4]i32
    fixed[0] = 10
    fixed[3] = 5
    let mut sum = 0
    for v in fixed {
        sum += v
    }
    return sum
}

fn pointers(v: ^Vec3) -> f32 {
    // `.` reaches through the pointer on its own; there is no `->` (spec §5.2). Doing so
    // is `unsafe`: nothing checks that `v` still points at something.
    unsafe {
        v.x += 1
        return v.x
    }
}

fn casts(n: i32, l: Layer) -> i64 {
    let wide = n as i64
    let tag = l as u16
    return wide + tag as i64
}

fn layer_name(l: Layer) -> str {
    switch l {
        case Background {
            return "background"
        }
        case World {
            return "world"
        }
        default {
            return "ui"
        }
    }
}

// Array literals (spec §5.3): the length is exactly what is written, and the elements take
// their type from the annotation when there is one.
fn array_literals() -> i32 {
    let a = [1, 2, 3]
    let grid = [[1, 2], [3, 4]]
    let vs = [Vec3{ x: 1, y: 2 }, Vec3{ x: 3, y: 4 }]
    return a[0] + a[2] + grid[1][0] + vs[1].x as i32
}

fn typed_array_literal() -> f32 {
    let b: [4]f32 = [1, 2, 3, 4]
    return b[3]
}

// A literal may be passed where a slice is wanted: the temporary outlives the call (§5.3).
fn sum_slice(xs: []i32) -> i32 {
    let mut total = 0
    for x in xs {
        total += x
    }
    return total
}

// §7.4: `.World` where the enum is already known, on either side of a comparison.
fn dotted_variant(l: Layer) -> str {
    if .Background == l {
        return "background"
    }
    if l == .World {
        return "world"
    }
    return "ui"
}

fn main() {
    println("arithmetic: {}", arithmetic(10, 4))
    println("conditional: {} {} {}", conditionals(-1), conditionals(0), conditionals(7))
    println("loops: {}", loops(4))
    println("arrays: {}", arrays())

    let mut v = Vec3{ x: 3, y: 4 }
    println("vec3: {} {}", v.length_squared(), v.z)
    println("pointer: {}", pointers(&mut v))

    let mut c = Counter(41)
    c.bump()
    println("counter: {} {}", c.get(), c.label)

    let named = Counter(1, "named")
    println("named: {}", named.label)

    println("casts: {}", casts(2, Layer::Ui))
    println("switch: {} {} {}", layer_name(Layer::Background), layer_name(Layer::World), layer_name(Layer::Ui))

    let o = Outer{ inner: Inner{ value: 9 }, tag: Layer::World }
    println("nested: {}", o.inner.value)

    println("array literals: {}", array_literals())
    println("typed array literal: {}", typed_array_literal())
    println("literal as slice: {}", sum_slice([10, 20, 30]))
    println("dotted: {} {} {}", dotted_variant(Layer::Background), dotted_variant(.World), dotted_variant(.Ui))

    defer println("deferred: last")
    println("before defer runs")
}
