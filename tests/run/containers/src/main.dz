// `List<T>` and `String` (spec §14): growth, `b[i]` through `Index`/`IndexMut`, removal
// that moves elements, move-only elements dropped exactly once, copying, and a list in
// `Allocators::Temp`. `a_tracked_build_reports_leaks_and_bad_frees` builds `allocators`
// with tracking; this one, run with `--track-memory` too, reports no leaks.

static DROPS: i32 = 0

struct Token {
    pub id: i32 = 0
    pub live: bool = false

    Token(id: i32) {
        self.id = id
        live = true
    }
}

impl Drop for Token {
    fn drop(&mut self) {
        if live {
            unsafe { DROPS += 1 }
        }
    }
}

fn sum(xs: []i32) -> i32 {
    let mut t = 0
    for x in xs {
        t += x
    }
    return t
}

fn main() {
    let mut b = List<i32>()
    for i in 0..20 {
        b.push(i)
    }
    b[0] = 100
    b[1] += 5
    let last = b.pop() or -1
    b.insert(2, 7)
    let removed = b.remove(3)
    let swapped = b.swap_remove(0)
    #println("{} {} {} {} {} {}", b.len(), last, removed, swapped, b[0], sum(b.as_slice()))
    let c = b
    b.clear()
    #println("{} {} {}", b.len(), c.len(), c[1])

    let mut tokens = List<Token>(2)
    for i in 0..5 {
        tokens.push(Token(i))
    }
    let t = tokens.remove(1)
    let u = tokens.pop() or Token(-1)
    #println("{} {} {} {}", tokens.len(), t.id, u.id, tokens[1].id)
    tokens.truncate(1)
    #println("drops {}", unsafe { DROPS })

    let mut s = String("hello")
    s.push_str(", world")
    s.push('!')
    s.push('\u{e9}')
    let copy = s
    let same = copy == s
    #println("{} {} {} {} {}", s.as_str(), s.len(), same, String::from("x").len(), s.as_cstr())
    let mut names = List<String>()
    names.push(String("ada"))
    names.push(String("grace"))
    #println("{} {}", names[1].as_str(), names.len())

    // A frame's scratch list, in the arena.
    let mut scratch = List<u16>(0, Allocators::Temp)
    for i in 0..1000 {
        scratch.push(i as u16)
    }
    #println("{} {}", scratch[999], Allocators::Temp.used() > 0)

    // Bytes to text, checked.
    let text = str::from_utf8(s.as_str() as []u8) or "invalid"
    let cut = str::from_utf8((s.as_str() as []u8)[0..14]) or "invalid"
    #println("{} {}", text.len, cut)
}
