struct First {
    pub number: i32
}

struct Second {
    pub number: i32
}

struct Owned {
    pub text: String = String()
}

impl Drop for Owned {
    fn drop(&mut self) {
        if text.len() > 0 {
            println!("drop {}", text)
        }
    }
}

fn add(first: &mut First, amount: i32) {
    first.number += amount
}

fn main() {
    let mut entries = TypeMap()
    assert(entries.len() == 0)
    assert(entries.get<First>() == null)

    let first = entries.insert(First{ number: 3 })
    let second = entries.insert(Second{ number: 7 })
    let owned = entries.insert(Owned{ text: String("original owned entry") })
    assert(entries.get_mut_at<First>(second) == null)
    assert(entries.get_mut_at<Second>(1000) == null)
    assert(!entries.update_at<First, i32>(second, 99, add))
    assert(entries.update_at<First, i32>(first, 5, add))

    // Grow both the slot array and the key table.
    let _ = entries.insert(1 as u8)
    let _ = entries.insert(1 as u16)
    let _ = entries.insert(1 as u32)
    let _ = entries.insert(1 as u64)
    let _ = entries.insert(1 as i8)
    let _ = entries.insert(1 as i16)
    let _ = entries.insert(1 as i32)
    let _ = entries.insert(1 as i64)
    let _ = entries.insert(1 as f32)
    let _ = entries.insert(1 as f64)
    assert(entries.len() == 13)
    let value = entries.get_mut_at<First>(first) or unreachable
    assert(value.number == 8)
    value.number = 2

    let replaced = entries.insert(Owned{ text: String("replaced owned entry") })
    assert(replaced == owned)
    let a = entries.get<First>() or unreachable
    let b = entries.get<Second>() or unreachable
    let stored = entries.get<Owned>() or unreachable
    assert(stored.text.as_str() == "replaced owned entry")
    println!("{} {} {}", a.number, b.number, entries.len())
}
