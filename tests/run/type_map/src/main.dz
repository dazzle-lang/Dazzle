struct First {
    pub number: i32
}

struct Second {
    pub number: i32
}

struct Owned {
    pub text: String = String()
}

impl Drop for Owned {
    fn drop(&mut self) {
        if text.len() > 0 {
            println!("drop {}", text)
        }
    }
}

fn main() {
    let mut entries = TypeMap()
    assert(entries.len() == 0)
    assert(entries.get<First>() == null)

    entries.insert(First{ number: 3 })
    entries.insert(Second{ number: 7 })
    entries.insert(Owned{ text: String("original owned entry") })
    // A type is its own key: `Second` is not found as `First`, nor `i32` as `u32`.
    assert(entries.get<i32>() == null)
    if let &mut first = entries.get_mut<First>() {
        first.number += 5
    }

    // Grow the list of entries and the key table; the values already there stay put.
    entries.insert(1 as u8)
    entries.insert(1 as u16)
    entries.insert(1 as u32)
    entries.insert(1 as u64)
    entries.insert(1 as i8)
    entries.insert(1 as i16)
    entries.insert(1 as i32)
    entries.insert(1 as i64)
    entries.insert(1 as f32)
    entries.insert(1 as f64)
    assert(entries.len() == 13)
    let value = entries.get_mut<First>() or unreachable
    assert(value.number == 8)
    value.number = 2

    // Replacing a value drops the old one and adds no entry.
    entries.insert(Owned{ text: String("replaced owned entry") })
    entries.insert(5 as u32)
    assert(entries.len() == 13)
    let a = entries.get<First>() or unreachable
    let b = entries.get<Second>() or unreachable
    let c = entries.get<u32>() or unreachable
    let stored = entries.get<Owned>() or unreachable
    assert(stored.text.as_str() == "replaced owned entry")
    println!("{} {} {} {}", a.number, b.number, c, entries.len())
}
