// `T` where a `T?` is wanted (spec §9.1, 18.53): `if`/`switch` arms joined with `none`,
// a typed `let`, assignment, an argument, `.Variant` inferred through the `?`, and a
// move-only `T?` consumed by `or`.

struct Token {
    pub id: i32 = 0
}

impl Drop for Token {
    fn drop(&mut self) {
        println!("drop {}", id)
    }
}

union State {
    Idle {}
    Busy { n: i32 }
}

fn next(s: &State) -> State? {
    return switch s {
        case Idle { .Busy{ n: 1 } }
        case Busy(b) { if b.n > 2 { none } else { State::Busy{ n: b.n + 1 } } }
    }
}

fn heal(amount: i32?) -> i32 {
    return amount or 0
}

fn main() {
    let alive = true
    let hp = if alive { 100 } else { none }
    let dead = if !alive { 100 } else { none }
    let mut maybe: i32? = 5
    println!("{} {} {} {}", hp or -1, dead or -1, maybe or -1, heal(7))
    maybe = 9
    println!("{} {}", maybe or -1, heal(none))
    let t: Token? = Token{ id: 3 }
    let moved = t or return
    println!("got {}", moved.id)
    let s = next(&State::Idle) or return
    let s2 = next(&s) or return
    switch s2 {
        case Idle { println!("idle") }
        case Busy(b) { println!("busy {}", b.n) }
    }
}
