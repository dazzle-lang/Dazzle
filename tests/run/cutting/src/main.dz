// Every sequence cuts two ways (spec §5.3, D-0100): `xs[a..b]` panics when the range does
// not fit, and `xs.slice(a, b)` and `xs.get(i)` give `null` there instead. A type of the
// program's own cuts with `[a..b]` by implementing `Slice`, as it indexes with `Index`.
// Text has no brackets: every way in says its unit, bytes or characters.

/// Lines of text, cut by line: `log[1..3]` is the second and third.
struct Log {
    m_lines: List<String> = List<String>()
    tie @lines = m_lines@items

    pub fn add(&mut self, line: &str) kills self@lines {
        m_lines.push(String(line))
    }
}

impl Slice for Log {
    type Output = &[]String

    fn cut(&self, from: usize, to: usize?, loc: SourceLocation = #location) -> &[]String in self {
        return m_lines.cut(from, to, loc)
    }
}

/// Each word of `text`, cut out of it by byte position: no `String` and no `unsafe`.
fn print_words(text: &str) {
    let bytes = text as &[]u8
    let mut start: usize = 0
    for i in 0..bytes.len + 1 {
        if i == bytes.len || bytes[i] == ' ' as u8 {
            if i > start {
                println!("{}", text.cut_bytes(start, i))
            }
            start = i + 1
        }
    }
}

fn main() {
    // A `List`: both ends, either end left out, and a writable part that writes through.
    let mut xs = List<i32>()
    for v in 0..6 {
        xs.push(v * 10)
    }
    let middle = xs[1..3]
    println!("{} {} {}", middle.len, middle[0], middle[1])
    println!("{} {}", xs[4..].len, xs[..2].len)
    let mut front = xs[0..2]
    front[1] = 11
    println!("{}", xs[1])
    println!("{} {}", xs.slice(5, 6) == null, xs.slice(2, 9) == null)
    let third = xs.get(2) or return
    println!("{} {}", third, xs.get(6) == null)
    let last = xs.get_mut(5) or return
    last = 55
    println!("{}", xs[5])

    // Text, by bytes and by characters: `é` is two bytes and one character.
    let name = String("café au lait")
    println!("{} {}", name.byte_len(), name.len())
    println!("[{}] [{}] [{}]", name.cut_bytes(0, 5), name.cut_chars(0, 4), name.cut_chars(5, name.len()))
    println!("{} {} {}", name.byte(3), name.get_byte(14) == none, name.char(3))
    println!("{} {}", name.get_char(11) or ' ', name.get_char(12) == none)
    let greeting = "héllo"
    println!("{} {}", greeting.byte_len, greeting.len())
    println!("{} {}", greeting.slice_bytes(0, 2) == null, greeting.slice_bytes(0, 3) or "?")
    println!("{} {}", greeting.slice_chars(1, 3) or "?", greeting.slice_chars(4, 6) == null)
    print_words("cut a str into words")

    // An array and a slice: `get` and `slice` through the slice.
    let mut arr = [1, 2, 3, 4]
    let second = arr.get(1) or return
    println!("{} {}", second, arr.get(4) == null)
    let tail = arr.slice(2, 4) or return
    println!("{} {}", tail.len, tail[0])
    let first = arr.get_mut(0) or return
    first = 9
    println!("{}", arr[0])
    let view = arr[1..]
    println!("{} {}", view.slice(0, 3) == null, view.get(2) or return)

    // A type of the program's own.
    let mut log = Log{}
    log.add("one")
    log.add("two")
    log.add("three")
    for line in log[1..] {
        println!("{}", line)
    }
}
