// The formatting macros — `format!`, `println!` and the rest — `Format` implemented by a
// type of its own, and arguments passed by name after a variadic one (spec §7.2, §12.9).

struct Vec2 {
    pub x: f32
    pub y: f32
}

impl Format for Vec2 {
    fn format(&self, f: &mut Formatter) {
        f.write_str("(")
        self.x.format(f)
        f.write_str(", ")
        self.y.format(f)
        f.write_str(")")
    }
}

/// A `Format` that reads the placeholder's spec: hex digits for `{:x}`, a name otherwise.
struct Id {
    pub n: u32
}

impl Format for Id {
    fn format(&self, f: &mut Formatter) {
        if f.hex() {
            f.write_str("#")
            self.n.format(f)
        } else {
            f.write_str("id ")
            self.n.format(f)
        }
    }
}

// Declared ahead of `total`, whose default calls it: C++ reads a default where the
// function is declared (see the deferral register).
fn unit() -> i32 {
    println!("unit()")
    return 1
}

/// Every parameter after the variadic one is passed by name; leaving out the first and
/// giving the second still evaluates the first's default.
fn total(label: str, xs: ..i32, scale: i32 = unit(), offset: i32 = 0, loc: SourceLocation = #location) -> i32 {
    let mut t = 0
    for x in xs {
        t += x
    }
    println!("{} at line {}", label, loc.line)
    return t * scale + offset
}

fn main() {
    // Every built-in kind, and the same through `println`, which must agree.
    let all = format!("{} {} {} {} {} {} {}", true, 'é', "str", 255u8, -7, 2.5f32, 1.0e20)
    println!("{}", all.as_str())
    println!("{} {} {} {} {} {} {}", true, 'é', "str", 255u8, -7, 2.5f32, 1.0e20)
    let c: cstr = "cstr"
    let s = format!("{}|{}", c, all)
    println!("{}", s.as_str())

    // The ends of every integer width.
    println!("{}", format!("{} {} {} {}", -128i8, 32767i16, -2147483648, 4294967295u32).as_str())
    println!("{}", format!("{} {}", -9223372036854775807i64 - 1, 18446744073709551615u64).as_str())
    let n: usize = 12
    let m: isize = -12
    println!("{}", format!("{} {} {:x}", n, m, n).as_str())

    // Specs, braces and an empty string.
    println!("{}", format!("{:x} {:X} {:x} {:.2} {:.0}", 255, 255, -1, 3.14159, 2.75f32).as_str())
    println!("{}", format!("{{literal}} {{{}}}", 7).as_str())
    println!("[{}]", format!("").as_str())

    // A type's own `Format`, which can read the spec it was given.
    let v = Vec2{ x: 1.5, y: -2.0 }
    println!("{}", format!("v = {}, id {} or {:x}", v, Id{ n: 42 }, Id{ n: 255 }).as_str())

    // Another allocator, passed by name.
    let t = format!("temp {}", 1, allocator = Allocators::Temp)
    println!("{}", t.as_str())
    Allocators::Temp.reset()

    // Named arguments after a variadic one.
    println!("{}", total("a", 1, 2, 3))
    println!("{}", total("b", 1, 2, scale = 10))
    println!("{}", total("c", offset = 5))
    println!("{}", total("d", 4, offset = 1, scale = 3))

    // Anything with `Format` is written straight to the stream, a type's own included,
    // through a reference too, and a `String` as it is.
    println!("{} and {:x}, {}", v, Id{ n: 255 }, &v)
    println!("{} | {}", s, all)
    print!("no line break, ")
    println!("then one")
    eprintln!("to stderr {}", 1)

    // Escapes beside the braces — `\u{41}` has braces of its own — and a raw string.
    println!("'quoted' \u{41}{}\t|", 1)
    println!(`raw {} \n`, 2)

    // `T: Format` in a generic function.
    show(42)
    show(v)

    // A formatting macro of one's own hands its string on, checked where it is written.
    log!("info", "{} of {}", 3, 4)

    // In an `or` clause, never taken; with only text; into another allocator.
    let present: i32? = 5
    let got = present or panic!("missing {}", 5)
    let plain = format!("plain {{}}")
    let w = format!("{:.1}", 2.25, allocator = Allocators::Temp)
    println!("{} {} {}", got, plain, w)
    Allocators::Temp.reset()

    // Widths: a number right-aligned, with zeros after its sign for `{:0N}`, in hex and
    // with a precision too; anything else left-aligned, counted in characters; nothing cut.
    println!("[{:6}] [{:06}] [{:06}] [{:8x}] [{:08X}]", 1250, 42, -42, 255, 48879)
    println!("[{:8.2}] [{:08.2}] [{:3}] [{:2}] [{:06}]", 3.14159, -2.5, 12345, 'é', -0.5)
    let word = format!("héllo")
    println!("{}", format!("[{:6}] [{:7}] [{:7}] [{:3}]", "ab", true, word, "longer").as_str())

    // A type's own `Format` is padded as a whole, the numbers inside it left as they are —
    // a number first, then more, included — and through a type parameter the same.
    println!("[{:12}] [{:8x}] [{:8}]", v, Id{ n: 255 }, Meters{ m: 2.5 })
    padded(7)
    padded(Meters{ m: 1.0 })

    // `error(…)` formats its message without `Format`, and pads the same way.
    let fallback = checked(-7) or { e ->
        println!("{}", e.message)
        0
    }
    println!("{}", fallback)

    // A pointer is written as what it points at, a spec and a width applying to that, or
    // as `null`; `{:p}` writes its address, which differs from run to run, so it is
    // compared rather than printed — except a null one's.
    let mut target = Vec2{ x: 0.5, y: 4.0 }
    let at: ^Vec2 = &target
    let at_mut: ^mut Vec2 = &mut target
    let nowhere: ^Vec2 = null
    let count = 255
    let counted: ^i32 = &count
    println!("{} {} {} {:x} [{:5}]", at, at_mut, nowhere, counted, counted)
    let address = format!("{:p}", at)
    let same = address == format!("{:p}", at_mut)
    println!("{} {} {}", same, address.as_str().starts_with("0x"), format!("[{:20p}]", at).len())
    println!("{:p} [{:5p}]", nowhere, nowhere)
    let _ = missing(nowhere) or { e ->
        println!("{}", e.message)
        0
    }
}

fn missing(p: ^Vec2) !-> i32 {
    return error("nothing at {:p} [{:5p}]", p, p)
}

/// A number then a unit: under a width, the whole of it is padded, not the number.
struct Meters {
    pub m: f32
}

impl Format for Meters {
    fn format(&self, f: &mut Formatter) {
        self.m.format(f)
        f.write_str("m")
    }
}

fn padded<T: Format>(x: T) {
    println!("[{:6}]", x)
}

fn checked(n: i32) !-> i32 {
    if n < 0 {
        return error("[{:5}] [{:05}] [{:4}] [{:08.3}]", n, n, "ab", 1.5)
    }
    return n
}

fn show<T: Format>(x: T) {
    println!("show {}", x)
}

macro log -> stmt {
    syntax Arg { $value: expr }
    pattern { ( $level: literal , $fmt: literal $( , $args: [,]Arg )? ) }
    expand {
        print!("[{}] ", $level)
        println!($fmt #for a in $args { , $a.value })
    }
}
