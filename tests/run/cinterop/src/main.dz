// M7a (spec §15.1, §19): a C library vendored as source, built by `dz`, and called
// directly — each call below is emitted as the C call it names, with no wrapper.

// Handed to C as a callback: a C function pointer is Dazzle's `fn(i32) -> i32` (§15.2).
fn triple(value: i32) -> i32 {
    return value * 3
}

// This module carries `mini`'s recipe, so the orphan rule counts the header's types as its
// own (§7.6, §15.1): it may give a C struct a trait from `std`, here `+`.
impl Add for mini::MiniVec2 {
    type Output = mini::MiniVec2
    fn add(&self, rhs: mini::MiniVec2) -> mini::MiniVec2 {
        return mini::mini_add(self, rhs)
    }
}

fn main() {
    // `MINI_SCALE=3` comes from the recipe's `defines`.
    println!("scaled {}", mini::mini_scale(5))

    // A C struct is a Dazzle struct; a literal names the fields it sets, and the rest
    // are zero, as `{}` makes them in C.
    let a = mini::MiniVec2{ x: 1, y: 2 }
    let b = mini::mini_add(a, mini::MiniVec2{ x: 2, y: 2 })
    println!("sum {} {}", b.x, b.y)
    let c = a + b
    println!("plus {} {}", c.x, c.y)
    println!("length sq {}", mini::mini_length_sq(b))
    let zero: mini::MiniVec2
    println!("zero {} {}", zero.x, zero.y)

    // An enum parameter takes a variant; an unscoped enumerator is also a plain integer,
    // and a macro that is a number is a constant (spec §15.2).
    println!("sides {} {}", mini::mini_sides(.MINI_CIRCLE), mini::mini_sides(mini::MiniShape::MINI_SQUARE))
    let square: i32 = mini::MINI_SQUARE
    println!("square {} version {} half {}", square, mini::MINI_VERSION, mini::MINI_HALF)

    // `int *` is a `^mut i32` and `const int *` a `^i32` (§18.37): a writable array's
    // `.ptr` passes to both.
    let mut xs: [4]i32
    mini::mini_fill(xs.ptr, 4, 6)
    println!("total {}", mini::mini_sum(xs.ptr, 4))

    // `const char *` is a `cstr`. A string literal is one wherever one is wanted, and a
    // `cstr` measures into a `str` with `as` (§18.39).
    println!("name {}", mini::mini_name())
    println!("length {}", mini::mini_length("hello"))
    let name = mini::mini_name() as str
    println!("measured {}", name)
    // A `String` is a `cstr` for the call it is passed to (§7.2), through `std`'s
    // `ImplicitAs<cstr>`: a built one, and a `format!` that lives until the call returns.
    let owned = String::from("dazzle")
    println!("owned {} formatted {}", mini::mini_length(owned), mini::mini_length(format!("{}!", owned)))

    println!("callback {}", mini::mini_apply(triple, 7))

    // `char *` (§15.2): the C++ types differ — `int8_t` is `signed char` — so the call is
    // cast at the boundary. (A platform whose plain `char` is unsigned maps it to `u8`.)
    let mut word: [3]i8
    word[0] = 'h' as i8
    word[1] = 'i' as i8
    mini::mini_upper(word.ptr)
    println!("upper {} {}", word[0] as i32, word[1] as i32)

    // A C array member and bit-fields (§15.2): indexed, iterated and read like any other
    // field. A bit-field has no address, so `&flags.visible` is refused.
    let flags = mini::mini_flags()
    let mut total = 0
    for s in flags.samples {
        total += s
    }
    println!("bits {} {} sample {} total {} {}", flags.visible, flags.level, flags.samples[2],
            total, mini::mini_sample_sum(&flags))

    // An anonymous union inside a struct (§15.2): its members belong to the struct itself.
    let event = mini::mini_event(5)
    println!("event {} {}", event.kind, event.pressed)

    // A C union (§18.41): its members are the same memory, so a literal sets one of them
    // and reading another is C's own bargain.
    let value = mini::mini_int_value(9)
    println!("union {} {}", value.as_int, mini::mini_read_int(&value))
    let chosen = mini::MiniValue{ as_int: 4 }
    println!("chosen {}", chosen.as_int)

    // A handle (§18.40): `mini.h` declares `MiniCounter` and never defines it, so it
    // travels as a pointer and the library does the work on what it points at.
    let counter = mini::mini_counter()
    mini::mini_bump(counter)
    mini::mini_bump(counter)
    println!("count {}", mini::mini_count(counter))

    // A field of a struct with no name (§15.2), and one nested in it: read, written, and
    // passed back to C, whose overload set beside it must not make the call ambiguous.
    let mut config = mini::mini_config()
    config.output.channels = 6
    config.output.gain.right = 4
    println!("config {} {} {} {}", config.rate, config.output.channels, config.output.gain.left,
            mini::mini_config_total(&config))
}
