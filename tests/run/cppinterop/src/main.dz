// M7b (spec §15.1, §15.2, §19): a C++ library vendored as source, built by `dz`, and
// called directly — a namespace is a scope Dazzle reaches through, a class is a struct
// with methods, and an overload set resolves by argument type (§15.3).

fn main() {
    // A namespace is a nested scope: `shp` is the header, `shapes` the namespace in it.
    let a = shp::shapes::Point{ x: 1, y: 2 }
    // The manifest's `namespaces` names `shapes` bare too, so the header's key can be left
    // out, struct literals and types included (§15.2, T-0179).
    let b = shapes::Point{ x: 4, y: 6 }
    let c: shapes::Point = b

    // A nested namespace takes one more segment, or none when it is named bare as well.
    println!("manhattan {} {}", shp::shapes::geom::manhattan(a, c), geom::manhattan(a, c))

    // A scoped enum's enumerators are reached only through it (§18.38).
    println!("round {} square {}",
            shp::shapes::area_of(shp::shapes::Kind::Round, 5),
            shp::shapes::area_of(shp::shapes::Kind::Square, 5))

    // A C++ reference: `const Point&` is a `&Point`, `Point&` a `&mut Point` (§15.2).
    let mut moving = shp::shapes::Point{ x: 3, y: 4 }
    println!("length sq {}", shp::shapes::length_sq(&moving))
    shp::shapes::translate(&mut moving, 1, 1)
    println!("moved {} {}", moving.x, moving.y)

    // Default arguments: the call stops short, and C++ supplies the rest (§15.2).
    println!("scaled {} {} {}",
            shp::shapes::scaled(5),
            shp::shapes::scaled(5, 3),
            shp::shapes::scaled(5, 3, 1))

    // An overloaded free function, chosen by the arguments' count and types (§15.3).
    let small: u32 = 2
    println!("describe {} {} {} {}",
            shp::shapes::describe(7),
            shp::shapes::describe(a),
            shp::shapes::describe(a, 2),
            shp::shapes::describe(small, 1))

    // An array parameter takes the whole array, by reference (§15.2).
    let mut rgb: [3]f32 = [1, 0.5, 0.25]
    shp::shapes::halve(&mut rgb)
    println!("halved {} {} {} total {}", rgb[0], rgb[1], rgb[2], shp::shapes::total(&rgb))

    // A class: a constructor call, a `const` method, and a mutating one.
    let mut counter = shp::shapes::Counter(10)
    counter.add(5)
    // The other `add` of the overload set, chosen by the argument's type (§15.3).
    counter.add(a)
    println!("counter {}", counter.value())

    // A class C++ destroys itself: move-only in Dazzle, and its destructor runs at the end
    // of this scope without Dazzle emitting a `drop` for it (§15.2).
    let mut buf = shp::shapes::Buffer(4)
    buf.fill(3)
    println!("buffer {} {}", buf.len(), buf.sum())

    // A class whose move is C++ code is not moved as bytes: a growing list moves each one
    // through its move constructor, which keeps it pointing at itself (D-0105).
    let mut anchors = List<shp::shapes::Anchored>()
    for i in 1..8 {
        anchors.push(shp::shapes::Anchored(i))
    }
    anchors.insert(0, shp::shapes::Anchored(100))
    let mut ids = 0
    for &x in anchors {
        ids += x.id()
    }
    println!("anchored {} {}", anchors.len(), ids)

    // An overloaded method whose one overload takes an array, cast to a pointer at the
    // call as that overload's own parameter says (T-0017).
    let summer = shp::shapes::Summer{}
    let four = [1, 2, 3, 4]
    println!("summed {} {}", summer.total(&four), summer.total(5, 6))

    // A named template instantiation is an ordinary type (spec §15.4).
    let pair = shp::IntPair(3, 9)
    println!("pair {} {}", pair.first(), pair.sum())
}
