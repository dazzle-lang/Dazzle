// The serializer in `json.dz` at work, on a game's save data, and the type table read
// directly: names, kinds, sizes, tags and variants (spec §13).

enum Class : u8 {
    Warrior
    Mage = 5
    Rogue
}

struct Stats {
    pub strength: i32 = 0
    pub agility:  f32 = 0 `json:"agi"`
}

union Item {
    Potion { heal: i32 }
    Sword { damage: i32 `json:"dmg"` }
}

struct Player {
    pub name:    str = "Aria"      `json:"player_name"`
    pub level:   u32 = 7
    pub class:   Class = Class::Mage
    pub alive:   bool = true
    pub stats:   Stats = Stats{}
    pub scores:  [3]i32 = [0, 0, 0]
    pub pet:     str? = none
    pub held:    Item = Item::Potion{ heal: 5 }
    m_session:   u64 = 99
}

fn main() {
    let mut p = Player{}
    p.stats.strength = 12
    p.stats.agility = 1.5
    p.scores = [10, 20, 30]
    p.pet = "Ember"
    p.held = Item::Sword{ damage: 40 }
    println!("{}", to_json(&p).as_str())

    let q = Player{ name: "Bram", class: Class::Rogue, alive: false }
    println!("{}", to_json(&q).as_str())

    let levels: [4]u16 = [1, 2, 3, 5]
    let view: []u16 = levels[1..3]
    println!("{}", to_json(&view).as_str())

    let info = typeinfo_of<Player>()
    println!("{} in {}: {} fields, kind {}", info.name, info.module_name, info.fields.len, info.kind as u8)
    for &f in info.fields {
        println!("  {} tag `{}` json={}", f.name, f.tag, f.tag_value("json") or "-")
    }
    let class = typeinfo_of<Class>()
    for &v in class.variants {
        println!("  {} = {}", v.name, v.value)
    }
    println!("same id: {}", typeid_of<Player>() == typeid_of<Player>())

    // An editor's component list: the program keeps the ids it wants, which is also what
    // puts those types in the table (spec §13.2).
    let components: [2]TypeId = [typeid_of<Stats>(), typeid_of<Item>()]
    for &id in components {
        let c = typeinfo(id)
        println!("component {} ({} bytes, {} fields, {} variants)", c.name, c.size, c.fields.len, c.variants.len)
    }
    println!("list: {}", typeinfo_of<List<i32>>().name)
}
