struct Values {
    pub items: List<i32> = List<i32>()
}

#[thread_local]
static EARLY: Values = Values{}

struct ProcessReport {
}

impl Drop for ProcessReport {
    fn drop(&mut self) {
        println!("process {} {} {}", EARLY.items.len(), REPORT.id, state::get_id())
    }
}

static PROCESS_REPORT: ProcessReport = ProcessReport{}

struct Report {
    pub id: i32 = 0
}

impl Drop for Report {
    fn drop(&mut self) {
        println!("report {} {} {} {}", id, EARLY.items.len(), LATE.id, state::get_id())
    }
}

#[thread_local]
static REPORT: Report = Report{ id: 2 }

struct Late {
    pub id: i32 = 0
}

impl Drop for Late {
    fn drop(&mut self) {
        println!("late {}", id)
    }
}

#[thread_local]
static LATE: Late = Late{ id: 3 }

fn use_statics(id: i32) {
    println!("before {} {} {} {} {}", id, EARLY.items.len(), REPORT.id, LATE.id, state::get_id())
    unsafe {
        EARLY.items.push(id)
    }
    REPORT.id = id
    LATE.id = id + 1
    state::set_id(id + 2)
}

fn block_size(index: i32) -> usize {
    return index as usize % 64 + 1
}

fn allocate_block(index: i32) -> ^mut void {
    return unsafe {
        Allocators::Global.alloc(block_size(index), 8) as ^mut void
    }
}

fn release_block(ptr: ^mut void, index: i32) {
    unsafe {
        Allocators::Global.free(ptr as ^mut u8, block_size(index), 8)
    }
}

fn main() {
    use_statics(10)
    native::run_worker(use_statics, 20)
    native::run_worker(use_statics, 30)
    println!("joined {} {} {} {}", EARLY.items.len(), REPORT.id, LATE.id, state::get_id())
    native::exchange_allocations(allocate_block, release_block)
    println!("exchanged allocations")
}
