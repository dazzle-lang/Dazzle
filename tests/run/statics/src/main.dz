// `static` (spec §7.7): one variable for the program, or per thread with `#[thread_local]`.
// Read anywhere; changed only inside `unsafe`, whether by assignment, a `&mut self` method,
// a `&mut` binding in a `for`, or a `&mut` stored as a pointer.

struct Counter {
    pub hits: i32 = 0
    pub name: str = "counter"

    pub fn bump(&mut self) -> i32 {
        hits += 1
        return hits
    }
}

const START: i32 = 1

static COUNT: Counter = Counter{}
static TABLE: [4]i32 = [START, 2, 3, 4]
#[thread_local]
static SCRATCH: i32 = 7

struct Holder {
    pub p: ^mut Counter = null
}

fn touch() -> i32 {
    unsafe {
        return COUNT.bump()
    }
}

fn main() {
    println("{} {} {} {}", COUNT.hits, COUNT.name, TABLE[2], SCRATCH)
    unsafe {
        COUNT.bump()
        COUNT.hits += 10
        TABLE[0] = 9
        SCRATCH = 8
        for &mut t in TABLE {
            t += 1
        }
    }
    let touched = touch()
    println("{} {}", touched, COUNT.hits)

    // A `&mut` built by a block and stored as a pointer points at the static itself.
    let h = Holder{ p: unsafe { &mut COUNT } }
    let c = h.p or return
    c.hits += 100
    println("{} {} {} {}", COUNT.hits, TABLE[0], TABLE[3], SCRATCH)
}
