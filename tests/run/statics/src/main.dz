// `static` (spec §7.7): one variable for the program, or per thread with `#[thread_local]`.
// Read and changed anywhere: by assignment, a `&mut self` method, a `&mut` binding in a
// `for`, or a `&mut` stored as a pointer. A change that frees memory the static owns is
// named in the function's `kills` clause, as `record`'s is (spec §6.7, D-0094 point 7).

struct Counter {
    pub hits: i32 = 0
    pub name: const &str = "counter"

    pub fn bump(&mut self) -> i32 {
        hits += 1
        return hits
    }
}

const START: i32 = 1

/// A `str` cannot be built at C++ compile time, inside an array no more than alone, so
/// this is an `inline const` rather than a `constexpr`.
const NAMES: [3]&str = ["red", "green", "blue"]

// A constant whose elements are casts: the C++ is a `constexpr` array, so the cast it
// lowers to must be usable in one.
const SIGNS: [2]u8 = ['+' as u8, '-' as u8]

static COUNT: Counter = Counter{}
static TABLE: [4]i32 = [START, 2, 3, 4]
#[thread_local]
static SCRATCH: i32 = 7

struct Log {
    pub lines: List<i32> = List<i32>()
}

static LOG: Log = Log{}

fn record(v: i32) kills LOG.lines@items {
    LOG.lines.push(v)
}

// At exit each static is dropped and left at its default, in reverse order of declaration
// (spec §7.7): `NOTES`, declared after `REPORT`, is already empty when `REPORT`'s drop reads
// it, and `LOG`, declared before, is still whole.
struct Report {
    pub runs: i32 = 0
}

impl Drop for Report {
    fn drop(&mut self) {
        println!("at exit: {} runs, {} logged, {} notes", runs, LOG.lines.len(), NOTES.lines.len())
    }
}

static REPORT: Report = Report{}
static NOTES: Log = Log{}

fn note(v: i32) kills NOTES.lines@items {
    NOTES.lines.push(v)
}

struct Holder {
    pub p: ^mut Counter = null
}

fn touch() -> i32 {
    return COUNT.bump()
}

fn main() {
    println!("{} {} {} {}", COUNT.hits, COUNT.name, TABLE[2], SCRATCH)
    COUNT.bump()
    COUNT.hits += 10
    TABLE[0] = 9
    SCRATCH = 8
    for &mut t in TABLE {
        t += 1
    }
    let touched = touch()
    println!("{} {}", touched, COUNT.hits)

    // A `&mut` built by a block and stored as a pointer points at the static itself.
    let h = Holder{ p: unsafe { &mut COUNT } }
    let c = unsafe { h.p or return }
    c.hits += 100
    println!("{} {} {} {}", COUNT.hits, TABLE[0], TABLE[3], SCRATCH)
    println!("{} {}", NAMES[1], NAMES.len)
    println!("{} {}", SIGNS[0], SIGNS[1] as char)

    record(4)
    record(5)
    println!("logged {} {}", LOG.lines.len(), LOG.lines[1])

    note(6)
    REPORT.runs = 1
}
