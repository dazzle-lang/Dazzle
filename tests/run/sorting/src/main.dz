// `List::sort`, `List::sort_by` and `List::swap` (spec §14.4): every length up to one past a
// power of two, from seeded random input, checked in order and a permutation of what went
// in; move-only elements dropped exactly once; `String` and `Path` by their bytes.

struct Token {
    pub rank: i32 = 0
}

impl Drop for Token {
    fn drop(&mut self) {
        // A moved-from token is back at its defaults (spec §6.4); only a live one counts.
        if rank != 0 {
            unsafe { DROPS += 1 }
        }
    }
}

static DROPS: i32 = 0

fn descending(a: &i32, b: &i32) -> bool {
    return a > b
}

fn by_rank(a: &Token, b: &Token) -> bool {
    return a.rank < b.rank
}

fn in_order(xs: &List<i32>) -> bool {
    let mut i: usize = 1
    while i < xs.len() {
        if xs[i - 1] > xs[i] {
            return false
        }
        i += 1
    }
    return true
}

fn integers() {
    Random::seed(7)
    let mut all_ok = true
    for n in 0..70 {
        let mut xs = List<i32>()
        let mut sum: i64 = 0
        for _ in 0..n {
            let v = Random::range(-50, 50)
            xs.push(v)
            sum += v as i64
        }
        xs.sort()
        let mut after: i64 = 0
        for x in xs {
            after += x as i64
        }
        all_ok = all_ok && in_order(&xs) && after == sum && xs.len() == n as usize
    }
    println!("random lengths 0..70 sorted: {}", all_ok)

    let mut rev = List<i32>()
    for i in 0..1000 {
        rev.push(1000 - i)
    }
    rev.sort()
    println!("reversed 1000: {} first {} last {}", in_order(&rev), rev[0], rev[999])

    let mut same = List<i32>()
    for i in 0..300 {
        same.push(i % 3)
    }
    same.sort()
    println!("many equal: {}", in_order(&same))

    let mut down = List<i32>()
    for v in [3, 9, 1, 7] {
        down.push(v)
    }
    down.sort_by(descending)
    println!("descending {} {} {} {}", down[0], down[1], down[2], down[3])

    down.swap(0, 3)
    println!("swapped {} {}", down[0], down[3])
}

fn move_only() {
    {
        let mut tokens = List<Token>()
        for r in [5, 2, 8, 1, 9, 3] {
            tokens.push(Token{ rank: r })
        }
        tokens.sort_by(by_rank)
        println!("tokens {} {} {} {} {} {}", tokens[0].rank, tokens[1].rank, tokens[2].rank, tokens[3].rank, tokens[4].rank, tokens[5].rank)
    }
    println!("dropped exactly once: {}", DROPS == 6)
}

fn text() {
    let mut names = List<String>()
    for s in ["zebra", "apple", "émile", "Zulu", "app"] {
        names.push(String(s))
    }
    names.sort()
    println!("strings {} {} {} {} {}", names[0].as_str(), names[1].as_str(), names[2].as_str(), names[3].as_str(), names[4].as_str())

    let mut paths = List<Path>()
    paths.push(Path("b/a.txt"))
    paths.push(Path("a/z.txt"))
    paths.push(Path("a"))
    paths.sort()
    println!("paths {} {} {}", paths[0].as_str(), paths[1].as_str(), paths[2].as_str())
}

fn main() {
    integers()
    move_only()
    text()
}
