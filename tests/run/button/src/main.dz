// M8's criterion (spec §19): the `ButtonState` sample from the user's pre-spec sketches
// (in git history), written in the language as specified. A tagged union whose variants
// name existing structs (§7.5), each state's `update` returning the next state as a
// `ButtonState?` (§9.1), a `switch` in the union's own `step` method (§7.5) that
// dispatches on the active variant and writes through it (§10.3), and every `or` clause
// form a caller reaches for (§9.4–§9.6) around a fallible `!->` load.

enum Sprite {
    Normal
    Selected
}

struct Input {
    pub mouse_down: bool
    pub mouse_up: bool
    pub over: bool
}

// The button owns its state machine, so nothing outside it has to keep the two together:
// a frame is `btn.update(&ctx, &input)`, and the active state is handed the button it
// belongs to.
struct Button {
    pub scale: f32 = 1
    pub sprite: Sprite = Sprite::Normal
    pub presses: i32 = 0
    pub state: ButtonState = .DefaultState{}

    pub fn update(&mut self, ctx: &ButtonCtx, input: &Input) {
        state.step(ctx, input, &mut self)
    }
}

struct ButtonCtx {
    pub delta_time: f32
}

struct DefaultState {
    pub fn update(&self, input: &Input) -> ButtonState? {
        if input.mouse_down && input.over {
            return ButtonState::TransitionState{}
        }
        return none
    }
}

struct TransitionState {
    pub t: f32 = 0

    pub fn update(&mut self, ctx: &ButtonCtx, input: &Input, btn: &mut Button) -> ButtonState? {
        if input.mouse_up {
            btn.scale = 1
            return ButtonState::DefaultState{}
        }
        t += ctx.delta_time
        btn.scale = lerp(1, 2, t)
        if t >= 1 {
            return ButtonState::ChangeSprite{}
        }
        return none
    }
}

struct ChangeSprite {
    pub fn enter(&self, btn: &mut Button) -> ButtonState? {
        btn.sprite = Sprite::Selected
        btn.presses += 1
        btn.scale = 1
        return .DefaultState{}
    }
}

union ButtonState {
    DefaultState
    TransitionState
    ChangeSprite

    // One frame: the active state decides whether there is a next one (spec §7.5).
    pub fn step(&mut self, ctx: &ButtonCtx, input: &Input, btn: &mut Button) {
        let next: ButtonState? = switch self {
            case DefaultState(d) { d.update(input) }
            case TransitionState(&mut t) { t.update(ctx, input, btn) }
            case ChangeSprite(c) { c.enter(btn) }
        }
        self = next or return
    }
}

fn lerp(a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t
}

fn name(s: &ButtonState) -> str {
    return switch s {
        case DefaultState { "default" }
        case TransitionState { "transition" }
        case ChangeSprite { "change" }
    }
}

fn load_delta(frames: i32) !-> f32 {
    if frames <= 0 {
        return error("no frames: {}", frames)
    }
    return 1.0 / frames as f32
}

fn ctx_for(frames: i32) !-> ButtonCtx {
    let dt = load_delta(frames) or return
    return ButtonCtx{ delta_time: dt }
}

fn main() {
    let mut btn = Button{}
    let ctx = ctx_for(4) or ButtonCtx{ delta_time: 0.5 }
    let broken = ctx_for(0) or { e ->
        println("fallback: {}", e.message)
        ButtonCtx{ delta_time: 0.5 }
    }
    println("{} {}", ctx.delta_time, broken.delta_time)

    // Hover, press, hold for four frames, and the sprite changes.
    let held = Input{ mouse_down: true, mouse_up: false, over: true }
    for frame in 0..7 {
        btn.update(&ctx, &held)
        println("{} {} {}", frame, name(&btn.state), btn.scale)
    }

    // Press and let go half way: the transition is abandoned and the scale restored.
    let released = Input{ mouse_down: false, mouse_up: true, over: true }
    btn.update(&ctx, &held)
    btn.update(&ctx, &held)
    println("{} {}", name(&btn.state), btn.scale)
    btn.update(&ctx, &released)
    println("{} {}", name(&btn.state), btn.scale)

    let selected = switch btn.sprite {
        case Normal { false }
        case Selected { true }
    }
    println("{} {}", selected, btn.presses)
}
