// A static whose value, while it is being built, reads the same static has no value to read:
// the program panics, naming it, before `main`'s body runs (spec §7.7, T-0166).

struct Loop {
    pub n: usize

    // `unsafe`: a field's default builds this, and a default may run on any thread, so it
    // cannot be `#[main_thread]` (spec §22.5); a static's is built as the program starts, on
    // the main thread, which the block vouches for.
    pub Loop() {
        n = unsafe { SELF_READ.l.n }
    }
}

struct Cyclic {
    pub l: Loop = Loop()
}

static SELF_READ: Cyclic = Cyclic{}

fn main() {
    println!("never printed: {}", SELF_READ.l.n)
}
