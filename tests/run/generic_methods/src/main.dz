// Generic methods (spec §8.1): type parameters of a method's own, inferred from the
// arguments or written out, on generic and non-generic types, with and without a receiver,
// called from this module and across modules, and from inside other generic code.

import shapes::{ Grid, Tally }

struct Loud {
    pub name: str

    pub fn say(&self) {
        println("loud {}", name)
    }
}

impl Drop for Loud {
    fn drop(&mut self) {
        println("drop {}", name)
    }
}

struct Pair<A: Copy> {
    pub first: A

    /// The type's parameter and the method's side by side.
    pub fn with<B>(&self, second: B) -> (A, B) {
        return (first, move(second))
    }

    /// A generic method calling another generic method on the same value.
    pub fn both<B: Copy>(&self, b: B) -> (A, B) {
        return self.with<B>(b)
    }
}

struct Maker {
    /// A move-only argument is moved in and moved out; it is dropped exactly once.
    pub fn keep<T>(value: T) -> T {
        return move(value)
    }

    pub fn swap<X, Y>(x: X, y: Y) -> (Y, X) {
        return (move(y), move(x))
    }
}

/// A generic function calling a generic method: the method's instance comes from this
/// function's instance.
fn wrap<T: Copy>(v: T) -> (i32, T) {
    let p = Pair<i32>{ first: 1 }
    return p.both(v)
}

fn double(x: i32) -> i32 {
    return x * 2
}

fn sum(acc: i32, c: &i32) -> i32 {
    return acc + c
}

fn longest(acc: usize, c: &str) -> usize {
    return if c.len > acc { c.len } else { acc }
}

fn as_str(b: bool) -> str {
    return if b { "yes" } else { "no" }
}

fn weight_u8(x: u8) -> i32 {
    return x as i32
}

fn main() {
    let p = Pair<f32>{ first: 0.5 }
    let t = p.with(7)
    let u = p.with<bool>(true)
    println("with: {} {} / {} {}", t.0, t.1, u.0, u.1)
    let w = wrap(9)
    let z = wrap<u8>(200)
    println("wrap: {} {} / {} {}", w.0, w.1, z.0, z.1)

    let l = Maker::keep(Loud{ name: "a" })
    l.say()
    let s = Maker::swap<i32, str>(3, "three")
    println("swap: {} {}", s.0, s.1)

    let g = Grid<i32>::filled(4, 3, double)
    println("fold: {}", g.fold(100, sum))
    let names = Grid<str>::filled<bool>(2, true, as_str)
    println("longest: {}", names.fold<usize>(0, longest))

    let mut tally = Tally{}
    let bytes: [3]u8 = [1, 2, 3]
    tally.add_all(bytes[..], weight_u8)
    println("tally: {}", tally.count)
    println("compare: {}", tally.count < 10)
}
