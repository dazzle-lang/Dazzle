// A battle between two teams on the `ecs` library (T-0172): the game creates a world,
// registers its systems and steps it. Each step moves every unit, pushes apart units that
// overlap, lets each unit strike the nearest enemy in range or close in on it, and replaces
// the dead with reinforcements.
//
// Two of the systems are why this benchmark exists. `separate` runs a query inside a query
// over the same storages and writes both units' velocities; `fight` walks positions and
// writes another unit's health. Both write through views that move nothing, which Dazzle
// allows (spec §6.7); a spawn or despawn inside either loop would move a storage, and is
// refused. The C++ half writes the same, unchecked; the Rust half cannot, and collects.

const ARENA: f32 = 800

/// Units closer than this, squared, push each other apart.
const PERSONAL: f32 = 64

const PUSH: f32 = 0.01

/// A unit strikes an enemy closer than this, squared.
const REACH: f32 = 900

const STEER: f32 = 0.0005

const FRICTION: f32 = 0.98

struct Position {
    pub x: f32
    pub y: f32
}

struct Velocity {
    pub x: f32
    pub y: f32
}

struct Team {
    pub side: u32
}

struct Health {
    pub hp: i32
}

/// SplitMix64, as every benchmark here generates its input.
struct Rng {
    pub state: u64

    pub fn next(&mut self) -> u64 {
        state += 0x9E3779B97F4A7C15
        let mut z = state
        z = (z ^^ z >> 30) * 0xBF58476D1CE4E5B9
        z = (z ^^ z >> 27) * 0x94D049BB133111EB
        return z ^^ z >> 31
    }

    /// A number in [0, 1) with 24 bits, so `f32` holds it exactly in every language.
    pub fn unit(&mut self) -> f32 {
        return (self.next() >> 40) as f32 / 16777216
    }

    pub fn below(&mut self, n: u64) -> u64 {
        return self.next() % n
    }
}

fn spawn_unit(world: &mut World, rng: &mut Rng, side: u32) kills world@entities, world@components {
    let e = world.spawn()
    world.insert(e, Position{ x: rng.unit() * ARENA, y: rng.unit() * ARENA })
    world.insert(e, Velocity{ x: rng.unit() - 0.5, y: rng.unit() - 0.5 })
    world.insert(e, Team{ side: side })
    world.insert(e, Health{ hp: 50 + rng.below(50) as i32 })
}

fn bounce(p: &mut f32, v: &mut f32) {
    if p < 0 {
        p = -p
        v = -v
    }
    if p > ARENA {
        p = 2 * ARENA - p
        v = -v
    }
}

fn movement(world: &mut World) {
    for _, &mut p, &mut v in world.query2<Position, Velocity>() {
        v.x *= FRICTION
        v.y *= FRICTION
        p.x += v.x
        p.y += v.y
        bounce(&mut p.x, &mut v.x)
        bounce(&mut p.y, &mut v.y)
    }
}

fn separate(world: &mut World) {
    for a, &pa, &mut va in world.query2<Position, Velocity>() {
        for b, &pb, &mut vb in world.query2<Position, Velocity>() {
            if a.index < b.index {
                let dx = pa.x - pb.x
                let dy = pa.y - pb.y
                let d2 = dx * dx + dy * dy
                if d2 < PERSONAL {
                    let s = (PERSONAL - d2) * PUSH
                    va.x += dx * s
                    va.y += dy * s
                    vb.x -= dx * s
                    vb.y -= dy * s
                }
            }
        }
    }
}

fn fight(world: &mut World) {
    let health = world.storage<Health>()
    let velocity = world.storage<Velocity>()
    for a, &pa, &ta in world.query2<Position, Team>() {
        let mut best: Entity? = none
        let mut best_d2: f32 = 0
        let mut bx: f32 = 0
        let mut by: f32 = 0
        for b, &pb, &tb in world.query2<Position, Team>() {
            if tb.side != ta.side {
                let dx = pb.x - pa.x
                let dy = pb.y - pa.y
                let d2 = dx * dx + dy * dy
                if best == none || d2 < best_d2 {
                    best = b
                    best_d2 = d2
                    bx = dx
                    by = dy
                }
            }
        }
        let target = best or continue
        if best_d2 < REACH {
            let h = health.get_mut(target) or unreachable
            h.hp -= 1
        } else {
            let v = velocity.get_mut(a) or unreachable
            v.x += bx * STEER
            v.y += by * STEER
        }
    }
}

fn reinforce(world: &mut World) kills world@entities, world@components {
    let mut dead = List<Entity>()
    let mut sides = List<u32>()
    for e, &h, &t in world.query2<Health, Team>() {
        if h.hp <= 0 {
            dead.push(e)
            sides.push(t.side)
        }
    }
    let mut rng: Rng = world.resource<Rng>()
    for i in 0..dead.len() {
        world.despawn(dead[i])
        spawn_unit(world, &mut rng, sides[i])
    }
    world.set_resource(rng)
    let fallen = world.resource<Fallen>()
    fallen.count += dead.len() as u64
}

/// How many units have fallen, a resource.
struct Fallen {
    pub count: u64
}

fn main() {
    let args = Process::args()
    let units = if args.len() > 1 {
        args[1].parse_i64() or 600
    } else {
        600
    }
    let steps = if args.len() > 2 {
        args[2].parse_i64() or 100
    } else {
        100
    }

    let mut world = World()
    let mut rng = Rng{ state: 42 }
    for i in 0..units {
        spawn_unit(&mut world, &mut rng, (i % 2) as u32)
    }
    world.set_resource(rng)
    world.set_resource(Fallen{ count: 0 })
    world.add_system(movement)
    world.add_system(separate)
    world.add_system(fight)
    world.add_system(reinforce)
    for _ in 0..steps {
        world.step()
    }

    // Every live unit, in slot order, so all halves fold the same values in the same order.
    let mut checksum: u64 = 1469598103934665603
    let mut alive: u64 = 0
    let mut hp: i64 = 0
    for i in 0..world.slots() {
        let e = world.entity_in(i) or continue
        let p = world.storage<Position>().get(e) or continue
        let h = world.storage<Health>().get(e) or unreachable
        let t = world.storage<Team>().get(e) or unreachable
        for v in [e.index as u64, e.generation as u64, t.side as u64, h.hp as u64, (p.x * 1024) as i64 as u64, (p.y * 1024) as i64 as u64] {
            checksum = (checksum ^^ v) * 1099511628211
        }
        alive += 1
        hp += h.hp as i64
    }
    let fallen = world.resource<Fallen>().count
    println!("{} units, {} steps: {} alive, {} fallen, {} hp", units, steps, alive, fallen, hp)
    println!("checksum {}", checksum)
}
