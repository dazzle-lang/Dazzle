/// Every entity that has an `A`, in the storage's order.
pub view struct Query<A> {
    pub(module) storage: &mut Storage<A>
    row:                 usize = 0

    tie @items = storage
}

impl<A> Iterate for Query<A> {
    type Item = (Entity, &mut A)

    #[inline]
    fn valid(&self) -> bool {
        return row < storage.len()
    }

    #[inline]
    fn get(&self) -> (Entity, &mut A) in self@items {
        return (storage.entity_at(row), storage.value_at(row))
    }

    #[inline]
    fn advance(&mut self) {
        row += 1
    }
}

/// Every entity that has both an `A` and a `B`: the smaller storage walked in order, the
/// other probed by entity. Holds views of both storages, so nothing that could move them may
/// run while it is in use; reading and writing through it moves nothing, so two queries over
/// the same storages may be nested (spec §6.7).
pub view struct Query2<A, B> {
    pub(module) first:      &mut Storage<A>
    pub(module) second:     &mut Storage<B>
    pub(module) scan_first: bool
    /// How many rows the storage walked has: neither storage can change while the query
    /// holds them, since anything that could would end it.
    pub(module) end: usize
    /// The row walked, and what `seek` found there: the entity, and its row in each.
    row:    usize = 0
    entity: Entity = Entity{ index: 0, generation: 0 }
    in_a:   usize = 0
    in_b:   usize = 0

    tie @items = first, second

    /// Move to the first row at or after `row` whose entity the other storage has too.
    #[inline]
    pub(module) fn seek(&mut self) {
        while row < end {
            if scan_first {
                entity = first.entity_at(row)
                if let found = second.row_of(entity) {
                    in_a = row
                    in_b = found
                    return
                }
            } else {
                entity = second.entity_at(row)
                if let found = first.row_of(entity) {
                    in_a = found
                    in_b = row
                    return
                }
            }
            row += 1
        }
    }
}

impl<A, B> Iterate for Query2<A, B> {
    type Item = (Entity, &mut A, &mut B)

    #[inline]
    fn valid(&self) -> bool {
        return row < end
    }

    #[inline]
    fn get(&self) -> (Entity, &mut A, &mut B) in self@items {
        return (entity, first.value_at(in_a), second.value_at(in_b))
    }

    #[inline]
    fn advance(&mut self) {
        row += 1
        self.seek()
    }
}
