/// An entity: a slot and the generation of whatever occupies it, so a key to a despawned
/// entity never names the one that reuses its slot.
pub struct Entity {
    pub index:      u32
    pub generation: u32
}

impl Eq for Entity {
    fn eq(&self, rhs: &Entity) -> bool {
        return index == rhs.index && generation == rhs.generation
    }
}

/// What the world knows of a component's storage without knowing the component's type:
/// enough to take an entity out of it when the entity is despawned.
pub struct AnyStorage {
    pub virtual fn remove(&mut self, _entity: Entity) kills self
}

/// One component type's sparse set: the values packed in a dense array, and for each entity
/// slot the row its value is in, plus one, or zero when it has none.
pub struct Storage<T> : AnyStorage {
    m_sparse:   List<u32> = List<u32>()
    m_entities: List<Entity> = List<Entity>()
    m_values:   List<T> = List<T>()

    tie @items = m_sparse@items, m_entities@items, m_values@items
    tie @values = m_values[*]

    pub fn len(&self) -> usize {
        return m_entities.len()
    }

    pub fn entity_at(&self, row: usize) -> Entity {
        return m_entities[row]
    }

    pub fn value_at(&mut self, row: usize) -> &mut T in self@items {
        return m_values[row]
    }

    /// The row `entity`'s value is in, if it has one.
    pub fn row_of(&self, entity: Entity) -> usize? {
        let index = entity.index as usize
        if index >= m_sparse.len() || m_sparse[index] == 0 {
            return none
        }
        let row = (m_sparse[index] - 1) as usize
        let found: Entity = m_entities[row]
        if found != entity {
            return none
        }
        return row
    }

    pub fn get(&self, entity: Entity) -> ^T in self@items {
        let row = self.row_of(entity) or return null
        return &m_values[row]
    }

    pub fn get_mut(&mut self, entity: Entity) -> ^mut T in self@items {
        let row = self.row_of(entity) or return null
        return &mut m_values[row]
    }

    pub fn insert(&mut self, entity: Entity, value: T) kills self@items sends value to self {
        let index = entity.index as usize
        if index >= m_sparse.len() {
            m_sparse.resize(index + 1)
        }
        m_sparse[index] = (m_entities.len() + 1) as u32
        m_entities.push(entity)
        m_values.push(value)
    }

    pub override fn remove(&mut self, entity: Entity) kills self@items, self@values {
        let row = self.row_of(entity) or return
        let _ = m_values.swap_remove(row)
        let _ = m_entities.swap_remove(row)
        m_sparse[entity.index as usize] = 0
        if row < m_entities.len() {
            m_sparse[m_entities[row].index as usize] = (row + 1) as u32
        }
    }
}
