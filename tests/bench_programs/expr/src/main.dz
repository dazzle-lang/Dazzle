// A tokenizer, parser and evaluator for a small expression language: the Dazzle half of a
// whole-program benchmark (tests/bench_programs/README.md). `main.cpp` beside this folder is
// the same program in C++, and both must print the same checksum.
//
// It generates a program of `let` statements as text, splits it into tokens, parses each
// statement into a tree of `Box`ed nodes, evaluates it against the names defined so far,
// and drops the tree. Some statements fail on purpose — a name never defined, a division
// by zero — and the failure travels back through `!->` and `or return` to the statement
// loop, which counts it and carries on.
//
// What it exercises: `String` building through a `Formatter`, `str` views into it as
// tokens and as `HashMap` keys, a tagged union holding `Box`es (so a tree that owns its
// children and drops them with it), each statement's tree in `Allocators::Temp` and
// released at once before the next, recursion, and the error path.
//
// Usage: expr [statements]

/// SplitMix64, written out so the C++ half generates exactly the same program.
struct Rng {
    m_state: u64 = 0

    Rng(seed: u64) {
        m_state = seed
    }

    pub fn next(&mut self) -> u64 {
        m_state += 0x9E3779B97F4A7C15
        let mut z = m_state
        z = (z ^^ z >> 30) * 0xBF58476D1CE4E5B9
        z = (z ^^ z >> 27) * 0x94D049BB133111EB
        return z ^^ z >> 31
    }

    pub fn below(&mut self, n: u64) -> u64 {
        return self.next() % n
    }
}

// --- generating the program ------------------------------------------------------------

// Weighted: division is rarer than the rest, as it is in real arithmetic, and as it must be
// here — integer division of two unrelated values is zero half the time, which then divides.
const OPERATORS: [8]u8 = ['+' as u8, '+' as u8, '-' as u8, '-' as u8, '*' as u8, '*' as u8, '/' as u8, '%' as u8]

fn precedence(op: u8) -> i32 {
    return if op == '+' as u8 || op == '-' as u8 {
        1
    } else {
        2
    }
}

/// Write an expression `depth` levels deep at most, for statement `index`. `context` is the
/// least precedence it may have without parentheses, so the text means the tree it was
/// generated as.
fn generate_expr(f: &mut Formatter, rng: &mut Rng, index: i64, depth: i32, context: i32) {
    if depth == 0 || rng.below(4) == 0 {
        let pick = rng.below(1000)
        if pick < 600 || index == 0 {
            rng.below(1000).format(f)
        } else if pick < 998 {
            let back = rng.below(if index < 50 {
                index as u64
            } else {
                50
            }) as i64
            f.write_char('v')
            (index - 1 - back).format(f)
        } else {
            // A name no statement defines: evaluating this fails.
            f.write_char('u')
            rng.below(100).format(f)
        }
        return
    }
    if rng.below(10) == 0 {
        f.write_char('-')
        generate_expr(f, rng, index, depth - 1, 3)
        return
    }
    let op = OPERATORS[rng.below(8) as usize]
    let p = precedence(op)
    let wrap = p < context || rng.below(10) == 0
    if wrap {
        f.write_char('(')
    }
    generate_expr(f, rng, index, depth - 1, p)
    f.write_char(' ')
    f.write_char(op as char)
    f.write_char(' ')
    generate_expr(f, rng, index, depth - 1, p + 1)
    if wrap {
        f.write_char(')')
    }
}

fn generate(statements: i64) -> String {
    let mut rng = Rng(7)
    let mut text = String()
    let mut f = Formatter::string(&mut text)
    for i in 0..statements {
        f.write_str("let v")
        i.format(&mut f)
        f.write_str(" = ")
        generate_expr(&mut f, &mut rng, i, 5, 0)
        f.write_char('\n')
    }
    return move(text)
}

// --- tokens ------------------------------------------------------------------------------

enum Kind : u8 {
    Number
    Name
    Let
    Assign
    Operator
    Open
    Close
    End
}

struct Token {
    pub kind: Kind = Kind::End
    /// The token's text: a view of the program, never a copy.
    pub text:  str = ""
    pub value: i64 = 0
}

pub enum Failure : u32 {
    Syntax = 1
    UnknownName
    DivideByZero
}

fn is_digit(c: u8) -> bool {
    return c >= '0' as u8 && c <= '9' as u8
}

fn is_letter(c: u8) -> bool {
    return c >= 'a' as u8 && c <= 'z' as u8 || c >= 'A' as u8 && c <= 'Z' as u8 || c == '_' as u8
}

fn tokenize(source: &String) !-> List<Token> {
    let bytes = source.as_str() as []u8
    let mut tokens = List<Token>()
    let mut i: usize = 0
    while i < bytes.len {
        let c = bytes[i]
        if c == ' ' as u8 {
            i += 1
            continue
        }
        let start = i
        if is_digit(c) {
            let mut value: i64 = 0
            while i < bytes.len && is_digit(bytes[i]) {
                value = value * 10 + (bytes[i] - '0' as u8) as i64
                i += 1
            }
            tokens.push(Token{ kind: .Number, text: source.slice(start, i) or unreachable, value: value })
            continue
        }
        if is_letter(c) {
            while i < bytes.len && (is_letter(bytes[i]) || is_digit(bytes[i])) {
                i += 1
            }
            let word = source.slice(start, i) or unreachable
            let kind = if word == "let" {
                Kind::Let
            } else {
                Kind::Name
            }
            tokens.push(Token{ kind: kind, text: word })
            continue
        }
        i += 1
        let kind = switch c as char {
            case '\n' {
                Kind::End
            }
            case '=' {
                Kind::Assign
            }
            case '(' {
                Kind::Open
            }
            case ')' {
                Kind::Close
            }
            case '+', '-', '*', '/', '%' {
                Kind::Operator
            }
            default {
                return error(Failure::Syntax, "unexpected character")
            }
        }
        tokens.push(Token{ kind: kind, text: source.slice(start, i) or unreachable })
    }
    return move(tokens)
}

// --- the tree ------------------------------------------------------------------------

union Expr {
    Number { value: i64 }
    Name { text: str }
    Negate { inner: Box<Expr> }
    Binary { op: u8, lhs: Box<Expr>, rhs: Box<Expr> }
}

/// A recursive-descent parser over one statement's tokens.
struct Parser {
    m_tokens: []Token
    m_at:     usize = 0
    /// Where the tree's nodes go.
    m_allocator: ^mut Allocator = Allocators::Global

    Parser(tokens: []Token, allocator: ^mut Allocator) {
        m_tokens = tokens
        m_allocator = allocator
    }

    fn peek(&self) -> Kind {
        return if m_at < m_tokens.len {
            m_tokens[m_at].kind
        } else {
            Kind::End
        }
    }

    fn peek_operator(&self, a: u8, b: u8, c: u8) -> u8? {
        if self.peek() != Kind::Operator {
            return none
        }
        let op = (m_tokens[m_at].text as []u8)[0]
        if op == a || op == b || op == c {
            return op
        }
        return none
    }

    fn expect(&mut self, kind: Kind) !-> Token {
        if self.peek() != kind {
            return error(Failure::Syntax, "unexpected token")
        }
        m_at += 1
        return m_tokens[m_at - 1]
    }

    /// `let name = expr`, then the end of the line.
    pub fn statement(&mut self) !-> (str, Expr) {
        let _ = self.expect(.Let) or return
        let name = self.expect(.Name) or return
        let _ = self.expect(.Assign) or return
        let value = self.expr() or return
        let _ = self.expect(.End) or return
        return (name.text, move(value))
    }

    fn expr(&mut self) !-> Expr {
        let mut lhs = self.term() or return
        while true {
            let op = self.peek_operator('+' as u8, '-' as u8, '-' as u8) or break
            m_at += 1
            let rhs = self.term() or return
            lhs = Expr::Binary{
                op: op,
                lhs: Box<Expr>(move(lhs), m_allocator),
                rhs: Box<Expr>(move(rhs), m_allocator),
            }
        }
        return move(lhs)
    }

    fn term(&mut self) !-> Expr {
        let mut lhs = self.unary() or return
        while true {
            let op = self.peek_operator('*' as u8, '/' as u8, '%' as u8) or break
            m_at += 1
            let rhs = self.unary() or return
            lhs = Expr::Binary{
                op: op,
                lhs: Box<Expr>(move(lhs), m_allocator),
                rhs: Box<Expr>(move(rhs), m_allocator),
            }
        }
        return move(lhs)
    }

    fn unary(&mut self) !-> Expr {
        if self.peek_operator('-' as u8, '-' as u8, '-' as u8) != none {
            m_at += 1
            let inner = self.unary() or return
            return Expr::Negate{ inner: Box<Expr>(move(inner), m_allocator) }
        }
        return self.primary() or return
    }

    fn primary(&mut self) !-> Expr {
        switch self.peek() {
            case Number {
                m_at += 1
                return Expr::Number{ value: m_tokens[m_at - 1].value }
            }
            case Name {
                m_at += 1
                return Expr::Name{ text: m_tokens[m_at - 1].text }
            }
            case Open {
                m_at += 1
                let inner = self.expr() or return
                let _ = self.expect(.Close) or return
                return move(inner)
            }
            default {
                return error(Failure::Syntax, "expected a number, a name or `(`")
            }
        }
    }
}

// --- evaluating ------------------------------------------------------------------------

/// Every result is reduced by this, so no value overflows and both halves agree exactly.
const MODULUS: i64 = 1000003

fn eval(e: &Expr, names: &HashMap<str, i64>) !-> i64 {
    switch e {
        case Number(&n) {
            return n.value
        }
        case Name(&n) {
            let value = names.get(&n.text) or return error(Failure::UnknownName, "unknown name")
            return value
        }
        case Negate(&n) {
            let inner = n.inner or unreachable
            return -(eval(inner, names) or return)
        }
        case Binary(&b) {
            let lhs = eval(b.lhs or unreachable, names) or return
            let rhs = eval(b.rhs or unreachable, names) or return
            let op = b.op as char
            if (op == '/' || op == '%') && rhs == 0 {
                return error(Failure::DivideByZero, "division by zero")
            }
            let value = switch op {
                case '+' {
                    lhs + rhs
                }
                case '-' {
                    lhs - rhs
                }
                case '*' {
                    lhs * rhs
                }
                case '/' {
                    lhs / rhs
                }
                default {
                    lhs % rhs
                }
            }
            return value % MODULUS
        }
    }
}

fn main() {
    let args = Process::args()
    let statements = if args.len() > 1 {
        args[1].parse_i64() or 100000
    } else {
        100000
    }

    let program = generate(statements)
    let tokens = tokenize(&program) or { e ->
        panic!("{}", e.message)
    }
    let all = tokens.as_slice()

    let mut names = HashMap<str, i64>()
    let mut checksum: u64 = 0
    let mut failures: [4]i64
    let mut start: usize = 0
    while start < all.len {
        // One statement is the tokens up to and including the end of its line.
        let mut end = start
        while end < all.len && all[end].kind != Kind::End {
            end += 1
        }
        end = if end < all.len {
            end + 1
        } else {
            end
        }
        // The previous statement's tree was dropped at the end of the last iteration; its
        // nodes are given back all at once, and this one's are bumped out of the same memory.
        Allocators::Temp.reset()
        let mut parser = Parser(all[start..end], Allocators::Temp)
        start = end

        let (name, tree) = parser.statement() or { e ->
            failures[e.code as usize] += 1
            checksum = checksum * 31 + e.code as u64
            continue
        }
        // A statement that fails still defines its name, as one, so one failure does not
        // make every statement that mentions it fail too.
        let value = eval(&tree, &names) or { e ->
            failures[e.code as usize] += 1
            checksum = checksum * 31 + e.code as u64
            1
        }
        names.insert(name, value)
        checksum = checksum * 31 + value as u64
    }
    println!("{} bytes, {} tokens, {} names, {} unknown-name, {} divide-by-zero, {} syntax", program.len(), all.len, names.len(), failures[2], failures[3], failures[1])
    println!("checksum {}", checksum)
}
