// Everything here must type-check. It is the counterweight to typeerrors/: a checker
// that rejects valid code is as broken as one that accepts invalid code.

pub const MAX: i32 = 4096
pub const PI = 3.14159
pub const NAME = "dazzle"

pub enum Layer : u16 {
    Background = 0
    World
    Ui = 300
}

pub union Shape {
    Circle { radius: f32 }
    Rect { w: f32, h: f32 }
    Point {}
}

pub struct Vec3 {
    pub x: f32
    pub y: f32
    pub z: f32 = 0

    pub fn length_squared(&self) -> f32 {
        return x * x + y * y + z * z
    }
}

pub struct Counter {
    m_count:    u32
    pub(module) shared: u32
    pub label:  const str
    pub origin: Vec3
    pub cursor: ^Vec3 = null

    Counter(start: u32, label: str = "counter") {
        m_count = start
        shared = 0
    }

    pub fn get(&self) -> u32 {
        return m_count
    }

    pub fn bump(&mut self) {
        m_count += 1
        shared += 1
        origin.x += 1
    }

    pub fn set_from(&mut self, other: &Counter) {
        m_count = other.m_count
    }
}

fn literals_take_their_context() {
    let a: u8 = 255
    let b: i64 = 9_000_000_000
    let c: f32 = 1
    let d: f64 = 2.5
    let e = 0xFF
    let f = 'x'
    let g = true
    let h: usize = 0
}

fn explicit_casts(n: i32, layer: Layer) {
    let wide = n as i64
    let narrow = n as u8
    let f = n as f32
    let tag = layer as u16
    let c = 65 as char
}

fn arithmetic(a: f32, b: f32) -> f32 {
    return (a + b) * 2 - a / b
}

fn comparisons(a: i32, b: i32) -> bool {
    return a < b && a != b || a >= 0
}

fn bitwise(flags: u32, mask: u32) -> u32 {
    return flags & mask | (flags ^^ mask) << 2 >> 1
}

fn defaults_are_optional() -> Counter {
    let c1 = Counter(0)
    let c2 = Counter(0, "named")
    return c2
}

fn struct_literals() -> Vec3 {
    let named = Vec3{ x: 1, y: 2, z: 3 }
    let positional = Vec3{ 1, 2, 3 }
    // `z` has a default, so it may be omitted (spec §6.2).
    let partial = Vec3{ x: 1, y: 2 }
    return partial
}

fn default_initialisation() -> Counter {
    // Every value is initialised, so this is a complete object (spec §6.2).
    let c: Counter
    return c
}

fn mutation() {
    let mut c = Counter(0)
    c.bump()
    c.set_from(&c)
}

fn pointers(v: ^Vec3) -> f32 {
    // `.` reaches through pointers on its own (spec §5.2) — inside `unsafe`, since nothing
    // checks that `v` still points at a `Vec3`.
    unsafe {
        let a = v.x
        let whole = v^
        return a + whole.y
    }
}

fn references(v: &Vec3, w: &mut Vec3) -> f32 {
    w.x = 1
    return v.x + w.y
}

fn arrays_and_slices(fixed: [4]i32, slice: []i32) -> i32 {
    let a = fixed[0]
    let b = slice[1]
    let n = slice.len
    return a + b
}

// A slice carries its writability in its type, so `[]mut T` may be written through no
// matter how the slice itself is bound — it is a view, and the binding governs the view
// and not the elements (spec §5.3, §18.22).
fn fill(dst: []mut i32, value: i32) {
    for i in 0..dst.len {
        dst[i] = value
    }
}

// ...and `[]mut T` satisfies `[]T`, exactly as `&mut T` satisfies `&T`.
fn sum(xs: []i32) -> i32 {
    let mut total = 0
    for x in xs {
        total += x
    }
    return total
}

fn fill_then_sum() -> i32 {
    // `let mut`, because viewing an array as `[]mut i32` hands out writes to it. No
    // initialiser: an array is default-initialised like everything else (spec §6.2).
    let mut storage: [4]i32
    fill(storage, 7)
    return sum(storage)
}

fn ranges(count: i32) -> i32 {
    let mut total = 0
    for i in 0..count {
        total += i
    }
    for i in 0..=count {
        total += i
    }
    return total
}

fn iterating(items: []Vec3) -> f32 {
    // Annotated `f32`: an unannotated `0.0` would be `f64` (spec §2.5) and then adding an
    // `f32` field would be an error, because there are no implicit conversions.
    let mut total: f32 = 0
    for v in items {
        total += v.x
    }
    for i, v in items.indexed() {
        total += v.y
    }
    return total
}

fn switching(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return 1
        }
        case Rect(r) {
            return 2
        }
        case Point {
            return 0
        }
    }
}

fn switching_with_default(l: Layer) -> i32 {
    switch l {
        case World {
            return 1
        }
        default {
            return 0
        }
    }
}

fn may_fail(n: i32) !-> i32 {
    if n < 0 {
        return error("negative")
    }
    return n
}

fn maybe_find(n: i32) -> i32? {
    if n < 0 {
        return none
    }
    return n
}

fn find_ptr(xs: []i32) -> ^i32 {
    return null
}

fn propagates() !-> i32 {
    // Bare `or return` propagates, and the signature can carry it (spec §9.5).
    let a = may_fail(1) or return
    return a
}

fn propagates_optional() -> i32? {
    let a = maybe_find(1) or return
    return a
}

fn handles() -> i32 {
    let v = may_fail(1) or { e ->
        return 0
    }
    return v
}

fn handles_a_block_without_binding() -> i32 {
    let v = maybe_find(1) or {
        return 0
    }
    return v
}

fn falls_back() -> i32 {
    let a = may_fail(1) or 0
    let b = maybe_find(1) or 0
    let c = may_fail(1) or { e ->
        0
    }
    return a + b + c
}

fn ignored_deliberately() {
    may_fail(1) or ignore
}

/// `^T` → `&T` goes through an `or` clause, because a pointer may be null (spec §5.2).
fn takes_ref(x: &i32) -> i32 {
    return 0
}

fn checks_a_pointer(xs: []i32) -> i32 {
    let a = find_ptr(xs) or return 0
    return takes_ref(a)
}

fn asserts_a_pointer(xs: []i32) -> i32 {
    let a = find_ptr(xs) or unreachable
    return takes_ref(a)
}

fn expression_forms(ready: bool) -> i32 {
    let x = if ready { 1 } else { 2 }
    let y = maybe_find(1) or 0
    return x + y
}

fn tuples() -> i32 {
    let pair: (i32, f32) = (1, 2.0)
    let (a, b) = pair
    return a
}

fn shadowing_in_inner_scope() -> i32 {
    let x = 1
    {
        let x = 2
        return x
    }
}

fn deferred() {
    let mut c = Counter(0)
    defer c.bump()
    c.bump()
}

// --- M5: ownership and the shapes it unblocked (spec §6, §7.5, §9.2) --------

// §6.1: at most one of each special member, and both are optional.
pub struct Owner {
    m_slot: own ^mut i32
    pub tag: i32

    Owner(slot: ^mut i32) {
        m_slot = slot
    }

    pub fn live(&self) -> bool {
        return m_slot != null
    }
}

// §6.5: an `own` field obliges the struct to release it.
impl Drop for Owner {
    fn drop(&mut self) {
        if m_slot != null {
            unsafe { m_slot^ = 0 }
        }
    }
}

pub struct Copyable {
    pub n: i32
}

impl Copy for Copyable {
    fn copy(&mut self, other: &Self) {
        n = other.n
    }
}

impl Drop for Copyable {
    fn drop(&mut self) {}
}

fn consumes(o: Owner) -> bool {
    return o.live()
}

// §6.4: `move` transfers ownership, and the source is not read again.
fn moving(slot: ^mut i32) -> bool {
    let o = Owner(slot)
    return consumes(move(o))
}

// §6.3: a type with a `copy` needs no `move` at all.
fn copying(c: Copyable) -> i32 {
    let a = c
    return a.n + c.n
}

// §7.5: a union variant is constructed with its own field list, and `case` binds it.
fn union_values() -> f32 {
    let c = Shape::Circle{ radius: 2 }
    let r = Shape::Rect{ w: 1, h: 2 }
    let p = Shape::Point
    return switching(c) + switching(r) + switching(p)
}

// §7.3: `.Variant` infers the union from the expected type.
fn inferred_variant() -> Shape {
    let s: Shape = .Circle{ radius: 1 }
    return s
}

// §10.3: an integer, a `char`, a `bool` or a `str` is matched against constants, with no
// exhaustiveness required.
const SWITCH_LIMIT = 10

fn switch_on_constants(n: i32, s: str, c: char) -> i32 {
    let a = switch n {
        case 0 { 1 }
        case 1, 2, SWITCH_LIMIT, SWITCH_LIMIT * 2 { 2 }
        case -1 { 3 }
        default { 0 }
    }
    switch s {
        case "idle" { return a }
    }
    switch c {
        case 'x', 'y' { return 1 }
        default {}
    }
    return a
}

// §7.5, §8.4: a generic union, its variants built with and without arguments written, and
// a `case` binding read through the instance.
union Choice<T> {
    One { value: T }
    Neither {}
}

fn generic_union(fallback: i32) -> i32 {
    let a = Choice<i32>::One{ value: 1 }
    let b: Choice<i32> = Choice::Neither
    let c: Choice<i32> = .One{ value: 2 }
    let total: i32 = switch a {
        case One(o) { o.value }
        case Neither { fallback }
    }
    switch b {
        case One(o) { return o.value + total }
        default {}
    }
    switch c {
        case One(o) { return o.value }
        default { return total }
    }
}

// §9.2: the `Error` an `or` block binds is a real struct with real fields.
fn reads_the_error() -> i32 {
    return may_fail(1) or { e ->
        // `location` is a `&SourceLocation` into static storage, read directly (§9.2).
        let where_from = e.location.line
        e.code as i32 + where_from as i32
    }
}

// --- M6: generics and traits (spec §7.6, §8) --------------------------------

// A trait of one's own, alongside the prelude's. `Weigh : Describe` means every `Weigh` is
// a `Describe`, and conformance is checked at the declaration below.
trait Describe {
    fn describe(&self) -> const str
}

trait Weigh : Describe {
    fn weight(&self) -> i32

    // A default method: implementers need not supply it (spec §7.6).
    fn heavy(&self) -> bool {
        return self.weight() > 100
    }
}

struct Crate {
    m_weight: i32

    Crate(w: i32) {
        m_weight = w
    }
}

impl Describe for Crate {
    fn describe(&self) -> const str {
        return "crate"
    }
}

impl Weigh for Crate {
    fn weight(&self) -> i32 {
        return m_weight
    }
}

// §8.1: the body is checked once, against `T: Weigh` and nothing else. `weight` is legal
// because `Weigh` provides it; `describe` is legal because `Weigh : Describe` does.
fn heaviest<T: Weigh>(a: T, b: T) -> const str {
    if a.weight() > b.weight() {
        return a.describe()
    }
    return b.describe()
}

fn uses_heaviest() -> const str {
    return heaviest(Crate(3), Crate(7))
}

// §8.2: an unbounded `T` supports being moved, default-initialised and dropped, which
// is exactly enough for a container.
struct Pair<T> {
    m_first:  T
    m_second: T

    pub fn first(&self) -> &T {
        return &m_first
    }
}

// §8.4: a member of an instantiation has the instantiated type — `first()` returns `&i32`
// here, from the `&T` the declaration wrote, which is why `takes_ref` accepts it.
fn reads_an_instantiation(p: &Pair<i32>) -> i32 {
    return takes_ref(p.first())
}

// Array literals (spec §5.3): the length is exactly what is written, elements take the
// annotation's element type, and struct literals are legal inside the brackets.
fn array_literals() -> f32 {
    let a = [1, 2, 3]
    let b: [4]f32 = [1, 2, 3, 4]
    let grid = [[1, 2], [3, 4]]
    let vs = [Vec3{ x: 1, y: 2, z: 3 }, Vec3{ 4, 5, 6 }]
    let empty: [0]i32 = []
    let wrapped = [
        1,
        2,
    ]
    return b[0] + vs[1].y + grid[0][1] as f32 + a[0] as f32 + wrapped[0] as f32
}

// A literal may be *passed* where a slice is wanted — the temporary outlives the call —
// even though it may not be stored as one (spec §5.3).
fn a_literal_may_be_passed_as_a_slice() -> i32 {
    return sum([1, 2, 3])
}

// §7.4: a variant may be written `.Left` wherever the enum is already known, on either
// side of a comparison, and `Layer::World` always works.
fn enum_variants_without_naming_the_type(l: Layer) -> bool {
    let a: Layer = .World
    let b = Layer::Ui
    if .Background == l {
        return true
    }
    return a == .World && l == b
}

// --- M6: the prelude and operator traits (spec §3.2, §11.2, §18.23) ---------

// No import: `Ord`, `Eq`, `Ordering`, `Add` and `Mul` all come from the prelude.
pub struct Score {
    pub value: i32
}

impl Eq for Score {
    fn eq(&self, rhs: &Score) -> bool {
        return value == rhs.value
    }
}

impl Ord for Score {
    fn cmp(&self, rhs: &Score) -> Ordering {
        if value < rhs.value {
            return .Less
        }
        if value > rhs.value {
            return .Greater
        }
        return .Equal
    }
}

// §11.2: all six comparison operators come from `eq` and `cmp`.
fn comparing_a_user_type(a: Score, b: Score) -> bool {
    return a == b || a != b && a < b && a > b && a <= b && a >= b
}

// `Rhs` defaults to `Self`, so `Add` alone is `Vec2 + Vec2`; `Mul<f32>` is `Vec2 * f32`.
pub struct Vec2 {
    pub x: f32
    pub y: f32
}

impl Add for Vec2 {
    type Output = Vec2

    fn add(&self, rhs: Vec2) -> Vec2 {
        return Vec2{ x: x + rhs.x, y: y + rhs.y }
    }
}

impl Mul<f32> for Vec2 {
    type Output = Vec2

    fn mul(&self, rhs: f32) -> Vec2 {
        return Vec2{ x: x * rhs, y: y * rhs }
    }
}

// §11.2: the expression a game language must have.
fn vector_arithmetic(a: Vec2, b: Vec2) -> Vec2 {
    return a + b * 3
}

// `std::Ord` names the same trait through the standard library's key (spec §3.2).
// `T` may be move-only, so returning one is written `move` exactly as it would be for any
// move-only type (spec §6.3, §8.2): a generic body is checked for every `T` at once.
fn largest<T: std::Ord>(a: T, b: T) -> T {
    if a > b {
        return move(a)
    }
    return move(b)
}

// §11.2: the machine's own types satisfy the operator traits, so §8.1's own example
// works on numbers.
fn primitives_satisfy_the_operator_traits() -> i32 {
    return largest(3, 9)
}

// --- M6: compile-time queries, constants, formatting, iteration ------------

// §5.5: every type answers these, and `sizeof(T)` is `T::size`.
fn queries<T>(x: &T) -> usize {
    if T::is_trivially_copyable && !T::has_drop {
        return sizeof(T) + T::align
    }
    return i32::size + Vec3::align
}

// §5.3, §8.3: array lengths and un-annotated constants fold at compile time.
const ROWS = 4
const CELLS = ROWS * ROWS + 1

fn folded() -> usize {
    let g: [CELLS]u8
    return g.len
}

// §12.9: the format string is parsed at compile time.
fn formatting(x: i32, f: f32) {
    println!("{} {:x} {:X} {:.3} {{literal}}", x, x, x, f)
}

// §12.9: a width suits anything; a zero fill a number, before `x`, `X` or `.N` too.
fn widths<T: Format>(x: i32, f: f32, s: str, t: T) {
    println!("{:8} {:08} {:8x} {:08X} {:10.3} {:010.3}", x, x, x, x, f, f)
    println!("{:12} {:5} {:3} {:6}", s, true, 'c', t)
}

// §8.5, §10.4: any type implementing `Iterate` works in `for`.
struct Upto {
    pub i: i32
    pub n: i32
}

impl Iterate for Upto {
    type Item = i32

    fn valid(&self) -> bool {
        return i < n
    }

    fn get(&self) -> i32 {
        return i
    }

    fn advance(&mut self) {
        i += 1
    }
}

fn iterating_a_user_type() -> i32 {
    // Bound first: a struct literal cannot sit in a `for` head, where `{` opens the body.
    let upto = Upto{ i: 0, n: 3 }
    let mut total = 0
    for v in upto {
        total += v
    }
    return total
}

// §7.6: a default method is callable on a type that inherits it rather than writing it.
fn inherited(c: Crate) -> bool {
    return c.heavy()
}

// --- r12 ------------------------------------------------------------------------------

// §5.2: an `unsafe fn` may touch raw memory in its body, and is called from `unsafe`.
unsafe fn poke(p: ^mut i32, v: i32) {
    p^ = v
}

// §5.2: forming, copying and comparing a pointer are all safe; only using one is not.
fn pointer_rules(p: ^mut i32) -> bool {
    let q = p
    if q == null {
        return false
    }
    unsafe { poke(q, 3) }
    return true
}

// §5.2: `p or …` checks for null once, and the reference it gives may be written through
// when the pointer may.
fn checked_pointer(v: ^mut Vec3) -> f32 {
    let r = v or return 0.0
    r.x = 2.0
    return r.x
}

// §5.3: `.ptr` is the unchecked way into a view; forming it is safe.
fn unchecked(xs: []mut i32) -> i32 {
    let raw = xs.ptr
    let mut n = 0
    unsafe {
        raw[0] = 1
        n = raw[0]
    }
    return n
}

// --- r21: making a `cstr` (spec §5.3, §18.39) --------------------------------------------

fn takes_cstr(s: cstr) -> cstr {
    return s
}

// A string literal is a `cstr` wherever one is wanted, and `as` says so explicitly; a
// `cstr` is measured into a `str` with `as`.
fn cstr_from_literals() -> usize {
    let a: cstr = "annotated"
    let b = "cast" as cstr
    let c = takes_cstr("argument")
    let _ = a
    let _ = b
    return (c as str).len
}

// --- r18: `^T` and `^mut T` (spec §5.2, §18.37) ----------------------------------------

// A shared reference forms a read-only pointer, and a writable pointer widens to one.
fn read_only_pointers(v: &Vec3, w: ^mut Vec3) -> f32 {
    let p: ^Vec3 = v
    let q: ^Vec3 = w
    let mut total: f32 = 0
    unsafe { total = p.x + q.x }
    return total
}

// A read-only view's `.ptr` is a `^T`, which reads.
fn read_only_ptr(xs: []i32) -> i32 {
    let raw: ^i32 = xs.ptr
    let mut n = 0
    unsafe { n = raw[0] }
    return n
}

// `or` on a `^T` gives a `&T`; through a read-only pointer's pointee the pointer may widen.
fn read_through(p: ^Vec3, pp: ^^mut Vec3) -> f32 {
    let r = p or return 0.0
    let widened: ^^Vec3 = pp
    return r.x
}

// §8.2: a `T: Copy` may be copied, where an unbounded `T` is move-only.
fn twice<T: Copy>(x: T) -> (T, T) {
    return (x, x)
}

fn copies() -> i32 {
    let t = twice(4)
    return t.0 + t.1
}

// §18.27: one operator trait at two arguments, one implementation each.
pub struct Scale {
    pub k: f32
}

impl Mul<f32> for Scale {
    type Output = Scale

    fn mul(&self, rhs: f32) -> Scale {
        return Scale{ k: k * rhs }
    }
}

// §18.29: each implementation chooses its own `Output` — a `Scale` times a `Scale` is a
// plain `f32` here, while a `Scale` times an `f32` is a `Scale`.
impl Mul<Scale> for Scale {
    type Output = f32

    fn mul(&self, rhs: Scale) -> f32 {
        return k * rhs.k
    }
}

// §8.1, §18.27: through a bound at two arguments too, the first argument picks the method —
// whichever of the two bounds is written first.
fn scale_by_both<T: Mul<Scale> + Mul<f32>>(a: &T) {
    let _ = a.mul(2.0)
    let _ = a.mul(Scale{ k: 2.0 })
}

fn scale_by_both_flipped<T: Mul<f32> + Mul<Scale>>(a: &T) {
    let _ = a.mul(Scale{ k: 2.0 })
    let _ = a.mul(2.0)
}

// §7.6: a trait of this module implemented for a type this program did not write.
trait Label {
    fn label(&self) -> const str

    fn shout(&self) -> const str {
        return self.label()
    }
}

impl Label for f32 {
    fn label(&self) -> const str {
        return "a float"
    }
}

// `Label::shout` is a default, reached through `impl Label for f32`; naming the trait is
// needed only because `Loud` below provides a `shout` too.
fn labels(x: f32) -> const str {
    return Label::shout(&x)
}

// §7.6: a generic implementation, applying to every `Wrap<T>` whose `T` is `Label`.
pub struct Wrap<T> {
    pub inner: T
}

impl<T: Label> Label for Wrap<T> {
    fn label(&self) -> const str {
        return inner.label()
    }
}

fn wrapped(w: Wrap<f32>) -> const str {
    return w.label()
}

// §7.6: two traits both provide `shout`, so the call names the one it means.
trait Loud {
    fn shout(&self) -> const str
}

impl Loud for f32 {
    fn shout(&self) -> const str {
        return "LOUD"
    }
}

fn chooses(x: f32) -> const str {
    return Loud::shout(&x)
}

// §6.1, §8.2: an `impl Copy` that applies only where its bound holds.
pub struct Held<T> {
    m_item: own ^T
}

impl<T> Drop for Held<T> {
    fn drop(&mut self) {}
}

impl<T: Copy> Copy for Held<T> {
    fn copy(&mut self, other: &Self) {
        m_item = null
    }
}

fn copies_where_it_may(h: Held<i32>) -> Held<i32> {
    let again = h
    return again
}

fn overloads(s: Scale) -> f32 {
    let a = s * 2.0
    let b = s * s
    let c = s.mul(3.0)
    return a.k + b + c.k
}

// §5.2, §18.35: a `&T` reads as a `T` wherever a `T` is wanted, when `T` is copyable.
fn copies_out_of_a_reference(v: &Vec3) -> Vec3 {
    return v
}

fn reference_where_a_value_is_wanted(v: &mut Vec3) -> f32 {
    let copy: Vec3 = v
    let r = v
    return by_value(r) + copy.length_squared()
}

fn by_value(v: Vec3) -> f32 {
    return v.length_squared()
}

fn generic_copy_out_of_a_reference<T: Copy>(r: &T) -> T {
    return r
}

// §9: comparing an optional with `none` asks whether it is empty, from either side.
fn optional_presence(v: i32?) -> bool {
    return v == none || none != v
}

// §9.4: `if let` binds what `or` would produce, in the first block only.
fn if_let_forms(o: i32?, p: ^mut Vec3) -> f32 {
    if let mut n = o {
        n += 1
    } else if let &mut v = p {
        v.x = 1
    }
    let got = if let v = p { v.x } else { 0 }
    return got
}

// §9.4, §14.5, 18.61–18.62: a handle is `null`, tested with `==`, and reached by `or` and by
// each `if let` binding; `if let` takes a `Weak` directly, and reads through a `&T?`.
fn handle_forms(shared: &mut Rc<Vec3>, o: &i32?) -> f32 {
    let watch = Weak<Vec3>(shared)
    let mut spare: Box<Vec3> = null
    if spare == null {
        spare = Box<Vec3>(Vec3{ x: 1, y: 2 })
    }
    if let &mut v = shared {
        v.x += 1
    }
    let mut total: f32 = 0.0
    if let v = watch {
        total += v.x
    } else if let &b = spare {
        total += b.x
    }
    if let n = o {
        total += n as f32
    }
    let v = shared or return total
    return v.x + total + (o or 0) as f32
}

// §7.3, 18.32: struct inheritance. The base's fields come first, so a `&Derived` is a
// `&Base` and a `^Derived` a `^Base`; a base's fields and methods are the derived type's,
// in scope unqualified inside its methods exactly as its own are.
pub struct Widget {
    pub left: i32 = 0
    pub top: i32 = 0

    pub fn origin(&self) -> i32 {
        return left + top
    }
}

pub struct Panel : Widget {
    pub title: cstr = ""

    pub fn area(&self) -> i32 {
        return left * top
    }
}

// A chain of three: `Dialog` holds `Widget`'s fields, then `Panel`'s, then its own.
pub struct Dialog : Panel {
    pub modal: bool = false
}

fn base_reference_from_a_derived_one(p: &Panel, d: &Dialog) -> i32 {
    return reads_a_widget(p) + reads_a_widget(d)
}

fn reads_a_widget(w: &Widget) -> i32 {
    return w.origin()
}

// §14.5, 18.64: a handle to a derived struct is a handle to its base, through any depth.
fn handles_to_a_base(d: Rc<Dialog>, owned: Box<Panel>) -> usize {
    let shared: Rc<Widget> = d
    let watcher: Weak<Widget> = Weak<Dialog>(&d)
    let mut widgets = List<Rc<Widget>>()
    widgets.push(d)
    let boxed: Box<Widget> = move(owned)
    let _ = move(boxed)
    let _ = watcher
    return shared.count() + widgets.len()
}

fn base_pointer_from_a_derived_one(d: ^mut Dialog) -> ^Widget {
    return d
}

fn writes_through_a_base_reference(p: &mut Panel) {
    shifts_a_widget(p)
}

fn shifts_a_widget(w: &mut Widget) {
    w.left += 1
}

fn inherited_members_are_reachable(d: &Dialog) -> i32 {
    return d.left + d.top + d.origin() + d.area()
}

// §7.3: a base with a constructor is built through it, and the derived type says so.
pub struct Sized {
    pub w: i32 = 0

    Sized(width: i32) {
        w = width
    }
}

pub struct Boxed : Sized {
    pub depth: i32 = 0

    Boxed(width: i32, d: i32) : Sized(width) {
        depth = d
    }
}

// A base argument may be built by statements: an `or` fallback, a block-valued `if`.
pub struct Fallback : Sized {
    Fallback(width: i32?, wide: bool) : Sized(width or if wide { 10 } else { 1 }) {}
}

// A base with no constructor may still be named, which is default-initialisation.
pub struct Explicitly : Widget {
    Explicitly() : Widget() {}
}

fn builds_through_constructors() -> i32 {
    let b = Boxed(3, 4)
    let e = Explicitly()
    return b.w + b.depth + e.left
}

// §7.3, 18.32: `virtual`, `override`, `protected`, and inherited implementations.
pub struct Drawable {
    protected depth: i32 = 0
    pub scale: i32 = 1

    // A `virtual fn` with no body makes this type abstract: only something that
    // overrides it can exist.
    pub virtual fn area(&self) -> i32

    pub virtual fn label(&self) -> i32 {
        return 1
    }

    protected fn bump(&self) -> i32 {
        return depth + 1
    }
}

pub struct Circle : Drawable {
    pub radius: i32 = 2

    pub override fn area(&self) -> i32 {
        // `protected` is reachable from a derived type, and so is the base's own field.
        return radius * radius * scale + depth
    }

    pub override fn label(&self) -> i32 {
        // A base's version, called without virtual dispatch, so an override can build on
        // what it replaces instead of discarding it.
        return Drawable::label(self) + self.bump()
    }
}

// An abstract type is fine behind a reference: that is what `virtual` is for.
fn area_of(d: &Drawable) -> i32 {
    return d.area() + d.label()
}

fn abstract_through_a_pointer(d: ^Drawable) -> ^Drawable {
    return d
}

// A trait implemented for a base is implemented for everything that inherits it, and a
// more specific implementation replaces the inherited one.
trait Measured {
    fn measure(&self) -> i32
}

impl Measured for Drawable {
    fn measure(&self) -> i32 {
        return scale
    }
}

pub struct Square : Drawable {
    pub side: i32 = 1

    pub override fn area(&self) -> i32 {
        return side * side
    }
}

impl Measured for Square {
    fn measure(&self) -> i32 {
        return side
    }
}

fn measure_any<T: Measured>(v: &T) -> i32 {
    return v.measure()
}

fn inherited_and_overridden_implementations(c: &Circle, s: &Square) -> i32 {
    return measure_any(c) + measure_any(s)
}

// §7.5: a bare variant carries the struct of that name — its fields, defaults and methods —
// beside a variant with no payload of its own.
struct Walking {
    pub speed: f32 = 1

    pub fn faster(&self) -> Motion? {
        if speed > 2 {
            return none
        }
        return .Walking{ speed: speed * 2 }
    }
}

union Motion {
    Walking
    Stopped {}
}

fn carried_struct(m: &mut Motion) -> f32 kills m {
    let next = switch m {
        case Walking(&w) { w.faster() }
        case Stopped { return 0 }
    }
    let n = next or return 0
    m = n
    return switch m {
        case Walking(&mut w) {
            w.speed += 1
            w.speed
        }
        case Stopped { 0.0 }
    }
}

// §7.7: a static is read anywhere and changed inside `unsafe`.
static TALLY: Walking = Walking{ speed: 2 }
#[thread_local]
static LIMITS: [2]i32 = [MAX_TALLY, 0]
const MAX_TALLY = 8

// §7.3: a function with no receiver is the type's, called through it.
struct Tally {
    pub n: i32 = 0

    pub fn starting_at(n: i32) -> Tally {
        return Tally{ n: n }
    }

    pub fn next(&self) -> Tally {
        return Tally::starting_at(n + 1)
    }
}

fn associated_functions() -> i32 {
    return Tally::starting_at(MAX_TALLY).next().n
}

// §7.6: `&T` and `^mut T` become `&Trait` and `^mut Trait` when `T` implements it.
struct Gauge {
    pub reading: ^Measured = null
}

fn measured_through_an_object(m: &Measured) -> i32 {
    return m.measure()
}

fn trait_objects(s: &Square) -> i32 {
    let g = Gauge{ reading: s }
    let r = g.reading or return 0
    return measured_through_an_object(s) + r.measure()
}

fn statics() -> f32 {
    let before = TALLY.speed + LIMITS[0] as f32
    unsafe {
        TALLY.speed = before
        LIMITS[1] = 1
        let _ = TALLY.faster()
    }
    return TALLY.speed
}

// §7.3: a constant declared in a type, named through it — a value, or a static's address.
struct Limits {
    pub const MAX: i32 = 64
    pub const SHARED: ^mut Walking = unsafe { &mut TALLY }
}

// §10.6: a pointer's address, and an address back to a pointer inside `unsafe`; §5.2: two
// pointers compare as addresses, whatever they point at.
fn addresses(w: ^mut Walking) -> bool {
    let at = w as usize
    let back: ^mut Walking = unsafe { at as ^mut Walking }
    let shared = Limits::SHARED
    return back == w && shared != null && Limits::MAX > 0
}

// §5.3: slices of part of an array, a string's bytes and length, and the checked way back
// from bytes to text; §11.2: `b[i]` on a `List` through `Index` and `IndexMut`.
fn slices_and_text(name: str) -> usize {
    let mut arr: [4]i32 = [1, 2, 3, 4]
    let middle = arr[1..3]
    let writable: []mut i32 = arr[..2]
    writable[0] = middle[1]
    let bytes = name as []u8
    let text = str::from_utf8(bytes[0..name.len]) or ""
    let mut b = List<i32>(4)
    b.push(arr[0])
    b[0] += 1
    return text.len + b.len() + b[0] as usize
}

// §9.8, §12.7: a final `SourceLocation` is where `panic` says it happened — how a helper
// like `assert` reports its caller's line.
fn require(ok: bool, what: str, loc: SourceLocation = #location) {
    if !ok {
        panic!("missing {}", what, loc)
    }
}

// §14.2: `Hash` — built in for integers, `bool`, `char` and `str`, called as a method on
// them, implemented by a struct, and what a `HashMap` key needs; `&` of a literal as a key.
struct Tile {
    pub x: i32 = 0
    pub y: i32 = 0
}

impl Eq for Tile {
    fn eq(&self, rhs: &Tile) -> bool {
        return x == rhs.x && y == rhs.y
    }
}

impl Hash for Tile {
    fn hash(&self) -> u64 {
        return hash_combine(x.hash(), y.hash())
    }
}

// §7.6: a trait is not implemented for a pointer type, which a method call reaches through;
// keying by identity wraps the pointer in a struct of its own (T-0080).
struct TileRef {
    pub at: ^Tile
}

impl Eq for TileRef {
    fn eq(&self, rhs: &TileRef) -> bool {
        return at == rhs.at
    }
}

impl Hash for TileRef {
    fn hash(&self) -> u64 {
        return (at as usize).hash()
    }
}

// §9.1, 18.53: a `T` is a `T?` wherever one is wanted — `let`, argument, assignment, and
// `if`/`switch` arms joined with `none` or a `T?`; `.Variant` infers through the `?`.
fn takes_optional(n: i32?) -> i32 {
    return n or 0
}

fn optionals(alive: bool, l: Layer) -> i32 {
    let hp = if alive { 100 } else { none }
    let mut slot: i32? = 5
    slot = 7
    let layer: Layer? = .World
    let picked = switch l {
        case Ui { none }
        default { l }
    }
    let other = if alive { none } else { Layer::Ui }
    return (hp or 0) + (slot or 0) + takes_optional(3) + (layer or l) as i32 + (picked or l) as i32 + (other or l) as i32
}

// §11.2: unary `-` on a struct is its `Neg`; `==` takes a temporary on the right as well as
// a place. §2.5: the most negative value of a signed type is one literal.
struct Heading {
    pub degrees: i32 = 0
}

impl Neg for Heading {
    type Output = Heading
    fn neg(&self) -> Heading {
        return Heading{ degrees: -degrees }
    }
}

impl Eq for Heading {
    fn eq(&self, rhs: &Heading) -> bool {
        return degrees == rhs.degrees
    }
}

fn negations(h: Heading) -> bool {
    let lowest: i8 = -128
    let back = -h
    return back == Heading{ degrees: -h.degrees } && lowest < 0
}

// §7.2: variadic parameters — none, several, a spread slice, a method, and a value borrowed
// where a trait reference is wanted.
fn total_of(first: i32, rest: ..i32) -> i32 {
    let mut t = first
    for x in rest {
        t += x
    }
    return t
}

trait Named {
    fn named(&self) -> str
}

impl Named for Heading {
    fn named(&self) -> str {
        return "heading"
    }
}

fn names(items: ..&Named) -> usize {
    return items.len
}

fn variadic_calls(h: Heading, xs: []i32) -> i32 {
    let n = names(h, Heading{ degrees: 90 }) + names()
    return total_of(1) + total_of(1, 2, 3) + total_of(0, ..xs) + n as i32
}

// §7.2: parameters after a variadic one, passed by name in any order, with or without a
// default — one left out before one given still gets its default.
fn weighted(xs: ..i32, scale: i32 = 1, offset: i32 = 0, label: str) -> i32 {
    let mut t = 0
    for x in xs {
        t += x
    }
    return t * scale + offset + label.len as i32
}

fn named_calls(xs: []i32) -> i32 {
    let a = weighted(1, 2, label = "a")
    let b = weighted(label = "b", scale = 2)
    let c = weighted(3, offset = 1, label = "c")
    return a + b + c + weighted(..xs, offset = 2, scale = 3, label = "d")
}

// §12.9: `Format` implemented by a type of its own, and `format!` with and without
// another allocator.
impl Format for Heading {
    fn format(&self, f: &mut Formatter) {
        self.degrees.format(f)
        f.write_str(" degrees")
    }
}

fn formatted(h: Heading) -> usize {
    let a = format!("{} at {:.1} {:x} {}", h, 1.5, 255, true)
    let b = format!("{{}}", allocator = Allocators::Temp)
    let c = format!("{} and {}", a, h)
    return a.len() + b.len() + c.len()
}

// §12.9: the printing macros take anything with `Format` — a type's own, a reference, a
// `String`, a type parameter bounded by it — and a spec a type's own `Format` reads.
fn printed<T: Format>(h: Heading, r: &Heading, s: String, t: T) {
    print!("{} {:x} ", h, h)
    println!("{} {} {}", r, s, t)
    eprint!("{}", 1)
    eprintln!("")
    println!(`raw {}`, "\u{7b}")
}

// §12.9: a pointer is written as what it points at, a spec applying to that, and `{:p}`
// writes its address — in `error(…)` too, which writes nothing else of a pointer.
fn pointed(h: ^Heading, m: ^mut Heading, n: ^i32) !-> usize {
    println!("{} {} {:x} [{:6}] {:p} {:18p}", h, m, n, n, h, m)
    let s = format!("{:p}", n)
    if s.len() == 0 {
        return error("nothing at {:p} [{:12p}]", n, h)
    }
    return s.len()
}

// §8.1: generic methods — inferred and written, with and without a receiver, on a generic
// type beside the type's own parameter, and a method's bound used in its body.
struct Shelf<T> {
    pub item: T

    pub fn paired<U: Copy>(&self, other: U) -> (U, U) {
        return (other, other)
    }

    pub fn take<U>(first: U, second: U) -> U {
        let _ = move(second)
        return move(first)
    }
}

fn generic_methods(s: &Shelf<bool>) -> i32 {
    let a = s.paired(3)
    let b = s.paired<u8>(4)
    let c = Shelf<bool>::take(5, 6)
    let d = Shelf<str>::take<i64>(7, 8)
    let less = s.item < true
    return a.0 + b.1 as i32 + c + d as i32 + (if less { 1 } else { 0 })
}

// §14.4: `Text` on a `str`, a `String` and a literal.
fn reading_text(line: &String, raw: str) -> i64 {
    let mut total: i64 = 0
    for field in line.trim().split(",") {
        total += field.parse_i64() or 0
    }
    for l in raw.lines() {
        if l.starts_with("#") || !l.contains("=") {
            continue
        }
        total += 1
    }
    let loud = "quiet".to_ascii_uppercase()
    let scale = "1.5".parse_f64() or 1.0
    return total + loud.replace("Q", "").len() as i64 + scale as i64
}

// §14.4: a `List` of anything `Ord` sorts; any `List` sorts by a comparison.
fn later_first(a: &f32, b: &f32) -> bool {
    return a > b
}

fn sorting(names: &mut List<String>, times: &mut List<f32>) -> usize kills names@items, times@items {
    names.sort()
    times.sort_by(later_first)
    times.swap(0, 0)
    return names.len()
}

// §14.4: text is UTF-8 — stepped through by character, and cut only on a boundary.
fn text_by_character(name: &String) -> usize {
    let mut wide: usize = 0
    for c in name.chars() {
        if c as u32 > 127 {
            wide += 1
        }
    }
    for c in name {
        let _ = c
    }
    let head = name.slice(0, 1) or ""
    return wide + name.char_count() + head.len
}

// §2.5: a suffix types the literal, with no context or in a matching one.
const SUFFIXED_LIMIT = 250u8

fn suffixed_literals() -> u64 {
    let small = 5u8
    let wrapped: u8 = small.wrapping_add(SUFFIXED_LIMIT)
    let big = 3_000_000_000u64
    let lowest = -128i8
    let half: f32 = 0.5f
    let two = 2f32
    return big + wrapped as u64 + (lowest as i64 + 128) as u64 + (half * two) as u64 + 0xFFu64
}

// §14.4: `Number` bounds either kind of number; `Integer` and `Float` include it.
fn as_wide<T: Number>(x: &T) -> f64 {
    return x.to_f64()
}

fn float_is_a_number<T: Float>(x: &T) -> f64 {
    return x.to_f64()
}

fn numbers() -> f64 {
    let die = Random::range(1, 7)
    let unit = Random::range<f32>(0.0, 1.0)
    let three = 3
    return as_wide(&die) + as_wide(&unit) + float_is_a_number(&2.5) + three.uniform(9, 42).to_f64()
}

// §14.4: paths, files and directories, each failure carried as an `Error`.
fn file_system(dir: &Path) !-> usize {
    let config = dir / "config.txt"
    Directory::create(dir) or return
    File::write_text(&config, "hello") or return
    let text = File::read_text(&config) or return
    let mut f = File::open(&config, .ReadWrite) or return
    let mut buf: [8]u8
    let n = f.read(buf[..]) or return
    let entries = Directory::list(dir) or return
    return text.len() + n + entries.len() + config.extension().len
}

// §10.4, 18.51: a container is looped over through `Iterable` and `IterableMut`.
fn iterating_containers(names: &HashMap<str, i32>) -> i32 {
    let mut xs = List<i32>(4)
    xs.push(1)
    for &mut x in xs {
        x += 1
    }
    let mut total = 0
    for x in xs {
        total += x
    }
    for _, &v in names {
        total += v
    }
    return total
}

// §7.4, 18.54: an enum is `Eq`, `Hash` and `Ord` with no `impl` — a key, and a `T: Ord`.
fn enum_traits(l: Layer) -> bool {
    let mut by_layer = HashMap<Layer, i32>()
    by_layer.insert(l, 1)
    let top = largest(l, Layer::Ui)
    return by_layer.contains(&top) || l.hash() == top.hash() || l.cmp(&top) == Ordering::Less
}

fn hashing(name: str) -> bool {
    let mut by_tile = HashMap<Tile, str>()
    by_tile.insert(Tile{ x: 1, y: 2 }, name)
    let mut by_name = HashMap<str, i32>(8)
    by_name.insert(name, 3)
    let three = by_name.replace(name, 4) or 0
    let counts = HashMap<u8, bool>()
    let at = Tile{ x: 1, y: 2 }
    assert(three == 3)
    assert(name.len > 0, "a name")
    let found = by_tile.contains(&at) && three == 3 && counts.get(&7) == null
    return found && 'c'.hash() != true.hash() && name.eq(&name)
}


// §13: reflection is typed like any call — a static `&TypeInfo`, a `TypeId` that compares,
// a tag looked up by key.
fn reflect_on_a_type() -> bool {
    let info = typeinfo_of<Vec3>()
    let id = typeid_of<Vec3>()
    let again = typeinfo(id)
    for &f in info.fields {
        let _ = f.tag_value("json") or f.name
    }
    return id == typeid_of<Vec3>() && again.kind == TypeKind::Struct && info.size > 0
}

// §7.5, 18.78: a union's methods — `self` is the union, a function without `self` is
// called through it, and a `&mut self` method may replace the whole union.
union Lamp {
    Off {}
    On { level: i32 }

    pub fn dark() -> Lamp {
        return .Off{}
    }

    pub fn level(&self) -> i32 {
        return switch self {
            case Off { 0 }
            case On(o) { o.level }
        }
    }

    pub fn flip(&mut self) kills self {
        let next: Lamp = switch self {
            case Off { .On{ level: 1 } }
            case On { .Off{} }
        }
        self = next
    }
}

fn union_methods() -> i32 {
    let mut l = Lamp::dark()
    l.flip()
    return l.level()
}

// §5.2: a reference to a number, `bool`, `char`, `str` or enum reads as its value under an
// operator, where no type is wanted of it: compared, computed with, masked.
fn operators_read_through(x: &i32, flag: &bool, l: &Layer, s: &str) -> bool {
    let doubled = x * 2
    let low = x & 1
    let bigger = x > 2 && 2 < x && x != doubled
    return bigger && low == 0 && flag == true && l == Layer::Ui && .Ui == l && s == "x"
}

// §14.4: `Search` and `Extend` on a `List` of `Eq` and `Copy` elements, a `List` as a key,
// `String` keys looked up by `str`, a `HashSet`, `Join`, and the newer `Text` methods.
fn collections_pass(names: &mut HashMap<String, i32>, words: &List<String>) -> usize kills names@items {
    let mut xs = List<i32>()
    let more: [2]i32 = [1, 2]
    xs.extend(more[0..2])
    xs.insert_slice(0, more[0..1])
    let at = xs.index_of(&2) or 0
    let first = xs.first() or return 0
    let mut by_cells = HashMap<List<i32>, bool>()
    by_cells.insert(xs, true)
    let hero = names.get_mut_str("hero") or return 0
    hero += 1
    let count = names.get_or_insert(String::from("wall"), 0)
    count += 1
    let mut seen = HashSet<str>()
    let fresh = seen.insert("a") && !seen.contains(&"b")
    let line = words.join(", ")
    let (k, _) = line.split_once(",") or ("", "")
    let tail = line.strip_prefix(k) or ""
    let mut s = String::from(tail)
    s.insert(0, 'x')
    let removed = s.remove(0)
    let comma = tail.rfind(",") or 0
    return at + k.len + comma + (if fresh && removed == 'x' && first == 1 { 1 } else { 0 })
}

// §7.2, T-0036: several constructors, each reached by the arguments that fit it — by count,
// defaults included, and by type; a base initialiser chooses the same way.
struct Extent {
    pub w: f32
    pub h: f32

    Extent(w: f32, h: f32 = 1.0) {
        self.w = w
        self.h = h
    }

    Extent(size: Vec2) {
        self.w = size.x
        self.h = size.y
    }
}

struct Framed : Extent {
    pub border: i32

    Framed(size: Vec2) : Extent(size) {
        self.border = 1
    }
}

fn constructors_by_argument() -> f32 {
    let a = Extent(2.0)
    let b = Extent(2.0, 3.0)
    let c = Extent(Vec2{ x: 1.0, y: 1.0 })
    let d = Framed(Vec2{ x: 4.0, y: 4.0 })
    return a.w + b.h + c.w + d.w + d.border as f32
}

// §7.3, T-0035: a generic base — an instance of it, or passed a parameter by a generic
// derived type — with its fields, methods and constructor read at the base's arguments.
struct Holder<T: Copy> {
    pub held: T

    Holder(held: T) {
        self.held = held
    }

    pub fn get(&self) -> T {
        return held
    }
}

struct IntHolder : Holder<i32> {
    IntHolder(n: i32) : Holder(n) {}
}

struct Labelled<T: Copy> : Holder<T> {
    pub label: str = ""

    Labelled(v: T) : Holder(v) {}
}

fn holder_value(h: &Holder<i32>) -> i32 {
    return h.get()
}

fn generic_bases() -> i32 {
    let a = IntHolder(3)
    let b = Labelled<i32>(4)
    return holder_value(&a) + holder_value(&b) + a.held + b.get()
}

// §14.4: a `SlotMap` and the `Key`s it hands out, kept in a field, as a map key, rebuilt
// from their parts; and §5.2, `&` of a reference, which refers to what that reference does.
struct Seeker {
    pub target: Key<Vec3> = Key<Vec3>()
}

fn slot_maps(points: &mut SlotMap<Vec3>, scores: &mut List<Score>) -> f32 kills points@items, points[*] {
    let k = points.insert(Vec3{ x: 1.0, y: 2.0, z: 3.0 })
    let seeker = Seeker{ target: k }
    let p = points.get_mut(seeker.target) or return 0.0
    p.x += 1.0
    let mut by_key = HashMap<Key<Vec3>, i32>()
    by_key.insert(Key<Vec3>(k.index(), k.version()), 1)
    let mut total: f32 = 0.0
    for key, &v in points {
        total += v.y + key.index() as f32
    }
    let gone = points.remove(k) or return total
    let first = &mut scores[0]
    let again = &mut first
    again.value += 1
    return total + gone.z
}

// §8.5: an associated type named off a bound — `T::Item`, `C::Iter::Item` — in a signature,
// in a `for` over a generic iterator and a generic container, and in an adapter's `Item`,
// which each instance reads as the implementation's choice.
fn first_item<T: Iterate>(it: &T) -> T::Item {
    return it.get()
}

fn count_items<C: Iterable>(xs: &C, seen: fn(C::Iter::Item)) -> i32 {
    let mut n = 0
    for x in xs {
        seen(move(x))
        n += 1
    }
    return n
}

struct Flagged<I: Iterate> {
    pub inner: I
}

impl<I: Iterate> Iterate for Flagged<I> {
    type Item = (I::Item, bool)

    fn valid(&self) -> bool {
        return inner.valid()
    }

    fn get(&self) -> (I::Item, bool) {
        return (inner.get(), true)
    }

    fn advance(&mut self) {
        inner.advance()
    }
}

fn ignore_int(x: &i32) {}

fn projections(xs: &List<i32>) -> i32 {
    let a: &i32 = first_item(&xs.iter())
    let flagged = Flagged<SliceIter<i32>>{ inner: xs.iter() }
    let pair: (&i32, bool) = first_item(&flagged)
    return a + pair.0 + count_items(xs, ignore_int)
}

// --- r78: the orphan rule counts a trait's arguments, and `ImplicitAs` (spec §7.2, §7.6) --

// `Mul` is `std`'s and `f32` is no one's here, but `Scale`, its argument, is this module's.
impl Mul<Scale> for f32 {
    type Output = Scale

    fn mul(&self, rhs: Scale) -> Scale {
        return rhs
    }
}

pub struct Grams {
    pub g: f32
}

// Into a type of this module, from one that is not.
impl ImplicitAs<Grams> for f32 {
    fn convert(&self) -> Grams {
        return Grams{ g: self }
    }
}

fn weigh(w: Grams) -> f32 {
    return w.g
}

fn c_text(s: cstr) -> cstr {
    return s
}

// A `String`, a reference to one and a temporary each convert for the call alone; so does a
// value whose type is converted from by a module that is not its own.
fn conversions(name: &String, owned: String, x: f32) -> f32 {
    let _ = c_text(name)
    let _ = c_text(owned)
    let _ = c_text(String::from("x"))
    return weigh(x) + weigh(owned.len() as f32)
}

// Ties and `kills` clauses (spec §6.7): every form a signature may use. Nothing checks yet
// that a body kills what its clause says, so the bodies here only have to make sense.
pub struct Roster {
    pub members: List<String>
    m_scores: List<i32>
    m_index: HashMap<String, i32>
    tie @scores = m_scores

    // A private method may name a private field; a public one names its tie.
    fn reset_index(&mut self) kills self.m_index@items, self.m_index[*] {
        m_index.clear()
    }

    pub fn add_score(&mut self, s: i32) kills self@scores {
        m_scores.push(s)
    }

    pub fn first_member(&self) -> ^String in self.members {
        return members.first()
    }

    pub fn rename_all(&mut self) kills self.members[*] {
        for &mut m in members {
            m.push_str("!")
        }
    }
}

pub trait Tidy {
    fn tidy(&mut self, roster: &mut Roster) kills roster.members
}

// A reference parameter may say where it points; a free function names `pub` fields.
fn shout(name: &mut String in roster, roster: &mut Roster) kills name@text, roster.members@items, roster.members[*] {
    name.push_str("!")
    roster.members.clear()
}

fn member_text(roster: &Roster, i: usize) -> str in roster.members[*] {
    return roster.members[i].as_str()
}

// Every returned view says where it points: one view input is enough, `in` picks between
// several or names them all, it may be on a result that holds a view, and text from nowhere
// is a `const str`. A raw pointer from nothing may own what it points at, and a `T` may not
// be a view at all (spec §6.7).
fn first_or(a: str, b: str) -> str in (a, b) {
    return if a.len > 0 { a } else { b }
}

fn after(s: str, prefix: str) -> str? in s {
    return s.strip_prefix(prefix)
}

fn halves(s: str) -> (str, str)? {
    return s.split_once("=")
}

fn walk(xs: &List<i32>) -> SliceIter<i32> {
    return xs.iter()
}

fn greeting() -> (const str, i32) {
    return ("hello", 5)
}

fn fresh_bytes() -> ^mut u8 {
    return null
}

fn either_value<T>(a: &Roster, b: &Roster, v: T) -> T {
    return move(v)
}

// A function fits a function type that promises at least what it kills; one that kills
// nothing fits any (spec §6.7).
fn score_once(r: &mut Roster) kills r@scores {
    r.add_score(1)
}

fn leave_alone(r: &mut Roster) {}

fn apply_to(f: fn(r: &mut Roster) kills r@scores, r: &mut Roster) kills r@scores {
    f(r)
}

fn applies(r: &mut Roster) kills r@scores {
    apply_to(score_once, r)
    apply_to(leave_alone, r)
}

// Fields may be tied together, and a path goes on past their tie when they share a type.
pub struct Record {
    m_wins: List<String>
    m_losses: List<String>
    tie @games = m_wins, m_losses

    pub fn forget(&mut self) kills self@games {
        m_wins.clear()
        m_losses.clear()
    }

    pub fn rename(&mut self) kills self@games[*] {
        for &mut w in m_wins {
            w.push_str("!")
        }
    }
}

// A tie may stand for another type's tie, so a wrapper names what its list names without
// naming the list; `[*]` says where its elements are, behind a pointer or in a field.
pub struct Bookshelf {
    m_books: List<String>
    m_count: own ^mut i32 = null
    tie @items = m_books@items
    tie [*] = m_books[*]
    tie @counts = m_count

    pub fn add(&mut self, title: String) kills self@items {
        m_books.push(title)
    }

    pub fn title(&self, i: usize) -> str in self[*]@text {
        return m_books[i].as_str()
    }

    pub fn wipe(&mut self) kills self@items, self[*] {
        m_books.clear()
    }
}

impl Drop for Bookshelf {
    fn drop(&mut self) {}
}

impl Index<usize> for Bookshelf {
    type Output = String

    fn index(&self, i: usize) -> &String in self@items {
        return &m_books[i]
    }
}

pub struct Rack {
    m_data: own ^mut i32 = null
    tie @items = m_data
    tie [*] = m_data[*]
}

impl Drop for Rack {
    fn drop(&mut self) {}
}

impl Iterable for Rack {
    type Iter = SliceIter<i32>

    fn iter(&self) -> SliceIter<i32> {
        return SliceIter<i32>(unsafe { m_data[0..0] })
    }
}

// `const str` (spec §5.3): text in static storage. A literal is one wherever one is wanted, a
// field and a container may hold one, and it reads as a `str` anywhere else.
pub struct Sign {
    pub text: const str
}

fn sign_text(s: &Sign) -> const str {
    return s.text
}

fn signs() -> usize {
    let mut all: List<const str> = List<const str>()
    let s = Sign{ text: "exit" }
    all.push(s.text)
    let shown: str = s.text
    let mut label = "none"
    label = sign_text(&s)
    return all.len() + shown.len + label.len
}
