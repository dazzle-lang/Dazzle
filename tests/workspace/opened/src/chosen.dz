// A `{ … }` import picks one of two opened dependencies' `Vec3` for this file, and wins over
// both (spec §3.2). The other files of the module are unaffected.

import geo::{ Vec3 }

fn origin() -> Vec3 {
    return Vec3{ x: 0, y: 0, z: 0 }
}

fn mass() -> f32 {
    return Body{ mass: 2 }.mass * area(1, 1)
}
