// Every line below is a deliberate type error.

pub enum Layer : u8 {
    Background = 0
    World      = 300
}

pub union Shape {
    Circle { radius: f32 }
    Rect { w: f32, h: f32 }
    Point {}
}

pub struct Vec3 {
    pub x: f32
    pub y: f32
    pub z: f32
}

pub struct Counter {
    count:      u32
    pub label:  str
    borrowed:   &Vec3

    pub fn get(&self) -> u32 {
        return count
    }

    pub fn bump(&mut self) {
        count += 1
    }

    pub fn broken_mutation(&self) {
        count += 1
    }
}

fn no_implicit_widening(small: i32) -> i64 {
    return small
}

fn literal_out_of_range() {
    let b: u8 = 300
}

fn mixed_arithmetic(a: i32, b: i64) -> i32 {
    return a + b
}

fn no_truthiness(n: i32) {
    if n {
        return
    }
}

fn bad_condition_type(v: Vec3) {
    while v {
        return
    }
}

fn unknown_field(v: Vec3) -> f32 {
    return v.w
}

fn private_field_from_here(c: Counter) -> u32 {
    return c.count
}

fn unknown_method(c: Counter) -> u32 {
    return c.increment()
}

fn immutable_receiver(c: Counter) {
    c.bump()
}

fn assign_to_immutable() {
    let total = 1
    total = 2
}

fn missing_struct_field() -> Vec3 {
    return Vec3{ x: 1, y: 2 }
}

fn unknown_struct_field() -> Vec3 {
    return Vec3{ x: 1, y: 2, z: 3, w: 4 }
}

fn wrong_argument_count(v: Vec3) -> f32 {
    return length(v, v)
}

fn length(v: Vec3) -> f32 {
    return v.x
}

fn bad_cast(v: Vec3) -> i32 {
    return v as i32
}

fn not_indexable(n: i32) -> i32 {
    return n[0]
}

fn not_dereferenceable(n: i32) -> i32 {
    return n^
}

fn non_exhaustive(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return 1
        }
        case Rect(r) {
            return 2
        }
    }
    return 0
}

fn unknown_variant(s: Shape) {
    switch s {
        case Triangle {
            return
        }
        default {
            return
        }
    }
}

fn may_fail() !-> i32 {
    return 1
}

fn maybe() -> i32? {
    return none
}

fn a_pointer() -> ^i32 {
    return null
}

fn takes_ref(x: &i32) {
}

// A fallible call must be consumed in the statement it appears in (spec §9.7).
fn unused_result() {
    may_fail()
}

// Bare `or return` propagates, and this signature cannot carry a failure (spec §9.5).
fn or_return_without_fallible() -> i32 {
    let v = may_fail() or return
    return v
}

// `or` needs something that can fail (spec §9.4).
fn or_on_plain_value(n: i32) -> i32 {
    return n or 0
}

// Only a fallible call carries an `Error` to bind (spec §9.4).
fn binding_on_optional() -> i32 {
    let v = maybe() or { e ->
        return 0
    }
    return v
}

// An `or` clause must produce the success type or diverge (spec §9.4).
fn or_clause_wrong_type() -> i32 {
    let v = maybe() or "not an i32"
    return v
}

// `or ignore` produces no value, so it cannot be bound (spec §9.4).
fn ignore_in_value_position() -> i32 {
    let v = may_fail() or ignore
    return 0
}

// `^T` → `&T` is not implicit: a pointer may be null (spec §5.2).
fn pointer_where_reference_wanted() {
    takes_ref(a_pointer())
}

fn none_without_context() -> i32 {
    let x = none
    return 0
}

fn cannot_iterate(n: i32) {
    for i in n {
        return
    }
}

// --- M5: the rules of spec §6, §7.5 and §9.2 --------------------------------

// A union variant's payload has its own field list (spec §7.5).
fn unknown_variant_field(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return c.diameter
        }
        default {
            return 0
        }
    }
}

fn wrong_variant_payload() -> Shape {
    return Shape::Circle{ w: 1 }
}

// `Error` is a struct the language provides, with the fields §9.2 lists.
fn unknown_error_field() -> i32 {
    return may_fail() or { e ->
        e.reason
    }
}

// --- M6: slices carry their writability (spec §5.3, §18.22) -----------------

// A `[]T` is a read-only view; its elements cannot be written however it is bound.
fn writes_through_a_read_only_slice(xs: []i32) {
    xs[0] = 1
}

// `[]T` does not satisfy `[]mut T` — that direction would gain the right to write.
fn narrow_then_widen(xs: []i32) {
    writes_through_a_read_only_slice(xs)
    fills(xs)
}

fn fills(dst: []mut i32) {
    dst[0] = 0
}

// Viewing an array as `[]mut T` needs the array itself to be writable.
fn immutable_array_as_mutable_slice() {
    let storage: [4]i32
    fills(storage)
}

// --- M6: generics and traits (spec §7.6, §8) --------------------------------

trait Same {
    fn eq(&self, rhs: &Self) -> bool
}

trait Rank : Same {
    fn cmp(&self, rhs: &Self) -> i32
}

// §8.1: a body may only do what its bounds allow, and this is reported here, inside the
// generic, rather than at any instantiation.
fn beyond_its_bounds<T: Same>(a: T, b: T) -> bool {
    return a.cmp(&b) == 0
}

// §8.2: an unbounded `T` has no members at all.
fn unbounded_has_no_members<T>(a: T) -> i32 {
    return a.count
}

// §8.1: a bound must name a trait.
fn bound_is_not_a_trait<T: Layer>(a: T) -> i32 {
    return 0
}

// §7.6: `impl Rank` obliges `cmp`, and `Rank : Same` obliges an `impl Same` as well.
struct Incomplete {
    m_value: i32
}

impl Rank for Incomplete {
}

// §7.6: implemented, but not with the declared signature.
struct WrongSignature {
    m_value: i32
}

impl Same for WrongSignature {
    fn eq(&self, rhs: &WrongSignature) -> i32 {
        return 0
    }
}

struct Plain {
    pub n: i32
}

// §8.1: the type chosen for a bounded parameter must satisfy the bound.
fn argument_does_not_satisfy(p: Plain) -> bool {
    return unrelated(p, p)
}

fn unrelated<T: Same>(a: T, b: T) -> bool {
    return a.eq(&b)
}

// §8.1: a parameter no argument determines cannot be inferred.
fn uninferrable<T: Same>() -> i32 {
    return 0
}

fn calls_uninferrable() -> i32 {
    return uninferrable()
}

// §8.1: the wrong number of type arguments.
struct OneParam<T> {
    m_value: T
}

fn too_many_type_args(p: &OneParam<i32, f32>) -> i32 {
    return 0
}

// --- M6: array literals (spec §5.3) -----------------------------------------

// The length is exactly what is written; a short literal is not a zero-fill.
fn array_literal_wrong_length() -> i32 {
    let a: [8]i32 = [1, 2]
    return a[0]
}

// Every element has the same type.
fn array_literal_elements_disagree() -> i32 {
    let a = [1, "two", 3]
    return 0
}

// An empty literal has nothing to read an element type from.
fn empty_array_literal_without_context() -> i32 {
    let a = []
    return 0
}

// A temporary array cannot be stored as a slice: the slice would already dangle.
fn array_literal_stored_as_a_slice() -> i32 {
    let s: []i32 = [1, 2, 3]
    return s[0]
}

fn array_literal_returned_as_a_slice() -> []i32 {
    return [1, 2, 3]
}

// --- M6: operators are traits (spec §11.2) ----------------------------------

// Comparing a struct that implements neither `Eq` nor `Ord`. This used to reach C++ and
// fail there, which invariant 7 forbids.
fn compares_without_eq(a: Plain, b: Plain) -> bool {
    return a == b
}

fn orders_without_ord(a: Plain, b: Plain) -> bool {
    return a < b
}

// Arithmetic likewise: `+` is `Add`.
fn adds_without_add(a: Plain, b: Plain) -> Plain {
    return a + b
}

// `impl Mul<f32>` accepts an `f32` on the right, not a `Plain`.
pub struct Scaled {
    pub v: f32
}

impl Mul<f32> for Scaled {
    type Output = Scaled

    fn mul(&self, rhs: f32) -> Scaled {
        return Scaled{ v: v * rhs }
    }
}

fn wrong_rhs(a: Scaled, b: Plain) -> Scaled {
    return a * b
}

// --- M6: compile-time queries, constants and formatting ---------------------

// §5.5: only the listed queries exist.
fn unknown_query<T>(x: &T) -> usize {
    return T::length
}

// §5.5: `sizeof` takes a type, not a value.
fn sizeof_of_a_value(n: i32) -> usize {
    return sizeof(n)
}

// §5.3: an array length must fold to a non-negative constant.
fn not_a_constant_length(n: usize) -> i32 {
    let a: [n]i32
    return 0
}

// The builtins codegen reads by position have their argument counts checked.
fn construct_with_two_values(p: ^mut i32) {
    unsafe { construct(p[0], 1, 2) }
}

// §12.9: the format string is checked against its arguments, at compile time.
fn format_count_mismatch(x: i32) {
    println!("{} and {}", x)
}

fn format_spec_does_not_fit(f: f32) {
    println!("{:x}", f)
}

// §12.9: a zero fill suits only a number.
fn format_zero_fill_does_not_fit(s: str) {
    println!("{:08}", s)
}

fn format_not_a_literal(s: str) {
    println!(s)
}

fn format_unformattable(v: Vec3) {
    println!("{}", v)
}

fn format_interpolation(hp: i32) {
    println!("hp is {hp}", hp)
}

// --- r12: `unsafe` (spec §5.2) ---------------------------------------------------------

unsafe fn raw_write(p: ^mut i32) {
    p^ = 1
}

fn deref_outside_unsafe(p: ^i32) -> i32 {
    return p^
}

fn field_through_pointer(v: ^Vec3) -> f32 {
    return v.x
}

fn index_a_pointer(p: ^i32) -> i32 {
    return p[1]
}

fn call_an_unsafe_fn(p: ^mut i32) {
    raw_write(p)
}

// One missing `unsafe`, one diagnostic — not one for `destroy` and one for `p[0]`.
fn placement_outside_unsafe(p: ^mut i32) {
    destroy(p[0])
}

fn pointer_cast_outside_unsafe(p: ^i32) -> ^u8 {
    return p as ^u8
}

// --- r21: a runtime `str` has no terminating zero, so it is not a `cstr` (§5.3, §18.39) ---

fn runtime_str_to_cstr(s: str) -> cstr {
    return s as cstr
}

// --- r18: `^T` and `^mut T` (spec §5.2, §18.37) ------------------------------------------

// `.ptr` is as writable as its view, so a read-only slice gives a `^T` (spec §5.3).
fn writable_pointer_from_a_read_only_slice(xs: []i32) -> ^mut i32 {
    return xs.ptr
}

// A `^T` is only read through.
fn write_through_a_read_only_pointer(p: ^i32) {
    unsafe { p^ = 1 }
}

fn field_through_a_read_only_pointer(v: ^Vec3) {
    unsafe { v.x = 1.0 }
}

// Neither a `^T` nor a `&T` becomes a `^mut T`: each would gain the right to write.
fn read_only_to_writable(p: ^i32) -> ^mut i32 {
    return p
}

fn shared_reference_to_writable(r: &i32) -> ^mut i32 {
    return r
}

// `construct` and `memcpy` write their destination.
fn construct_through_a_read_only_pointer(p: ^i32) {
    unsafe { construct(p[0], 1) }
}

fn memcpy_into_a_read_only_pointer(dst: ^u8, src: ^u8) {
    unsafe { memcpy(dst, src, 4) }
}

// --- r12: `Copy` (spec §8.2, §18.26) -----------------------------------------------------

fn keep_copy<T: Copy>(x: T) -> T {
    return x
}

pub struct Unique {
}

impl Drop for Unique {
    fn drop(&mut self) {}
}

fn copy_bound_unsatisfied(u: Unique) -> Unique {
    return keep_copy(move(u))
}

// --- r12: one trait at several arguments (spec §18.27) ----------------------------------

// A struct declares each method once; implementations of one trait at several arguments
// live in separate `impl` blocks.
pub struct Twice {
    pub fn go(&self) {}
    pub fn go(&self) {}
}

pub struct Widen {
}

impl Mul<i64> for Widen {
    type Output = Widen

    fn mul(&self, rhs: i64) -> Widen {
        return Widen{}
    }
}

impl Mul<u8> for Widen {
    type Output = Widen

    fn mul(&self, rhs: u8) -> Widen {
        return Widen{}
    }
}

// `3` fits both an `i64` and a `u8`, and would default to neither.
fn ambiguous_operand(w: Widen) -> Widen {
    return w * 3
}

// --- r13: implementations (spec §6.1, §7.6) ----------------------------------------------

// The orphan rule: neither `Add` nor `i32` is declared in this module.
impl Add for i32 {
    type Output = i32

    fn add(&self, rhs: i32) -> i32 {
        return 0
    }
}

// An implementation for every type at once.
impl<T> Same for T {
    fn eq(&self, rhs: &T) -> bool {
        return false
    }
}

// An implementation for a pointer type: a method call reaches through it (T-0080).
impl Same for ^Twin {
    fn eq(&self, rhs: &^Twin) -> bool {
        return false
    }
}

// `Drop` is a destructor, so it belongs to a struct of this module.
impl Drop for f32 {
    fn drop(&mut self) {}
}

// One implementation of a trait per type and arguments.
struct Twin {
}

impl Same for Twin {
    fn eq(&self, rhs: &Twin) -> bool {
        return true
    }
}

impl Same for Twin {
    fn eq(&self, rhs: &Twin) -> bool {
        return false
    }
}

// An implementation holds exactly the trait's methods.
struct Extra {
}

impl Same for Extra {
    fn eq(&self, rhs: &Extra) -> bool {
        return true
    }

    fn also(&self) -> i32 {
        return 0
    }
}

// Two traits both provide `shout`; the call has to name the one it means.
trait Yell {
    fn shout(&self) -> i32
}

trait Holler {
    fn shout(&self) -> i32
}

struct Crier {
}

impl Yell for Crier {
    fn shout(&self) -> i32 {
        return 1
    }
}

impl Holler for Crier {
    fn shout(&self) -> i32 {
        return 2
    }
}

fn ambiguous_trait_method(c: Crier) -> i32 {
    return c.shout()
}

// `drop` is the destructor: it runs by itself, and calling it would run it twice.
fn drop_called_by_name(u: Unique) {
    u.drop()
}

// §9: an optional is compared only with `none`; two optionals have no `==`.
fn compares_two_optionals(a: i32?, b: i32?) -> bool {
    return a == b
}

// §9.4: `if let` takes a `T?` or a `^T`. A fallible call carries an `Error` that its
// `else` would drop, and a plain value has nothing to take out.
fn if_let_on_a_fallible_call() {
    if let v = may_fail() {
        return
    }
}

fn if_let_on_a_plain_value(n: i32) {
    if let v = n {
        return
    }
}

// 18.61: `&mut` in an `if let` needs something writable, and a plain binding copies.
fn if_let_mut_through_a_read_only_pointer(p: ^i32) {
    if let &mut x = p {
        x += 1
    }
}

fn if_let_mut_on_a_read_only_handle(h: &Rc<i32>) {
    if let &mut x = h {
        x += 1
    }
}

fn if_let_writes_to_a_copy(p: ^mut i32) {
    if let x = p {
        x += 1
    }
}

// §7.3, 18.32: struct inheritance, one deliberate failure per rule.
pub struct Panel {
    pub left: i32 = 0
}

pub struct Framed : Panel {
    pub thickness: i32 = 1
}

// A base must be a struct: a trait is implemented, not inherited from.
pub struct NotAStruct : Yell {
    pub n: i32 = 0
}

// A base's field cannot be redeclared — a name means one thing in a type.
pub struct Redeclares : Panel {
    pub left: i32 = 5
}

// A whole `Framed` is not a `Panel`: copying one would drop what `Framed` adds.
fn slices_by_value(f: Framed) -> i32 {
    let p: Panel = f
    return p.left
}

// A read-only reference does not become a writable one on the way to the base.
fn widens_a_read_only_reference(f: &Framed) {
    writes_a_panel(f)
}

fn writes_a_panel(p: &mut Panel) {
    p.left = 1
}

// A base with a constructor has to be constructed through it.
pub struct Measured {
    pub w: i32 = 0

    Measured(width: i32) {
        w = width
    }
}

pub struct ForgetsTheBase : Measured {
    pub extra: i32 = 0

    ForgetsTheBase(e: i32) {
        extra = e
    }
}

// A base initialiser names the one base the struct declares, and nothing else.
pub struct InitialisesTheWrongBase : Panel {
    InitialisesTheWrongBase() : Measured(1) {}
}

// The base is built before the constructor begins, so there is nothing to return from.
pub struct ReturnsFromTheBase : Measured {
    ReturnsFromTheBase(width: i32?) : Measured(width or return) {}
}

// A type with a constructor is built by calling it, not with a literal.
fn literal_of_a_type_with_a_constructor() -> i32 {
    let m = Measured{ w: 2 }
    return m.w
}

// §7.3, 18.32: `virtual`, `override` and `protected`, one deliberate failure per rule.
pub struct Abstract {
    protected inner: i32 = 0

    pub virtual fn area(&self) -> i32
    pub virtual fn label(&self) -> i32 { return 1 }
    pub fn fixed(&self) -> i32 { return 2 }
}

// Abstract: inherits a body-less `virtual` and does not override it.
pub struct StillAbstract : Abstract {
    pub n: i32 = 0
}

// An abstract type has no values, so it cannot be held by value or built.
fn holds_an_abstract_by_value(a: Abstract) -> i32 {
    return a.area()
}

fn builds_an_abstract() -> i32 {
    let a = StillAbstract{}
    return a.n
}

// `override` with nothing to override.
pub struct OverridesNothing {
    pub override fn missing(&self) -> i32 { return 0 }
}

// `override` aimed at a method that is not `virtual`.
pub struct OverridesAFixedOne : Abstract {
    pub override fn area(&self) -> i32 { return 1 }
    pub override fn fixed(&self) -> i32 { return 3 }
}

// An override whose signature has drifted from the base's.
pub struct DriftedSignature : Abstract {
    pub override fn area(&self) -> i32 { return 1 }
    pub override fn label(&self, extra: i32) -> i32 { return extra }
}

// Redeclaring a base's method without `override` is a shadow, which Dazzle has not got.
pub struct ShadowsAMethod : Abstract {
    pub override fn area(&self) -> i32 { return 1 }
    pub fn label(&self) -> i32 { return 9 }
}

// `protected` is for the family, not for everyone.
pub struct Unrelated {
    pub fn peeks(&self, a: &Abstract) -> i32 {
        return a.inner
    }
}

// `Abstract::area` is called on an `Abstract` or something that inherits from one.
fn base_call_on_an_unrelated_type(u: &Unrelated) -> i32 {
    return Abstract::label(u)
}

// A `#[test]` is a function the runner calls with nothing and reads nothing back
// from: it passes by returning and fails by panicking (spec §19 M14).
#[test]
fn a_test_that_takes_an_argument(n: i32) {}

#[test]
fn a_test_that_returns_a_value() -> i32 {
    return 1
}

#[test]
fn a_test_that_is_fallible() !-> i32 {
    return 1
}

#[test]
fn a_test_with_type_parameters<T>() {}

// --- M8: `switch` on constants (spec §10.3) ----------------------------------------------

fn a_case_label_computed_at_run_time(n: i32, m: i32) -> i32 {
    switch n {
        case m { return 1 }
        default { return 0 }
    }
}

fn a_case_value_on_a_union(s: Shape) -> i32 {
    switch s {
        case 3 { return 1 }
        default { return 0 }
    }
}

fn the_same_case_twice(n: i32) -> i32 {
    switch n {
        case 1, 2 { return 1 }
        case 2 { return 2 }
        default { return 0 }
    }
}

// §7.5: a bare variant carries the struct it names, and there is no `Stopped` struct. A
// variant with no payload is written `Stopped {}`.
union Motion {
    Stopped
}

// §7.7: a static is built from constants, and changed only inside `unsafe`.
fn a_runtime_value() -> i32 {
    return 3
}

static STARTS_AT_RUN_TIME: i32 = a_runtime_value()
static SHARED: i32 = 0

fn changes_a_static_safely() {
    SHARED = 1
}

// §7.3: a function with no receiver is called through its type, never on a value.
struct Factory {
    pub fn make() -> Factory {
        return Factory{}
    }
}

fn calls_an_associated_function_on_a_value(f: Factory) -> Factory {
    return f.make()
}

// §7.6: only a type that implements the trait becomes a trait object of it.
trait Named {
    fn name(&self) -> str
}

fn named(n: &Named) -> str {
    return n.name()
}

fn not_an_implementer(f: &Factory) -> str {
    return named(f)
}

// §7.3: a constant in a type is folded into its uses, so it cannot run code.
struct Settings {
    pub const COMPUTED: i32 = a_runtime_value()
}

// §10.6: making a pointer from an address is `unsafe`.
fn forged(n: usize) -> ^mut u8 {
    return n as ^mut u8
}

// §5.3: bytes taken as text unchecked is `unsafe`; `str::from_utf8` is the checked way.
fn unchecked_text(bytes: []u8) -> str {
    return bytes as str
}

// §5.3: a pointer carries no length, so its slice needs an end.
fn pointer_slice_without_end(p: ^i32) -> []i32 {
    return unsafe { p[1..] }
}

// §11.2: indexing a type needs its `Index`.
fn index_without_index(p: Plain) -> i32 {
    return p[0]
}

// §9.8: `panic`'s location is not a value to format, so the placeholder has no argument.
fn located_panic(loc: SourceLocation) {
    panic!("at {}", loc)
}

// §12.7: `assert` is an ordinary function, and its condition is a `bool`.
fn assert_needs_a_bool(n: i32) {
    assert(n)
}

// §7.2: a function has one variadic parameter, with no default; a spread is the only
// variadic argument and is a slice; each argument is the element type.
fn variadic_twice(xs: ..i32, ys: ..i32) {}

fn variadic_default(xs: ..i32 = 0) {}

fn adds(xs: ..i32) -> usize {
    return xs.len
}

fn bad_variadic_calls(xs: []i32, n: i32) -> usize {
    return adds(1, ..xs) + adds(..n) + adds(1, true)
}

// §7.2: DZ0558 — a parameter after a variadic one is passed by name, by its own name,
// once, after the others, and must be passed when it has no default; nothing else is
// passed by name.
fn scaled(xs: ..i32, by: i32 = 1, needed: bool) -> usize {
    return xs.len
}

fn bad_named_calls() -> usize {
    let a = scaled(1, needed = true, bi = 2)
    let b = scaled(1, by = 2, needed = true, by = 3)
    let c = scaled(1, by = 2)
    let d = scaled(1, needed = true, 2)
    let e = adds(xs = 1)
    variadic_default(n = 1)
    return a + b + c + d + e
}

// §12.9: `format!`'s format string is a literal that fits its arguments, each of which
// implements `Format`.
struct Unwritten {
    pub n: i32
}

fn bad_format_calls(fmt: str, h: Unwritten) -> usize {
    let a = format!("{} {}", 1)
    let b = format!(fmt, 1)
    let c = format!("{:x}", 1.5)
    let d = format!("{}", h)
    return a.len() + b.len() + c.len() + d.len()
}

// §12.9: an enum, an optional and a pointer to a pointer have no `Format`; `{:p}` suits
// only a pointer, and is not filled with zeros; `error(…)` writes a pointer only by its
// address; only `format!` takes an argument by name, and only `allocator`; every
// formatting macro needs its string; and a spread has no count to check the string
// against.
enum Shade {
    Light
    Dark
}

fn bad_pointer_formats(n: i32, p: ^i32) !-> i32 {
    println!("{:p} {:08p}", n, p)
    return error("{}", p)
}

fn bad_print_calls(s: Shade, o: i32?, p: ^^i32, xs: []i32) {
    println!("{} {} {}", s, o, p)
    println!("{}", 1, allocator = Allocators::Temp)
    let t = format!("{}", 1, colour = 2)
    print!("{}", t)
    print!()
    println!("{} {}", ..xs)
}

// §8.1: a generic method's bound, a parameter no argument decides, type arguments on a
// method with none; DZ0557 a `virtual` or trait method with parameters of its own.
struct Crate2 {
    pub fn both<T: Copy>(&self, v: T) -> (T, T) {
        return (v, v)
    }

    pub fn fresh<T>() -> T {
        let t: T
        return move(t)
    }

    pub fn plain(&self) -> i32 {
        return 1
    }

    virtual fn shout<T>(&self, v: T) {
        let _ = move(v)
    }
}

trait ShowAny {
    fn show<T>(&self, v: T)
}

fn bad_generic_methods(c: &Crate2, owned: Box<i32>) -> i32 {
    let _ = c.both(move(owned))
    let _: i32 = Crate2::fresh()
    return c.plain<i32>()
}

// §14.5, 18.64: a handle converts only from a derived type to its base — not back down.
fn handle_downcast(base: Rc<Panel>, framed: Rc<Framed>) -> Rc<Framed> {
    let _ = move(framed)
    return base
}

// §14.4: parsing may find no number, so the result is an optional that must be unwrapped.
fn parse_without_or(s: str) -> i64 {
    return s.parse_i64()
}

// §14.4: `sort` needs elements that are `Ord`; a comparison must take two references.
fn sorts_the_unordered(xs: &mut List<Plain>, ys: &mut List<i32>) {
    xs.sort()
    ys.sort_by(by_value)
}

fn by_value(a: i32, b: i32) -> bool {
    return a < b
}

// §5.2: a reference reads as its value under an operator, and the value is still typed.
fn compares_a_reference_with_text(x: &i32) -> bool {
    return x == "three"
}

// §14.4: `Search` needs elements that are `Eq` and `Extend` ones that are `Copy`; a `str`
// lookup exists only for `String` keys; a set's elements must be `Hash`.
fn collections_unbounded(xs: &mut List<Plain>, ts: &mut List<Box<i32>>, m: &HashMap<i32, i32>) -> bool {
    let found = xs.contains(&Plain{ n: 1 })
    ts.fill(Box<i32>(3))
    let named = m.get_str("hero") == null
    let floats = HashSet<f32>()
    return found && named && floats.is_empty()
}

// §14.4: a `String`'s characters are decoded, not stored, so a loop cannot write them.
fn write_through_chars(s: &mut String) {
    for &mut c in s {
        c = 'x'
    }
}

// §2.5: a suffix fixes the type — out of range for it, or not the type wanted.
fn suffix_out_of_range() -> u8 {
    return 300u8
}

fn suffix_against_context() -> u16 {
    return 5u8
}

// §14.4: a `bool` is not a `Number`, so there is no random one in a range.
fn random_bool_range() -> bool {
    return Random::range(false, true)
}

// §14.4: a file call fails, so its result must be consumed; and `read` writes into its
// buffer, which must be writable.
fn file_mistakes(p: &Path) !-> void {
    File::remove(p)
    let mut f = File::open(p, .Read) or return
    let buf: [4]u8
    let _ = f.read(buf[..]) or return
}

// §11.2: unary `-` on a struct needs its `Neg`. §2.5: one past the most negative `i8`.
fn negate_without_neg(p: Plain) -> Plain {
    return -p
}

fn below_i8() -> i8 {
    return -129
}

// §10.4, 18.51: writing through a loop needs `IterableMut`, and a list behind `&` is
// read-only.
struct Readings {
    pub values: List<i32>
}

impl Iterable for Readings {
    type Iter = SliceIter<i32>

    fn iter(&self) -> SliceIter<i32> {
        return values.iter()
    }
}

fn write_through_iterable(r: Readings) {
    for &mut v in r {
        v = 0
    }
}

fn write_through_shared_list(xs: &List<i32>) {
    for &mut x in xs {
        x = 0
    }
}

// §9.1, 18.53: a `T` becomes a `T?`, never the reverse; and arms that are all `none` say
// nothing about which `T?` they are.
fn optional_is_not_a_value(o: i32?) -> i32 {
    let n: i32 = o
    return n
}

fn only_nones(alive: bool) {
    let x = if alive { none } else { none }
}

// §7.4, 18.54: an enum is compared and hashed as an integer, but not added as one.
fn enum_is_not_arithmetic(l: Layer) -> bool {
    return l + l == l
}

// §14.2: a float is not `Hash` — `NaN != NaN` — so it cannot be a `HashMap` key.
fn float_key() -> usize {
    let m = HashMap<f32, i32>()
    return m.len()
}


// §13.1: `typeinfo_of` names a type and takes nothing; `typeinfo` takes a `TypeId`.
fn reflection_in_the_wrong_form() {
    let a = typeinfo_of<i32>(1)
    let b = typeinfo(3)
}

// §7.5, 18.78: `kind` is every union's own, a union's method has nothing to dispatch to,
// and one taking `&self` cannot replace the union or be called to change it.
union Dial {
    Low {}
    High {}

    pub fn kind(&self) -> i32 {
        return 0
    }

    virtual fn turn(&self) {}

    pub fn reset(&self) {
        self = .Low{}
    }
}

fn calls_a_missing_union_method(d: Dial) {
    d.spin()
}

// §7.2, T-0036: a call reaches the constructor its arguments fit, defaults counted; two
// that both fit exactly are ambiguous.
struct Interval {
    pub lo: i32
    pub hi: i32

    Interval(lo: i32, hi: i32 = 0) {
        self.lo = lo
        self.hi = hi
    }

    Interval(width: i32) {
        self.lo = 0
        self.hi = width
    }
}

fn ambiguous_constructor() -> i32 {
    return Interval(3).hi
}

// §7.3, T-0035: a generic base is named with its arguments, and is that instance only —
// `&Badge` is a `&Frame<i32>`, never a `&Frame<f32>`.
struct Frame<T: Copy> {
    pub inner: T
}

struct Badge : Frame<i32> {
    pub text: str = ""
}

struct Unnamed : Frame {
}

fn wider(f: &Frame<f32>) -> f32 {
    return f.inner
}

fn badge_is_not_a_float_frame(b: &Badge) -> f32 {
    return wider(b)
}

// §14.4: a `Key` names one type of value — a `Key<Vec3>` is not a `Key<Counter>` — and §5.2:
// `&mut` of a read-only reference cannot make it writable.
fn wrong_key(points: &SlotMap<Vec3>, k: Key<Counter>) -> bool {
    return points.contains(k)
}

fn writable_through_read_only(v: &Vec3) {
    let w = &mut v
    w.x = 1.0
}
