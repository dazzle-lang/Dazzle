// Every line below is a deliberate type error.

pub enum Layer : u8 {
    Background = 0
    World      = 300
}

pub union Shape {
    Circle { radius: f32 }
    Rect { w: f32, h: f32 }
    Point {}
}

pub struct Vec3 {
    pub x: f32
    pub y: f32
    pub z: f32
}

pub struct Counter {
    count:      u32
    pub label:  str
    borrowed:   &Vec3

    pub fn get(&self) -> u32 {
        return count
    }

    pub fn bump(&mut self) {
        count += 1
    }

    pub fn broken_mutation(&self) {
        count += 1
    }
}

fn no_implicit_widening(small: i32) -> i64 {
    return small
}

fn literal_out_of_range() {
    let b: u8 = 300
}

fn mixed_arithmetic(a: i32, b: i64) -> i32 {
    return a + b
}

fn no_truthiness(n: i32) {
    if n {
        return
    }
}

fn bad_condition_type(v: Vec3) {
    while v {
        return
    }
}

fn unknown_field(v: Vec3) -> f32 {
    return v.w
}

fn private_field_from_here(c: Counter) -> u32 {
    return c.count
}

fn unknown_method(c: Counter) -> u32 {
    return c.increment()
}

fn immutable_receiver(c: Counter) {
    c.bump()
}

fn assign_to_immutable() {
    let total = 1
    total = 2
}

fn missing_struct_field() -> Vec3 {
    return Vec3{ x: 1, y: 2 }
}

fn unknown_struct_field() -> Vec3 {
    return Vec3{ x: 1, y: 2, z: 3, w: 4 }
}

fn wrong_argument_count(v: Vec3) -> f32 {
    return length(v, v)
}

fn length(v: Vec3) -> f32 {
    return v.x
}

fn bad_cast(v: Vec3) -> i32 {
    return v as i32
}

fn not_indexable(n: i32) -> i32 {
    return n[0]
}

fn not_dereferenceable(n: i32) -> i32 {
    return n^
}

fn non_exhaustive(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return 1
        }
        case Rect(r) {
            return 2
        }
    }
    return 0
}

fn unknown_variant(s: Shape) {
    switch s {
        case Triangle {
            return
        }
        default {
            return
        }
    }
}

fn may_fail() !-> i32 {
    return 1
}

fn maybe() -> i32? {
    return none
}

fn a_pointer() -> ^i32 {
    return null
}

fn takes_ref(x: &i32) {
}

// A fallible call must be consumed in the statement it appears in (spec §9.7).
fn unused_result() {
    may_fail()
}

// Bare `or return` propagates, and this signature cannot carry a failure (spec §9.5).
fn or_return_without_fallible() -> i32 {
    let v = may_fail() or return
    return v
}

// `or` needs something that can fail (spec §9.4).
fn or_on_plain_value(n: i32) -> i32 {
    return n or 0
}

// Only a fallible call carries an `Error` to bind (spec §9.4).
fn binding_on_optional() -> i32 {
    let v = maybe() or { e ->
        return 0
    }
    return v
}

// An `or` clause must produce the success type or diverge (spec §9.4).
fn or_clause_wrong_type() -> i32 {
    let v = maybe() or "not an i32"
    return v
}

// `or ignore` produces no value, so it cannot be bound (spec §9.4).
fn ignore_in_value_position() -> i32 {
    let v = may_fail() or ignore
    return 0
}

// `^T` → `&T` is not implicit: a pointer may be null (spec §5.2).
fn pointer_where_reference_wanted() {
    takes_ref(a_pointer())
}

fn none_without_context() -> i32 {
    let x = none
    return 0
}

fn cannot_iterate(n: i32) {
    for i in n {
        return
    }
}

// --- M5: the rules of spec §6, §7.5 and §9.2 --------------------------------

// A union variant's payload has its own field list (spec §7.5).
fn unknown_variant_field(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return c.diameter
        }
        default {
            return 0
        }
    }
}

fn wrong_variant_payload() -> Shape {
    return Shape::Circle{ w: 1 }
}

// `Error` is a struct the language provides, with the fields §9.2 lists.
fn unknown_error_field() -> i32 {
    return may_fail() or { e ->
        e.reason
    }
}

// --- M6: slices carry their writability (spec §5.3, §18.22) -----------------

// A `[]T` is a read-only view; its elements cannot be written however it is bound.
fn writes_through_a_read_only_slice(xs: []i32) {
    xs[0] = 1
}

// `[]T` does not satisfy `[]mut T` — that direction would gain the right to write.
fn narrow_then_widen(xs: []i32) {
    writes_through_a_read_only_slice(xs)
    fills(xs)
}

fn fills(dst: []mut i32) {
    dst[0] = 0
}

// Viewing an array as `[]mut T` needs the array itself to be writable.
fn immutable_array_as_mutable_slice() {
    let storage: [4]i32
    fills(storage)
}

// --- M6: generics and traits (spec §7.6, §8) --------------------------------

trait Same {
    fn eq(&self, rhs: &Self) -> bool
}

trait Rank : Same {
    fn cmp(&self, rhs: &Self) -> i32
}

// §8.1: a body may only do what its bounds allow, and this is reported here, inside the
// generic, rather than at any instantiation.
fn beyond_its_bounds<T: Same>(a: T, b: T) -> bool {
    return a.cmp(&b) == 0
}

// §8.2: an unbounded `T` has no members at all.
fn unbounded_has_no_members<T>(a: T) -> i32 {
    return a.count
}

// §8.1: a bound must name a trait.
fn bound_is_not_a_trait<T: Layer>(a: T) -> i32 {
    return 0
}

// §7.6: `impl Rank` obliges `cmp`, and `Rank : Same` obliges an `impl Same` as well.
struct Incomplete {
    m_value: i32
}

impl Rank for Incomplete {
}

// §7.6: implemented, but not with the declared signature.
struct WrongSignature {
    m_value: i32
}

impl Same for WrongSignature {
    fn eq(&self, rhs: &WrongSignature) -> i32 {
        return 0
    }
}

struct Plain {
    pub n: i32
}

// §8.1: the type chosen for a bounded parameter must satisfy the bound.
fn argument_does_not_satisfy(p: Plain) -> bool {
    return unrelated(p, p)
}

fn unrelated<T: Same>(a: T, b: T) -> bool {
    return a.eq(&b)
}

// §8.1: a parameter no argument determines cannot be inferred.
fn uninferrable<T: Same>() -> i32 {
    return 0
}

fn calls_uninferrable() -> i32 {
    return uninferrable()
}

// §8.1: the wrong number of type arguments.
struct OneParam<T> {
    m_value: T
}

fn too_many_type_args(p: &OneParam<i32, f32>) -> i32 {
    return 0
}

// --- M6: array literals (spec §5.3) -----------------------------------------

// The length is exactly what is written; a short literal is not a zero-fill.
fn array_literal_wrong_length() -> i32 {
    let a: [8]i32 = [1, 2]
    return a[0]
}

// Every element has the same type.
fn array_literal_elements_disagree() -> i32 {
    let a = [1, "two", 3]
    return 0
}

// An empty literal has nothing to read an element type from.
fn empty_array_literal_without_context() -> i32 {
    let a = []
    return 0
}

// A temporary array cannot be stored as a slice: the slice would already dangle.
fn array_literal_stored_as_a_slice() -> i32 {
    let s: []i32 = [1, 2, 3]
    return s[0]
}

fn array_literal_returned_as_a_slice() -> []i32 {
    return [1, 2, 3]
}

// --- M6: operators are traits (spec §11.2) ----------------------------------

// Comparing a struct that implements neither `Eq` nor `Ord`. This used to reach C++ and
// fail there, which invariant 7 forbids.
fn compares_without_eq(a: Plain, b: Plain) -> bool {
    return a == b
}

fn orders_without_ord(a: Plain, b: Plain) -> bool {
    return a < b
}

// Arithmetic likewise: `+` is `Add`.
fn adds_without_add(a: Plain, b: Plain) -> Plain {
    return a + b
}

// `impl Mul<f32>` accepts an `f32` on the right, not a `Plain`.
pub struct Scaled {
    pub v: f32
}

impl Mul<f32> for Scaled {
    type Output = Scaled

    fn mul(&self, rhs: f32) -> Scaled {
        return Scaled{ v: v * rhs }
    }
}

fn wrong_rhs(a: Scaled, b: Plain) -> Scaled {
    return a * b
}

// --- M6: compile-time queries, constants and formatting ---------------------

// §5.5: only the listed queries exist.
fn unknown_query<T>(x: &T) -> usize {
    return T::length
}

// §5.5: `sizeof` takes a type, not a value.
fn sizeof_of_a_value(n: i32) -> usize {
    return sizeof(n)
}

// §5.3: an array length must fold to a non-negative constant.
fn not_a_constant_length(n: usize) -> i32 {
    let a: [n]i32
    return 0
}

// The builtins codegen reads by position have their argument counts checked.
fn alloc_without_alignment() -> ^u8 {
    return alloc(16)
}

// §12.9: the format string is checked against its arguments, at compile time.
fn format_count_mismatch(x: i32) {
    println("{} and {}", x)
}

fn format_spec_does_not_fit(f: f32) {
    println("{:x}", f)
}

fn format_not_a_literal(s: str) {
    println(s)
}

fn format_unformattable(v: Vec3) {
    println("{}", v)
}

fn format_interpolation(hp: i32) {
    println("hp is {hp}", hp)
}

// --- r12: `unsafe` (spec §5.2) ---------------------------------------------------------

unsafe fn raw_write(p: ^mut i32) {
    p^ = 1
}

fn deref_outside_unsafe(p: ^i32) -> i32 {
    return p^
}

fn field_through_pointer(v: ^Vec3) -> f32 {
    return v.x
}

fn index_a_pointer(p: ^i32) -> i32 {
    return p[1]
}

fn call_an_unsafe_fn(p: ^mut i32) {
    raw_write(p)
}

// One missing `unsafe`, one diagnostic — not one for `destroy` and one for `p[0]`.
fn placement_outside_unsafe(p: ^mut i32) {
    destroy(p[0])
}

fn pointer_cast_outside_unsafe(p: ^i32) -> ^u8 {
    return p as ^u8
}

// --- r21: a runtime `str` has no terminating zero, so it is not a `cstr` (§5.3, §18.39) ---

fn runtime_str_to_cstr(s: str) -> cstr {
    return s as cstr
}

// --- r18: `^T` and `^mut T` (spec §5.2, §18.37) ------------------------------------------

// `.ptr` is as writable as its view, so a read-only slice gives a `^T` (spec §5.3).
fn writable_pointer_from_a_read_only_slice(xs: []i32) -> ^mut i32 {
    return xs.ptr
}

// A `^T` is only read through.
fn write_through_a_read_only_pointer(p: ^i32) {
    unsafe { p^ = 1 }
}

fn field_through_a_read_only_pointer(v: ^Vec3) {
    unsafe { v.x = 1.0 }
}

// Neither a `^T` nor a `&T` becomes a `^mut T`: each would gain the right to write.
fn read_only_to_writable(p: ^i32) -> ^mut i32 {
    return p
}

fn shared_reference_to_writable(r: &i32) -> ^mut i32 {
    return r
}

// `construct` and `memcpy` write their destination.
fn construct_through_a_read_only_pointer(p: ^i32) {
    unsafe { construct(p[0], 1) }
}

fn memcpy_into_a_read_only_pointer(dst: ^u8, src: ^u8) {
    unsafe { memcpy(dst, src, 4) }
}

// --- r12: `Copy` (spec §8.2, §18.26) -----------------------------------------------------

fn keep_copy<T: Copy>(x: T) -> T {
    return x
}

pub struct Unique {
}

impl Drop for Unique {
    fn drop(&mut self) {}
}

fn copy_bound_unsatisfied(u: Unique) -> Unique {
    return keep_copy(move(u))
}

// --- r12: one trait at several arguments (spec §18.27) ----------------------------------

// A struct declares each method once; implementations of one trait at several arguments
// live in separate `impl` blocks.
pub struct Twice {
    pub fn go(&self) {}
    pub fn go(&self) {}
}

pub struct Widen {
}

impl Mul<i64> for Widen {
    type Output = Widen

    fn mul(&self, rhs: i64) -> Widen {
        return Widen{}
    }
}

impl Mul<u8> for Widen {
    type Output = Widen

    fn mul(&self, rhs: u8) -> Widen {
        return Widen{}
    }
}

// `3` fits both an `i64` and a `u8`, and would default to neither.
fn ambiguous_operand(w: Widen) -> Widen {
    return w * 3
}

// --- r13: implementations (spec §6.1, §7.6) ----------------------------------------------

// The orphan rule: neither `Add` nor `i32` is declared in this module.
impl Add for i32 {
    type Output = i32

    fn add(&self, rhs: i32) -> i32 {
        return 0
    }
}

// An implementation for every type at once.
impl<T> Same for T {
    fn eq(&self, rhs: &T) -> bool {
        return false
    }
}

// `Drop` is a destructor, so it belongs to a struct of this module.
impl Drop for f32 {
    fn drop(&mut self) {}
}

// One implementation of a trait per type and arguments.
struct Twin {
}

impl Same for Twin {
    fn eq(&self, rhs: &Twin) -> bool {
        return true
    }
}

impl Same for Twin {
    fn eq(&self, rhs: &Twin) -> bool {
        return false
    }
}

// An implementation holds exactly the trait's methods.
struct Extra {
}

impl Same for Extra {
    fn eq(&self, rhs: &Extra) -> bool {
        return true
    }

    fn also(&self) -> i32 {
        return 0
    }
}

// Two traits both provide `shout`; the call has to name the one it means.
trait Yell {
    fn shout(&self) -> i32
}

trait Holler {
    fn shout(&self) -> i32
}

struct Crier {
}

impl Yell for Crier {
    fn shout(&self) -> i32 {
        return 1
    }
}

impl Holler for Crier {
    fn shout(&self) -> i32 {
        return 2
    }
}

fn ambiguous_trait_method(c: Crier) -> i32 {
    return c.shout()
}

// `drop` is the destructor: it runs by itself, and calling it would run it twice.
fn drop_called_by_name(u: Unique) {
    u.drop()
}

// §9: an optional is compared only with `none`; two optionals have no `==`.
fn compares_two_optionals(a: i32?, b: i32?) -> bool {
    return a == b
}

// §9.4: `if let` takes a `T?` or a `^T`. A fallible call carries an `Error` that its
// `else` would drop, and a plain value has nothing to take out.
fn if_let_on_a_fallible_call() {
    if let v = may_fail() {
        return
    }
}

fn if_let_on_a_plain_value(n: i32) {
    if let v = n {
        return
    }
}

// §7.3, 18.32: struct inheritance, one deliberate failure per rule.
pub struct Panel {
    pub left: i32 = 0
}

pub struct Framed : Panel {
    pub thickness: i32 = 1
}

// A base must be a struct: a trait is implemented, not inherited from.
pub struct NotAStruct : Yell {
    pub n: i32 = 0
}

// A base's field cannot be redeclared — a name means one thing in a type.
pub struct Redeclares : Panel {
    pub left: i32 = 5
}

// A whole `Framed` is not a `Panel`: copying one would drop what `Framed` adds.
fn slices_by_value(f: Framed) -> i32 {
    let p: Panel = f
    return p.left
}

// A read-only reference does not become a writable one on the way to the base.
fn widens_a_read_only_reference(f: &Framed) {
    writes_a_panel(f)
}

fn writes_a_panel(p: &mut Panel) {
    p.left = 1
}

// A base with a constructor has to be constructed through it.
pub struct Measured {
    pub w: i32 = 0

    Measured(width: i32) {
        w = width
    }
}

pub struct ForgetsTheBase : Measured {
    pub extra: i32 = 0

    ForgetsTheBase(e: i32) {
        extra = e
    }
}

// A base initialiser names the one base the struct declares, and nothing else.
pub struct InitialisesTheWrongBase : Panel {
    InitialisesTheWrongBase() : Measured(1) {}
}

// The base is built before the constructor begins, so there is nothing to return from.
pub struct ReturnsFromTheBase : Measured {
    ReturnsFromTheBase(width: i32?) : Measured(width or return) {}
}

// A type with a constructor is built by calling it, not with a literal.
fn literal_of_a_type_with_a_constructor() -> i32 {
    let m = Measured{ w: 2 }
    return m.w
}

// §7.3, 18.32: `virtual`, `override` and `protected`, one deliberate failure per rule.
pub struct Abstract {
    protected inner: i32 = 0

    pub virtual fn area(&self) -> i32
    pub virtual fn label(&self) -> i32 { return 1 }
    pub fn fixed(&self) -> i32 { return 2 }
}

// Abstract: inherits a body-less `virtual` and does not override it.
pub struct StillAbstract : Abstract {
    pub n: i32 = 0
}

// An abstract type has no values, so it cannot be held by value or built.
fn holds_an_abstract_by_value(a: Abstract) -> i32 {
    return a.area()
}

fn builds_an_abstract() -> i32 {
    let a = StillAbstract{}
    return a.n
}

// `override` with nothing to override.
pub struct OverridesNothing {
    pub override fn missing(&self) -> i32 { return 0 }
}

// `override` aimed at a method that is not `virtual`.
pub struct OverridesAFixedOne : Abstract {
    pub override fn area(&self) -> i32 { return 1 }
    pub override fn fixed(&self) -> i32 { return 3 }
}

// An override whose signature has drifted from the base's.
pub struct DriftedSignature : Abstract {
    pub override fn area(&self) -> i32 { return 1 }
    pub override fn label(&self, extra: i32) -> i32 { return extra }
}

// Redeclaring a base's method without `override` is a shadow, which Dazzle has not got.
pub struct ShadowsAMethod : Abstract {
    pub override fn area(&self) -> i32 { return 1 }
    pub fn label(&self) -> i32 { return 9 }
}

// `protected` is for the family, not for everyone.
pub struct Unrelated {
    pub fn peeks(&self, a: &Abstract) -> i32 {
        return a.inner
    }
}

// `Abstract::area` is called on an `Abstract` or something that inherits from one.
fn base_call_on_an_unrelated_type(u: &Unrelated) -> i32 {
    return Abstract::label(u)
}

// A `#[test]` is a function the runner calls with nothing and reads nothing back
// from: it passes by returning and fails by panicking (spec §19 M14).
#[test]
fn a_test_that_takes_an_argument(n: i32) {}

#[test]
fn a_test_that_returns_a_value() -> i32 {
    return 1
}

#[test]
fn a_test_that_is_fallible() !-> i32 {
    return 1
}

#[test]
fn a_test_with_type_parameters<T>() {}

// --- M8: `switch` on constants (spec §10.3) ----------------------------------------------

fn a_case_label_computed_at_run_time(n: i32, m: i32) -> i32 {
    switch n {
        case m { return 1 }
        default { return 0 }
    }
}

fn a_case_value_on_a_union(s: Shape) -> i32 {
    switch s {
        case 3 { return 1 }
        default { return 0 }
    }
}

fn the_same_case_twice(n: i32) -> i32 {
    switch n {
        case 1, 2 { return 1 }
        case 2 { return 2 }
        default { return 0 }
    }
}

// §7.5: a bare variant carries the struct it names, and there is no `Stopped` struct. A
// variant with no payload is written `Stopped {}`.
union Motion {
    Stopped
}
