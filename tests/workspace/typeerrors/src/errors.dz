// Every line below is a deliberate type error.

pub enum Layer : u8 {
    Background = 0
    World      = 300
}

pub union Shape {
    Circle { radius: f32 }
    Rect { w: f32, h: f32 }
    Point
}

pub struct Vec3 {
    pub x: f32
    pub y: f32
    pub z: f32
}

pub struct Counter {
    count:      u32
    pub label:  str
    borrowed:   &Vec3

    pub fn get(&self) -> u32 {
        return count
    }

    pub mut fn bump(&mut self) {
        count += 1
    }

    pub fn broken_mutation(&self) {
        count += 1
    }
}

fn no_implicit_widening(small: i32) -> i64 {
    return small
}

fn literal_out_of_range() {
    let b: u8 = 300
}

fn mixed_arithmetic(a: i32, b: i64) -> i32 {
    return a + b
}

fn no_truthiness(n: i32) {
    if n {
        return
    }
}

fn bad_condition_type(v: Vec3) {
    while v {
        return
    }
}

fn unknown_field(v: Vec3) -> f32 {
    return v.w
}

fn private_field_from_here(c: Counter) -> u32 {
    return c.count
}

fn unknown_method(c: Counter) -> u32 {
    return c.increment()
}

fn immutable_receiver(c: Counter) {
    c.bump()
}

fn assign_to_immutable() {
    let total = 1
    total = 2
}

fn missing_struct_field() -> Vec3 {
    return Vec3{ x: 1, y: 2 }
}

fn unknown_struct_field() -> Vec3 {
    return Vec3{ x: 1, y: 2, z: 3, w: 4 }
}

fn wrong_argument_count(v: Vec3) -> f32 {
    return length(v, v)
}

fn length(v: Vec3) -> f32 {
    return v.x
}

fn bad_cast(v: Vec3) -> i32 {
    return v as i32
}

fn not_indexable(n: i32) -> i32 {
    return n[0]
}

fn not_dereferenceable(n: i32) -> i32 {
    return n^
}

fn non_exhaustive(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return 1
        }
        case Rect(r) {
            return 2
        }
    }
    return 0
}

fn unknown_variant(s: Shape) {
    switch s {
        case Triangle {
            return
        }
        default {
            return
        }
    }
}

fn may_fail() !-> i32 {
    return 1
}

fn maybe() -> i32? {
    return none
}

fn a_pointer() -> ^i32 {
    return null
}

fn takes_ref(x: &i32) {
}

// A fallible call must be consumed in the statement it appears in (spec §9.7).
fn unused_result() {
    may_fail()
}

// Bare `or return` propagates, and this signature cannot carry a failure (spec §9.5).
fn or_return_without_fallible() -> i32 {
    let v = may_fail() or return
    return v
}

// `or` needs something that can fail (spec §9.4).
fn or_on_plain_value(n: i32) -> i32 {
    return n or 0
}

// Only a fallible call carries an `Error` to bind (spec §9.4).
fn binding_on_optional() -> i32 {
    let v = maybe() or { e ->
        return 0
    }
    return v
}

// An `or` clause must produce the success type or diverge (spec §9.4).
fn or_clause_wrong_type() -> i32 {
    let v = maybe() or "not an i32"
    return v
}

// `or ignore` produces no value, so it cannot be bound (spec §9.4).
fn ignore_in_value_position() -> i32 {
    let v = may_fail() or ignore
    return 0
}

// `^T` → `&T` is not implicit: a pointer may be null (spec §5.2).
fn pointer_where_reference_wanted() {
    takes_ref(a_pointer())
}

fn none_without_context() -> i32 {
    let x = none
    return 0
}

fn cannot_iterate(n: i32) {
    for i in n {
        return
    }
}

// --- M5: the rules of spec §6, §7.5 and §9.2 --------------------------------

// A union variant's payload has its own field list (spec §7.5).
fn unknown_variant_field(s: Shape) -> f32 {
    switch s {
        case Circle(c) {
            return c.diameter
        }
        default {
            return 0
        }
    }
}

fn wrong_variant_payload() -> Shape {
    return Shape::Circle{ w: 1 }
}

// `Error` is a struct the language provides, with the fields §9.2 lists.
fn unknown_error_field() -> i32 {
    return may_fail() or { e ->
        e.reason
    }
}
