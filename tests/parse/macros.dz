// Macros (spec §12): a declaration with `syntax` rules, every capture shape, an optional
// group, and `#for` / `#if` / `#error` in `expand`; then an invocation in each position.

pub macro machine -> decl {
    syntax Field {
        $name: ident : $type: type $( = $default: expr )?
    }

    syntax State {
        state $name: ident $( ( $fields: [,]Field ) )? {
            $body: code
        }
    }

    pattern {
        $name: ident ( $ctx: type ) {
            $states: []State
        }
    }

    expand {
        #if !$states {
            #error($name, "a state machine needs at least one state")
        }
        #for s in $states {
            struct $s.name {
                #for f in $s.fields {
                    $f.name: $f.type #if $f.default { = $f.default }
                }
            }
        }
        union $name {
            #for s in $states {
                $s.name
            }
        }
        #if DEBUG {
            fn debug_only() {}
        }
    }
}

macro max -> expr {
    pattern { ( $a: expr , $b: expr ) }
    expand { if $a > $b { $a } else { $b } }
}

macro trace -> stmt {
    pattern { ( $what: literal $( at $level: literal )? ) }
    expand { println!("{}", $what) }
}

#machine Door(DoorCtx) {
    state Closed
    state Opening(t: f32 = 0) {
        t += 1
    }
}

#engine::machine Gate(GateCtx) {
    state Shut
}

union Light {
    Off {}
    On { level: i32 }

    pub fn level(&self) -> i32 {
        return 0
    }
}

fn uses() {
    let m = max!(1, 2)
    let n = engine::max![3, 4]
    trace!("here")
    trace!("there" at 2)
    let at = #location
}
