fn precedence() {
    // spec §11.1, loosest to tightest
    let a = x || y && z
    let b = x == y && p != q
    let c = 1 | 2 ^^ 3 & 4
    let d = 1 & 2 << 3
    let e = 1 + 2 * 3 - 4 / 5 % 6
    let f = a as i64 * b
    let g = -x + !y
    let h = ~flags & mask
    let i = (a + b) * c
    let j = a + b * c
}

