// Ties and `kills` clauses (spec §6.7): a struct declaring its ties, its elements' and ones
// reaching into a field's own, a reference parameter and a returned reference saying where
// they point, and clauses on declarations, trait methods and function types. Parsed only.

pub struct Grid<T> {
    m_cells: own ^mut T = null
    m_names: List<String>
    pub width: i32 = 0
    tie @cells = m_cells
    tie @names = m_names
    tie [*] = m_cells[*]
    tie @all = (m_names@items, m_names[*]@text)

    pub fn first(&self) -> ^T in self@cells {
        return null
    }

    pub fn push(&mut self, v: T) kills self@cells {}

    pub fn clear(&mut self) kills self@cells, self[*] {}

    pub fn rename(&mut self, i: usize) kills self@names[*]@text {}

    pub fn len(&self) -> usize {
        return 0
    }
}

union Slot {
    Full { value: String }
    Empty
}

trait System {
    fn run(&mut self, world: &mut World) kills world
}

fn think(e: &mut Enemy in world, world: &mut World) kills world.enemies@items {
    e.hp -= 1
}

fn load(path: str) !-> Mesh kills cache.meshes@items {}

fn view(list: &List<String>, i: usize) -> str in list[*]@text {
    return list[i].as_str()
}

fn longer(a: str, b: str) -> str in (a, b) {
    return a
}

fn halves(s: str, sep: str) -> (str, str)? in s kills cache@items {
    return none
}

struct Hooks {
    pub on_spawn: fn(world: &mut World, e: Enemy) kills world.spawned@items
    pub on_reset: fn(world: &mut World) kills (world.enemies@items, world.spawned@items)
    pub plain: fn(i32, f32) -> bool
    pub pick: fn(a: &Enemy, b: &Enemy) -> &Enemy in (a, b)
    pub grow: fn(xs: &mut List<i32>) -> ^i32 in xs@items kills xs@items
}

fn each(f: fn(xs: &mut List<i32>) kills xs@items, n: i32) {}

fn each_first(f: fn(xs: &List<i32>) -> ^i32 in xs, n: i32) {}

// `view` (spec §6.7) is a keyword only before `struct`, `type` and a type parameter, so it
// stays a name everywhere else: a parameter, a local, a field.
pub view struct Cursor<view I: Iterate, T> {
    pub inner: I
    pub view: i32 = 0
}

trait Walk {
    view type Steps : Iterate
    type Plain
}

fn count<view T: Iterate, view>(it: T, view: i32) -> i32 {
    let view = view + 1
    return view
}

// A static, bare or through its module, in a clause and an `in` (spec §6.7).
fn add(v: i32) kills SCORES.list@items, world::LOG.lines@items {}
fn first() -> &i32 in world::SCORES.list@items {}
fn each(f: fn(v: i32) kills (SCORES@items, world::LOG)) {}

// `sends` after `kills`, or before it; `to` stays a name elsewhere; `in x@home` on an
// owned result (D-0097).
fn give(from: &mut List<String>, store: &mut Store) kills from@items, from[*] sends from[*] to store, from[*] to KEPT {}
fn put(&mut self, v: T) sends v to self kills self@items {}
fn last(xs: &mut List<String>) -> String in xs@home kills xs@items, xs[*] {}
fn to(to: i32) -> i32 { return to }

// A function type takes `sends` and `in x@home` as a declaration does; more than one pair is
// parenthesised, and a comma after a bare pair begins the next parameter (T-0202).
fn put_with(f: fn(xs: &mut List<String>, s: String) kills xs@items sends s to xs, n: i32) {}
fn take_with(f: fn(xs: &mut List<String>) -> String in xs@home sends (xs[*] to KEPT, xs[*] to LOG) kills xs) {}
