// Ties and `kills` clauses (spec §6.7): a struct declaring its ties, its elements' and ones
// reaching into a field's own, a reference parameter and a returned reference saying where
// they point, and clauses on declarations, trait methods and function types. Parsed only.

pub struct Grid<T> {
    m_cells: own ^mut T = null
    m_names: List<String>
    pub width: i32 = 0
    tie @cells = m_cells
    tie @names = m_names
    tie [*] = m_cells[*]
    tie @all = (m_names@items, m_names[*]@text)

    pub fn first(&self) -> ^T in self@cells {
        return null
    }

    pub fn push(&mut self, v: T) kills self@cells {}

    pub fn clear(&mut self) kills self@cells, self[*] {}

    pub fn rename(&mut self, i: usize) kills self@names[*]@text {}

    pub fn len(&self) -> usize {
        return 0
    }
}

union Slot {
    Full { value: String }
    Empty
}

trait System {
    fn run(&mut self, world: &mut World) kills world
}

fn think(e: &mut Enemy in world, world: &mut World) kills world.enemies@items {
    e.hp -= 1
}

fn load(path: str) !-> Mesh kills cache.meshes@items {}

fn view(list: &List<String>, i: usize) -> str in list[*]@text {
    return list[i].as_str()
}

fn longer(a: str, b: str) -> str in (a, b) {
    return a
}

fn halves(s: str, sep: str) -> (str, str)? in s kills cache@items {
    return none
}

struct Hooks {
    pub on_spawn: fn(world: &mut World, e: Enemy) kills world.spawned@items
    pub on_reset: fn(world: &mut World) kills (world.enemies@items, world.spawned@items)
    pub plain: fn(i32, f32) -> bool
}

fn each(f: fn(xs: &mut List<i32>) kills xs@items, n: i32) {}
