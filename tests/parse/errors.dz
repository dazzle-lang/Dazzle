// `drop` is an implementation of the `Drop` trait, not a member (spec §6.1). Placed above
// `MissingBrace`, whose unclosed body takes in everything after it.
struct OldStyle {
    drop() {}
}

// `mut fn` was removed: the receiver says whether a method mutates (spec §7.3, §18.34).
// Reported once, and the method still parses. Also above `MissingBrace`.
struct Removed {
    pub mut fn bump(&mut self) {}
}

// A tie path that breaks off is reported once, and the function, its body and what
