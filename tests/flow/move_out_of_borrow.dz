// The source of a move is reset to its defaults (spec §6.4), which is a right a borrow
// does not confer — so nothing may be moved out from behind a `^` or a `&`.
// expect: DZ0402

pub struct Res {
    m_p: own ^i32
    drop() {}
}

fn take(r: Res) -> bool {
    return true
}

fn through_a_pointer(p: ^Res) -> bool {
    return take(move(p^))
}
