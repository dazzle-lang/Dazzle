// The source of a move is reset to its defaults (spec §6.4), which is a right a borrow
// does not confer — so nothing may be moved out from behind a `^` or a `&`. `unsafe`
// allows the read through the pointer (spec §5.2); it does not relax ownership.
// expect: DZ0402

pub struct Res {
    m_p: own ^mut i32
}

impl Drop for Res {
    fn drop(&mut self) {}
}

fn take(r: Res) -> bool {
    return true
}

fn through_a_pointer(p: ^mut Res) -> bool {
    unsafe { return take(move(p^)) }
}
