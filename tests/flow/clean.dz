// Ownership code that is correct, and must produce nothing at all. Half of the pair:
// an analysis that rejects valid code is as broken as one that accepts invalid code.
// expect: (none)

pub struct Res {
    m_p: own ^mut i32

    Res(p: ^mut i32) {
        m_p = p
    }

    pub fn live(&self) -> bool {
        return m_p != null
    }
}

impl Drop for Res {
    fn drop(&mut self) {
        if m_p != null {
            unsafe { m_p^ = 0 }
        }
    }
}

// Copyable: it declares a `copy`, so ordinary assignment duplicates it (spec §6.3).
pub struct Tally {
    pub n: i32
}

impl Copy for Tally {
    fn copy(&mut self, other: &Self) {
        n = other.n
    }
}

impl Drop for Tally {
    fn drop(&mut self) {}
}

pub struct Holder {
    pub a: Res
    pub b: Res
}

fn take(r: Res) -> bool {
    return r.live()
}

fn moves_are_fine(r: Res) -> bool {
    return take(move(r))
}

// A move on one branch and a move on the other still leaves nothing live after the join.
fn both_branches(r: Res, flag: bool) -> bool {
    if flag {
        return take(move(r))
    }
    return take(move(r))
}

// Assigning to a moved-from binding puts a value back in it (spec §6.4).
fn reassignment_revives(p: ^mut i32, q: ^mut i32) -> bool {
    let mut r = Res(p)
    let first = take(move(r))
    r = Res(q)
    return take(move(r)) && first
}

// Every field moved out separately is not a partial move of anything still read.
fn field_by_field(h: Holder) -> bool {
    let x = take(move(h.a))
    let y = take(move(h.b))
    return x && y
}

// A copyable type needs no `move` anywhere.
fn copies_are_fine(t: Tally) -> i32 {
    let a = t
    let b = t
    return a.n + b.n
}

// A union is copyable when every variant is (spec §7.5, 18.52): `Tally` has a `copy`.
pub union Counted {
    Nothing {}
    Tally
}

fn union_copies_are_fine(c: Counted) -> bool {
    let a = c
    let b = c
    return switch a {
        case Nothing { true }
        case Tally { switch b { case Nothing { false } case Tally { true } } }
    }
}

// A move-only union moves like any move-only value.
pub union Owned {
    Nothing {}
    Res
}

fn union_moves_are_fine(o: Owned) -> bool {
    let kept = move(o)
    return switch kept {
        case Nothing { false }
        case Res(&r) { r.live() }
    }
}

// Reading through a reference is not a move.
fn borrowing_is_not_moving(r: &Res) -> bool {
    return r.live()
}

// An exhaustive `switch` returns on every path even with no `default` (spec §10.3).
fn exhaustive_switch_returns(n: i32) -> i32 {
    let mut total = 0
    for i in 0..n {
        total += i
    }
    return total
}

// A returned view is in its input (spec §6.7): an iterator used before its list grows, a
// view in either of two lists after only an unrelated one changes, and a reassigned
// iterator, are fine. `pop` hands back the element, which points wherever it did, not into
// the list.
fn walked_then_grown(xs: &mut List<i32>) kills xs@items {
    let mut it = xs.iter()
    let _ = it.valid()
    xs.push(1)
    it = xs.iter()
    let _ = it.valid()
}

// An item outlives the iterator it came from: it is in what the iterator views, through the
// tie a view struct declares on its view field (spec §6.7). So is a piece of a split.
fn first_of(xs: &List<i32>) -> &i32 {
    let it = xs.iter()
    return it.get()
}

fn first_piece(line: &String) -> &str {
    let parts = line.as_str().split(",")
    return parts.get()
}

fn pick(a: &List<i32>, b: &List<i32>) -> &List<i32> in (a, b) {
    return b
}

fn only_another_changes(a: &List<i32>, b: &List<i32>, c: &mut List<i32>) kills c@items {
    let x = pick(a, b)
    c.push(1)
    let _ = x.len()
}

fn popped_text_survives(names: &mut List<const &str>) kills names@items {
    let s = names.pop() or return
    names.push("x")
    let _ = s.len
}

// A view struct given to a function stands for what it views (spec §6.7, D-0093): an item
// of a temporary iterator outlives it, in the list, and so does one from an iterator taken
// by value.
fn first_item<view T: Iterate>(it: &T) -> T::Item {
    return it.get()
}

fn taken<view T: Iterate>(it: T) -> T::Item {
    return it.get()
}

fn kept_items(xs: &List<i32>) -> i32 {
    let a = first_item(&xs.iter())
    let b = taken(xs.iter())
    return a + b
}

// §6.5: a scope's drops and defers run in reverse order of declaration, so a defer
// sees the locals declared before it alive (T-0130).
fn noted(s: ^String) {}

fn deferred_reads_an_earlier_local() {
    let s = String::from("earlier")
    let p: ^String = &s
    defer noted(p)
}

// §6.7 (D-0094 point 7): a static named in a clause, a reference into it used before the
// kill and got again after, a result tied to it, and a counter written with no clause.
pub struct Shelf {
    pub books: List<i32> = List<i32>()
    pub reads: i32 = 0
}

static SHELF: Shelf = Shelf{}

fn shelve(v: i32) kills SHELF.books@items {
    SHELF.books.push(v)
}

fn first_book() -> &i32 in SHELF.books@items {
    return &SHELF.books[0]
}

fn read_twice() kills SHELF.books@items {
    shelve(1)
    let first = first_book()
    println!("{}", first)
    shelve(2)
    println!("{}", first_book())
    SHELF.reads += 1
}

// A call through a trait object kills the object, so its clause says so, and a reference
// into the object is taken again after it (T-0203).
trait Sink {
    fn put(&mut self, v: i32) kills self
}

impl Sink for List<i32> {
    fn put(&mut self, v: i32) kills self@items {
        self.push(v)
    }
}

fn put_through(sink: &mut Sink) kills sink {
    sink.put(1)
}

fn read_after_put(xs: &mut List<i32>) kills xs {
    println!("{}", xs[0])
    put_through(xs)
    let first = &xs[0]
    println!("{}", first)
}

// A number cast from an element is a copy of it, not a view: `xs[i]` on a `let mut` list is
// `index_mut`'s `&mut i32` (§11.2), and the cast reads through it.
fn element_as_number() -> usize {
    let mut xs = List<i32>()
    xs.push(1)
    let v = xs[0]
    return xs[0] as usize + v as usize
}
