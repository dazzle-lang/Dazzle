// Spec §6.4, D-0106: a borrow gives no right to reset what it points at, so a value that is
// not plain is not moved out through one — a cloneable `String` as much as a resource. Plain
// data, an `i32` field, copies.
// expect: DZ0402

pub struct Named {
    pub name: String
    pub n: i32
}

fn steal(p: &Named) -> String {
    return p.name
}

fn plain(p: &Named) -> i32 {
    return p.n
}
