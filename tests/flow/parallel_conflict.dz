// Spec §22.3: the calls of `parallel { … }` run at the same time, so a place one of them
// writes, by `&mut`, through a `&mut self` receiver, or by being moved into it, is touched by
// no other. Refused: a write beside a read, two writes, a move beside a read, and two
// elements not proven apart. Still legal: reads beside reads, writes to separate fields,
// elements whose indices differ, and a plain value copied into two calls.
// expect: DZ0424, DZ0424, DZ0424, DZ0424

struct World {
    pub positions: List<i32>
    pub velocities: List<i32>
    pub cells: [4]i32
    pub step: i32
}

fn physics(positions: &mut List<i32>, velocities: &List<i32>) {
    for i in 0..positions.len() {
        positions[i] += velocities[i]
    }
}

fn render(positions: &List<i32>) {
    println!("{}", positions.len())
}

fn bump(n: &mut i32) {
    n += 1
}

fn keep(xs: List<i32>) {
    println!("{}", xs.len())
}

fn show(n: i32) {
    println!("{}", n)
}

fn refused(w: &mut World, i: usize) lends w {
    let mut a = 0
    parallel {
        physics(&mut w.positions, &w.velocities)
        render(&w.positions)
    }
    parallel {
        bump(&mut a)
        bump(&mut a)
    }
    let mut cells = [0, 0, 0]
    parallel {
        bump(&mut cells[i])
        bump(&mut cells[0])
    }
    let xs = List<i32>()
    parallel {
        render(&xs)
        keep(xs)
    }
}

fn allowed(w: &mut World) lends w {
    parallel {
        render(&w.positions)
        render(&w.positions)
        render(&w.velocities)
    }
    parallel {
        physics(&mut w.positions, &w.velocities)
        bump(&mut w.step)
        bump(&mut w.cells[0])
        bump(&mut w.cells[3])
    }
    let n = 4
    parallel {
        show(n)
        show(n)
    }
}

fn main() {
    let mut w = World{ positions: List<i32>(), velocities: List<i32>(), cells: [0, 0, 0, 0], step: 0 }
    refused(&mut w, 1)
    allowed(&mut w)
}
