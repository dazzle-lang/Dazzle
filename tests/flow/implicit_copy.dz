// Spec §6.3, D-0106: a type that owns something and has no `impl Clone` cannot be copied;
// handing it on moves it, and `.clone()` asks for what it cannot do.
// expect: DZ0403

pub struct Res {
    m_p: own ^mut i32

    pub fn live(&self) -> bool {
        return m_p != null
    }
}

impl Drop for Res {
    fn drop(&mut self) {}
}

fn copied(r: Res) -> bool {
    let other = r.clone()
    return other.live() && r.live()
}
