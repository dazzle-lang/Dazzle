// Optional captures and groups, separators, repetition through a `syntax` rule, `#if` on a
// capture and on a build flag (spec §12.3, §12.10).

macro record -> decl {
    syntax Field { $name: ident : $type: type $( = $default: expr )? }

    pattern { $name: ident ( $fields: [,]Field ) $( : $doc: literal )? }

    expand {
        struct $name {
            #for f in $fields {
                pub $f.name: $f.type #if $f.default { = $f.default } #else { = 0 }
            }

            pub fn values(&self) -> [3]f32 {
                return [#for f in $fields[,] { $f.name }]
            }

            pub fn about() -> str {
                return #if $doc { $doc } #else { "no description" }
            }

            #if DEBUG {
                pub fn checked(&self) -> bool {
                    return true
                }
            }
        }
    }
}

#record Size(w: f32, h: f32 = 2, d: f32 = 0.5) : "a box"
#record Plain(a: f32, b: f32, c: f32)

fn main() {
    let s = Size{}
    #println("{} {} {}", s.values()[1], Size::about(), Plain::about())
}
