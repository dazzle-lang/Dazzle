// expect: DZ0599
// What a pass reads from outside the loop is read by every pass at once, so it is `Share`;
// an `Rc`'s count is not updated by threads together yet (spec §22.2, §22.4).

fn main() {
    let scale = Rc<i32>(2)
    let mut xs = [1, 2, 3, 4]
    parallel for &mut x in xs {
        x += scale.count() as i32
    }
}
