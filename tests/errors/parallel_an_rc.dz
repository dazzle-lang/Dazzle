// expect: DZ0599
// Every `Rc` of one value shares a count, which threads do not update together yet, so an
// `Rc` does not reach `parallel`, even through `&` (spec §22.4).

struct Sprite {
    pub texture: Rc<u32>
}

fn draw(_s: &Sprite) {}

fn work(n: &mut i32) {
    n += 1
}

fn main() {
    let a = Sprite{ texture: Rc<u32>(1) }
    let mut n = 0
    parallel {
        draw(&a)
        work(&mut n)
    }
    println!("{}", n)
}
