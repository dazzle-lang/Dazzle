// expect: DZ0406
//
// A parameter a macro copies into several functions is unused only if every copy leaves
// it unused — and then it is reported once, where it was written (spec §12.6, 18.79).
// `input` is read by no state; `count` by one, which is enough.

struct Input {
    pub down: bool
}

macro machine -> decl {
    syntax Param { $name: ident : $type: type }
    syntax State { state $name: ident { $body: code } }
    pattern { $name: ident ( $params: [,]Param ) { $states: []State } }
    expand {
        #for s in $states {
            struct $s.name {
                pub(module) fn update(&mut self, $params) -> $name? {
                    $s.body
                    return none
                }
            }
        }
        union $name {
            #for s in $states {
                $s.name
            }
        }
    }
}

#machine Light(input: &Input, count: &mut i32) {
    state Off {
        count += 1
        return .On{}
    }
    state On {
        return .Off{}
    }
}

fn main() {}
