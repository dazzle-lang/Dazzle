// expect: (none)
//
// `std::math` (spec §14.4) with its names used every way an import allows: through the
// module alias, imported by name, methods on the machine's numbers, a struct's `Neg` and
// `Eq` with a temporary on the right, and the most negative `i8` as a literal.

import std::math
import std::math::{ Vec3, Mat4 }

fn angles(t: f32) -> f32 {
    return (t * math::TAU).sin().abs().clamp(0, 1)
}

fn counters(n: u16) -> u16 {
    let lowest: i8 = -128
    let _ = lowest.saturating_sub(1)
    return n.wrapping_mul(3).max(1)
}

fn vectors(v: Vec3) -> bool {
    let flipped = -v
    let moved = Mat4::translation(v).transform_point(flipped)
    return moved == Vec3{} && math::Vec2{ x: 1, y: 0 }.length() == 1
}
