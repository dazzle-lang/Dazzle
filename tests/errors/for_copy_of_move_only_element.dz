// expect: DZ0403
//
// `r` would copy a `Res`, which has a `drop` and so cannot be copied (spec §6.3). The array
// is behind a reference, so the loop cannot consume it either (D-0106).

struct Res {
    pub n: i32
}

impl Drop for Res {
    fn drop(&mut self) {}
}

fn main() {
    let rs = [Res{ n: 1 }]
    let seen = &rs
    for r in seen {
        println!("{}", r.n)
    }
}
