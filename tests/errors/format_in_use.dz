// expect: (none)
//
// `Format` implemented by a type of its own, and a `#[format]` function that passes its
// format string and arguments on, with a parameter of its own passed by name
// (spec §7.2, §12.9).

struct Point {
    pub x: i32
    pub y: i32
}

impl Format for Point {
    fn format(&self, f: &mut Formatter) {
        f.write_str("(")
        self.x.format(f)
        f.write_str(", ")
        self.y.format(f)
        f.write_str(")")
    }
}

#[format]
fn report(fmt: str, args: ..&Format, prefix: str = "") -> String {
    let body = String::format(fmt, ..args)
    return String::format("{}{}", prefix, body)
}

fn main() {
    let p = Point{ x: 1, y: 2 }
    let s = report("at {} after {:.1}s", p, 2.5, prefix = "> ")
    println("{}", s.as_str())
}
