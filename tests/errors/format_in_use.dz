// expect: (none)
//
// `Format` implemented by a type of its own, and `format!`, whose text the compiler
// places (spec §12.9, §14.6).

struct Point {
    pub x: i32
    pub y: i32
}

impl Format for Point {
    fn format(&self, f: &mut Formatter) {
        f.write_str("(")
        self.x.format(f)
        f.write_str(", ")
        self.y.format(f)
        f.write_str(")")
    }
}

fn main() {
    let p = Point{ x: 1, y: 2 }
    let s = format!("at {} after {:.1}s", p, 2.5)
    println!("{}", s.as_str())
}
