// expect: DZ0401
//
// `for r in rs` binds each element by value, and a `Res` is not plain, so the loop
// consumes the array, and it is gone after the loop (D-0106).

struct Res {
    pub n: i32
}

impl Drop for Res {
    fn drop(&mut self) {}
}

fn main() {
    let rs = [Res{ n: 1 }]
    for r in rs {
        println!("{}", r.n)
    }
    println!("{}", rs[0].n)
}
