// expect: DZ0549
//
// An iterator whose `get` returns a value has no element to hand out by reference.

struct Countdown {
    left: i32
    Countdown(n: i32) {
        left = n
    }
}

impl Iterate for Countdown {
    type Item = i32
    fn valid(&self) -> bool {
        return left > 0
    }
    fn get(&self) -> i32 {
        return left
    }
    fn advance(&mut self) {
        left -= 1
    }
}

fn main() {
    for &mut n in Countdown(3) {
        println!("{}", n)
    }
}
