// expect: (none)
//
// Behind a `&mut Shape`, `&mut c` writes into the caller's union.

union Shape {
    Circle { radius: f32 }
    Point {}
}

fn grow(s: &mut Shape) {
    switch s {
        case Circle(&mut c) { c.radius += 1 }
        case Point {}
    }
}

fn main() {
    let mut s = Shape::Circle{ radius: 1 }
    grow(&mut s)
    switch s {
        case Circle(c) { #println("{}", c.radius) }
        default {}
    }
}
