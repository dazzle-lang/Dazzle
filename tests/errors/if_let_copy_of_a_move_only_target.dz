// expect: DZ0403
//
// A plain `if let` binding copies what the handle refers to, and a `File` cannot be
// copied; `&f` refers to it instead.

struct File {
    pub fd: i32 = 0
}

impl Drop for File {
    fn drop(&mut self) {}
}

fn main() {
    let shared = Rc<File>(File{ fd: 3 })
    if let f = shared {
        println("{}", f.fd)
    }
}
