// expect: DZ0426
// `lends` makes callers keep what they give apart from their other arguments, so it names
// only what another thread writes: `c` is written after the block, on this thread, and needs
// none (spec §22.12).

fn bump(n: &mut i32) {
    n += 1
}

fn twice(a: &mut i32, b: &mut i32, c: &mut i32) lends a, b, c {
    parallel {
        bump(a)
        bump(b)
    }
    c += 1
}

fn main() {
    let mut a = 0
    let mut b = 0
    let mut c = 0
    twice(&mut a, &mut b, &mut c)
}
