// expect: DZ0401
//
// `Indexed(it)` takes the iterator it numbers by value: one that is not plain data moves in,
// and is gone from where it was (spec §6.4, §10.4).

struct Letters {
    pub text: String
    pub at:   usize = 0
}

impl Iterate for Letters {
    type Item = usize

    fn valid(&self) -> bool {
        return at < text.byte_len()
    }

    fn get(&self) -> usize {
        return at
    }

    fn advance(&mut self) {
        at += 1
    }
}

fn main() {
    let w = Letters{ text: String("abc") }
    let n = Indexed(w)
    println!("{}", w.at)
    for i, _ in n {
        println!("{}", i)
    }
}
