// expect: DZ0430
// A `&mut` from outside the loop, passed on, would let every pass write what it refers to
// at once (spec §22.3).

fn bump(n: &mut i32) {
    n += 1
}

fn count(xs: &mut [4]i32, hits: &mut i32) {
    parallel for &mut x in xs {
        x += 1
        bump(hits)
    }
}

fn main() {
    let mut xs = [1, 2, 3, 4]
    let mut hits = 0
    count(&mut xs, &mut hits)
    println!("{}", hits)
}
