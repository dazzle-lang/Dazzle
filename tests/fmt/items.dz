import math
import engine::render as gfx
import math::{ pow, sqrt, PI }
import cpp "raylib.h" as rl

/// A doc comment on a constant.
const MAX_ENTITIES = 4096
const GRAVITY: f32 = -9.81
static FRAME: u64 = 0
#[thread_local]
pub static SCRATCH: [4]u8 = [0, 0, 0, 0]

#[align(64)]
pub struct CacheLine {
    data: [64]u8
}

pub struct Transform {
    position: Vec3
    rotation: Quat = Quat::identity()
    scale:    Vec3 = Vec3{ 1, 1, 1 }

    pub fn matrix(&self) -> Mat4 {
        return Mat4::from(position, rotation, scale)
    }

    pub fn translate(&mut self, d: Vec3) {
        position += d
    }
}

pub struct SpriteBatch {
    m_verts:                 Buffer<Vertex>
    pub(module) m_gl_handle: u32
    pub count:               u32

    pub fn draw(&mut self, s: &Sprite) {
        count += 1
    }

    fn flush(&mut self) {}
}

pub union Shape {
    Circle { radius: f32 }
    Rect { w: f32, h: f32 }
    Point {}
}

pub enum Sprite : u16 {
    None = 0
    Default
    /// The selected state.
    Selected
    Pressed
}

pub trait Allocator {
    fn alloc(&self, size: usize, align: usize) -> ^u8
    fn free(&self, p: ^u8, size: usize, align: usize)
}

pub trait Drawable {
    fn bounds(&self) -> Rect

    fn is_visible(&self, cam: &Camera) -> bool {
        return cam.frustum.contains(self.bounds())
    }
}

pub trait Iterate {
    type Item
    fn next(&mut self) -> Item?
}

pub struct Arena {
    m_base: own ^u8
    m_used: usize
}

impl Allocator for Arena {
    fn alloc(&self, size: usize, align: usize) -> ^u8 {
        return m_base
    }

    fn free(&self, p: ^u8, size: usize, align: usize) {}
}

impl Drop for Arena {
    fn drop(&mut self) {
        free_pages(m_base)
    }
}

pub struct SliceIter<T> {
    m_slice: []T
    m_index: usize
}

impl<T> Iterate for SliceIter<T> {
    type Item = &T

    fn valid(&self) -> bool {
        return m_index < m_slice.len
    }

    fn get(&self) -> &T {
        return &m_slice[m_index]
    }

    fn advance(&mut self) {
        m_index += 1
    }
}

pub struct SliceIterMut<T> {
    m_slice: []mut T
    m_index: usize
}

impl<T> Iterate for SliceIterMut<T> {
    type Item = &mut T

    fn get(&self) -> &mut T {
        return &mut m_slice[m_index]
    }
}

pub struct Nested {
    grid:  Buffer<Buffer<f32>>
    table: HashMap<str, Buffer<Vec3>>
}

pub unsafe fn poke(p: ^i32, v: i32) {
    p^ = v
}

pub struct Raw {
    m_p: ^i32

    unsafe fn write(&mut self, v: i32) {
        m_p^ = v
    }
}

pub struct Button : UiElement {
    label: str
}

impl<T: Copy> Copy for Buffer<T> {
    fn copy(&mut self, other: &Self) {
        m_len = other.m_len
    }
}

fn sum(xs: ..i32) -> i32 {
    return 0
}

fn tell(prefix: str, things: ..&Describe) {}

// Parameters after a variadic one, passed by name (spec §7.2).
fn note(fmt: str, args: ..&Format, level: i32 = 0, loc: SourceLocation = #location) {}

fn named() {
    note("{} {}", 1, 2, level = 3)
    note("x", loc = here(), level = 1 + 2)
}

/// Field tags: free-form text for reflection (spec §13.1).
pub struct Player {
    pub name: str = "" `json:"player_name"`
    pub hp:   i32 = 100 `json:"health" save:"-"`
    m_id:     u64
}

union Event {
    Hit { amount: i32 `json:"dmg"` }
}

// `const str`: text in static storage, as a field, a parameter and a result (spec §5.3).
pub struct Sign {
    pub text: const str
}

fn caption(s: const str, fallback: const str) -> const str {
    return s
}
