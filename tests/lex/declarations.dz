import engine::render as gfx

pub struct Buffer<T> {
    m_allocator: ^Allocator = null
    m_data:      own ^T
    m_len:       u32

    Buffer(capacity: u32, allocator: ^Allocator = Allocators::Global) {
        m_allocator = allocator
        m_capacity  = capacity
    }

    copy(other: &Self) { m_len = other.m_len }
    drop() { m_allocator.free(m_data as ^u8, m_capacity, alignof(T)) }

    pub fn length(&self) -> u32 { return m_len }
    pub mut fn resize(&mut self, n: u32) { m_len = n }
}

fn load(path: str) !-> Texture {
    let tex = open(path) or return
    let found = find(tex) or { e ->
        return error("no texture: {}", e.message)
    }
    return found
}
